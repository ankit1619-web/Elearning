@* Usage: <partial name="_Pager" model="(Model.Page, Model.TotalPages)" /> — baaki query string (filters) bachi rehti hai *@
@model (int Page, int TotalPages)
@{
    string Link(int p)
    {
        var parts = Context.Request.Query
            .Where(k => !string.Equals(k.Key, "page", StringComparison.OrdinalIgnoreCase))
            .Select(k => $"{Uri.EscapeDataString(k.Key)}={Uri.EscapeDataString(k.Value.ToString())}")
            .Append($"page={p}");
        return Context.Request.Path + "?" + string.Join("&", parts);
    }
}
@if (Model.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination pagination-sm justify-content-end mb-0">
            <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                <a class="page-link" href="@Link(Math.Max(1, Model.Page - 1))">&laquo;</a>
            </li>
            @for (var p = Math.Max(1, Model.Page - 2); p <= Math.Min(Model.TotalPages, Model.Page + 2); p++)
            {
                <li class="page-item @(p == Model.Page ? "active" : "")"><a class="page-link" href="@Link(p)">@p</a></li>
            }
            <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                <a class="page-link" href="@Link(Math.Min(Model.TotalPages, Model.Page + 1))">&raquo;</a>
            </li>
        </ul>
    </nav>
}
