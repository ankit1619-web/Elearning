@functions {
    string Active(string controller) =>
        string.Equals(ViewContext.RouteData.Values["controller"]?.ToString(), controller, StringComparison.OrdinalIgnoreCase)
            ? "active" : "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "Teacher") - Manika Learning Teacher</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/adminlayout.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

    <nav id="sidebar">
        <div class="sidebar-brand">
            <div class="brand-icon"><i class="bi bi-person-video3"></i></div>
            <div class="brand-text">
                <span class="fw-bold fs-6">Manika Teacher</span>
                <small class="d-block text-muted" style="font-size: 11px;">Teaching Studio</small>
            </div>
            <button type="button" class="btn btn-sm btn-light border-0 d-lg-none ms-auto" id="sidebarCloseBtn" aria-label="Close Sidebar">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>

        <div class="sidebar-scroll">
            <ul class="nav flex-column" id="teacherSidebarMenu">
                <li class="nav-item">
                    <a class="nav-link @Active("Dashboard")" asp-area="Teacher" asp-controller="Dashboard" asp-action="Index">
                        <i class="bi bi-grid-1x2-fill"></i><span>Dashboard</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @Active("Courses")" asp-area="Teacher" asp-controller="Courses" asp-action="Index">
                        <i class="bi bi-journal-bookmark-fill"></i><span>My Courses</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @Active("Questions")" asp-area="Teacher" asp-controller="Questions" asp-action="Index">
                        <i class="bi bi-database-fill"></i><span>Question Bank</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @Active("Tests")" asp-area="Teacher" asp-controller="Tests" asp-action="Index">
                        <i class="bi bi-ui-checks"></i><span>Tests</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @Active("Doubts")" asp-area="Teacher" asp-controller="Doubts" asp-action="Index">
                        <i class="bi bi-chat-dots-fill"></i><span>Doubts</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @Active("Students")" asp-area="Teacher" asp-controller="Students" asp-action="Index">
                        <i class="bi bi-people-fill"></i><span>Students</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @Active("Analytics")" asp-area="Teacher" asp-controller="Analytics" asp-action="Index">
                        <i class="bi bi-graph-up-arrow"></i><span>Analytics</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @Active("Profile")" asp-area="Teacher" asp-controller="Profile" asp-action="Index">
                        <i class="bi bi-person-circle"></i><span>Profile</span>
                    </a>
                </li>
            </ul>
        </div>
    </nav>

    <div id="content">
        <header class="admin-navbar">
            <div class="d-flex align-items-center gap-3">
                <button class="btn btn-light border-0 shadow-none d-lg-none" id="sidebarToggle" type="button" aria-label="Toggle Navigation">
                    <i class="bi bi-list fs-4"></i>
                </button>
                <h5 class="fw-bold mb-0 text-dark">@(ViewData["HeaderTitle"] ?? ViewData["Title"] ?? "Teacher Panel")</h5>
            </div>

            <div class="d-flex align-items-center gap-3">
                <div class="dropdown">
                    <a href="#" class="d-flex align-items-center text-decoration-none dropdown-toggle text-dark fw-medium" data-bs-toggle="dropdown" aria-expanded="false">
                        <div class="avatar-circle me-2"><i class="bi bi-person-fill"></i></div>
                        <span class="d-none d-sm-inline">@(User.Identity?.Name ?? "Teacher")</span>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 rounded-3">
                        <li><a class="dropdown-item py-2" asp-area="Teacher" asp-controller="Profile" asp-action="Index"><i class="bi bi-person me-2"></i> My Profile</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" id="logoutForm" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="dropdown-item text-danger fw-medium d-flex align-items-center gap-2">
                                    <i class="bi bi-box-arrow-right"></i> Sign Out
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </header>

        <main class="container-fluid p-3 p-md-4 w-100">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @* Page-level AJAX actions (delete, publish, reply...) ke liye ek token *@
            @Html.AntiForgeryToken()

            <div id="globalLoader" class="d-none position-fixed top-50 start-50 translate-middle" style="z-index: 1060;">
                <div class="spinner-border text-primary shadow-sm" style="width: 3.5rem; height: 3.5rem; border-width: 0.35em;" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </div>

            <div class="modal fade" id="globalModal" tabindex="-1" aria-labelledby="globalModalTitle" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
                <div class="modal-dialog modal-dialog-centered modal-lg modal-fullscreen-sm-down" id="globalModalSize">
                    <div class="modal-content rounded-4 border-0 shadow-lg" id="globalModalContent"></div>
                </div>
            </div>

            <div class="modal fade" id="confirmModal" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered modal-sm">
                    <div class="modal-content rounded-4 border-0 shadow">
                        <div class="modal-body text-center p-4">
                            <div class="text-danger mb-3"><i class="bi bi-exclamation-octagon-fill display-5"></i></div>
                            <h6 class="fw-bold text-dark mb-2" id="confirmTitle">Are you sure?</h6>
                            <p class="text-muted small mb-4" id="confirmMessage"></p>
                            <div class="d-flex gap-2 justify-content-center">
                                <button type="button" class="btn btn-light rounded-3 px-3 w-50" data-bs-dismiss="modal">Cancel</button>
                                <button type="button" id="confirmYesBtn" class="btn btn-danger rounded-3 px-3 w-50">Yes</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="toast-container position-fixed top-0 end-0 p-4" style="z-index: 1055;" id="toastContainer"></div>

            @RenderBody()
        </main>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/admin-ui.js" asp-append-version="true"></script>
    <script src="~/js/teacher-ui.js" asp-append-version="true"></script>
    <script>
        $(document).ready(function () {
            $('#sidebarToggle, #sidebarCloseBtn, #sidebarBackdrop').on('click', function () {
                $('#sidebar, #sidebarBackdrop').toggleClass('show');
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
