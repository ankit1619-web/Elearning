@using Manikalearning.Application.Features.Handlers.Teacher
@model PagedResult<PickQuestionRow>
@{
    var testId = (Guid)ViewData["TestId"]!;
    var search = ViewData["Search"] as string;

    string Diff(DifficultyLevel d) => d switch
    {
        DifficultyLevel.Easy => "Easy",
        DifficultyLevel.Medium => "Medium",
        DifficultyLevel.Hard => "Hard",
        _ => "-"
    };

    string DiffCls(DifficultyLevel d) => d switch
    {
        DifficultyLevel.Easy => "success",
        DifficultyLevel.Medium => "warning",
        DifficultyLevel.Hard => "danger",
        _ => "secondary"
    };
    string PageUrl(int p) => $"/Teacher/Tests/PickPartial/{testId}?search={Uri.EscapeDataString(search ?? "")}&page={p}";
}

<div class="modal-header border-bottom pb-2">
    <h5 class="modal-title fw-bold text-dark">Add Questions <span class="text-muted small fw-normal">(@Model.TotalCount available)</span></h5>
    <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<form asp-area="Teacher" asp-controller="Tests" asp-action="AddQuestions" asp-route-id="@testId" method="post"
      onsubmit="return Toast.submitModalForm(this);">
    @Html.AntiForgeryToken()

    <div class="modal-body py-3">
        <div class="input-group input-group-sm mb-3" style="max-width:420px">
            <input type="text" id="pickSearch" value="@search" class="form-control shadow-none" placeholder="Question text search..."
                   onkeydown="if(event.key==='Enter'){event.preventDefault();document.getElementById('pickSearchBtn').click();}" />
            <button class="btn btn-light border" type="button" id="pickSearchBtn"
                    onclick="Toast.openModal('/Teacher/Tests/PickPartial/@testId?search=' + encodeURIComponent(document.getElementById('pickSearch').value), 'modal-xl')">
                <i class="bi bi-search"></i>
            </button>
        </div>

        @if (!Model.Items.Any())
        {
            <div class="text-center text-muted small py-4">Koi question nahi mila. Question Bank me active questions banayein.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width:40px" class="border-0 ps-3"></th>
                            <th class="text-muted fw-semibold border-0">Question</th>
                            <th class="text-muted fw-semibold border-0">Topic</th>
                            <th class="text-muted fw-semibold border-0">Level</th>
                            <th class="text-muted fw-semibold border-0">Marks</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var q in Model.Items)
                        {
                            var text = q.QuestionText.Length > 110 ? q.QuestionText.Substring(0, 110) + "..." : q.QuestionText;
                            <tr>
                                <td class="ps-3"><input type="checkbox" name="questionIds" value="@q.QuestionId" class="form-check-input shadow-none" /></td>
                                <td class="fw-medium text-dark">@text</td>
                                <td class="small text-muted">@(q.TopicName ?? "-")</td>
                                <td><span class="badge bg-@DiffCls(q.Difficulty) bg-opacity-10 text-@DiffCls(q.Difficulty) rounded-pill">@Diff(q.Difficulty)</span></td>
                                <td class="small">@q.Marks.ToString("0.##")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (Model.TotalPages > 1)
            {
                <div class="d-flex justify-content-between align-items-center mt-3 small text-muted">
                    <span>Page @Model.Page / @Model.TotalPages <span class="ms-2">(page badalne par chune hue questions reset ho jate hain, pehle add kar lein)</span></span>
                    <div class="btn-group btn-group-sm">
                        <button type="button" class="btn btn-light border" @(Model.Page <= 1 ? "disabled" : "")
                                onclick="Toast.openModal('@PageUrl(Model.Page - 1)', 'modal-xl')">
                            &laquo;
                        </button>
                        <button type="button" class="btn btn-light border" @(Model.Page >= Model.TotalPages ? "disabled" : "")
                                onclick="Toast.openModal('@PageUrl(Model.Page + 1)', 'modal-xl')">
                            &raquo;
                        </button>
                    </div>
                </div>
            }
        }
    </div>

    <div class="modal-footer border-top pt-2">
        <button type="button" class="btn btn-sm btn-light rounded-2 px-3" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-sm btn-primary px-4 shadow-sm"><i class="bi bi-plus-lg me-1"></i> Add Selected</button>
    </div>
</form>
