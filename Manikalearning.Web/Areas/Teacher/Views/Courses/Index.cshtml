@using Manikalearning.Application.Features.Handlers.Teacher
@model List<TeacherCourseListItem>

@{
    ViewData["Title"] = "My Courses";
    ViewData["HeaderTitle"] = "My Courses";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h4 class="fw-bold text-dark mb-1 d-flex align-items-center gap-2">
            My Courses
            <span class="badge bg-indigo bg-opacity-10 text-indigo rounded-pill px-3 py-1 fs-6" style="color: #4f46e5; background-color: rgba(79, 70, 229, 0.1);">@Model.Count</span>
        </h4>
        <p class="text-muted small mb-0">Create courses, add sections and lectures, then publish them for students.</p>
    </div>
    <button class="btn btn-outline-primary btn-sm rounded-pill px-4" 
            onclick="Toast.openModal('/Teacher/Courses/CreatePartial', 'modal-lg')">
        <i class="bi bi-plus-lg"></i> New Course
    </button>
</div>

@if (!Model.Any())
{
    <div class="card border-0 shadow-sm rounded-4 p-5 text-center text-muted bg-white my-5">
        <div class="mb-3">
            <div class="rounded-circle bg-light d-inline-flex p-4 text-indigo" style="color: #4f46e5;">
                <i class="bi bi-journal-bookmark fs-1"></i>
            </div>
        </div>
        <h5 class="fw-bold text-dark mb-1">No courses found</h5>
        <p class="small text-muted mb-3">Get started by clicking "New Course" above.</p>
        <div>
            <button class="btn btn-outline-primary btn-sm rounded-pill px-4" onclick="Toast.openModal('/Teacher/Courses/CreatePartial', 'modal-lg')">
                Create First Course
            </button>
        </div>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var c in Model)
        {
            <div class="col-12 col-md-6 col-xl-4">
                <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden bg-white course-manage-card" style="transition: all 0.3s ease;">
                    <div class="position-relative overflow-hidden bg-light" style="height: 160px;">
                        @if (!string.IsNullOrWhiteSpace(c.ThumbnailUrl))
                        {
                            <img src="@c.ThumbnailUrl" alt="@c.CourseName" class="w-100 h-100 object-fit-cover" />
                        }
                        else
                        {
                            <div class="w-100 h-100 d-flex align-items-center justify-content-center text-muted bg-gradient">
                                <i class="bi bi-image fs-1 opacity-25"></i>
                            </div>
                        }
                        <div class="position-absolute top-0 end-0 m-3">
                            @if (c.IsPublished)
                            {
                                <span class="badge bg-success text-white rounded-pill px-3 py-1 shadow-sm fw-semibold" style="font-size: 0.75rem;">Published</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary text-white rounded-pill px-3 py-1 shadow-sm fw-semibold" style="font-size: 0.75rem;">Draft</span>
                            }
                        </div>
                    </div>

                    <div class="card-body d-flex flex-column p-4">
                        <h5 class="fw-bold text-dark mb-2 text-truncate" title="@c.CourseName">@c.CourseName</h5>

                        <div class="mb-3">
                            @if (c.IsFree)
                            {
                                <span class="fw-bold text-success fs-5">Free</span>
                            }
                            else if (c.DiscountPrice > 0 && c.DiscountPrice < c.Price)
                            {
                                <div class="d-flex align-items-center gap-2">
                                    <span class="fw-bold text-dark fs-5">₹@c.DiscountPrice</span>
                                    <span class="text-muted text-decoration-line-through small">₹@c.Price.ToString("0.##")</span>
                                </div>
                            }
                            else
                            {
                                <span class="fw-bold text-dark fs-5">₹@c.Price.ToString("0.##")</span>
                            }
                        </div>

                        <div class="d-flex justify-content-between py-2 px-3 rounded-3 bg-light bg-opacity-75 small text-muted mb-4">
                            <span><i class="bi bi-collection text-indigo me-1"></i> @c.SectionCount Sec</span>
                            <span><i class="bi bi-play-circle text-primary me-1"></i> @c.LectureCount Lec</span>
                            <span><i class="bi bi-people text-success me-1"></i> @c.StudentCount Students</span>
                        </div>

                        <!-- Button Actions Grouped Cleanly -->
                        <div class="mt-auto pt-2 border-top border-light d-flex flex-column gap-2">
                            <div class="d-flex align-items-center gap-2">
                                <a class="btn btn-sm btn-primary rounded-pill px-3 flex-grow-1 fw-semibold shadow-sm text-center" style="background-color: #4f46e5; border: none;" href="/Teacher/Courses/Manage/@c.CourseId">
                                    <i class="bi bi-layout-text-sidebar-reverse me-1"></i> Content
                                </a>
                                <button type="button" class="btn btn-sm btn-light text-secondary rounded-circle p-2" title="Edit Course"
                                        onclick="Toast.openModal('/Teacher/Courses/EditPartial/@c.CourseId', 'modal-lg')">
                                    <i class="bi bi-pencil-square fs-6"></i>
                                </button>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <button type="button" class="btn btn-sm @(c.IsPublished ? "btn-outline-secondary" : "btn-outline-success") rounded-pill px-3 fw-semibold flex-grow-1"
                                        onclick="TeacherAjax.post('/Teacher/Courses/TogglePublish/@c.CourseId')">
                                    @(c.IsPublished ? "Unpublish" : "Publish")
                                </button>
                                <button type="button" class="btn btn-sm btn-light text-danger rounded-circle p-2" title="Delete Course"
                                        onclick="TeacherAjax.confirmPost('Delete course?', 'The course along with its sections and lectures will be removed.', '/Teacher/Courses/Delete/@c.CourseId')">
                                    <i class="bi bi-trash fs-6"></i>
                                </button>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        }
    </div>
}

<style>
    .course-manage-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.08) !important;
    }
</style>