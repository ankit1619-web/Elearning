@model List<TeacherCourseListItem>

@{
    ViewData["Title"] = "My Courses";
    ViewData["HeaderTitle"] = "My Courses";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h5 class="fw-bold text-dark mb-0">
            My Courses
            <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-2.5 py-1">@Model.Count</span>
        </h5>
        <p class="text-muted small mb-0">Course banayein, sections aur lectures add karein, phir publish karein.</p>
    </div>
    <button class="btn btn-primary-custom btn-sm text-nowrap rounded-3 px-3 shadow-sm"
            onclick="Toast.openModal('/Teacher/Courses/CreatePartial', 'modal-lg')">
        <i class="bi bi-plus-lg me-1"></i> New Course
    </button>
</div>

@if (!Model.Any())
{
    <div class="card border-0 shadow-sm rounded-4 p-5 text-center text-muted bg-white">
        <i class="bi bi-journal-bookmark fs-1 opacity-50 mb-2"></i>
        <h6 class="fw-semibold mb-1">Abhi koi course nahi hai</h6>
        <p class="small mb-0">"New Course" se shuru karein.</p>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var c in Model)
        {
            <div class="col-12 col-md-6 col-xl-4">
                <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden bg-white">
                    @if (!string.IsNullOrWhiteSpace(c.ThumbnailUrl))
                    {
                        <img src="@c.ThumbnailUrl" alt="@c.CourseName" style="height:150px;object-fit:cover;" />
                    }
                    else
                    {
                        <div class="d-flex align-items-center justify-content-center bg-light text-secondary" style="height:150px;">
                            <i class="bi bi-image fs-1 opacity-50"></i>
                        </div>
                    }

                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start gap-2 mb-1">
                            <h6 class="fw-bold text-dark mb-0">@c.CourseName</h6>
                            @if (c.IsPublished)
                            {
                                <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-2.5 py-1">Published</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill px-2.5 py-1">Draft</span>
                            }
                        </div>

                        <div class="small mb-2">
                            @if (c.IsFree)
                            {
                                <span class="fw-semibold text-success">Free</span>
                            }
                            else if (c.DiscountPrice > 0 && c.DiscountPrice < c.Price)
                            {
                                <span class="fw-semibold text-dark">₹@c.DiscountPrice.ToString("0.##")</span>
                                <span class="text-muted text-decoration-line-through ms-1">₹@c.Price.ToString("0.##")</span>
                            }
                            else
                            {
                                <span class="fw-semibold text-dark">₹@c.Price.ToString("0.##")</span>
                            }
                        </div>

                        <div class="d-flex gap-3 small text-muted mb-3">
                            <span><i class="bi bi-collection me-1"></i>@c.SectionCount sections</span>
                            <span><i class="bi bi-play-circle me-1"></i>@c.LectureCount lectures</span>
                            <span><i class="bi bi-people me-1"></i>@c.StudentCount students</span>
                        </div>

                        <div class="d-flex flex-wrap gap-1 mt-auto">
                            <a class="btn btn-sm btn-primary px-3" href="/Teacher/Courses/Manage/@c.CourseId">
                                <i class="bi bi-layout-text-sidebar-reverse me-1"></i> Content
                            </a>
                            <button type="button" class="btn btn-sm btn-light text-primary" title="Edit"
                                    onclick="Toast.openModal('/Teacher/Courses/EditPartial/@c.CourseId', 'modal-lg')">
                                <i class="bi bi-pencil-square"></i>
                            </button>
                            <button type="button" class="btn btn-sm @(c.IsPublished ? "btn-outline-secondary" : "btn-outline-success")"
                                    onclick="TeacherAjax.post('/Teacher/Courses/TogglePublish/@c.CourseId')">
                                @(c.IsPublished ? "Unpublish" : "Publish")
                            </button>
                            <button type="button" class="btn btn-sm btn-light text-danger ms-auto" title="Delete"
                                    onclick="TeacherAjax.confirmPost('Delete course?', 'Course aur uske sections/lectures hat jayenge.', '/Teacher/Courses/Delete/@c.CourseId')">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
