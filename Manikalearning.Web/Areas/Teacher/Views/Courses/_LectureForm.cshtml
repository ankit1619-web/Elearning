@using Manikalearning.Web.Areas.Teacher.ViewModels
@model LectureFormVm
@{
    var f = Model.Form;
    var isEdit = f.LectureId != null && f.LectureId != Guid.Empty;
}

<div class="modal-header border-bottom pb-2">
    <h5 class="modal-title fw-bold text-dark">@(isEdit ? "Edit Lecture" : "Add Lecture")</h5>
    <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<form asp-area="Teacher" asp-controller="Courses" asp-action="SaveLecture" method="post" enctype="multipart/form-data"
      onsubmit="return Toast.submitModalForm(this);">
    @Html.AntiForgeryToken()
    <input type="hidden" name="CourseSectionId" value="@f.CourseSectionId" />
    @if (isEdit)
    {
        <input type="hidden" name="LectureId" value="@f.LectureId" />
    }

    <div class="modal-body py-3">
        <div class="row g-3">
            <div class="col-lg-7">
                <div class="mb-3">
                    <label class="form-label small fw-semibold text-muted">Lecture Title *</label>
                    <input name="LectureTitle" value="@f.LectureTitle" maxlength="250" required
                           class="form-control form-control-sm rounded-2 shadow-none" placeholder="e.g. Introduction to Preamble" />
                </div>
                <div class="mb-3">
                    <label class="form-label small fw-semibold text-muted">Description</label>
                    <textarea name="Description" rows="3" class="form-control form-control-sm rounded-2 shadow-none" placeholder="Brief explanation of the lecture content...">@f.Description</textarea>
                </div>

                <div class="p-2 bg-light rounded-2 border mb-3">
                    <label class="form-label small fw-semibold text-muted mb-1"><i class="bi bi-camera-video me-1"></i>Video</label>
                    <input name="VideoUrl" value="@f.VideoUrl" maxlength="1000"
                           class="form-control form-control-sm rounded-2 shadow-none mb-2"
                           placeholder="Video URL (YouTube / Vimeo / Bunny / S3)" />
                    <div class="d-flex align-items-center gap-2">
                        <input type="file" name="videoFile" accept=".mp4,.webm" class="form-control form-control-sm shadow-none" />
                        <input type="number" min="0" max="1000" name="VideoDurationMinutes" value="@f.VideoDurationMinutes"
                               class="form-control form-control-sm shadow-none" style="max-width:130px" placeholder="Minutes" />
                    </div>
                    <div class="form-text">Provide a URL or upload a file (mp4/webm, max 500 MB). Uploading a file will override the URL. Using direct video URLs is recommended for large files.</div>
                </div>

                <div class="p-2 bg-light rounded-2 border">
                    <label class="form-label small fw-semibold text-muted mb-1"><i class="bi bi-file-earmark-pdf me-1"></i>Notes</label>
                    <input name="NotesUrl" value="@f.NotesUrl" maxlength="1000"
                           class="form-control form-control-sm rounded-2 shadow-none mb-2" placeholder="Notes PDF URL" />
                    <input type="file" name="notesFile" accept=".pdf" class="form-control form-control-sm shadow-none mb-2" />
                    <textarea name="Notes" rows="3" class="form-control form-control-sm rounded-2 shadow-none"
                              placeholder="Or write short notes directly here...">@f.Notes</textarea>
                    <div class="form-text">PDF max size: 25 MB.</div>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="p-2 bg-light rounded-2 border mb-3">
                    <label class="form-label small fw-semibold text-muted mb-1">Curriculum Topic (optional)</label>
                    <select id="ddlSubject" class="form-select form-select-sm rounded-2 shadow-none mb-2">
                        <option value="">-- Subject --</option>
                        @foreach (var s in Model.Subjects)
                        {
                            <option value="@s.Id" selected="@(f.PickSubjectId == s.Id)">@s.Name</option>
                        }
                    </select>
                    <select id="ddlSection" class="form-select form-select-sm rounded-2 shadow-none mb-2">
                        <option value="">-- Section --</option>
                        @foreach (var s in Model.Sections)
                        {
                            <option value="@s.Id" selected="@(f.PickSectionId == s.Id)">@s.Name</option>
                        }
                    </select>
                    <select id="ddlTopic" name="TopicId" class="form-select form-select-sm rounded-2 shadow-none">
                        <option value="">-- Topic --</option>
                        @foreach (var t in Model.Topics)
                        {
                            <option value="@t.Id" selected="@(f.TopicId == t.Id)">@t.Name</option>
                        }
                    </select>
                    <div class="form-text">Linking a topic connects this lecture to the question bank and student analytics.</div>
                </div>

                <div class="p-2 bg-light rounded-2 border">
                    <div class="mb-2">
                        <label class="form-label small fw-semibold text-muted">Display Order</label>
                        <input type="number" min="0" name="DisplayOrder" value="@(f.DisplayOrder > 0 ? f.DisplayOrder.ToString() : "")"
                               class="form-control form-control-sm rounded-2 shadow-none" placeholder="Auto (at the end)" />
                    </div>
                    <div class="form-check form-switch mb-2">
                        <input class="form-check-input shadow-none" type="checkbox" name="IsFreePreview" value="true" id="chkFreePrev" @(f.IsFreePreview ? "checked" : "") />
                        <label class="form-check-label small fw-semibold text-dark" for="chkFreePrev">Free preview (visible without purchase)</label>
                    </div>
                    <div class="form-check form-switch">
                        <input class="form-check-input shadow-none" type="checkbox" name="IsPublished" value="true" id="chkLecPub" @(f.IsPublished ? "checked" : "") />
                        <label class="form-check-label small fw-semibold text-dark" for="chkLecPub">Published</label>
                    </div>
                    <div class="form-text">At least video content or notes are required to publish a lecture.</div>
                </div>
            </div>
        </div>
    </div>

    <div class="modal-footer border-top pt-2">
        <button type="button" class="btn btn-sm btn-light rounded-2 px-3" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-sm btn-primary px-4 shadow-sm"><i class="bi bi-check-lg me-1"></i> Save Lecture</button>
    </div>
</form>

<script>
    (function() {
        TeacherLookup.link('#ddlSubject', '#ddlSection', 'Sections', '-- Section --',
            [{ sel: '#ddlTopic', placeholder: '-- Topic --' }]);
        TeacherLookup.link('#ddlSection', '#ddlTopic', 'Topics', '-- Topic --');
    })();
</script>