@using Manikalearning.Application.Features.Handlers.Teacher
@model TeacherCourseForm
@{
    var isEdit = Model.CourseId != null && Model.CourseId != Guid.Empty;
}

<div class="modal-header border-bottom pb-2">
    <h5 class="modal-title fw-bold text-dark">@(isEdit ? "Edit Course" : "New Course")</h5>
    <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<form asp-area="Teacher" asp-controller="Courses" asp-action="Save" method="post" enctype="multipart/form-data"
      onsubmit="return Toast.submitModalForm(this);">
    @Html.AntiForgeryToken()
    @if (isEdit)
    {
        <input type="hidden" name="CourseId" value="@Model.CourseId" />
    }
    <input type="hidden" name="ThumbnailUrl" value="@Model.ThumbnailUrl" />

    <div class="modal-body py-3">
        <div class="mb-3">
            <label class="form-label small fw-semibold text-muted">Course Name *</label>
            <input name="CourseName" value="@Model.CourseName" maxlength="250" required
                   class="form-control form-control-sm rounded-2 shadow-none" placeholder="e.g. UPSC Prelims Polity" />
        </div>

        <div class="mb-3">
            <label class="form-label small fw-semibold text-muted">Description</label>
            <textarea name="Description" rows="4" class="form-control form-control-sm rounded-2 shadow-none"
                      placeholder="What will students learn in this course..."></textarea>@Model.Description
        </div>

        <div class="mb-3">
            <label class="form-label small fw-semibold text-muted">Thumbnail (jpg/png/webp, max 2 MB)</label>
            <div class="d-flex align-items-center gap-3">
                @if (!string.IsNullOrWhiteSpace(Model.ThumbnailUrl))
                {
                    <img src="@Model.ThumbnailUrl" alt="thumbnail" class="rounded-2 border" style="width:96px;height:56px;object-fit:cover;" />
                }
                <input type="file" name="thumbnail" accept=".jpg,.jpeg,.png,.webp" class="form-control form-control-sm shadow-none" />
            </div>
        </div>

        <div class="p-2 bg-light rounded-2 border">
            <div class="form-check form-switch mb-2">
                <input class="form-check-input shadow-none" type="checkbox" name="IsFree" value="true" id="chkFree" @(Model.IsFree ? "checked" : "") />
                <label class="form-check-label small fw-semibold text-dark" for="chkFree">Free course</label>
            </div>
            <div class="row g-2" id="priceFields">
                <div class="col-6">
                    <label class="form-label small fw-semibold text-muted">Price (₹)</label>
                    <input type="number" step="0.01" min="0" name="Price" value="@Model.Price.ToString("0.##")"
                           class="form-control form-control-sm rounded-2 shadow-none" />
                </div>
                <div class="col-6">
                    <label class="form-label small fw-semibold text-muted">Discount Price (₹)</label>
                    <input type="number" step="0.01" min="0" name="DiscountPrice" value="@Model.DiscountPrice"
                           class="form-control form-control-sm rounded-2 shadow-none" />
                    <div class="form-text">Selling price after discount. 0 = No discount.</div>
                </div>
            </div>
        </div>
    </div>

    <div class="modal-footer border-top pt-2">
        <button type="button" class="btn btn-sm btn-light rounded-2 px-3" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-sm btn-primary px-4 shadow-sm"><i class="bi bi-check-lg me-1"></i> Save Course</button>
    </div>
</form>

<script>
    (function() {
        const chk = document.getElementById('chkFree');
        const box = document.getElementById('priceFields');
        function sync() { box.style.opacity = chk.checked ? '.4' : '1'; box.querySelectorAll('input').forEach(i => i.disabled = chk.checked); }
        chk.addEventListener('change', sync); sync();
    })();
</script>