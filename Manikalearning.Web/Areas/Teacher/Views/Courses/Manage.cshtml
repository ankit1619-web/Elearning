@model CourseManageDto

@{
    ViewData["Title"] = Model.CourseName;
    ViewData["HeaderTitle"] = "Course Content";

    string Duration(int? seconds)
    {
        if (seconds == null || seconds <= 0) return "-";
        var t = TimeSpan.FromSeconds(seconds.Value);
        return t.TotalHours >= 1 ? $"{(int)t.TotalHours}:{t.Minutes:00}:{t.Seconds:00}" : $"{t.Minutes}:{t.Seconds:00}";
    }
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <a href="/Teacher/Courses" class="small text-decoration-none text-muted"><i class="bi bi-arrow-left me-1"></i>My Courses</a>
        <h5 class="fw-bold text-dark mb-0 mt-1">
            @Model.CourseName
            @if (Model.IsPublished)
            {
                <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-2.5 py-1 ms-1">Published</span>
            }
            else
            {
                <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill px-2.5 py-1 ms-1">Draft</span>
            }
        </h5>
        <p class="text-muted small mb-0">@Model.Sections.Count sections · @Model.Sections.Sum(s => s.Lectures.Count) lectures · @Model.PublishedLectures published</p>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-sm @(Model.IsPublished ? "btn-outline-secondary" : "btn-outline-success") rounded-3 px-3"
                onclick="TeacherAjax.post('/Teacher/Courses/TogglePublish/@Model.CourseId')">
            @(Model.IsPublished ? "Unpublish" : "Publish")
        </button>
        <button class="btn btn-primary-custom btn-sm text-nowrap rounded-3 px-3 shadow-sm"
                onclick="Toast.openModal('/Teacher/Courses/SectionPartial?courseId=@Model.CourseId', 'modal-md')">
            <i class="bi bi-plus-lg me-1"></i> Add Section
        </button>
    </div>
</div>

@if (!Model.Sections.Any())
{
    <div class="card border-0 shadow-sm rounded-4 p-5 text-center text-muted bg-white">
        <i class="bi bi-collection fs-1 opacity-50 mb-2"></i>
        <h6 class="fw-semibold mb-1">Abhi koi section nahi hai</h6>
        <p class="small mb-0">Pehle ek section add karein (jaise "Chapter 1"), phir usme lectures.</p>
    </div>
}

@foreach (var s in Model.Sections)
{
    <div class="card border-0 shadow-sm rounded-4 mb-3 bg-white">
        <div class="card-header bg-white border-bottom d-flex flex-wrap justify-content-between align-items-center gap-2 py-3 rounded-top-4">
            <div>
                <span class="fw-bold text-dark">@s.SectionName</span>
                @if (!s.IsActive)
                {
                    <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill ms-1">Inactive</span>
                }
                @if (!string.IsNullOrWhiteSpace(s.Description))
                {
                    <div class="small text-muted">@s.Description</div>
                }
            </div>
            <div class="d-flex gap-1">
                <button class="btn btn-sm btn-primary-custom px-3"
                        onclick="Toast.openModal('/Teacher/Courses/LecturePartial?sectionId=@s.CourseSectionId', 'modal-xl')">
                    <i class="bi bi-plus-lg me-1"></i> Lecture
                </button>
                <button class="btn btn-sm btn-light" title="Move up" onclick="TeacherAjax.post('/Teacher/Courses/MoveSection/@s.CourseSectionId', { up: true })"><i class="bi bi-arrow-up"></i></button>
                <button class="btn btn-sm btn-light" title="Move down" onclick="TeacherAjax.post('/Teacher/Courses/MoveSection/@s.CourseSectionId', { up: false })"><i class="bi bi-arrow-down"></i></button>
                <button class="btn btn-sm btn-light text-primary" title="Edit section"
                        onclick="Toast.openModal('/Teacher/Courses/SectionPartial?courseId=@Model.CourseId&id=@s.CourseSectionId', 'modal-md')"><i class="bi bi-pencil-square"></i></button>
                <button class="btn btn-sm btn-light text-danger" title="Delete section"
                        onclick="TeacherAjax.confirmPost('Delete section?', 'Section tabhi delete hoga jab usme koi lecture na ho.', '/Teacher/Courses/DeleteSection/@s.CourseSectionId')"><i class="bi bi-trash"></i></button>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                @if (s.Lectures.Any())
                {
                    <thead class="table-light">
                        <tr>
                            <th class="text-muted fw-semibold border-0 ps-3" style="width:38%">Lecture</th>
                            <th class="text-muted fw-semibold border-0">Content</th>
                            <th class="text-muted fw-semibold border-0">Duration</th>
                            <th class="text-muted fw-semibold border-0">Free preview</th>
                            <th class="text-muted fw-semibold border-0">Status</th>
                            <th class="text-muted fw-semibold border-0 text-end pe-3">Actions</th>
                        </tr>
                    </thead>
                }
                <tbody>
                    @foreach (var l in s.Lectures)
                    {
                        <tr>
                            <td class="ps-3 fw-medium text-dark">@l.LectureTitle</td>
                            <td>
                                <i class="bi bi-camera-video @(l.HasVideo ? "text-success" : "text-muted opacity-25")" title="@(l.HasVideo ? "Video added" : "No video")"></i>
                                <i class="bi bi-file-earmark-text ms-2 @(l.HasNotes ? "text-success" : "text-muted opacity-25")" title="@(l.HasNotes ? "Notes added" : "No notes")"></i>
                            </td>
                            <td class="small text-muted">@Duration(l.VideoDurationSeconds)</td>
                            <td>
                                <button class="btn btn-sm py-0 @(l.IsFreePreview ? "btn-success" : "btn-outline-secondary")"
                                        onclick="TeacherAjax.post('/Teacher/Courses/ToggleLecture/@l.LectureId', { flag: 'FreePreview' })">
                                    @(l.IsFreePreview ? "Free" : "Locked")
                                </button>
                            </td>
                            <td>
                                <button class="btn btn-sm py-0 @(l.IsPublished ? "btn-success" : "btn-outline-secondary")"
                                        onclick="TeacherAjax.post('/Teacher/Courses/ToggleLecture/@l.LectureId', { flag: 'Publish' })">
                                    @(l.IsPublished ? "Published" : "Draft")
                                </button>
                            </td>
                            <td class="text-end pe-3">
                                <div class="d-inline-flex gap-1">
                                    <button class="btn btn-sm btn-light" title="Move up" onclick="TeacherAjax.post('/Teacher/Courses/MoveLecture/@l.LectureId', { up: true })"><i class="bi bi-arrow-up"></i></button>
                                    <button class="btn btn-sm btn-light" title="Move down" onclick="TeacherAjax.post('/Teacher/Courses/MoveLecture/@l.LectureId', { up: false })"><i class="bi bi-arrow-down"></i></button>
                                    <button class="btn btn-sm btn-light text-primary" title="Edit"
                                            onclick="Toast.openModal('/Teacher/Courses/LecturePartial?sectionId=@s.CourseSectionId&id=@l.LectureId', 'modal-xl')"><i class="bi bi-pencil-square"></i></button>
                                    <button class="btn btn-sm btn-light text-danger" title="Delete"
                                            onclick="TeacherAjax.confirmPost('Delete lecture?', 'Ye lecture hamesha ke liye hat jayega.', '/Teacher/Courses/DeleteLecture/@l.LectureId')"><i class="bi bi-trash"></i></button>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!s.Lectures.Any())
                    {
                        <tr><td class="text-center text-muted small py-4">Is section me abhi koi lecture nahi hai.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
