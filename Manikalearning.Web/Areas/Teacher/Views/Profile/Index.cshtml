@using Manikalearning.Application.Features.Handlers.Teacher
@model TeacherProfileDto

@{
    ViewData["Title"] = "My Profile";
    ViewData["HeaderTitle"] = "My Profile";
    var initial = string.IsNullOrWhiteSpace(Model.FullName) ? "T" : Model.FullName.Trim().Substring(0, 1).ToUpper();
}

<div class="mb-4">
    <h5 class="fw-bold text-dark mb-0">My Profile</h5>
    <p class="text-muted small mb-0">Manage your personal details and see your teaching summary.</p>
</div>

<div class="row g-4">
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-4 bg-white text-center p-4">
            <div class="rounded-circle bg-primary bg-opacity-10 text-primary fw-bold d-inline-flex align-items-center justify-content-center mx-auto mb-3"
                 style="width:84px;height:84px;font-size:2rem">
                @initial
            </div>
            <h6 class="fw-bold mb-0">@Model.FullName</h6>
            <div class="text-muted small mb-3">@(Model.Email ?? "-")</div>
            <span class="badge bg-primary bg-opacity-10 text-primary mx-auto">Teacher</span>
            <hr class="my-4">
            <div class="row g-3 text-center">
                <div class="col-6"><div class="fs-4 fw-semibold">@Model.Courses</div><div class="small text-muted">Courses</div></div>
                <div class="col-6"><div class="fs-4 fw-semibold">@Model.Students</div><div class="small text-muted">Students</div></div>
                <div class="col-6"><div class="fs-4 fw-semibold">@Model.Questions</div><div class="small text-muted">Questions</div></div>
                <div class="col-6"><div class="fs-4 fw-semibold">@Model.Tests</div><div class="small text-muted">Tests</div></div>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4 bg-white">
            <div class="card-header bg-white border-bottom py-3 rounded-top-4 fw-bold">Personal details</div>
            <div class="card-body p-4">
                <form id="profileForm" asp-area="Teacher" asp-controller="Profile" asp-action="Save" method="post" novalidate>
                    @Html.AntiForgeryToken()
                    <div id="profileAlert" class="alert d-none py-2 small" role="alert"></div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold" for="FullName">Full name <span class="text-danger">*</span></label>
                            <input class="form-control shadow-none" id="FullName" name="FullName" maxlength="100" required
                                   placeholder="Enter your full name" value="@Model.FullName">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold" for="Phone">Phone number</label>
                            <input class="form-control shadow-none" id="Phone" name="Phone" maxlength="20"
                                   placeholder="e.g. +91 98765 43210" value="@Model.Phone">
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-semibold" for="Email">Email address</label>
                            <input class="form-control shadow-none bg-light" id="Email" value="@Model.Email" disabled>
                            <div class="form-text">Your email is used to sign in and cannot be changed here.</div>
                        </div>
                    </div>
                    <div class="text-end mt-4">
                        <button type="submit" class="btn btn-primary px-4" id="profileSave">Save changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function() {
            var form = document.getElementById('profileForm');
            var alertBox = document.getElementById('profileAlert');
            var btn = document.getElementById('profileSave');

            function show(ok, msg) {
                alertBox.className = 'alert py-2 small ' + (ok ? 'alert-success' : 'alert-danger');
                alertBox.textContent = msg;
            }

            form.addEventListener('submit', function(e) {
                e.preventDefault();
                if (!form.FullName.value.trim()) { show(false, 'Enter your full name.'); form.FullName.focus(); return; }
                btn.disabled = true;
                fetch(form.action, { method: 'POST', body: new FormData(form) })
                    .then(function(r) { return r.json(); })
                    .then(function(res) { show(res.isSuccess, res.message); })
                    .catch(function() { show(false, 'Something went wrong. Please try again.'); })
                    .finally(function() { btn.disabled = false; });
            });
        })();
    </script>
}
