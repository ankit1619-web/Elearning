@model Manikalearning.Application.DTOs.TopicPyqListDto

@{
    var instanceId = "cbt_inst_" + Guid.NewGuid().ToString("N");
}

<style>
    .cbt-container {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        font-size: 14px;
    }

    .cbt-header-brand {
        background: linear-gradient(90deg, #0d6efd, #0056b3);
    }

    .cbt-banner-alert {
        background-color: #ff4d4d;
        color: #fff;
        font-weight: 600;
        font-size: 13px;
    }

    .cbt-option-circle {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        border: 2px solid #6c757d;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        cursor: pointer;
        transition: all 0.2s ease;
        background-color: #fff;
    }

        .cbt-option-circle.active {
            border-color: #198754;
            background-color: #198754;
            color: #fff;
        }

    .cbt-palette-btn {
        width: 36px;
        height: 36px;
        font-weight: 600;
        font-size: 13px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 4px;
        border: 1px solid #ccc;
        cursor: pointer;
        background-color: #e9ecef;
        color: #333;
    }

        .cbt-palette-btn.current {
            border: 2px solid #0d6efd !important;
            font-weight: bold;
        }

        .cbt-palette-btn.status-0 {
            background-color: #e9ecef;
            color: #333;
        }

        .cbt-palette-btn.status-1 {
            background-color: #dc3545;
            color: #fff;
        }

        .cbt-palette-btn.status-2 {
            background-color: #198754;
            color: #fff;
        }

        .cbt-palette-btn.status-3 {
            background-color: #0d6efd;
            color: #fff;
        }

    .cbt-close-corner {
        position: absolute;
        top: 0;
        right: 0;
        width: 0;
        height: 0;
        border-top: 45px solid #dc3545;
        border-left: 45px solid transparent;
        z-index: 1050;
        cursor: pointer;
    }

        .cbt-close-corner i {
            position: absolute;
            top: -40px;
            right: 6px;
            color: #fff;
            font-size: 16px;
        }
</style>

<div id="@instanceId" class="cbt-container position-relative bg-white rounded-3 overflow-hidden shadow-lg border">
     
    <script type="application/json" class="js-json-data">
            @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model?.Questions ?? new List<Manikalearning.Application.DTOs.TopicPyqDto>()))
    </script>
     
    <div class="cbt-close-corner" data-bs-dismiss="modal" title="Close"><i class="bi bi-x-lg"></i></div>
    <div class="cbt-header-brand text-white text-center py-2 fw-semibold">
        <span>Provided by <strong class="text-warning">Manika Learning</strong></span>
    </div>

    @if (Model != null && Model.IsPreviewOnly)
    {
        <div class="cbt-banner-alert text-center py-2 px-3 border-bottom">
            <i class="bi bi-exclamation-triangle-fill me-1"></i>
            @Model.BannerMessage
            <a href="/Student/Subscription" class="text-white text-decoration-underline ms-2 fw-bold">Upgrade Now</a>
        </div>
    }
     
    <div class="js-workspace row g-0 p-3">
        <div class="col-lg-8 col-md-7 pe-md-3">
            <div class="border rounded-3 p-3 mb-3 bg-white" style="min-height: 430px;">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <div class="d-flex align-items-center gap-2">
                        <span class="fw-bold text-dark fs-6 js-q-title">Q. 1 / 0</span>
                        <span class="badge bg-secondary font-monospace js-q-topic">Topic PYQ</span>
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-warning border-0 js-btn-bookmark" title="Bookmark Question">
                        <i class="bi bi-bookmark fs-5"></i>
                    </button>
                </div>

                <div class="text-muted extra-small mb-1 js-q-id">(ID ----)</div>
                <div class="fw-bold text-dark mb-1 fs-6 js-q-text">Loading...</div>
                <div class="text-secondary small mb-3 js-q-hindi"></div>

                <div class="mb-3 ps-2 js-q-options"></div>

                <div class="p-2 bg-light rounded text-muted extra-small mb-3 js-q-exam">Came in --</div>

                <div class="d-flex align-items-center gap-2 mb-3">
                    <button type="button" class="btn btn-sm btn-outline-success px-3 js-btn-exp">Explanation</button>
                    <button type="button" class="btn btn-sm btn-outline-danger px-3"><i class="bi bi-flag"></i> Report</button>
                </div>

                <div class="js-exp-box alert alert-success small mb-3 d-none">
                    <strong>Explanation:</strong> <span class="js-exp-text"></span>
                    <div class="js-exp-hindi mt-1 text-muted"></div>
                </div>
                 
                <div class="d-flex align-items-center justify-content-center gap-3 pt-2 border-top">
                    <div class="cbt-option-circle" data-opt="1">1</div>
                    <div class="cbt-option-circle" data-opt="2">2</div>
                    <div class="cbt-option-circle" data-opt="3">3</div>
                    <div class="cbt-option-circle" data-opt="4">4</div>
                </div>
            </div>
             
            <div class="border rounded-3 p-2 bg-light d-flex align-items-center gap-2">
                <button type="button" class="btn btn-success fw-bold btn-sm px-4 js-btn-savenext">Save & Next</button>
                <button type="button" class="btn btn-primary fw-bold btn-sm px-3 js-btn-mark">Mark for Review</button>
                <button type="button" class="btn btn-outline-secondary btn-sm px-3 js-btn-clear">Clear</button>
            </div>
        </div>
         
        <div class="col-lg-4 col-md-5 mt-3 mt-md-0 border-start ps-md-3">
            <div class="border rounded-3 p-2 mb-3 bg-light" style="max-height: 220px; overflow-y: auto;">
                <div class="d-flex flex-wrap gap-2 js-q-palette"></div>
            </div>

            <div class="border rounded-3 p-3 bg-light">
                <div class="row g-2 extra-small">
                    <div class="col-6"><span class="badge bg-secondary rounded-1 js-cnt-0">0</span> Not Visited</div>
                    <div class="col-6"><span class="badge bg-danger rounded-1 js-cnt-1">0</span> Not Answered</div>
                    <div class="col-6"><span class="badge bg-success rounded-1 js-cnt-2">0</span> Answered</div>
                    <div class="col-6"><span class="badge bg-primary rounded-1 js-cnt-3">0</span> Marked For Review</div>
                </div>
            </div>
        </div>
    </div>
     
    <div class="js-footer border-top bg-light p-2 px-3 d-flex justify-content-between align-items-center">
        <div>
            <button type="button" class="btn btn-sm btn-outline-secondary px-3 js-btn-prev">&lt; Back</button>
            <button type="button" class="btn btn-sm btn-outline-secondary px-3 ms-1 js-btn-next">Next &gt;</button>
        </div>
        <div class="d-flex align-items-center gap-3">
            <span class="fw-bold font-monospace text-danger fs-6 js-timer">00:00:00</span>
            <button type="button" class="btn btn-success btn-sm fw-bold px-4 js-btn-submit">
                <i class="bi bi-check-circle me-1"></i> Submit Test
            </button>
        </div>
    </div>
     
    <div class="js-result-screen d-none p-4 text-center bg-white rounded-3">
        <div class="mb-3">
            <i class="bi bi-trophy-fill text-warning display-3"></i>
            <h4 class="fw-bold text-dark mt-2">Test Submitted Successfully!</h4>
        </div>
        <div class="row g-3 justify-content-center mb-4">
            <div class="col-md-3 col-6"><div class="p-3 border rounded bg-light"><div class="extra-small text-muted">Total</div><div class="fs-4 fw-bold js-res-total">0</div></div></div>
            <div class="col-md-3 col-6"><div class="p-3 border rounded bg-success bg-opacity-10"><div class="extra-small text-success">Correct</div><div class="fs-4 fw-bold text-success js-res-correct">0</div></div></div>
            <div class="col-md-3 col-6"><div class="p-3 border rounded bg-danger bg-opacity-10"><div class="extra-small text-danger">Incorrect</div><div class="fs-4 fw-bold text-danger js-res-wrong">0</div></div></div>
            <div class="col-md-3 col-6"><div class="p-3 border rounded bg-secondary bg-opacity-10"><div class="extra-small text-secondary">Skipped</div><div class="fs-4 fw-bold text-secondary js-res-skipped">0</div></div></div>
        </div>
        <div class="alert alert-info border-0 rounded mb-4 d-inline-block px-5">
            <span class="fs-5 fw-bold">Score: <span class="js-res-score">0</span> / <span class="js-res-total-marks">0</span> | Accuracy: <span class="js-res-accuracy">0</span>%</span>
        </div>
        <div>
            <button type="button" class="btn btn-primary fw-bold px-4" data-bs-dismiss="modal">Close</button>
        </div>
    </div>
</div>

<script>
    (function() {
        const $root = $('#' + '@instanceId');
         
        let pyqData = [];
        try {
            const rawJson = $root.find('.js-json-data').text();
            pyqData = JSON.parse(rawJson || '[]');
        } catch (e) {
            console.error("PYQ JSON Parse Error:", e);
        }

        if (!pyqData || pyqData.length === 0) return;

        let currentIndex = 0;
        const userState = [];
        for (let i = 0; i < pyqData.length; i++) {
            userState.push({ selectedOptionNumber: null, status: 0, isBookmarked: false });
        }
         
        let totalSeconds = pyqData.length * 60;
        const $timerDisplay = $root.find('.js-timer');

        const timerInterval = setInterval(function() {
            if (totalSeconds <= 0) {
                clearInterval(timerInterval);
                alert("Time is up! Your test is being submitted automatically.");
                submitTest(true);
                return;
            }

            totalSeconds--;
            let hours = Math.floor(totalSeconds / 3600);
            let minutes = Math.floor((totalSeconds % 3600) / 60);
            let seconds = totalSeconds % 60;

            let formattedTime =
                (hours < 10 ? "0" + hours : hours) + ":" +
                (minutes < 10 ? "0" + minutes : minutes) + ":" +
                (seconds < 10 ? "0" + seconds : seconds);

            $timerDisplay.text(formattedTime);

            if (totalSeconds < 120) {
                $timerDisplay.addClass('text-danger');
            }
        }, 1000);

        function loadQuestion(index) {
            if (index < 0 || index >= pyqData.length) return;
            currentIndex = index;

            const q = pyqData[index];
            if (userState[index].status === 0) userState[index].status = 1;

            $root.find('.js-q-title').text('Q. ' + (index + 1) + ' / ' + pyqData.length);
            $root.find('.js-q-topic').text('PYQ - ' + (q.examName || 'Topic'));

            var idDisplay = '----';
            if (q.questionId) {
                idDisplay = q.questionId.toString().substring(0, 8);
            }
            $root.find('.js-q-id').text('(ID ' + idDisplay + ')');

            $root.find('.js-q-text').text(q.questionText || '');
            $root.find('.js-q-hindi').text(q.questionTextHindi || '');

            var optionsHtml = '<div class="mb-1"><strong>1.</strong> ' + (q.optionA || '') + '</div>' +
                '<div class="mb-1"><strong>2.</strong> ' + (q.optionB || '') + '</div>' +
                '<div class="mb-1"><strong>3.</strong> ' + (q.optionC || '') + '</div>' +
                '<div class="mb-1"><strong>4.</strong> ' + (q.optionD || '') + '</div>';

            $root.find('.js-q-options').html(optionsHtml);
            $root.find('.js-exp-text').text(q.explanation || '');
            $root.find('.js-exp-hindi').text(q.explanationHindi || '');
            $root.find('.js-exp-box').addClass('d-none');

            updateCircleSelection(userState[index].selectedOptionNumber);
            updateBookmarkIcon(userState[index].isBookmarked);
            renderPalette();
        }

        function updateCircleSelection(num) {
            $root.find('.cbt-option-circle').removeClass('active');
            if (num) {
                $root.find('.cbt-option-circle[data-opt="' + num + '"]').addClass('active');
            }
        }

        function updateBookmarkIcon(isBookmarked) {
            const $btn = $root.find('.js-btn-bookmark i');
            if (isBookmarked) {
                $btn.removeClass('bi-bookmark').addClass('bi-bookmark-fill text-warning');
            } else {
                $btn.removeClass('bi-bookmark-fill text-warning').addClass('bi-bookmark');
            }
        }

        function renderPalette() {
            var html = '';
            var counts = [0, 0, 0, 0];

            for (var i = 0; i < userState.length; i++) {
                var st = userState[i];
                var isCur = (i === currentIndex) ? 'current' : '';
                html += '<div class="cbt-palette-btn status-' + st.status + ' ' + isCur + '" data-idx="' + i + '">' + (i + 1) + '</div>';
                counts[st.status]++;
            }

            $root.find('.js-q-palette').html(html).find('.cbt-palette-btn').on('click', function() {
                var idx = parseInt($(this).attr('data-idx'));
                loadQuestion(idx);
            });

            for (var k = 0; k < 4; k++) {
                $root.find('.js-cnt-' + k).text(counts[k]);
            }
        }

        function submitTest(isAutoSubmit = false) {
            if (!isAutoSubmit && !confirm("Are you sure you want to submit the test?")) return;

            clearInterval(timerInterval);

            var answersPayload = [];
            for (var i = 0; i < pyqData.length; i++) {
                answersPayload.push({
                    questionId: pyqData[i].questionId,
                    selectedOptionNumber: userState[i].selectedOptionNumber,
                    isAnswered: userState[i].selectedOptionNumber != null,
                    isMarkedForReview: userState[i].status === 3
                });
            }

            var firstSectionId = '00000000-0000-0000-0000-000000000000';
            if (pyqData.length > 0 && pyqData[0].sectionId) {
                firstSectionId = pyqData[0].sectionId;
            }

            var timeSpent = (pyqData.length * 60) - totalSeconds;
             
            $.ajax({
                url: '/Student/PYQPractice/SubmitPyqTest',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    sectionId: firstSectionId,
                    timeTakenSeconds: timeSpent > 0 ? timeSpent : 1,
                    answers: answersPayload
                }),
                success: function(res) {
                    var r = res && res.data ? res.data : res;
                    $root.find('.js-res-total').text(r.totalQuestions || 0);
                    $root.find('.js-res-correct').text(r.correctAnswers || 0);
                    $root.find('.js-res-wrong').text(r.wrongAnswers || 0);
                    $root.find('.js-res-skipped').text(r.skippedQuestions || 0);
                    $root.find('.js-res-score').text(r.score || 0);
                    $root.find('.js-res-total-marks').text(r.totalMarks || 0);
                    $root.find('.js-res-accuracy').text(r.accuracy || 0);

                    $root.find('.js-workspace, .js-footer').addClass('d-none');
                    $root.find('.js-result-screen').removeClass('d-none');
                },
                error: function() {
                    alert("Error submitting test. Please try again.");
                }
            });
        }

        // Event Listeners Binding
        $root.find('.cbt-option-circle').on('click', function() {
            var opt = parseInt($(this).attr('data-opt'));
            userState[currentIndex].selectedOptionNumber = opt;
            updateCircleSelection(opt);
        });

        $root.find('.js-btn-bookmark').on('click', function() {
            userState[currentIndex].isBookmarked = !userState[currentIndex].isBookmarked;
            updateBookmarkIcon(userState[currentIndex].isBookmarked);
        });

        $root.find('.js-btn-savenext').on('click', function() {
            userState[currentIndex].status = (userState[currentIndex].selectedOptionNumber != null) ? 2 : 1;
            renderPalette();
            if (currentIndex < pyqData.length - 1) {
                loadQuestion(currentIndex + 1);
            }
        });

        $root.find('.js-btn-mark').on('click', function() {
            userState[currentIndex].status = 3;
            renderPalette();
            if (currentIndex < pyqData.length - 1) {
                loadQuestion(currentIndex + 1);
            }
        });

        $root.find('.js-btn-clear').on('click', function() {
            userState[currentIndex].selectedOptionNumber = null;
            userState[currentIndex].status = 1;
            updateCircleSelection(null);
            renderPalette();
        });

        $root.find('.js-btn-prev').on('click', function() {
            if (currentIndex > 0) loadQuestion(currentIndex - 1);
        });

        $root.find('.js-btn-next').on('click', function() {
            if (currentIndex < pyqData.length - 1) loadQuestion(currentIndex + 1);
        });

        $root.find('.js-btn-exp').on('click', function() {
            $root.find('.js-exp-box').toggleClass('d-none');
        });

        $root.find('.js-btn-submit').on('click', function() {
            submitTest(false);
        });

        $root.find('[data-bs-dismiss="modal"]').on('click', function() {
            clearInterval(timerInterval);
        });

        setTimeout(function() {
            loadQuestion(0);
        }, 50);
    })();
</script>