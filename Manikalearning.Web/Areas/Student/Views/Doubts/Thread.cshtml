@using Manikalearning.Application.DTOs

@model DoubtThreadDto
@{
    ViewData["Title"] = "Doubt";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
    var d = Model.Doubt;
}

@section Styles {
    <style>
        .th-wrap {
            max-width: 820px;
            margin: 0 auto;
        }

        .th-top {
            padding: 1.3rem 1.5rem;
            margin-bottom: 1.2rem;
        }

        .th-meta {
            display: flex;
            flex-wrap: wrap;
            gap: .7rem;
            align-items: center;
            margin-bottom: .8rem;
        }

        .th-status {
            padding: .25rem .7rem;
            border-radius: 999px;
            font-size: .76rem;
            font-weight: 800;
        }

            .th-status.Open {
                background: #fff4d6;
                color: #92400e;
            }

            .th-status.Answered {
                background: #d9f7ea;
                color: #065f46;
            }

            .th-status.Closed {
                background: #eceaf8;
                color: #5b5a80;
            }

        .th-small {
            color: var(--muted);
            font-size: .8rem;
            font-weight: 600;
        }

        .th-q {
            margin: 0;
            white-space: pre-line;
            overflow-wrap: anywhere;
            font-weight: 600;
        }

        .th-chat {
            display: grid;
            gap: .9rem;
            margin-bottom: 1.2rem;
        }

        .th-msg {
            max-width: 88%;
            padding: .9rem 1.1rem;
            border-radius: 18px;
            overflow-wrap: anywhere;
        }

            .th-msg p {
                margin: 0;
                white-space: pre-line;
            }

            .th-msg small {
                display: block;
                margin-top: .4rem;
                font-size: .72rem;
                opacity: .75;
                font-weight: 600;
            }

            .th-msg.staff {
                background: var(--soft);
                border-bottom-left-radius: 6px;
                justify-self: start;
            }

            .th-msg.me {
                background: var(--grad);
                color: #fff;
                border-bottom-right-radius: 6px;
                justify-self: end;
            }

        .th-who {
            font-size: .76rem;
            font-weight: 800;
            margin-bottom: .25rem;
            color: var(--brand);
        }

        .th-wait {
            text-align: center;
            color: var(--muted);
            padding: 1rem;
            font-size: .9rem;
        }

        .th-form {
            padding: 1.2rem 1.4rem;
        }

            .th-form textarea {
                width: 100%;
                min-height: 100px;
                padding: .7rem 1rem;
                border: 1px solid var(--line);
                border-radius: 12px;
                font: inherit;
                color: var(--text);
                background: var(--surface);
                resize: vertical;
            }

                .th-form textarea:focus {
                    outline: 3px solid rgba(99,102,241,.25);
                    border-color: var(--brand);
                }

        @@media (max-width: 575.98px) {
            .th-msg {
                max-width: 100%;
            }

            .th-top, .th-form {
                padding: 1rem;
            }
        }
    </style>
}

<div class="th-wrap">
    <a class="b b-link" style="margin-bottom:.6rem" asp-action="Index"><i class="bi bi-arrow-left"></i> All doubts</a>

    <section class="panel th-top">
        <div class="th-meta">
            <span class="th-status @d.Status">@d.Status</span>
            @if (!string.IsNullOrEmpty(d.CourseName))
            {
                <span class="th-small"><i class="bi bi-journal-text"></i> @d.CourseName</span>
            }
            <span class="th-small">@d.CreatedAt.ToLocalTime().ToString("d MMM yyyy, h:mm tt")</span>
        </div>
        <p class="th-q">@d.QuestionText</p>
    </section>

    <div class="th-chat">
        @foreach (var r in Model.Replies)
        {
            <div class="th-msg @(r.IsFromStaff ? "staff" : "me")">
                @if (r.IsFromStaff)
                {
                    <div class="th-who"><i class="bi bi-mortarboard-fill"></i> Teacher</div>
                }
                <p>@r.Text</p>
                <small>@r.CreatedAt.ToLocalTime().ToString("d MMM, h:mm tt")</small>
            </div>
        }
        @if (Model.Replies.Count == 0)
        {
            <div class="th-wait"><i class="bi bi-hourglass-split"></i> Waiting for a teacher's reply. We will answer soon.</div>
        }
    </div>

    @if (Model.CanStudentReply)
    {
        <section class="panel th-form">
            <form method="post" asp-area="Student" asp-controller="Doubts" asp-action="Reply" asp-route-id="@d.DoubtId">
                <textarea name="text" maxlength="1000" placeholder="Write a follow-up message" aria-label="Your message" required></textarea>
                <div style="margin-top:.8rem"><button type="submit" class="b b-solid"><i class="bi bi-send"></i> Send</button></div>
            </form>
        </section>
    }
    else
    {
        <div class="th-wait">This doubt is closed. You can ask a new doubt any time.</div>
    }
</div>
