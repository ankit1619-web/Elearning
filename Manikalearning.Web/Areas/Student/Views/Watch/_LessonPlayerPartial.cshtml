@model Manikalearning.Application.DTOs.LessonPlayerViewModel

@{ 
    string videoUrl = Model.VideoUrl ?? string.Empty;
    bool isYouTube = videoUrl.Contains("youtube.com") || videoUrl.Contains("youtu.be");
    bool isDirectVideoFile = videoUrl.EndsWith(".mp4", StringComparison.OrdinalIgnoreCase) ||
                             videoUrl.EndsWith(".webm", StringComparison.OrdinalIgnoreCase) ||
                             videoUrl.EndsWith(".mkv", StringComparison.OrdinalIgnoreCase) ||
                             videoUrl.Contains("mediaType=videos", StringComparison.OrdinalIgnoreCase);
 
    string embedVideoUrl = videoUrl;
    if (isYouTube)
    {
        if (videoUrl.Contains("watch?v="))
        {
            var videoId = videoUrl.Split("v=")[1].Split("&")[0];
            embedVideoUrl = $"https://www.youtube.com/embed/{videoId}?rel=0&autoplay=1";
        }
        else if (videoUrl.Contains("youtu.be/"))
        {
            var videoId = videoUrl.Split("youtu.be/")[1].Split("?")[0];
            embedVideoUrl = $"https://www.youtube.com/embed/{videoId}?rel=0&autoplay=1";
        }
    }
    else if (!videoUrl.StartsWith("http://", StringComparison.OrdinalIgnoreCase) &&
             !videoUrl.StartsWith("https://", StringComparison.OrdinalIgnoreCase) &&
             !string.IsNullOrEmpty(videoUrl))
    { 
        var cleanFileName = System.IO.Path.GetFileName(videoUrl);
        embedVideoUrl = $"/Student/Watch/GetMedia?fileName={Uri.EscapeDataString(cleanFileName)}&mediaType=videos";
        isDirectVideoFile = true;
    }
}

<style>
    .player-container {
        background-color: #0b0f19;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 10px 25px rgba(0,0,0,0.15);
    }

    .btn-action-pill {
        background-color: #f1f5f9;
        border: 1px solid #e2e8f0;
        color: #475569;
        font-weight: 600;
        font-size: 0.85rem;
        padding: 6px 16px;
        border-radius: 999px;
        transition: all 0.2s ease;
    }

        .btn-action-pill:hover {
            background-color: #e2e8f0;
            color: #0f172a;
        }

    .notes-card {
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        overflow: hidden;
        background: #ffffff;
    }

    .notes-dark-header {
        background-color: #18181b;
        color: #ffffff;
        padding: 1rem 1.25rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .btn-pyq-blue {
        background-color: #2563eb;
        color: #ffffff;
        font-weight: 600;
        font-size: 0.825rem;
        padding: 6px 16px;
        border-radius: 8px;
        border: none;
    }

        .btn-pyq-blue:hover {
            background-color: #1d4ed8;
            color: #ffffff;
        }

    .btn-bookmark {
        background: rgba(255,255,255,0.15);
        color: #ffffff;
        border: none;
        width: 36px;
        height: 36px;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

        .btn-bookmark:hover {
            background: rgba(255,255,255,0.25);
        }
</style>

<!-- VIDEO PLAYER SCREEN -->
<div class="player-container ratio ratio-16x9 mb-4">
    @if (!string.IsNullOrEmpty(Model.VideoUrl))
    {
        @if (isDirectVideoFile)
        {
            <!-- HTML5 Video Player for Local / Direct MP4 Files -->
            <video controls controlsList="nodownload" class="w-100 h-100" style="object-fit: contain;">
                <source src="@embedVideoUrl" type="video/mp4">
                Your browser does not support video playback.
            </video>
        }
        else
        {
            <!-- iFrame Player for External / YouTube Embed Links -->
            <iframe src="@embedVideoUrl"
                    title="@Model.LessonTitle"
                    allowfullscreen
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture">
            </iframe>
        }
    }
    else
    {
        <div class="d-flex flex-column justify-content-center align-items-center text-white p-4">
            <div class="spinner-border text-light mb-3" role="status" style="width: 3rem; height: 3rem;">
                <span class="visually-hidden">Loading...</span>
            </div>
            <h4 class="fw-bold mb-1">We're getting things ready</h4>
            <p class="text-muted small">Loading your experience... This won't take long.</p>
        </div>
    }
</div>

<!-- ACTION BAR WITH PDF PREVIEW & ASK DOUBT -->
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4 px-1">
    <h2 class="fw-bold text-dark mb-0 fs-3">@Model.LessonTitle</h2>

    <div class="d-flex gap-2">
        <!-- PDF Notes Preview Button (If PDF exists) -->
        @if (!string.IsNullOrEmpty(Model.NotesUrl))
        {
            <button type="button" class="btn btn-action-pill" onclick="openSecurePdfPreview('@Model.NotesUrl')">
                <i class="bi bi-file-earmark-pdf-fill me-1 text-danger"></i> PDF Notes
            </button>
        }
        <button type="button" class="btn btn-action-pill"
                onclick="Toast.openModal('/Student/Watch/AskDoubtPartial/@Model.LessonId', 'modal-md')">
            <i class="bi bi-question-circle me-1 text-primary"></i> Ask Doubt
        </button>
       
        <button type="button" class="btn btn-action-pill">
            <i class="bi bi-star-fill me-1 text-warning"></i> Reviews
        </button>
    </div>
</div>

<!-- NOTES CARD -->
<div class="notes-card shadow-sm">
    <div class="notes-dark-header">
        <h5 class="fw-bold mb-0 fs-6 text-truncate pe-2">@Model.LessonTitle</h5>

        <div class="d-flex align-items-center gap-2 flex-shrink-0">
            <button type="button" class="btn btn-pyq-blue">
                Topic-wise PYQs
            </button>
            <button type="button" class="btn btn-bookmark" title="Save Bookmark">
                <i class="bi bi-bookmark"></i>
            </button>
        </div>
    </div>

    <div class="p-4 bg-white">
        @if (!string.IsNullOrWhiteSpace(Model.Notes))
        {
            <div class="lecture-notes-html">
                @Html.Raw(Model.Notes)
            </div>
        }
    </div>
</div>

<!-- JAVASCRIPT FOR SECURE BLOB PDF PREVIEW -->
<script>
    async function openSecurePdfPreview(pdfPath) {
        if (!pdfPath) return;

        // 1. External URL Check (e.g. Google Drive, external server)
        if (pdfPath.startsWith('http://') || pdfPath.startsWith('https://')) {
            window.open(pdfPath, '_blank');
            return;
        }
 
        var targetUrl = `/Student/Watch/GetMedia?fileName=${encodeURIComponent(pdfPath)}&mediaType=pdfs`;

        try {
            var response = await fetch(targetUrl, {
                method: 'GET',
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            });

            if (!response.ok) {
                alert('Unable to load PDF document.');
                return;
            }

            var blob = await response.blob();
            var blobUrl = URL.createObjectURL(blob);
            window.open(blobUrl, '_blank');

            // Memory cleanup after 1 minute
            setTimeout(function () {
                URL.revokeObjectURL(blobUrl);
            }, 60000);

        } catch (error) {
            console.error('Error opening PDF preview:', error);
            alert('An error occurred while opening the PDF.');
        }
    }
</script>