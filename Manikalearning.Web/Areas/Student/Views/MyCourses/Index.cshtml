 
@using Manikalearning.Application.DTOs
@model MyCoursesViewModel
@{
    ViewData["Title"] = "My Courses";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";

    var allowed = ViewBag.AccessibleCourseIds as HashSet<Guid> ?? new HashSet<Guid>();
    var filters = new[] { ("All", "All", Model.TotalEnrolled), ("InProgress", "In progress", Model.InProgressCount), ("Completed", "Completed", Model.CompletedCount) };
}

@section Styles {
    <style>
        .mc-stats {
            grid-template-columns: repeat(3, 1fr);
        }

        .mc-bar {
            display: flex;
            flex-wrap: wrap;
            gap: 1rem;
            justify-content: space-between;
            align-items: center;
            margin: 1.5rem 0 1.2rem;
        }

        .mc-filters {
            display: flex;
            flex-wrap: wrap;
            gap: .5rem;
        }

        .mc-search {
            display: flex;
            gap: .5rem;
            min-width: 280px;
        }

            .mc-search input {
                flex: 1;
                min-width: 0;
                padding: .55rem 1rem;
                border: 1px solid var(--line);
                border-radius: 12px;
                background: var(--surface);
                font: inherit;
                color: var(--text);
            }

                .mc-search input:focus {
                    outline: 3px solid rgba(99,102,241,.25);
                    border-color: var(--brand);
                }

        .mc-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
            gap: 1.2rem;
        }

        .mc-card {
            display: flex;
            flex-direction: column;
            overflow: hidden;
            padding: 0;
        }

        .mc-thumb {
            position: relative;
            aspect-ratio: 16/9;
            background: linear-gradient(135deg, #312e81, #7c3aed);
            display: grid;
            place-items: center;
            color: rgba(255,255,255,.9);
            font-size: 2.4rem;
        }

            .mc-thumb img {
                position: absolute;
                inset: 0;
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

        .mc-lock {
            position: absolute;
            inset: 0;
            background: rgba(20,18,46,.55);
            display: grid;
            place-items: center;
            color: #fff;
            font-size: 2rem;
        }

        .mc-mods {
            position: absolute;
            left: .8rem;
            top: .8rem;
            font-size: .72rem;
            font-weight: 700;
            padding: .25rem .65rem;
            border-radius: 999px;
            background: rgba(20,18,46,.7);
            color: #fff;
        }

        .mc-pill {
            position: absolute;
            right: .8rem;
            bottom: .8rem;
            font-size: .72rem;
            font-weight: 800;
            padding: .25rem .7rem;
            border-radius: 999px;
        }

            .mc-pill.done {
                background: #d9f7ea;
                color: #065f46;
            }

            .mc-pill.active {
                background: #fff4d6;
                color: #92400e;
            }

            .mc-pill.locked {
                background: #ffe4e9;
                color: #9f1239;
            }

        .mc-body {
            padding: 1.2rem 1.3rem 1.3rem;
            display: flex;
            flex-direction: column;
            gap: .7rem;
            flex: 1;
        }

            .mc-body h2 {
                font-size: 1.05rem;
                font-weight: 800;
                letter-spacing: -.01em;
                margin: 0;
                display: -webkit-box;
                -webkit-line-clamp: 2;
                -webkit-box-orient: vertical;
                overflow: hidden;
                min-height: 2.6em;
            }

        .mc-meta {
            color: var(--muted);
            font-size: .8rem;
            display: flex;
            flex-wrap: wrap;
            gap: .2rem .8rem;
        }

        .mc-pct {
            display: flex;
            justify-content: space-between;
            font-size: .82rem;
            font-weight: 700;
            margin-bottom: .35rem;
        }

        .mc-next {
            padding: .6rem .8rem;
            border-radius: 12px;
            background: var(--paper);
            border-left: 3px solid var(--brand);
            font-size: .85rem;
        }

            .mc-next small {
                display: block;
                color: var(--muted);
                font-weight: 700;
                font-size: .7rem;
            }

            .mc-next span {
                display: -webkit-box;
                -webkit-line-clamp: 1;
                -webkit-box-orient: vertical;
                overflow: hidden;
                font-weight: 600;
            }

        .mc-card .b {
            margin-top: auto;
        }

        .mc-empty {
            text-align: center;
            padding: 3.5rem 1.5rem;
        }

            .mc-empty i {
                font-size: 2.8rem;
                color: var(--brand);
            }

            .mc-empty h2 {
                font-size: 1.25rem;
                font-weight: 800;
                margin: .6rem 0 .3rem;
            }

            .mc-empty p {
                color: var(--muted);
                max-width: 42ch;
                margin: 0 auto 1.2rem;
            }

        @@media (max-width: 767.98px) {
            .mc-search {
                min-width: 0;
                width: 100%;
            }

            .mc-filters .b {
                flex: 1 1 auto;
            }
        }

        @@media (max-width: 575.98px) {
            .mc-stats {
                grid-template-columns: 1fr;
            }
        }
    </style>
}

<div class="dash">
    <div class="head">
        <div>
            <h1>My courses</h1>
            <p>Pick up right where you left off.</p>
        </div>
    </div>

    <section class="panel stats mc-stats">
        <div class="stat"><div class="l"><span class="ico"><i class="bi bi-collection-play"></i></span> Enrolled</div><div class="v">@Model.TotalEnrolled</div></div>
        <div class="stat"><div class="l"><span class="ico"><i class="bi bi-clock-history"></i></span> In progress</div><div class="v">@Model.InProgressCount</div></div>
        <div class="stat"><div class="l"><span class="ico"><i class="bi bi-check2-circle"></i></span> Completed</div><div class="v">@Model.CompletedCount</div></div>
    </section>

    <div class="mc-bar">
        <nav class="mc-filters" aria-label="Filter courses">
            @foreach (var (key, label, count) in filters)
            {
                <a class="b b-sm @(Model.SelectedFilter == key ? "b-solid" : "b-line")" asp-action="Index" asp-route-filter="@key" asp-route-search="@Model.SearchQuery">@label (@count)</a>
            }
        </nav>

        @* a real submit button = works without JavaScript *@
        <form class="mc-search" method="get" asp-area="Student" asp-controller="MyCourses" asp-action="Index">
            <input type="hidden" name="filter" value="@Model.SelectedFilter" />
            <input type="search" name="search" value="@Model.SearchQuery" maxlength="100" placeholder="Search my courses" aria-label="Search my courses" />
            <button type="submit" class="b b-line"><i class="bi bi-search"></i> Search</button>
        </form>
    </div>

    @if (Model.Courses != null && Model.Courses.Any())
    {
        <div class="mc-grid">
            @foreach (var course in Model.Courses)
            {
                var open = allowed.Contains(course.CourseId);
                var pct = (int)Math.Round(Convert.ToDouble(course.ProgressPercentage));
                pct = Math.Clamp(pct, 0, 100);

                <article class="panel mc-card">
                    <div class="mc-thumb">
                        <i class="bi bi-mortarboard-fill"></i>
                        @* empty alt: a broken link just shows the gradient behind it *@
                        @if (!string.IsNullOrEmpty(course.ThumbnailUrl))
                        {
                            <img src="@course.ThumbnailUrl" alt="" loading="lazy" />
                        }
                        @if (!open)
                        {
                            <div class="mc-lock"><i class="bi bi-lock-fill"></i></div>
                        }
                        <span class="mc-mods"><i class="bi bi-collection-play"></i> @course.TotalModules modules</span>
                        @if (!open)
                        {
                            <span class="mc-pill locked">Locked</span>
                        }
                        else if (course.IsCompleted)
                        {

                            <span class="mc-pill done">Completed</span>
                        }
                        else
                        {

                            <span class="mc-pill active">Active</span>
                        }
                    </div>

                    <div class="mc-body">
                        <h2 title="@course.Title">@course.Title</h2>
                        <div class="mc-meta">
                            <span><i class="bi bi-play-btn"></i> @course.CompletedLessons / @course.TotalLessons lessons</span>
                            <span>Enrolled @course.EnrolledDate.ToString("d MMM yyyy")</span>
                        </div>

                        <div>
                            <div class="mc-pct"><span>Progress</span><span style="color:var(--brand)">@pct%</span></div>
                            <div class="bar"><i style="--w:@(pct)%"></i></div>
                        </div>

                        @if (open && !course.IsCompleted && !string.IsNullOrEmpty(course.NextLessonTitle))
                        {
                            <div class="mc-next"><small>Up next</small><span>@course.NextLessonTitle</span></div>
                        }

                        @if (!open)
                        {
                            <p class="muted" style="margin:0">Your plan for this course has ended.</p>
                            <a class="b b-solid b-block" asp-area="Student" asp-controller="Subscription" asp-action="Index"><i class="bi bi-arrow-repeat"></i> Renew plan</a>
                        }
                        else if (course.IsCompleted)
                        {
                            <a class="b b-line b-block" asp-area="Student" asp-controller="Watch" asp-action="Index" asp-route-courseId="@course.CourseId"><i class="bi bi-arrow-repeat"></i> Review course</a>
                        }
                        else
                        {
                            <a class="b b-solid b-block" asp-area="Student" asp-controller="Watch" asp-action="Index" asp-route-courseId="@course.CourseId" asp-route-lessonId="@course.NextLessonId">Continue learning <i class="bi bi-arrow-right"></i></a>
                        }
                    </div>
                </article>
            }
        </div>
    }
    else
    {
        <section class="panel mc-empty">
            <i class="bi bi-journal-x"></i>
            <h2>No courses found</h2>
            <p>
                @(string.IsNullOrEmpty(Model.SearchQuery) && Model.SelectedFilter == "All"
                    ? "You have not enrolled in any course yet. Pick your exam to see the courses made for it."
                    : "Nothing matches this filter or search. Try another one.")
            </p>
            <a class="b b-solid" asp-area="Student" asp-controller="Exams" asp-action="Index"><i class="bi bi-compass"></i> Explore exams</a>
        </section>
    }
</div>
