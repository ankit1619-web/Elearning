@using Manikalearning.Application.DTOs
@model MyCoursesViewModel
@{
    ViewData["Title"] = "My Enrolled Courses";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;600&display=swap');

    .my-courses-dashboard {
        font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
        color: #0f172a;
        background-color: #f8fafc;
        border-radius: 24px;
        overflow: hidden;
        padding-bottom: 2rem;
    }

    /* Hero Banner Section */
    .hero-banner-saas {
        background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 60%, #312e81 100%);
        color: #ffffff;
        padding: 2.75rem 2rem;
        position: relative;
        border-radius: 24px 24px 0 0;
        overflow: hidden;
    }

        .hero-banner-saas::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -10%;
            width: 450px;
            height: 450px;
            background: radial-gradient(circle, rgba(99, 102, 241, 0.25) 0%, rgba(255, 255, 255, 0) 70%);
            pointer-events: none;
        }

    .pill-hero-badge {
        background: rgba(99, 102, 241, 0.2);
        color: #a5b4fc;
        border: 1px solid rgba(165, 180, 252, 0.3);
        padding: 6px 14px;
        border-radius: 999px;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        display: inline-flex;
        align-items: center;
    }

    /* Glassmorphism Stats Cards */
    .stat-card-glass {
        background: rgba(255, 255, 255, 0.07);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 16px;
        padding: 0.85rem 1.25rem;
        color: #ffffff;
        transition: background 0.2s ease, border-color 0.2s ease;
    }

        .stat-card-glass:hover {
            background: rgba(255, 255, 255, 0.12);
            border-color: rgba(255, 255, 255, 0.25);
        }

    /* Toolbar Filter & Search */
    .toolbar-saas {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 18px;
        padding: 10px 14px;
        box-shadow: 0 4px 12px rgba(15, 23, 42, 0.03);
    }

    .filter-btn-saas {
        padding: 8px 18px;
        border-radius: 12px;
        font-size: 0.85rem;
        font-weight: 600;
        color: #64748b;
        text-decoration: none;
        transition: all 0.2s ease;
        display: inline-block;
    }

        .filter-btn-saas:hover {
            color: #1e293b;
            background: #f1f5f9;
        }

        .filter-btn-saas.active {
            background: #4f46e5;
            color: #ffffff;
            box-shadow: 0 4px 12px rgba(79, 70, 229, 0.25);
        }

    .search-wrapper-saas {
        position: relative;
        min-width: 280px;
    }

        .search-wrapper-saas .bi-search {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: #94a3b8;
        }

    .search-input-saas {
        background: #f8fafc;
        border: 1px solid #cbd5e1;
        border-radius: 12px;
        padding: 8px 16px 8px 38px;
        font-size: 0.875rem;
        color: #0f172a;
        transition: all 0.2s ease;
    }

        .search-input-saas:focus {
            background: #ffffff;
            border-color: #6366f1;
            box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.15);
            outline: none;
        }

    /* Course Cards Architecture */
    .course-card-saas {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 20px;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        height: 100%;
        transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.25s ease, border-color 0.25s ease;
        box-shadow: 0 4px 12px rgba(15, 23, 42, 0.03);
    }

        .course-card-saas:hover {
            transform: translateY(-6px);
            border-color: #c7d2fe;
            box-shadow: 0 20px 30px -10px rgba(15, 23, 42, 0.08);
        }

    /* Thumbnail Area & Badges */
    .thumb-wrapper-saas {
        position: relative;
        height: 185px;
        background: linear-gradient(135deg, #1e1b4b 0%, #312e81 100%);
        overflow: hidden;
    }

    .course-img-saas {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.4s ease;
    }

    .course-card-saas:hover .course-img-saas {
        transform: scale(1.05);
    }

    .thumb-fallback-saas {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #4f46e5 0%, #3b82f6 100%);
        color: #ffffff;
        font-size: 3.5rem;
        opacity: 0.9;
    }

    .badge-overlay-glass {
        background: rgba(15, 23, 42, 0.65);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        color: #ffffff;
        font-size: 0.72rem;
        font-weight: 700;
        padding: 5px 12px;
        border-radius: 999px;
        letter-spacing: 0.02em;
        border: 1px solid rgba(255, 255, 255, 0.15);
    }

    /* Status Pills */
    .pill-status {
        padding: 5px 12px;
        border-radius: 9999px;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.02em;
        text-transform: uppercase;
        display: inline-flex;
        align-items: center;
    }

    .pill-emerald {
        background: #d1fae5;
        color: #047857;
        border: 1px solid #a7f3d0;
    }

    .pill-amber {
        background: #fef3c7;
        color: #b45309;
        border: 1px solid #fde68a;
    }

    /* Up Next Box */
    .up-next-box-saas {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-left: 3px solid #6366f1;
        border-radius: 12px;
        padding: 10px 14px;
    }

    /* Progress Bar */
    .progress-track-saas {
        background: #e2e8f0;
        border-radius: 999px;
        height: 8px;
        overflow: hidden;
    }

    .progress-fill-saas {
        background: linear-gradient(90deg, #6366f1 0%, #4f46e5 100%);
        border-radius: 999px;
        height: 100%;
        transition: width 0.4s ease;
    }

    /* Action Buttons */
    

    .font-mono {
        font-family: 'JetBrains Mono', monospace;
    }

    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .line-clamp-1 {
        display: -webkit-box;
        -webkit-line-clamp: 1;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    /* Empty State */
    .empty-state-saas {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 24px;
        padding: 4rem 2rem;
        box-shadow: 0 4px 12px rgba(15, 23, 42, 0.03);
    }
</style>

<div class="my-courses-dashboard">

    <!-- HERO & QUICK STATS BANNER -->
    <div class="hero-banner-saas mb-4">
        <div class="row align-items-center g-4">
            <div class="col-lg-7">
                <div class="mb-3">
                    <span class="pill-hero-badge">
                        <i class="bi bi-mortarboard-fill me-2" style="color: #a5b4fc;"></i> STUDENT PORTAL
                    </span>
                </div>
                <h2 class="fw-extrabold text-white mb-2 display-6">My Enrolled Courses</h2>
                <p class="text-slate-300 fs-6 mb-0" style="color: #cbd5e1;">
                    Track your active courses, review completed modules, and continue learning right where you left off.
                </p>
            </div>

            <!-- Stats Glass Cards Strip -->
            <div class="col-lg-5">
                <div class="row g-2">
                    <div class="col-4">
                        <div class="stat-card-glass text-center">
                            <span class="d-block font-mono fs-3 fw-bold text-white">@Model.TotalEnrolled</span>
                            <span class="text-slate-300 small" style="color: #cbd5e1; font-size: 0.75rem;">Total Enrolled</span>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="stat-card-glass text-center">
                            <span class="d-block font-mono fs-3 fw-bold" style="color: #fbbf24;">@Model.InProgressCount</span>
                            <span class="text-slate-300 small" style="color: #cbd5e1; font-size: 0.75rem;">In Progress</span>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="stat-card-glass text-center">
                            <span class="d-block font-mono fs-3 fw-bold" style="color: #34d399;">@Model.CompletedCount</span>
                            <span class="text-slate-300 small" style="color: #cbd5e1; font-size: 0.75rem;">Completed</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="px-3">
        <!-- FILTER BAR & SEARCH INPUT -->
        <div class="toolbar-saas d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">

            <!-- Filter Buttons -->
            <div class="d-flex align-items-center gap-2 overflow-x-auto pb-1 pb-md-0">
                <a asp-action="Index" asp-route-filter="All" asp-route-search="@Model.SearchQuery"
                   class="filter-btn-saas @(Model.SelectedFilter == "All" ? "active" : "")">
                    All (@Model.TotalEnrolled)
                </a>
                <a asp-action="Index" asp-route-filter="InProgress" asp-route-search="@Model.SearchQuery"
                   class="filter-btn-saas @(Model.SelectedFilter == "InProgress" ? "active" : "")">
                    In Progress (@Model.InProgressCount)
                </a>
                <a asp-action="Index" asp-route-filter="Completed" asp-route-search="@Model.SearchQuery"
                   class="filter-btn-saas @(Model.SelectedFilter == "Completed" ? "active" : "")">
                    Completed (@Model.CompletedCount)
                </a>
            </div>

            <!-- Search Form -->
            <form method="get" asp-action="Index" class="search-wrapper-saas">
                <input type="hidden" name="filter" value="@Model.SelectedFilter" />
                <i class="bi bi-search"></i>
                <input type="text" name="search" value="@Model.SearchQuery" class="form-control search-input-saas" placeholder="Search my courses..." onchange="this.form.submit()" />
            </form>

        </div>

        <!-- COURSE CARDS GRID -->
        @if (Model.Courses != null && Model.Courses.Any())
        {
            <div class="row g-4">
                @foreach (var course in Model.Courses)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="course-card-saas">

                            <!-- Thumbnail Area with Badges Overlay -->
                            <div class="thumb-wrapper-saas">
                                @if (!string.IsNullOrEmpty(course.ThumbnailUrl))
                                {
                                    <img src="@course.ThumbnailUrl"
                                         alt="@course.Title"
                                         class="course-img-saas"
                                         onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                                }

                                <div class="thumb-fallback-saas" style="@(!string.IsNullOrEmpty(course.ThumbnailUrl) ? "display:none;" : "display:flex;")">
                                    <i class="bi bi-mortarboard-fill"></i>
                                </div>

                                <div class="position-absolute top-0 start-0 m-3">
                                    <span class="badge-overlay-glass">
                                        <i class="bi bi-collection-play me-1"></i> @course.TotalModules Modules
                                    </span>
                                </div>

                                <div class="position-absolute bottom-0 end-0 m-3">
                                    @if (course.IsCompleted)
                                    {
                                        <span class="pill-status pill-emerald shadow-sm">
                                            <i class="bi bi-check-circle-fill me-1"></i> Completed
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="pill-status pill-amber shadow-sm">
                                            <i class="bi bi-clock-history me-1"></i> Active
                                        </span>
                                    }
                                </div>
                            </div>

                            <!-- Card Details Body -->
                            <div class="p-4 d-flex flex-column flex-grow-1 justify-content-between">
                                <div>
                                    <h5 class="fw-bold text-slate-900 mb-2 line-clamp-2" style="min-height: 48px;" title="@course.Title">
                                        @course.Title
                                    </h5>

                                    <div class="d-flex align-items-center gap-2 small text-muted mb-3">
                                        <span><i class="bi bi-play-btn me-1" style="color: #6366f1;"></i>@course.CompletedLessons / @course.TotalLessons Lessons</span>
                                        <span>•</span>
                                        <span>Enrolled: @course.EnrolledDate.ToString("MMM dd, yyyy")</span>
                                    </div>

                                    <!-- Progress Bar -->
                                    <div class="mb-3">
                                        <div class="d-flex justify-content-between align-items-center small fw-semibold mb-1.5">
                                            <span class="text-slate-600">Progress</span>
                                            <span class="font-mono fw-bold" style="color: #4f46e5;">@course.ProgressPercentage%</span>
                                        </div>
                                        <div class="progress-track-saas">
                                            <div class="progress-fill-saas" style="width: @course.ProgressPercentage%;"></div>
                                        </div>
                                    </div>

                                    <!-- Up Next Lesson Box -->
                                    @if (!course.IsCompleted && !string.IsNullOrEmpty(course.NextLessonTitle))
                                    {
                                        <div class="up-next-box-saas mb-3">
                                            <span class="text-muted d-block font-mono text-uppercase" style="font-size: 0.65rem;">Up Next:</span>
                                            <span class="fw-semibold text-slate-800 line-clamp-1 small">@course.NextLessonTitle</span>
                                        </div>
                                    }
                                </div>

                                <!-- Action Buttons -->
                                <div class="pt-3 border-top border-slate-100">
                                    @if (course.IsCompleted)
                                    {
                                        <a asp-controller="Watch" asp-action="Index" asp-route-courseId="@course.CourseId" class="btn-saas-secondary">
                                            <i class="bi bi-arrow-repeat me-1"></i> Review Course
                                        </a>
                                    }
                                    else
                                    {
                                        <a asp-controller="Watch" asp-action="Index" asp-route-courseId="@course.CourseId" asp-route-lessonId="@course.NextLessonId" class="btn-saas-primary">
                                            Continue Learning <i class="bi bi-arrow-right ms-1"></i>
                                        </a>
                                    }
                                </div>

                            </div>

                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <!-- EMPTY STATE -->
            <div class="empty-state-saas text-center my-4">
                <div class="mb-3">
                    <div class="d-inline-flex align-items-center justify-content-center rounded-circle" style="width: 80px; height: 80px; background: #eef2ff; color: #4f46e5;">
                        <i class="bi bi-journal-x fs-1"></i>
                    </div>
                </div>
                <h4 class="fw-extrabold text-slate-900 mb-2">No Courses Found</h4>
                <p class="text-muted mx-auto mb-4" style="max-width: 440px;">
                    You have not enrolled in any courses in this filter category yet.
                </p>
                <a asp-area="Student" asp-controller="Explore" asp-action="Index" class="btn-saas-primary d-inline-block px-4 py-2.5">
                    <i class="bi bi-compass me-1"></i> Explore Courses →
                </a>
            </div>
        }
    </div>

</div>