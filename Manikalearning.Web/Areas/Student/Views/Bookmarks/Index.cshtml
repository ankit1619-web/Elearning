@using Manikalearning.Application.DTOs
@model BookmarkPagedResultDto
@{
    ViewData["Title"] = "Saved";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
}

@section Styles {
    <style>
        .bm-list { display: grid; gap: 1rem; }
        .bm-card { padding: 1.4rem; }
        .bm-top { display: flex; align-items: center; gap: .7rem; flex-wrap: wrap; margin-bottom: 1rem; }
        .bm-tag { display: inline-flex; align-items: center; gap: .4rem; padding: .28rem .7rem; border-radius: 999px; background: var(--soft); color: var(--brand); font-size: .78rem; font-weight: 700; }
        .bm-date { color: var(--muted); font-size: .8rem; font-weight: 600; }
        .bm-form { margin: 0 0 0 auto; }
        .bm-q { font-size: 1.08rem; font-weight: 700; line-height: 1.5; margin: 0 0 1rem; overflow-wrap: anywhere; }
        .bm-ans { display: flex; gap: .75rem; padding: .8rem 1rem; border-radius: 14px; background: #d9f7ea; color: #065f46; overflow-wrap: anywhere; }
        .bm-ans small { display: block; font-size: .75rem; font-weight: 700; opacity: .8; }
        .bm-exp { margin-top: .8rem; }
        .bm-exp summary { list-style: none; display: inline-flex; }
        .bm-exp summary::-webkit-details-marker { display: none; }
        .bm-exp .bm-exp-body { margin-top: .7rem; padding: .9rem 1rem; border-radius: 14px; background: var(--paper); color: var(--muted); font-size: .9rem; overflow-wrap: anywhere; }
        .bm-search { display: flex; gap: .6rem; margin-bottom: 1.2rem; }
        .bm-search input { flex: 1; min-width: 0; padding: .65rem 1rem; border: 1px solid var(--line); border-radius: 12px; background: var(--surface); font: inherit; color: var(--text); }
        .bm-search input:focus { outline: 3px solid rgba(99,102,241,.25); border-color: var(--brand); }
        .bm-pager { display: flex; justify-content: center; align-items: center; gap: .8rem; margin-top: 1.5rem; color: var(--muted); font-weight: 600; font-size: .9rem; }
        .bm-empty { text-align: center; padding: 3rem 1.5rem; }
        .bm-empty i { font-size: 2.8rem; color: var(--brand); }
        .bm-empty h2 { font-size: 1.25rem; font-weight: 800; margin: .6rem 0 .3rem; }
        .bm-empty p { color: var(--muted); max-width: 42ch; margin: 0 auto 1.2rem; }

        @@media (max-width: 575.98px) {
            .bm-card { padding: 1rem; }
            .bm-form { margin-left: 0; width: 100%; }
            .bm-form .b { width: 100%; }
            .bm-search { flex-direction: column; }
        }
    </style>
}

@Html.AntiForgeryToken()
<div class="dash">
    <div class="head">
        <div>
            <h1>Saved questions</h1>
            <p>@Model.TotalCount saved @(Model.TotalCount == 1 ? "question" : "questions"). Revise them any time.</p>
        </div>
        <div class="actions">
            <a class="b b-solid" asp-area="Student" asp-controller="PYQPractice" asp-action="Index"><i class="bi bi-lightning-charge"></i> Practice more</a>
        </div>
    </div>
 
    <form class="bm-search" method="get" asp-area="Student" asp-controller="Bookmarks" asp-action="Index">
        <input type="search" name="search"  value="@Model.Search" maxlength="100" placeholder="Search saved questions" aria-label="Search saved questions" />
        <button type="submit" class="b b-line"><i class="bi bi-search"></i> Search</button>
        @if (!string.IsNullOrEmpty(Model.Search))
        {
            <a class="b b-link" asp-action="Index">Clear</a>
        }
    </form>

    @if (Model.Bookmarks.Count == 0)
    {
        <section class="panel bm-empty">
            <i class="bi bi-bookmark-star"></i>
            <h2>@(string.IsNullOrEmpty(Model.Search) ? "Nothing saved yet" : "No matching questions")</h2>
            <p>
                @(string.IsNullOrEmpty(Model.Search)
                    ? "Tap the bookmark icon on any question while practising and it will appear here."
                    : "Try a different word, or clear the search.")
            </p>
            <a class="b b-solid" asp-area="Student" asp-controller="PYQPractice" asp-action="Index">Start practising</a>
        </section>
    }
    else
    {
        <div class="bm-list">
            @foreach (var b in Model.Bookmarks)
            {
                <article class="panel bm-card">
                    <div class="bm-top">
                        <span class="bm-tag"><i class="bi bi-bookmark-fill"></i> Saved</span>
                        <span class="bm-date">@b.SavedAt.ToLocalTime().ToString("d MMM yyyy")</span>
                         <button type="button"
                                 class="btn btn-sm btn-light text-danger shadow-none rounded-2"
                                 title="Delete Bookmark"
                                 onclick="confirmDelete('@b.BookmarkId', '@b.StudentName')">
                             <i class="bi bi-trash"></i>
                         </button> 
                    </div>

                    <h2 class="bm-q">@b.QuestionTitle</h2>

                    @if (!string.IsNullOrWhiteSpace(b.CorrectAnswer))
                    {
                        <div class="bm-ans"><i class="bi bi-check-lg"></i><div><small>Correct answer</small>@b.CorrectAnswer</div></div>
                    }

                    @if (!string.IsNullOrWhiteSpace(b.Explanation))
                    {
                        <details class="bm-exp">
                            <summary class="b b-soft b-sm"><i class="bi bi-lightbulb"></i> Show explanation</summary>
                            <div class="bm-exp-body">@b.Explanation</div>
                        </details>
                    }
                </article>
            }
        </div>

        
    }
</div>
<div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-body text-center p-4">
                <div class="text-danger mb-3">
                    <i class="bi bi-exclamation-octagon-fill display-5"></i>
                </div>
                <h6 class="fw-bold text-dark mb-2">Delete Bookmark?</h6>
                <p class="text-muted small mb-4" id="deleteBookmarkWarningText">Are you sure you want to delete this bookmark?</p>

                <div class="d-flex gap-2 justify-content-center">
                    <button type="button" class="btn btn-light rounded-3 px-3 w-50" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" id="confirmDeleteBtn" class="btn btn-danger rounded-3 px-3 w-50">Delete</button>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    let selectedDeleteId = null;
    let deleteModalInstance = null;

    function confirmDelete(id, studentName) {
        selectedDeleteId = id;
        document.getElementById('deleteBookmarkWarningText').innerText = `Are you sure you want to delete the bookmark "? This action cannot be undone.`;

        const modalEl = document.getElementById('deleteConfirmModal');
        deleteModalInstance = new bootstrap.Modal(modalEl);
        deleteModalInstance.show();
    }

    document.getElementById('confirmDeleteBtn').addEventListener('click', function() {
        if (!selectedDeleteId) return;

        deleteModalInstance.hide();
        Toast.showLoader();

        const token = $('input[name="__RequestVerificationToken"]').val();

        $.ajax({
            url: '/Student/Bookmarks/Delete/' + selectedDeleteId,
            type: 'POST',
            data: {
                __RequestVerificationToken: token
            },
            success: function(response) {
                Toast.hideLoader();

                if (typeof response === 'object' && response.isSuccess) {
                    Toast.success(response.message || "Bookmark deleted successfully.");
                    setTimeout(() => location.reload(), 800);
                } else {
                    const errorMsg = (response && response.message) ? response.message : "Unable to delete bookmark.";
                    Toast.error(errorMsg);
                }
            },
            error: function() {
                Toast.hideLoader();
                Toast.error("An error occurred while deleting the bookmark.");
            }
        });
    });</script>