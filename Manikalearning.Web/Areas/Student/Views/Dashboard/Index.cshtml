 
@model Manikalearning.Web.Areas.Student.Controllers.DashboardPageVm
@{
    ViewData["Title"] = "Overview";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";

    var d = Model.Data;
    var courses = Model.Courses.Courses?.Take(3).ToList();
    var first = courses?.FirstOrDefault();
    int dailyGoal = d.DailyGoal ?? 1;
    var goalPct = Math.Min(100, (d.SolvedToday * 100) / Math.Max(1, dailyGoal)); 
    var maxQ = Math.Max(1, d.Week.Max(w => w.Questions));
    var todayDate = d.Week.Last().Date;
    string Tone(decimal p) => p >= 75 ? "good" : p >= 50 ? "mid" : "low";
     
    var tasks = new List<(string Title, string Meta, bool Done, string Url)>
    {
        ($"Solve {d.DailyGoal} questions", $"{d.SolvedToday} of {d.DailyGoal} done", d.SolvedToday >= d.DailyGoal,
            Url.Action("Index", "PYQPractice", new { area = "Student" })!)
    };
    if (d.Mistakes > 0)
        tasks.Add(($"Revise {d.Mistakes} {(d.Mistakes == 1 ? "mistake" : "mistakes")}", "Mistake Book", false,
            Url.Action("Index", "MistakeBook", new { area = "Student" })!));
    if (first != null && !string.IsNullOrEmpty(first.NextLessonTitle))
        tasks.Add(($"Continue: {first.NextLessonTitle}", (string)first.Title, false,
            Url.Action("Index", "Watch", new { area = "Student", courseId = first.CourseId, lessonId = first.NextLessonId })!));
}

<div class="dash">

    <div class="head">
        <div>
            <h1>Welcome back, @d.FirstName</h1>
            <p>@DateTime.Today.ToString("dddd, d MMMM")</p>
        </div>
        <div class="actions">
            <a class="b b-line" asp-area="Student" asp-controller="Bookmarks" asp-action="Index"><i class="bi bi-bookmark"></i> Saved (@d.Saved)</a>
            <a class="b b-solid" asp-area="Student" asp-controller="PYQPractice" asp-action="Index"><i class="bi bi-play-fill"></i> Practice PYQs</a>
        </div>
    </div>
     
    <section class="hero" style="margin-bottom:1.5rem">
        <div>
            <span class="chip"><i class="bi bi-bullseye"></i> @(d.TargetExamName != null ? "Target exam: " + d.TargetExamName : "Your exam goal")</span>

            @if (d.DaysLeft != null)
            {
                <div class="count">@d.DaysLeft<span>@(d.DaysLeft == 1 ? "day" : "days") until your exam</span></div>
            }
            else
            {
                <div class="count" style="font-size:clamp(2rem,5vw,3rem);letter-spacing:-.03em">Set your exam goal<span>Add your exam and its date to see a countdown here.</span></div>
            }

            <p>
                @if (d.SolvedWeek > 0)
                {
                    <text>You solved @d.SolvedWeek questions this week.</text>
                }
                else
                {

                    <text>Solve your first questions this week.</text>
                }
                @if (d.StreakDays > 0)
                {
                    <text> You are on a @d.StreakDays-day streak.</text>
                }
            </p>

            <div class="goal"><span>Today's practice</span><span>@d.SolvedToday of @d.DailyGoal questions</span></div>
            <div class="bar dark" style="max-width:430px;margin-bottom:1.5rem"><i style="--w:@(goalPct)%"></i></div>

            <div class="actions">
                <a class="b b-white" asp-area="Student" asp-controller="PYQPractice" asp-action="Index">Resume practice <i class="bi bi-arrow-right"></i></a>
                @if (d.DaysLeft == null)
                {
                    <a class="b b-ghost" asp-area="Student" asp-controller="Profile" asp-action="Index">Set exam goal</a>
                }
                else
                {

                    <a class="b b-ghost" asp-area="Student" asp-controller="Performance" asp-action="Index">View insights</a>
                }
            </div>
        </div>

        <div class="plan">
            <div class="plan-head"><h2>Today's plan</h2><span>@tasks.Count(t => t.Done) of @tasks.Count done</span></div>
            @foreach (var t in tasks)
            {
                <div class="task @(t.Done ? "done" : "")">
                    <span class="tick"><i class="bi bi-check-lg"></i></span>
                    <div><div class="t">@t.Title</div><div class="m">@t.Meta</div></div>
                    @if (!t.Done)
                    {
                        <a class="go" href="@t.Url" aria-label="Open"><i class="bi bi-arrow-right"></i></a>
                    }
                </div>
            }
        </div>
    </section>
     
    <section class="panel stats">
        <div class="stat">
            <div class="l"><span class="ico"><i class="bi bi-check2-all"></i></span> Questions solved</div>
            <div class="v">@d.SolvedTotal</div>
            <div class="n up"><i class="bi bi-graph-up-arrow"></i> +@d.SolvedWeek this week</div>
        </div>
        <div class="stat">
            <div class="l"><span class="ico"><i class="bi bi-bullseye"></i></span> Accuracy</div>
            <div class="v">@d.Accuracy%</div>
            <div class="bar" style="margin-bottom:.45rem"><i class="@Tone(d.Accuracy)" style="--w:@(d.Accuracy)%"></i><span class="mark" style="--at:@(d.AccuracyTarget)%"></span></div>
            <div class="n">Target is @d.AccuracyTarget%</div>
        </div>
        <div class="stat">
            <div class="l"><span class="ico"><i class="bi bi-bookmark"></i></span> Saved</div>
            <div class="v">@d.Saved</div>
            <a asp-area="Student" asp-controller="Bookmarks" asp-action="Index">Open Saved</a>
        </div>
        <div class="stat">
            <div class="l"><span class="ico"><i class="bi bi-exclamation-circle"></i></span> Mistakes to revise</div>
            <div class="v">@d.Mistakes</div>
            <a asp-area="Student" asp-controller="MistakeBook" asp-action="Index">Open Mistake Book</a>
        </div>
    </section>

    <div class="cols">
        <div class="stack">

            <section class="panel pad">
                <div class="ptitle"><h2>Questions this week</h2><a asp-area="Student" asp-controller="Performance" asp-action="Index">Full report</a></div>
                <div class="bars">
                    @foreach (var w in d.Week)
                    {
                        <div class="@(w.Date == todayDate ? "on" : "")">
                            <b>@w.Questions</b>
                            <i style="--h:@(w.Questions * 100 / maxQ)%"></i>
                            @w.Date.ToString("ddd")
                        </div>
                    }
                </div>
            </section>

            <section class="panel pad">
                <div class="ptitle"><h2>Continue learning</h2><a asp-area="Student" asp-controller="MyCourses" asp-action="Index">All courses</a></div>

                @if (courses != null && courses.Count > 0)
                {
                    foreach (var c in courses)
                    {
                        var pct = Math.Clamp((int)Math.Round(Convert.ToDouble(c.ProgressPercentage)), 0, 100);
                        <div class="item">
                            <div class="grow">
                                <div class="nm">@c.Title</div>
                                <div class="mt">@c.CompletedLessons of @c.TotalLessons lessons @(string.IsNullOrEmpty(c.NextLessonTitle) ? "" : "· Up next: " + c.NextLessonTitle)</div>
                                <div class="bar"><i style="--w:@(pct)%"></i></div>
                            </div>
                            <a class="b b-solid b-sm" asp-area="Student" asp-controller="Watch" asp-action="Index" asp-route-courseId="@c.CourseId" asp-route-lessonId="@c.NextLessonId">Continue</a>
                        </div>
                    }
                }
                else
                {
                    <p class="muted" style="margin:.2rem 0 1rem">No course in progress yet. Pick your exam and start a course.</p>
                    <a class="b b-line" asp-area="Student" asp-controller="Exams" asp-action="Index"><i class="bi bi-compass"></i> Explore exams</a>
                }
            </section>
        </div>

        <aside class="stack">
            <section class="mock">
                <span class="chip">Practice</span>
                <h3>Previous year questions</h3>
                <div class="info"><span><i class="bi bi-collection"></i> By subject</span><span><i class="bi bi-calendar3"></i> By year</span></div>
                <a class="b b-white" asp-area="Student" asp-controller="PYQPractice" asp-action="Index">Start practising</a>
            </section>

            <section class="panel pad">
                <div class="ptitle"><h2>Doubts</h2><a asp-area="Student" asp-controller="Doubts" asp-action="Index">View all</a></div>
                <div class="kv"><span>Waiting for a reply</span><strong>@d.OpenDoubts</strong></div>
                <div class="kv"><span>Answered</span><strong>@d.AnsweredDoubts</strong></div>
            </section>

            <section class="panel pad">
                <div class="ptitle"><h2>Your plan</h2></div>
                @if (d.PlanName != null)
                {
                    <div class="kv"><span>Plan</span><strong>@d.PlanName</strong></div>
                    <div class="kv"><span>Valid till</span><strong>@d.PlanEnds!.Value.ToLocalTime().ToString("d MMM yyyy")</strong></div>
                    <div class="kv" style="margin-bottom:1rem"><span>Days left</span><strong>@d.PlanDaysLeft</strong></div>
                    <a class="b b-line b-block" asp-area="Student" asp-controller="Subscription" asp-action="Index">Manage plan</a>
                }
                else
                {
                    <p class="muted" style="margin:0 0 1rem">You have no active plan. Choose one to save your PYQ results, ask doubts and more.</p>
                    <a class="b b-solid b-block" asp-area="Student" asp-controller="Subscription" asp-action="Index">See plans</a>
                }
            </section>
        </aside>
    </div>
</div>
