@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
}

<div class="row g-4">
    <!-- Main Welcome & Performance Card (Dark Violet Theme) -->
    <div class="col-lg-8">
        <div class="card border-0 rounded-4 p-4 text-white" style="background: linear-gradient(135deg, #1e1b4b 0%, #4338ca 100%);">
            <div class="d-flex justify-content-between align-items-start mb-4">
                <div>
                    <span class="text-uppercase small fw-bold text-indigo-200" style="color: #c7d2fe;">Your Performance</span>
                    <h2 class="fw-bold mb-0">Keep going! 🔥</h2>
                </div>
                <span class="badge bg-success bg-opacity-25 text-success border border-success rounded-pill px-3 py-1">LIVE</span>
            </div>

            <div class="row align-items-center mb-4 bg-white bg-opacity-10 p-3 rounded-4 mx-0">
                <div class="col-auto">
                    <!-- CSS Circular Progress -->
                    <div class="position-relative d-flex align-items-center justify-content-center bg-dark rounded-circle border border-4" style="width: 80px; height: 80px; border-color: #8b5cf6 !important;">
                        <span class="fw-bold fs-5">84%</span>
                    </div>
                </div>
                <div class="col">
                    <p class="mb-1 fw-medium text-light">Weekly Progress</p>
                    <div class="progress mb-2" style="height: 8px; background-color: rgba(255,255,255,0.2);">
                        <div class="progress-bar" style="width: 84%; background-color: #a78bfa;"></div>
                    </div>
                    <small style="color: #a78bfa;">+12.5% this week</small>
                </div>
            </div>

            <div class="row g-3 text-center">
                <div class="col-4">
                    <div class="bg-dark bg-opacity-25 rounded-3 p-3">
                        <small class="text-light opacity-75">Questions</small>
                        <h4 class="fw-bold mb-0 mt-1">1,248</h4>
                    </div>
                </div>
                <div class="col-4">
                    <div class="bg-dark bg-opacity-25 rounded-3 p-3">
                        <small class="text-light opacity-75">Accuracy</small>
                        <h4 class="fw-bold mb-0 mt-1">91%</h4>
                    </div>
                </div>
                <div class="col-4">
                    <div class="bg-dark bg-opacity-25 rounded-3 p-3">
                        <small class="text-light opacity-75">Rank</small>
                        <h4 class="fw-bold mb-0 mt-1">#128</h4>
                    </div>
                </div>
            </div>
            
            <div class="mt-4 bg-dark bg-opacity-50 p-3 rounded-3 d-flex justify-content-between align-items-center cursor-pointer">
                <div>
                    <span class="badge bg-primary mb-1"><i class="bi bi-lightning-fill"></i> NEXT TEST</span>
                    <h6 class="mb-0 fw-bold">Full Length Mock Test 4</h6>
                </div>
                <i class="bi bi-arrow-up-right fs-5"></i>
            </div>
        </div>
    </div>

    <!-- Right Sidebar (Resume Learning) -->
    <div class="col-lg-4">
        <h6 class="fw-bold text-dark mb-3">Resume Learning</h6>
        
        <!-- Enrolled Course Card -->
        <div class="card border-0 shadow-sm rounded-4 mb-3 overflow-hidden">
            <img src="/images/course-banner.jpg" class="card-img-top bg-light" alt="Course" style="height: 120px; object-fit: cover;">
            <div class="card-body p-3">
                <h6 class="fw-bold text-dark text-truncate">UGC NET Paper 1 Complete</h6>
                <p class="text-muted small mb-2">Teaching Aptitude - Level of Teaching</p>
                <div class="progress mb-2" style="height: 6px;">
                    <div class="progress-bar bg-indigo" style="width: 45%; background-color: #6366f1;"></div>
                </div>
                <div class="d-flex justify-content-between align-items-center">
                    <small class="text-muted fw-medium">45% Completed</small>
                    <a href="#" class="btn btn-sm text-white px-3 rounded-pill shadow-none" style="background-color: #6366f1;">Resume <i class="bi bi-play-fill"></i></a>
                </div>
            </div>
        </div>
    </div>
</div>