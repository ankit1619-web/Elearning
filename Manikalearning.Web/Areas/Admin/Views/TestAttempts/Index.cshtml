@model IEnumerable<Manikalearning.Application.DTOs.TestAttemptDto>
@{
    ViewData["Title"] = "Student Test Attempts";
}

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h4 class="fw-bold mb-0 text-dark"><i class="bi bi-person-lines-fill text-primary me-2"></i>Student Test Attempts</h4>
            <small class="text-muted">Monitor student test performances, reset attempts, and view submission analytics.</small>
        </div>
    </div>

    <!-- Filter Card -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3">
            <form method="get" asp-action="Index" class="row g-2 align-items-center">
                <div class="col-md-8">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" name="search" value="@ViewBag.SearchTerm" class="form-control border-start-0 ps-0" placeholder="Search by Student Name, Email, or Test Title...">
                    </div>
                </div>
                <div class="col-md-4 d-flex gap-2">
                    <button type="submit" class="btn btn-primary px-4 rounded-2 flex-fill"><i class="bi bi-filter me-1"></i> Filter</button>
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-2"><i class="bi bi-arrow-counterclockwise"></i> Reset</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Attempts Table -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Student</th>
                            <th>Test Title</th>
                            <th>Status</th>
                            <th>Score / Total</th>
                            <th>Accuracy</th>
                            <th>Correct/Wrong</th>
                            <th>Time Spent</th>
                            <th>Started At</th>
                            <th class="text-end pe-3">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="9" class="text-center py-4 text-muted">No student attempts found.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                var timeSpan = TimeSpan.FromSeconds(item.TimeTakenSeconds);
                                string formattedTime = $"{timeSpan.Minutes}m {timeSpan.Seconds}s";

                                <tr>
                                    <td class="ps-3">
                                        <div class="fw-bold text-dark">@item.UserName</div>
                                        <small class="text-muted fs-7">@item.UserEmail</small>
                                    </td>
                                    <td class="fw-semibold text-primary">@item.TestTitle</td>
                                    <td>
                                        @if (item.Status == "Completed")
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1">Completed</span>
                                        }
                                        else if (item.Status == "In Progress")
                                        {
                                            <span class="badge bg-warning-subtle text-warning border border-warning-subtle rounded-pill px-3 py-1">In Progress</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary border rounded-pill px-3 py-1">@item.Status</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="fw-bold text-dark">@item.Score</span> / <small class="text-muted">@item.TotalMarks</small>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center gap-1">
                                            <span class="fw-semibold">@item.Accuracy%</span>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="text-success fw-semibold"><i class="bi bi-check-circle-fill"></i> @item.CorrectAnswers</span>
                                        <span class="text-danger ms-2 fw-semibold"><i class="bi bi-x-circle-fill"></i> @item.WrongAnswers</span>
                                    </td>
                                    <td><small class="text-muted"><i class="bi bi-clock me-1"></i>@formattedTime</small></td>
                                    <td><small class="text-muted">@item.StartedAt.ToString("dd MMM yyyy, hh:mm tt")</small></td>
                                    <td class="text-end pe-3">
                                        <div class="d-inline-flex gap-1">
                                            <!-- Detailed Answer Sheet View -->
                                            <a asp-controller="TestAttemptAnswers" asp-action="Index" asp-route-attemptId="@item.AttemptId" 
                                               class="btn btn-sm btn-light text-primary rounded-2 shadow-none" title="View Attempt Answers">
                                                <i class="bi bi-eye-fill"></i>
                                            </a>

                                            @if (item.Status == "In Progress")
                                            {
                                                <button type="button" class="btn btn-sm btn-light text-warning rounded-2 shadow-none"
                                                        title="Force Submit Test" onclick="forceSubmitAttempt('@item.AttemptId')">
                                                    <i class="bi bi-check2-all"></i>
                                                </button>
                                            }

                                            <!-- Reset Attempt -->
                                            <button type="button" class="btn btn-sm btn-light text-danger rounded-2 shadow-none"
                                                    title="Reset Attempt (Allow Retake)" onclick="resetAttempt('@item.AttemptId')">
                                                <i class="bi bi-arrow-counterclockwise"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script>
    function resetAttempt(id) {
        if (confirm("Are you sure you want to RESET this student's attempt? This will permanently clear their answers so they can retake the test.")) {
            fetch(`/Admin/TestAttempts/Reset/${id}`, { method: 'POST' })
            .then(res => res.json())
            .then(data => {
                if(data.success) {
                    location.reload();
                } else {
                    alert(data.message);
                }
            });
        }
    }

    function forceSubmitAttempt(id) {
        if (confirm("Force submit this attempt now?")) {
            fetch(`/Admin/TestAttempts/ForceSubmit/${id}`, { method: 'POST' })
            .then(res => res.json())
            .then(data => {
                if(data.success) {
                    location.reload();
                } else {
                    alert(data.message);
                }
            });
        }
    }
</script>