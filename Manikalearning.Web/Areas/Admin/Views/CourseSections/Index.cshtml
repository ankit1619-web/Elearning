@using Manikalearning.Application.DTOs
@model List<CourseSectionDto>

@{
    ViewData["Title"] = "Course Sections";
    ViewData["HeaderTitle"] = "Course Sections";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var courseId = (Guid)ViewData["CourseId"]!;
    var courseName = ViewData["CourseName"]?.ToString() ?? "Selected Course";
}

@Html.AntiForgeryToken()

<div class="card border-0 shadow-sm rounded-4 p-4 bg-white"> 
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <a href="/Admin/Courses" class="btn btn-sm btn-light border shadow-none rounded-2 me-1" title="Back to Courses">
                    <i class="bi bi-arrow-left"></i>
                </a>
                <h5 class="fw-bold text-dark mb-0">Course Modules & Sections</h5>
            </div>
            <p class="text-muted small mb-0 ms-4">
                Managing sections for: <span class="fw-semibold text-primary">@courseName</span>
            </p>
        </div>

        <div class="d-flex align-items-center gap-2">
            <div class="input-group input-group-sm rounded-3 overflow-hidden border">
                <span class="input-group-text bg-light border-0 text-muted"><i class="bi bi-search"></i></span>
                <input type="text" id="tableSearch" class="form-control bg-light border-0 shadow-none" placeholder="Search sections..." onkeyup="filterTable()">
            </div>

            <button class="btn btn-primary-custom btn-sm text-nowrap rounded-3 px-3 shadow-sm" onclick="Toast.openModal('/Admin/CourseSections/CreatePartial/@courseId', 'modal-md')">
                <i class="bi bi-plus-lg me-1"></i> Add Section
            </button>
        </div>
    </div>

    <!-- Table -->
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0" id="sectionsTable">
            <thead class="table-light rounded-3">
                <tr>
                    <th class="text-muted fw-semibold border-0 py-3 ps-3" style="width: 100px;">Order</th>
                    <th class="text-muted fw-semibold border-0 py-3">Section Title</th>
                    <th class="text-muted fw-semibold border-0 py-3">Status</th>
                    <th class="text-muted fw-semibold border-0 py-3 text-end pe-3">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-3">
                                <span class="badge bg-light text-dark border rounded-pill px-3 py-2 fw-semibold">
                                    #@item.DisplayOrder
                                </span>
                            </td>
                            <td class="fw-medium text-dark">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                                        <i class="bi bi-journal-bookmark fs-6"></i>
                                    </div>
                                    <div>
                                        <span class="d-block fw-semibold text-dark">@item.SectionName</span>
                                        @if (!string.IsNullOrEmpty(item.Description))
                                        {
                                            <small class="text-muted d-block text-truncate" style="max-width: 300px;">@item.Description</small>
                                        }
                                    </div>
                                </div>
                            </td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-2 fw-medium">
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill px-3 py-2 fw-medium">
                                        Inactive
                                    </span>
                                }
                            </td>
                            <td class="text-end pe-3">
                                <div class="d-inline-flex gap-1"> 
                                    <a href="/Admin/CourseLectures/@item.CourseSectionId"
                                       class="btn btn-sm btn-light text-info shadow-none rounded-2"
                                       title="Manage Lectures">
                                        <i class="bi bi-play-circle"></i>
                                    </a>
 
                                    <button type="button"
                                            class="btn btn-sm btn-light text-primary shadow-none rounded-2"
                                            title="Edit Section"
                                            onclick="Toast.openModal('/Admin/CourseSections/EditPartial/@item.CourseSectionId', 'modal-md')">
                                        <i class="bi bi-pencil-square"></i>
                                    </button>
 
                                    <button type="button"
                                            class="btn btn-sm btn-light text-danger shadow-none rounded-2"
                                            title="Delete Section"
                                            onclick="confirmDelete('@item.CourseSectionId', '@item.SectionName')">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="text-center py-5">
                            <div class="text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary opacity-50"></i>
                                <h6 class="fw-semibold mb-1">No Sections Found</h6>
                                <p class="small mb-0">Click on "Add Section" to create your first module.</p>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-body text-center p-4">
                <div class="text-danger mb-3">
                    <i class="bi bi-exclamation-octagon-fill display-5"></i>
                </div>
                <h6 class="fw-bold text-dark mb-2">Delete Section?</h6>
                <p class="text-muted small mb-4" id="deleteSectionWarningText">Are you sure you want to delete this section?</p>

                <div class="d-flex gap-2 justify-content-center">
                    <button type="button" class="btn btn-light rounded-3 px-3 w-50" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" id="confirmDeleteBtn" class="btn btn-danger rounded-3 px-3 w-50">Delete</button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    let selectedDeleteId = null;
    let deleteModalInstance = null;

    function confirmDelete(id, sectionTitle) {
        selectedDeleteId = id;
        document.getElementById('deleteSectionWarningText').innerText = `Are you sure you want to delete "${sectionTitle}"? This action cannot be undone.`;

        const modalEl = document.getElementById('deleteConfirmModal');
        deleteModalInstance = new bootstrap.Modal(modalEl);
        deleteModalInstance.show();
    }

    document.getElementById('confirmDeleteBtn').addEventListener('click', function() {
        if (!selectedDeleteId) return;

        deleteModalInstance.hide();
        Toast.showLoader();

        const token = $('input[name="__RequestVerificationToken"]').val();

        $.ajax({
            url: '/Admin/CourseSections/Delete/' + selectedDeleteId,
            type: 'POST',
            data: {
                __RequestVerificationToken: token
            },
            success: function(response) {
                Toast.hideLoader();

                if (typeof response === 'object' && response.isSuccess) {
                    Toast.success(response.message || "Section deleted successfully.");
                    setTimeout(() => location.reload(), 800);
                } else {
                    const errorMsg = (response && response.message) ? response.message : "Unable to delete section.";
                    Toast.error(errorMsg);
                }
            },
            error: function() {
                Toast.hideLoader();
                Toast.error("An error occurred while deleting the section.");
            }
        });
    });

    function filterTable() {
        const input = document.getElementById("tableSearch");
        const filter = input.value.toLowerCase();
        const table = document.getElementById("sectionsTable");
        const trs = table.getElementsByTagName("tr");

        for (let i = 1; i < trs.length; i++) {
            const td = trs[i].getElementsByTagName("td")[1];
            if (td) {
                const textValue = td.textContent || td.innerText;
                trs[i].style.display = textValue.toLowerCase().indexOf(filter) > -1 ? "" : "none";
            }
        }
    }
</script>