@model Manikalearning.Web.Areas.Admin.ViewModels.CourseSectionViewModel

@{
    string title = Model.IsEdit ? "Edit Course Section" : "Create New Section";
    string actionName = Model.IsEdit ? "Edit" : "Create";
}

<div class="modal-header border-bottom-0 pb-0">
    <h5 class="modal-title fw-bold text-dark" id="globalModalTitle">@title</h5>
    <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<form asp-area="Admin" asp-controller="CourseSections" asp-action="@actionName" method="post" onsubmit="return Toast.submitModalForm(this);">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="CourseId" />
    
    @if (Model.IsEdit)
    {
        <input type="hidden" asp-for="SectionId" />
    }

    <div class="modal-body py-3">
        <div class="mb-3">
            <label asp-for="Title" class="form-label text-muted small fw-semibold"></label>
            <input asp-for="Title" class="form-control rounded-3 shadow-none" placeholder="e.g. Module 1: Introduction to MVC" required />
            <span asp-validation-for="Title" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label text-muted small fw-semibold"></label>
            <textarea asp-for="Description" class="form-control rounded-3 shadow-none" rows="3" placeholder="Brief section details..."></textarea>
            <span asp-validation-for="Description" class="text-danger small"></span>
        </div>

        <div class="row g-3">
            <div class="col-6">
                <label asp-for="DisplayOrder" class="form-label text-muted small fw-semibold"></label>
                <input asp-for="DisplayOrder" type="number" class="form-control rounded-3 shadow-none" min="0" required />
                <span asp-validation-for="DisplayOrder" class="text-danger small"></span>
            </div>

            @if (Model.IsEdit)
            {
                <div class="col-6 d-flex align-items-end">
                    <div class="form-check form-switch mb-2">
                        <input class="form-check-input shadow-none" type="checkbox" asp-for="IsActive" id="IsActiveSwitch" />
                        <label class="form-check-label fw-medium text-dark small" for="IsActiveSwitch">Active Status</label>
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="modal-footer border-top-0 pt-0">
        <button type="button" class="btn btn-light rounded-3 px-4" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary-custom px-4 shadow-sm">
            <i class="bi bi-check-lg me-1"></i> Save Changes
        </button>
    </div>
</form>