@model Manikalearning.Web.Areas.Admin.ViewModels.PlanCourseMappingViewModel

@{
    ViewData["Title"] = $"Manage Courses - {Model.PlanName}";
    ViewData["HeaderTitle"] = "Plan Course Mapping";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@Html.AntiForgeryToken()

<div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <a href="/Admin/Plans" class="btn btn-sm btn-light text-secondary rounded-2"><i class="bi bi-arrow-left"></i> Back</a>
                <h5 class="fw-bold text-dark mb-0">Courses in "@Model.PlanName"</h5>
            </div>
            <p class="text-muted small mb-0 pe-2">Select the courses accessible to students purchasing this plan.</p>
        </div>

        <div class="d-flex align-items-center gap-2">
            <div class="input-group input-group-sm rounded-3 overflow-hidden border">
                <span class="input-group-text bg-light border-0 text-muted"><i class="bi bi-search"></i></span>
                <input type="text" id="courseSearch" class="form-control bg-light border-0 shadow-none" placeholder="Filter courses..." onkeyup="filterCourses()">
            </div>

            <button type="button" id="saveMappingBtn" class="btn btn-primary-custom btn-sm text-nowrap rounded-3 px-3 shadow-sm">
                <i class="bi bi-check-circle me-1"></i> Save Access
            </button>
        </div>
    </div>

    <form id="planCourseForm">
        <input type="hidden" id="PlanId" value="@Model.PlanId" />

        <div class="row g-3" id="courseListContainer">
            @if (Model.AvailableCourses != null && Model.AvailableCourses.Any())
            {
                @foreach (var course in Model.AvailableCourses)
                {
                    bool isChecked = course.IsMapped;
                    <div class="col-md-6 col-lg-4 course-card-item">
                        <div class="border rounded-3 p-3 h-100 d-flex align-items-center justify-content-between bg-light-subtle">
                            <div class="d-flex align-items-center gap-3">
                                <div class="form-check fs-5 mb-0">
                                    <input class="form-check-input course-checkbox shadow-none" 
                                           type="checkbox" 
                                           value="@course.CourseId" 
                                           id="course_@course.CourseId" 
                                           @(isChecked ? "checked" : "") />
                                </div>
                                <div>
                                    <label class="form-check-label fw-semibold text-dark d-block course-title text-decoration-none" for="course_@course.CourseId" style="cursor: pointer;">
                                        @course.CourseName
                                    </label>
                                    <small class="text-muted">Price: ₹@course.Price.ToString("N2")</small>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center py-5">
                    <i class="bi bi-journal-x fs-1 text-muted d-block mb-2"></i>
                    <h6 class="fw-semibold">No Courses Available</h6>
                    <p class="small text-muted mb-0">Create courses in the catalog first to assign them here.</p>
                </div>
            }
        </div>
    </form>
</div>

<script>
    document.getElementById('saveMappingBtn').addEventListener('click', function () {
        const planId = $('#PlanId').val();
        const selectedIds = [];

        $('.course-checkbox:checked').each(function () {
            selectedIds.push($(this).val());
        });

        Toast.showLoader();

        const token = $('input[name="__RequestVerificationToken"]').val();

        $.ajax({
            url: '/Admin/PlanCourses/Save',
            type: 'POST',
            contentType: 'application/json',
            headers: {
                'RequestVerificationToken': token
            },
            data: JSON.stringify({
                planId: planId,
                selectedCourseIds: selectedIds
            }),
            success: function (response) {
                Toast.hideLoader();

                if (response && response.isSuccess) {
                    Toast.success(response.message || "Plan course access updated.");
                } else {
                    Toast.error(response.message || "Failed to save mapping.");
                }
            },
            error: function () {
                Toast.hideLoader();
                Toast.error("An error occurred while saving mapped courses.");
            }
        });
    });

    function filterCourses() {
        const term = document.getElementById('courseSearch').value.toLowerCase();
        const items = document.querySelectorAll('.course-card-item');

        items.forEach(item => {
            const title = item.querySelector('.course-title').innerText.toLowerCase();
            if (title.includes(term)) {
                item.style.display = "";
            } else {
                item.style.display = "none";
            }
        });
    }
</script>