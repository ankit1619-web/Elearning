@using Manikalearning.Application.DTOs
@model ManageUserRoleViewModel

<div class="modal-content border-0 shadow">
<form asp-area="Admin" asp-controller="Users" asp-action="ManageRoles" method="post" onsubmit="return Toast.submitModalForm(this);"> 
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="UserId" />
        <input type="hidden" asp-for="FullName" />
        <input type="hidden" asp-for="Email" />

        <div class="modal-header">
            <h5 class="modal-title fw-bold">Assign Role</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
            <div class="mb-3">
                <label class="form-label text-muted mb-0 small">User</label>
                <div class="fw-bold text-dark">@(string.IsNullOrEmpty(Model.FullName) ? Model.Email : Model.FullName)</div>
                <div class="small text-muted">@Model.Email</div>
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Select Single Role</label>
                <select asp-for="SelectedRoleId" class="form-select">
                    <option value="">-- No Role --</option>
                    @foreach (var role in Model.AvailableRoles)
                    {
                        <option value="@role.Id">@role.Name</option>
                    }
                </select>
            </div>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-primary">Save Role</button>
        </div>
    </form>
</div>