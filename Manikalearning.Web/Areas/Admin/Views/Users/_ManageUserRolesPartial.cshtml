@using Manikalearning.Application.DTOs
@model  ManageUserRolesViewModel

<div class="modal-content border-0 shadow">
    <form asp-action="Manage" method="post">
        <input type="hidden" asp-for="UserId" />
        <input type="hidden" asp-for="FullName" />
        <input type="hidden" asp-for="Email" />

        <div class="modal-header">
            <h5 class="modal-title fw-bold">Manage Roles: @Model.FullName</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
            <p class="text-muted small mb-3">Assign or remove roles for <strong>@Model.Email</strong>.</p>

            <div class="list-group">
                @for (int i = 0; i < Model.UserRoles.Count; i++)
                {
                    <label class="list-group-item d-flex justify-content-between align-items-center">
                        <div>
                            <input class="form-check-input me-2" type="checkbox" asp-for="@Model.UserRoles[i].IsSelected" />
                            <span class="fw-semibold">@Model.UserRoles[i].RoleName</span>
                        </div>
                        <input type="hidden" asp-for="@Model.UserRoles[i].RoleId" />
                        <input type="hidden" asp-for="@Model.UserRoles[i].RoleName" />
                    </label>
                }
            </div>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-primary">Save Changes</button>
        </div>
    </form>
</div>