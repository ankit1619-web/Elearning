@using Manikalearning.Application.DTOs
@model StudentLectureProgressDto

<div class="modal-header border-bottom-0 pb-0">
    <div>
        <h5 class="modal-title fw-bold text-dark" id="globalModalTitle">Lecture Progress Analytics</h5>
        <p class="text-muted small mb-0">Detailed watching telemetry for student.</p>
    </div>
    <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<div class="modal-body py-3">
    <!-- Student & Course Info Header -->
    <div class="p-3 bg-light rounded-3 mb-3 border">
        <div class="row g-2">
            <div class="col-md-6 border-end">
                <small class="text-muted text-uppercase fw-bold fs-8 d-block">Student</small>
                <span class="fw-bold text-dark">@Model.StudentName</span>
                <small class="text-muted d-block">@Model.StudentEmail</small>
            </div>
            <div class="col-md-6 ps-md-3">
                <small class="text-muted text-uppercase fw-bold fs-8 d-block">Course</small>
                <span class="fw-bold text-primary">@Model.CourseTitle</span>
            </div>
        </div>
    </div>

    <!-- Lecture Title -->
    <div class="border rounded-3 p-3 mb-3">
        <small class="text-muted text-uppercase fw-bold fs-8 d-block mb-1">Lecture Topic</small>
        <div class="fw-semibold text-dark"><i class="bi bi-play-circle-fill text-danger me-1"></i> @Model.LectureTitle</div>
    </div>

    <!-- Completion Visual Bar -->
    <div class="border rounded-3 p-3 mb-3">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <small class="fw-bold text-muted text-uppercase fs-8">Watch Completion Rate</small>
            <span class="fw-bold text-dark">@Model.CompletionPercentage%</span>
        </div>
        <div class="progress rounded-pill" style="height: 10px;">
            <div class="progress-bar @(Model.IsCompleted ? "bg-success" : "bg-primary") progress-bar-striped progress-bar-animated"
                 role="progressbar"
                 style="width: @Model.CompletionPercentage%"
                 aria-valuenow="@Model.CompletionPercentage"
                 aria-valuemin="0"
                 aria-valuemax="100"></div>
        </div>
        <div class="d-flex justify-content-between text-muted fs-8 mt-2">
            <span>Watched: <strong>@Model.FormattedWatchedTime</strong> (@Model.WatchedSeconds secs)</span>
            <span>Total Video: <strong>@Model.FormattedTotalTime</strong> (@Model.TotalSeconds secs)</span>
        </div>
    </div>

    <!-- Timestamps -->
    <ul class="list-group list-group-flush border rounded-3 fs-7">
        <li class="list-group-item d-flex justify-content-between py-2">
            <span class="text-muted">Last Watched At:</span>
            <strong class="text-dark">@Model.LastWatchedAt.ToString("dd MMMM yyyy, hh:mm tt")</strong>
        </li>
        <li class="list-group-item d-flex justify-content-between py-2">
            <span class="text-muted">Status:</span>
            <strong>
                @if (Model.IsCompleted)
                {
                    <span class="badge bg-success px-2 py-1">Completed</span>
                }
                else
                {
                    <span class="badge bg-warning text-dark px-2 py-1">In Progress</span>
                }
            </strong>
        </li>
    </ul>
</div>

<div class="modal-footer border-top-0 pt-0">
    <button type="button" class="btn btn-light rounded-3 px-4" data-bs-dismiss="modal">Close</button>
</div>