@model Manikalearning.Web.Areas.Admin.ViewModels.CourseLectureViewModel

@{
    string title = Model.IsEdit ? "Edit Lecture" : "Add New Lecture";
    string actionName = Model.IsEdit ? "Edit" : "Create";
}

<!-- Custom CSS for Sleek Modal Design -->
<style>
    .modal-header-gradient {
        background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
    }

    .nav-pills-custom .nav-link {
        color: #6c757d;
        border-radius: 8px;
        padding: 8px 20px;
        font-weight: 600;
        transition: all 0.2s ease;
    }

        .nav-pills-custom .nav-link.active {
            background-color: #0d6efd;
            color: #ffffff;
            box-shadow: 0 4px 10px rgba(13, 110, 253, 0.25);
        }

    .note-editor.note-frame {
        border-radius: 10px !important;
        border: 1px solid #dee2e6 !important;
        overflow: hidden;
        box-shadow: 0 2px 6px rgba(0,0,0,0.02);
    }

    .note-toolbar {
        background: #f8f9fa !important;
        border-bottom: 1px solid #e9ecef !important;
    }
</style>
  
<div class="modal-header border-bottom-0 pb-0">
    <h5 class="modal-title fw-bold text-dark" id="globalModalTitle">@title</h5>
    <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
</div>
 
<div class="px-4 pt-3 bg-light border-bottom">
    <ul class="nav nav-pills nav-pills-custom gap-2" id="lectureModalTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="tab-details-btn" data-bs-toggle="pill" data-bs-target="#tab-details-pane" type="button" role="tab" aria-controls="tab-details-pane" aria-selected="true">
                <i class="bi bi-info-circle me-1"></i> Lecture Details
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab-editor-btn" data-bs-toggle="pill" data-bs-target="#tab-editor-pane" type="button" role="tab" aria-controls="tab-editor-pane" aria-selected="false">
                <i class="bi bi-journal-richtext me-1"></i> Lecture Notes (Editor)
            </button>
        </li>
    </ul>
</div>
 
<form id="courseLectureForm" asp-area="Admin" asp-controller="CourseLectures" asp-action="@actionName" method="post" enctype="multipart/form-data" onsubmit="return Toast.submitModalForm(this, event);">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="CourseSectionId" />

    @if (Model.IsEdit)
    {
        <input type="hidden" asp-for="LectureId" />
    }

    <div class="modal-body p-4 bg-light-subtle">
        <div class="tab-content" id="lectureModalTabsContent">
             
            <div class="tab-pane fade show active" id="tab-details-pane" role="tabpanel" aria-labelledby="tab-details-btn">
                <div class="mb-3">
                    <label asp-for="TopicId" class="form-label text-muted small fw-semibold">Related Topic</label>
                    <select asp-for="TopicId" asp-items="Model.Topics" class="form-select rounded-3 shadow-none">
                        <option value="">-- Select Topic --</option>
                    </select>
                    <span asp-validation-for="TopicId" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Title" class="form-label text-muted small fw-semibold"></label>
                    <input asp-for="Title" class="form-control rounded-3 shadow-none" placeholder="e.g. 1.1 Overview of C# Syntax" required />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>
                 
                <div class="mb-3">
                    <label class="form-label text-muted small fw-semibold">Video Source (URL or Upload File)</label>
                    <div class="input-group mb-2">
                        <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-link-45deg"></i></span>
                        <input asp-for="VideoUrl" id="txtVideoUrl" class="form-control shadow-none border-start-0" placeholder="e.g. YouTube / Vimeo / Direct Video Link" />
 
                       <button type="button" id="btnVideoPreview" class="btn btn-outline-primary border-start-0 d-none" onclick="previewSecureMedia('videos')">
                           <i class="bi bi-eye-fill me-1"></i> Preview Video
                       </button>
                    </div>
                    <div class="d-flex align-items-center my-1 text-muted small">
                        <hr class="flex-grow-1 my-0"><span class="px-2">OR Upload MP4</span><hr class="flex-grow-1 my-0">
                    </div>
                    <input asp-for="VideoFile" type="file" class="form-control rounded-3 shadow-none" accept="video/mp4,video/mkv,video/webm" />
                    <span asp-validation-for="VideoUrl" class="text-danger small"></span>
                </div>
 
                <div class="mb-3">
                    <label class="form-label text-muted small fw-semibold">PDF Attachment (URL or Upload File)</label>
                    <div class="input-group mb-2">
                        <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-file-earmark-pdf"></i></span>
                        <input asp-for="PdfUrl" id="txtPdfUrl" class="form-control shadow-none border-start-0" placeholder="e.g. External PDF Link" />
 
                        <button type="button" id="btnPdfPreview" class="btn btn-outline-danger border-start-0 d-none" onclick="previewSecureMedia('pdfs')">
                            <i class="bi bi-file-earmark-pdf-fill me-1"></i> Preview PDF
                        </button>
                    </div>
                    <div class="d-flex align-items-center my-1 text-muted small">
                        <hr class="flex-grow-1 my-0"><span class="px-2">OR Upload PDF</span><hr class="flex-grow-1 my-0">
                    </div>
                    <input asp-for="PdfFile" type="file" class="form-control rounded-3 shadow-none" accept="application/pdf" />
                    <span asp-validation-for="PdfUrl" class="text-danger small"></span>
                </div>

                <div class="row g-3 mb-2">
                    <div class="col-6">
                        <label asp-for="DurationInMinutes" class="form-label text-muted small fw-semibold"></label>
                        <input asp-for="DurationInMinutes" type="number" class="form-control rounded-3 shadow-none" min="0" />
                        <span asp-validation-for="DurationInMinutes" class="text-danger small"></span>
                    </div>

                    <div class="col-6">
                        <label asp-for="DisplayOrder" class="form-label text-muted small fw-semibold"></label>
                        <input asp-for="DisplayOrder" type="number" class="form-control rounded-3 shadow-none" min="0" required />
                        <span asp-validation-for="DisplayOrder" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row g-3 mt-1">
                    <div class="col-6">
                        <div class="form-check form-switch">
                            <input class="form-check-input shadow-none" type="checkbox" asp-for="IsPreview" id="IsPreviewSwitch" />
                            <label class="form-check-label fw-medium text-dark small" for="IsPreviewSwitch">Free Preview</label>
                        </div>
                    </div>

                    @if (Model.IsEdit)
                    {
                        <div class="col-6">
                            <div class="form-check form-switch">
                                <input class="form-check-input shadow-none" type="checkbox" asp-for="IsActive" id="IsActiveSwitch" />
                                <label class="form-check-label fw-medium text-dark small" for="IsActiveSwitch">Publish Status</label>
                            </div>
                        </div>
                    }
                </div>
            </div>
             
            <div class="tab-pane fade" id="tab-editor-pane" role="tabpanel" aria-labelledby="tab-editor-btn">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="text-muted small fw-semibold">Lecture Notes / Study Material</span>
                    <button type="button" class="btn btn-sm btn-outline-danger border-0 rounded-2" onclick="clearLectureNotesEditor()">
                        <i class="bi bi-eraser-fill me-1"></i> Clear Editor
                    </button>
                </div>

                <div class="form-group mb-0">
                    <textarea asp-for="Notes" id="txtLectureNotes" class="form-control rich-editor-lecture"></textarea>
                    <span asp-validation-for="Notes" class="text-danger small"></span>
                </div>
            </div>

        </div>
    </div>
     
    <div class="modal-footer bg-light border-top px-4 py-3">
        <button type="button" class="btn btn-outline-secondary rounded-2 px-4 fw-medium" data-bs-dismiss="modal">
            <i class="bi bi-x-lg me-1"></i> Close
        </button>
        <button type="submit" class="btn btn-primary rounded-2 px-4 shadow-sm fw-semibold">
            <i class="bi bi-check-lg me-1"></i> Save Lecture
        </button>
    </div>
</form>
 
<link href="https://cdn.jsdelivr.net/npm/summernote@0.8.18/dist/summernote-lite.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/summernote@0.8.18/dist/summernote-lite.min.js"></script>

<script>
    function initLectureNotesEditor() {
        if (typeof $.fn.summernote === "undefined") {
            console.error("Summernote library not loaded.");
            return;
        }

        $('.rich-editor-lecture').summernote({
            height: 320,
            placeholder: 'Add detailed reading notes, theory, code snippets or images here...',
            toolbar: [
                ['style', ['style']],
                ['font', ['bold', 'italic', 'underline', 'strikethrough', 'clear']],
                ['fontname', ['fontname']],
                ['fontsize', ['fontsize']],
                ['color', ['color']],
                ['para', ['ul', 'ol', 'paragraph']],
                ['table', ['table']],
                ['insert', ['link', 'picture', 'video']],
                ['view', ['fullscreen', 'codeview']]
            ],
            callbacks: {
                onImageUpload: function(files) {
                    for (let i = 0; i < files.length; i++) {
                        handleEditorImageUpload(files[i], $(this));
                    }
                }
            }
        });
    }
     
    function handleEditorImageUpload(file, $editor) {
        let reader = new FileReader();
        reader.onload = function(e) {
            $editor.summernote('insertImage', e.target.result);
        };
        reader.readAsDataURL(file);
    }

    function clearLectureNotesEditor() {
        $('#txtLectureNotes').summernote('code', '');
    }
     
    setTimeout(function() {
        initLectureNotesEditor();
    }, 150);
     
    $('button[data-bs-toggle="pill"]').on('shown.bs.tab', function(e) {
        if (e.target.id === 'tab-editor-btn') {
            $('.rich-editor-lecture').summernote('refresh');
        }
    });
     
    $('#courseLectureForm').off('submit').on('submit', function() {
        if ($('#txtLectureNotes').data('summernote')) {
            $('#txtLectureNotes').val($('#txtLectureNotes').summernote('code'));
        }
    }); 
     async function previewSecureMedia(mediaType) {
         var rawPath = mediaType === 'pdfs' ? $('#txtPdfUrl').val().trim() : $('#txtVideoUrl').val().trim();
         if (!rawPath) return;     
         var isExternalUrl = rawPath.startsWith('http://') || rawPath.startsWith('https://');
     
         if (isExternalUrl) {
             window.open(rawPath, '_blank');
             return;
         }     
         var targetUrl = `/Admin/CourseLectures/GetMedia?fileName=${encodeURIComponent(rawPath)}&mediaType=${mediaType}`;
     
         try {
             var response = await fetch(targetUrl, {
                 method: 'GET',
                 headers: { 'X-Requested-With': 'XMLHttpRequest' }
             });
     
             if (!response.ok) {
                 alert('Unable to load the file.');
                 return;
             }
     
             var blob = await response.blob();
             var blobUrl = URL.createObjectURL(blob);
             window.open(blobUrl, '_blank');
     
             setTimeout(function () { URL.revokeObjectURL(blobUrl); }, 60000);
     
         } catch (error) {
             console.error('Error in preview:', error);
         }
     }
      
     $('#txtPdfUrl').on('input change blur', function () {
         if ($(this).val().trim().length > 0) {$('#btnPdfPreview').removeClass('d-none');
         } else {
             $('#btnPdfPreview').addClass('d-none');
         }
     });
     
     $('#txtVideoUrl').on('input change blur', function () {
         if ($(this).val().trim().length > 0) {$('#btnVideoPreview').removeClass('d-none');
         } else {
             $('#btnVideoPreview').addClass('d-none');
         }
     });
</script>