@model Manikalearning.Web.Areas.Admin.ViewModels.CouponViewModel

@{
    bool isEdit = Model != null && Model.CouponId.HasValue && Model.CouponId != Guid.Empty;
    string title = isEdit ? "Edit Coupon" : "Create New Coupon";
    string actionName = isEdit ? "Edit" : "Create";
}

<div class="modal-header border-bottom-0 pb-0">
    <h5 class="modal-title fw-bold text-dark" id="globalModalTitle">@title</h5>
    <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<form asp-area="Admin" asp-controller="Coupons" asp-action="@actionName" method="post" onsubmit="return Toast.submitModalForm(this);">
    @Html.AntiForgeryToken()

    @if (isEdit)
    {
        <input type="hidden" asp-for="CouponId" />
    }

    <div class="modal-body py-3">
        <div class="row g-3 mb-3">
            <div class="col-md-7">
                <label asp-for="CouponCode" class="form-label text-muted small fw-semibold">Coupon Code</label>
                <input asp-for="CouponCode" class="form-control text-uppercase rounded-3 shadow-none" placeholder="e.g. FESTIVE20" required />
                <span asp-validation-for="CouponCode" class="text-danger small"></span>
            </div>

            <div class="col-md-5">
                <label asp-for="DiscountType" class="form-label text-muted small fw-semibold">Discount Type</label>
                <select asp-for="DiscountType" class="form-select rounded-3 shadow-none">
                    <option value="Percentage">Percentage (%)</option>
                    <option value="Fixed">Fixed Amount (₹)</option>
                </select>
                <span asp-validation-for="DiscountType" class="text-danger small"></span>
            </div>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-md-4">
                <label asp-for="DiscountValue" class="form-label text-muted small fw-semibold">Discount Value</label>
                <input asp-for="DiscountValue" type="number" step="0.01" min="0" class="form-control rounded-3 shadow-none" placeholder="e.g. 20" required />
                <span asp-validation-for="DiscountValue" class="text-danger small"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="MinimumAmount" class="form-label text-muted small fw-semibold">Min Order Amount (₹)</label>
                <input asp-for="MinimumAmount" type="number" step="0.01" min="0" class="form-control rounded-3 shadow-none" placeholder="e.g. 499" />
                <span asp-validation-for="MinimumAmount" class="text-danger small"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="MaximumDiscount" class="form-label text-muted small fw-semibold">Max Discount (₹)</label>
                <input asp-for="MaximumDiscount" type="number" step="0.01" min="0" class="form-control rounded-3 shadow-none" placeholder="e.g. 200" />
                <span asp-validation-for="MaximumDiscount" class="text-danger small"></span>
            </div>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-md-4">
                <label asp-for="UsageLimit" class="form-label text-muted small fw-semibold">Usage Limit</label>
                <input asp-for="UsageLimit" type="number" min="1" class="form-control rounded-3 shadow-none" placeholder="e.g. 100 (Optional)" />
                <span asp-validation-for="UsageLimit" class="text-danger small"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="StartDate" class="form-label text-muted small fw-semibold">Start Date</label>
                <input asp-for="StartDate" type="date" class="form-control rounded-3 shadow-none" required />
                <span asp-validation-for="StartDate" class="text-danger small"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="ExpiryDate" class="form-label text-muted small fw-semibold">Expiry Date</label>
                <input asp-for="ExpiryDate" type="date" class="form-control rounded-3 shadow-none" required />
                <span asp-validation-for="ExpiryDate" class="text-danger small"></span>
            </div>
        </div>

        <div class="d-flex align-items-center">
            <div class="form-check form-switch mb-2">
                <input class="form-check-input shadow-none" type="checkbox" asp-for="IsActive" id="IsActiveSwitch" />
                <label class="form-check-label fw-medium text-dark small" for="IsActiveSwitch">Active Status</label>
            </div>
        </div>
    </div>

    <div class="modal-footer border-top-0 pt-0">
        <button type="button" class="btn btn-light rounded-3 px-4" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary-custom px-4 shadow-sm">
            <i class="bi bi-check-lg me-1"></i> Save Changes
        </button>
    </div>
</form>