@using Manikalearning.Application.DTOs
@model List<CouponDto>

@{
    ViewData["Title"] = "Promo Coupons";
    ViewData["HeaderTitle"] = "Coupons"; 
    Layout = "~/Views/Shared/_AdminLayout.cshtml"; 
}

@Html.AntiForgeryToken()

<div class="card border-0 shadow-sm rounded-4 p-4 bg-white"> 
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h5 class="fw-bold text-dark mb-1">Promo Coupons</h5>
            <p class="text-muted small mb-0">Create and manage promotional discount codes and usage limits.</p>
        </div>
        
        <div class="d-flex align-items-center gap-2"> 
            <div class="input-group input-group-sm rounded-3 overflow-hidden border">
                <span class="input-group-text bg-light border-0 text-muted"><i class="bi bi-search"></i></span>
                <input type="text" id="tableSearch" class="form-control bg-light border-0 shadow-none" placeholder="Search coupons..." onkeyup="filterTable()">
            </div>
             
            <button class="btn btn-primary-custom btn-sm text-nowrap rounded-3 px-3 shadow-sm" onclick="Toast.openModal('/Admin/Coupons/CreatePartial', 'modal-lg')">
                <i class="bi bi-plus-lg me-1"></i> Add Coupon
            </button>
        </div>
    </div>
     
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0" id="couponsTable">
            <thead class="table-light rounded-3">
                <tr>
                    <th class="text-muted fw-semibold border-0 py-3 ps-3">Coupon Code</th>
                    <th class="text-muted fw-semibold border-0 py-3">Discount</th>
                    <th class="text-muted fw-semibold border-0 py-3">Usage</th>
                    <th class="text-muted fw-semibold border-0 py-3">Validity</th>
                    <th class="text-muted fw-semibold border-0 py-3">Status</th>
                    <th class="text-muted fw-semibold border-0 py-3 text-end pe-3">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        bool isExpired = DateTime.Today > item.ExpiryDate;
                        <tr>
                            <td class="fw-medium text-dark ps-3">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                                        <i class="bi bi-ticket-perforated fs-6"></i>
                                    </div>
                                    <span class="fw-bold text-primary font-monospace fs-6">@item.CouponCode</span>
                                </div>
                            </td>
                            <td>
                                @if (item.DiscountType == "Percentage")
                                {
                                    <span class="fw-semibold text-dark">@item.DiscountValue% OFF</span>
                                }
                                else
                                {
                                    <span class="fw-semibold text-dark">₹@item.DiscountValue.ToString("N2") OFF</span>
                                }
                                @if (item.MinimumAmount.HasValue)
                                {
                                    <small class="d-block text-muted">Min order: ₹@item.MinimumAmount.Value.ToString("N0")</small>
                                }
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border px-2 py-1">
                                    @item.UsedCount / @(item.UsageLimit.HasValue ? item.UsageLimit.Value.ToString() : "∞")
                                </span>
                            </td>
                            <td>
                                <small class="d-block text-dark fw-medium">@item.StartDate.ToString("dd MMM yyyy") - @item.ExpiryDate.ToString("dd MMM yyyy")</small>
                            </td>
                            <td>
                                @if (isExpired)
                                {
                                    <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-3 py-2 fw-medium">
                                        Expired
                                    </span>
                                }
                                else if (item.IsActive)
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-2 fw-medium">
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill px-3 py-2 fw-medium">
                                        Inactive
                                    </span>
                                }
                            </td>
                            <td class="text-end pe-3">
                                <div class="d-inline-flex gap-1">
                                    <!-- Edit Coupon -->
                                    <button type="button"
                                            class="btn btn-sm btn-light text-primary shadow-none rounded-2"
                                            title="Edit Coupon"
                                            onclick="Toast.openModal('/Admin/Coupons/EditPartial/@item.CouponId', 'modal-lg')">
                                        <i class="bi bi-pencil-square"></i>
                                    </button>

                                    <!-- Delete Coupon -->
                                    <button type="button"
                                            class="btn btn-sm btn-light text-danger shadow-none rounded-2"
                                            title="Delete Coupon"
                                            onclick="confirmDelete('@item.CouponId', '@item.CouponCode')">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                { 
                    <tr>
                        <td colspan="6" class="text-center py-5">
                            <div class="text-muted">
                                <i class="bi bi-ticket-perforated fs-1 d-block mb-2 text-secondary opacity-50"></i>
                                <h6 class="fw-semibold mb-1">No Promo Coupons Found</h6>
                                <p class="small mb-0">Click on "Add Coupon" to create your first promo code.</p>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-body text-center p-4">
                <div class="text-danger mb-3">
                    <i class="bi bi-exclamation-octagon-fill display-5"></i>
                </div>
                <h6 class="fw-bold text-dark mb-2">Delete Coupon?</h6>
                <p class="text-muted small mb-4" id="deleteCouponWarningText">Are you sure you want to delete this coupon?</p>
                
                <div class="d-flex gap-2 justify-content-center">
                    <button type="button" class="btn btn-light rounded-3 px-3 w-50" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" id="confirmDeleteBtn" class="btn btn-danger rounded-3 px-3 w-50">Delete</button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    let selectedDeleteId = null;
    let deleteModalInstance = null;
     
    function confirmDelete(id, couponCode) {
        selectedDeleteId = id;
        document.getElementById('deleteCouponWarningText').innerText = `Are you sure you want to delete coupon "${couponCode}"? This action cannot be undone.`;
        
        const modalEl = document.getElementById('deleteConfirmModal');
        deleteModalInstance = new bootstrap.Modal(modalEl);
        deleteModalInstance.show();
    }
     
    document.getElementById('confirmDeleteBtn').addEventListener('click', function () {
        if (!selectedDeleteId) return;

        deleteModalInstance.hide();
        Toast.showLoader();

        const token = $('input[name="__RequestVerificationToken"]').val();

        $.ajax({
            url: '/Admin/Coupons/Delete/' + selectedDeleteId,
            type: 'POST',
            data: {
                __RequestVerificationToken: token
            },
            success: function (response) {
                Toast.hideLoader();

                if (typeof response === 'object' && response.isSuccess) {
                    Toast.success(response.message || "Coupon deleted successfully.");
                    setTimeout(() => location.reload(), 800);
                } else {
                    const errorMsg = (response && response.message) ? response.message : "Unable to delete coupon.";
                    Toast.error(errorMsg);
                }
            },
            error: function () {
                Toast.hideLoader();
                Toast.error("An error occurred while deleting the coupon.");
            }
        });
    });
     
    function filterTable() {
        const input = document.getElementById("tableSearch");
        const filter = input.value.toLowerCase();
        const table = document.getElementById("couponsTable");
        const trs = table.getElementsByTagName("tr");

        for (let i = 1; i < trs.length; i++) {
            const td = trs[i].getElementsByTagName("td")[0];
            if (td) {
                const textValue = td.textContent || td.innerText;
                trs[i].style.display = textValue.toLowerCase().indexOf(filter) > -1 ? "" : "none";
            }
        }
    }
</script>