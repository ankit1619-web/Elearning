@model Manikalearning.Web.Areas.Admin.ViewModels.ExamViewModel

@{
    bool isEdit = Model.ExamId != Guid.Empty;
    string title = isEdit ? "Edit Exam" : "Create New Exam";
    string actionName = isEdit ? "Edit" : "Create";
}

<div class="modal-header border-bottom-0 pb-0">
    <h5 class="modal-title fw-bold text-dark" id="globalModalTitle">@title</h5>
    <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<form asp-area="Admin" asp-controller="Exams" asp-action="@actionName" method="post" onsubmit="return Toast.submitModalForm(this);">
    @Html.AntiForgeryToken()

    @if (isEdit)
    {
        <input type="hidden" asp-for="ExamId" />
    }

    <div class="modal-body py-3">
        <div class="row g-3 mb-3">
            <div class="col-md-8">
                <label asp-for="ExamName" class="form-label text-muted small fw-semibold">Exam Name</label>
                <input asp-for="ExamName" class="form-control rounded-3 shadow-none" placeholder="e.g. UGC NET Paper 1" required />
                <span asp-validation-for="ExamName" class="text-danger small"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="ExamCode" class="form-label text-muted small fw-semibold">Exam Code</label>
                <input asp-for="ExamCode" class="form-control rounded-3 shadow-none" placeholder="e.g. UGC-NET-P1" required />
                <span asp-validation-for="ExamCode" class="text-danger small"></span>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label text-muted small fw-semibold">Description</label>
            <textarea asp-for="Description" class="form-control rounded-3 shadow-none" rows="3" placeholder="Brief exam details..."></textarea>
            <span asp-validation-for="Description" class="text-danger small"></span>
        </div>

        <div class="row g-3">
            <div class="col-6">
                <label asp-for="DisplayOrder" class="form-label text-muted small fw-semibold">Display Order</label>
                <input asp-for="DisplayOrder" type="number" class="form-control rounded-3 shadow-none" min="1" required />
                <span asp-validation-for="DisplayOrder" class="text-danger small"></span>
            </div>

            <div class="col-6 d-flex align-items-end">
                <div class="form-check form-switch mb-2">
                    <input class="form-check-input shadow-none" type="checkbox" asp-for="IsActive" id="IsActiveSwitch" />
                    <label class="form-check-label fw-medium text-dark small" for="IsActiveSwitch">Active Status</label>
                </div>
            </div>
        </div>
    </div>

    <div class="modal-footer border-top-0 pt-0">
        <button type="button" class="btn btn-light rounded-3 px-4" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary-custom px-4 shadow-sm">
            <i class="bi bi-check-lg me-1"></i> Save Changes
        </button>
    </div>
</form>