@using Manikalearning.Application.DTOs
@model List<ExamDto>

@{
    ViewData["Title"] = "Exams Management";
    ViewData["HeaderTitle"] = "Exams";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@Html.AntiForgeryToken()

<div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h5 class="fw-bold text-dark mb-1">All Exams</h5>
            <p class="text-muted small mb-0">Manage exams, exam codes, display order, and active status.</p>
        </div>

        <div class="d-flex align-items-center gap-2">
            <div class="input-group input-group-sm rounded-3 overflow-hidden border">
                <span class="input-group-text bg-light border-0 text-muted"><i class="bi bi-search"></i></span>
                <input type="text" id="tableSearch" class="form-control bg-light border-0 shadow-none" placeholder="Search exams..." onkeyup="filterTable()">
            </div>

            <button class="btn btn-primary-custom btn-sm text-nowrap rounded-3 px-3 shadow-sm" onclick="Toast.openModal('/Admin/Exams/CreatePartial', 'modal-lg')">
                <i class="bi bi-plus-lg me-1"></i> Add Exam
            </button>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0" id="examsTable">
            <thead class="table-light rounded-3">
                <tr>
                    <th class="text-muted fw-semibold border-0 py-3 ps-3">Exam Name</th>
                    <th class="text-muted fw-semibold border-0 py-3">Code</th>
                    <th class="text-muted fw-semibold border-0 py-3 text-center">Display Order</th>
                    <th class="text-muted fw-semibold border-0 py-3">Status</th>
                    <th class="text-muted fw-semibold border-0 py-3 text-end pe-3">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-medium text-dark ps-3">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                                        <i class="bi bi-mortarboard-fill fs-6"></i>
                                    </div>
                                    <div>
                                        <div class="fw-semibold text-dark">@item.ExamName</div>
                                        @if (!string.IsNullOrEmpty(item.Description))
                                        {
                                            <small class="text-muted d-block text-truncate" style="max-width: 250px;">@item.Description</small>
                                        }
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="badge bg-light text-primary border px-2 py-1">@item.ExamCode</span>
                            </td>
                            <td class="text-center fw-semibold text-dark">
                                <span class="badge bg-light text-dark border">#@item.DisplayOrder</span>
                            </td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-2 fw-medium">
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill px-3 py-2 fw-medium">
                                        Inactive
                                    </span>
                                }
                            </td>
                            <td class="text-end pe-3">
                                <div class="d-inline-flex gap-1"> 
                                    <a href="/Admin/Papers?examId=@item.ExamId"
                                       class="btn btn-sm btn-light text-primary shadow-none rounded-2"
                                       title="Manage Papers">
                                        <i class="bi bi-journal-bookmark me-1"></i>
                                    </a>
                                     
                                    <button type="button"
                                            class="btn btn-sm btn-light text-primary shadow-none rounded-2"
                                            title="Edit Exam"
                                            onclick="Toast.openModal('/Admin/Exams/EditPartial/@item.ExamId', 'modal-lg')">
                                        <i class="bi bi-pencil-square"></i>
                                    </button>
                                     
                                    <button type="button"
                                            class="btn btn-sm btn-light text-danger shadow-none rounded-2"
                                            title="Delete Exam"
                                            onclick="confirmDelete('@item.ExamId', '@item.ExamName')">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center py-5">
                            <div class="text-muted">
                                <i class="bi bi-mortarboard fs-1 d-block mb-2 text-secondary opacity-50"></i>
                                <h6 class="fw-semibold mb-1">No Exams Found</h6>
                                <p class="small mb-0">Click on "Add Exam" to create your first item.</p>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-body text-center p-4">
                <div class="text-danger mb-3">
                    <i class="bi bi-exclamation-octagon-fill display-5"></i>
                </div>
                <h6 class="fw-bold text-dark mb-2">Delete Exam?</h6>
                <p class="text-muted small mb-4" id="deleteExamWarningText">Are you sure you want to delete this exam?</p>

                <div class="d-flex gap-2 justify-content-center">
                    <button type="button" class="btn btn-light rounded-3 px-3 w-50" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" id="confirmDeleteBtn" class="btn btn-danger rounded-3 px-3 w-50">Delete</button>
                </div>
            </div>
        </div>
    </div>
</div> 
 @section Scripts {
     
    <script>
        let selectedDeleteId = null;
        let deleteModalInstance = null;

        function confirmDelete(id, examName) {
            selectedDeleteId = id;
            document.getElementById('deleteExamWarningText').innerText = `Are you sure you want to delete "${examName}"? This action cannot be undone.`;

            const modalEl = document.getElementById('deleteConfirmModal');
            deleteModalInstance = new bootstrap.Modal(modalEl);
            deleteModalInstance.show();
        }

        $('#confirmDeleteBtn').on('click', function() {
            if (!selectedDeleteId) return;

            deleteModalInstance.hide();
            if (typeof Toast !== 'undefined' && Toast.showLoader) Toast.showLoader();

            const token = $('input[name="__RequestVerificationToken"]').val();

            $.ajax({
                url: '/Admin/Exams/Delete/' + selectedDeleteId,
                type: 'POST',
                data: { __RequestVerificationToken: token },
                success: function (response) {
                    if (typeof Toast !== 'undefined' && Toast.hideLoader) Toast.hideLoader();

                    if (response && response.isSuccess) {
                        if (typeof Toast !== 'undefined' && Toast.success) {
                            Toast.success(response.message || "Exam deleted successfully.");
                        }
                        setTimeout(() => location.reload(), 800);
                    } else {
                        const errorMsg = (response && response.message) ? response.message : "Unable to delete exam.";
                        if (typeof Toast !== 'undefined' && Toast.error) Toast.error(errorMsg);
                    }
                },
                error: function () {
                    if (typeof Toast !== 'undefined' && Toast.hideLoader) Toast.hideLoader();
                    if (typeof Toast !== 'undefined' && Toast.error) {
                        Toast.error("An error occurred while deleting the exam.");
                    }
                }
            });
        });

        function filterTable() {
            const input = document.getElementById("tableSearch");
            const filter = input.value.toLowerCase();
            const table = document.getElementById("examsTable");
            const trs = table.getElementsByTagName("tr");

            for (let i = 1; i < trs.length; i++) {
                const nameTd = trs[i].getElementsByTagName("td")[0];
                const codeTd = trs[i].getElementsByTagName("td")[1];

                if (nameTd || codeTd) {
                    const nameText = nameTd ? (nameTd.textContent || nameTd.innerText) : "";
                    const codeText = codeTd ? (codeTd.textContent || codeTd.innerText) : "";

                    if (nameText.toLowerCase().indexOf(filter) > -1 || codeText.toLowerCase().indexOf(filter) > -1) {
                        trs[i].style.display = "";
                    } else {
                        trs[i].style.display = "none";
                    }
                }
            }
        }
    </script>
}