@using Manikalearning.Application.DTOs
@model  BookmarkPagedResultDto

<div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
        <thead class="bg-light text-muted fs-8 text-uppercase">
            <tr>
                <th class="ps-4">Student</th>
                <th>Question</th>
                <th>Bookmarked Date</th>
                <th class="text-end pe-4">Actions</th>
            </tr>
        </thead>
        <tbody class="border-top-0 fs-7">
            @if (Model.Bookmarks != null && Model.Bookmarks.Any())
            {
                foreach (var item in Model.Bookmarks)
                {
                    <tr>
                        <td class="ps-4">
                            <div class="fw-bold text-dark">@item.StudentName</div>
                            <small class="text-muted d-block fs-8">@item.StudentEmail</small>
                        </td>
                        <td>
                            <span class="text-truncate d-inline-block text-dark fw-medium" style="max-width: 400px;">
                                <i class="bi bi-bookmark-fill text-warning me-1"></i> @item.QuestionText
                            </span>
                        </td>
                        <td>
                            <span class="text-dark">@item.SavedAt.ToString("dd MMM yyyy")</span>
                            <small class="text-muted d-block fs-8">@item.SavedAt.ToString("hh:mm tt")</small>
                        </td>
                        <td class="text-end pe-4">
                            <button type="button" class="btn btn-sm btn-light text-primary border-0 me-1 btn-view-details"
                                    data-id="@item.BookmarkId" title="View Details">
                                <i class="bi bi-eye"></i>
                            </button>
                            <button type="button" class="btn btn-sm btn-light text-danger border-0 btn-delete-bookmark"
                                    data-id="@item.BookmarkId" title="Remove Bookmark">
                                <i class="bi bi-trash"></i>
                            </button>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="4" class="text-center py-5 text-muted">
                        <i class="bi bi-bookmark-x fs-1 text-secondary d-block mb-2"></i>
                        No bookmark records found matching your query.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Pagination Footer -->
@if (Model.TotalCount > Model.PageSize)
{
    var totalPages = (int)Math.Ceiling((double)Model.TotalCount / Model.PageSize);
    <div class="d-flex justify-content-between align-items-center p-3 border-top">
        <small class="text-muted">
            Showing Page <strong>@Model.PageIndex</strong> of <strong>@totalPages</strong> (Total @Model.TotalCount entries)
        </small>
        <nav aria-label="Bookmark pagination">
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(Model.PageIndex == 1 ? "disabled" : "")">
                    <a class="page-link pagination-link" href="#" data-page="@(Model.PageIndex - 1)">Previous</a>
                </li>
                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                        <a class="page-link pagination-link" href="#" data-page="@i">@i</a>
                    </li>
                }
                <li class="page-item @(Model.PageIndex == totalPages ? "disabled" : "")">
                    <a class="page-link pagination-link" href="#" data-page="@(Model.PageIndex + 1)">Next</a>
                </li>
            </ul>
        </nav>
    </div>
}