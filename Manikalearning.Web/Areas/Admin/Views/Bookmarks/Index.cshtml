@using Manikalearning.Application.DTOs

@model List<BookmarkDto>

@{
    ViewData["Title"] = "Student Bookmarks Management";
    ViewData["HeaderTitle"] = "Bookmarks";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@Html.AntiForgeryToken()

<div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h5 class="fw-bold text-dark mb-1">Student Bookmarks</h5>
            <p class="text-muted small mb-0">View and manage bookmarked questions saved by students.</p>
        </div>

        <div class="d-flex align-items-center gap-2">
            <div class="input-group input-group-sm rounded-3 overflow-hidden border">
                <span class="input-group-text bg-light border-0 text-muted"><i class="bi bi-search"></i></span>
                <input type="text" id="tableSearch" class="form-control bg-light border-0 shadow-none" placeholder="Search bookmarks..." onkeyup="filterTable()">
            </div>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0" id="bookmarksTable">
            <thead class="table-light rounded-3">
                <tr>
                    <th class="text-muted fw-semibold border-0 py-3 ps-3">Student Name</th>
                    <th class="text-muted fw-semibold border-0 py-3">Bookmarked Question</th>
                    <th class="text-muted fw-semibold border-0 py-3">Saved On</th>
                    <th class="text-muted fw-semibold border-0 py-3 text-end pe-3">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-medium text-dark ps-3">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="rounded-circle bg-warning bg-opacity-10 text-warning d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                                        <i class="bi bi-bookmark-star fs-6"></i>
                                    </div>
                                    <div>
                                        <div class="fw-semibold text-dark">@item.StudentName</div>
                                        <small class="text-muted fs-8">@item.StudentEmail</small>
                                    </div>
                                </div>
                            </td>
                            <td class="fw-medium text-dark">
                                <span class="text-truncate d-inline-block" style="max-width: 380px;" title="@item.QuestionTitle">
                                    @item.QuestionTitle
                                </span>
                            </td>
                            <td>
                                <span class="fw-medium text-dark">@item.CreatedAt.ToString("dd MMM yyyy")</span>
                                <small class="text-muted d-block fs-8">@item.CreatedAt.ToString("hh:mm tt")</small>
                            </td>
                            <td class="text-end pe-3">
                                <div class="d-inline-flex gap-1">
                                    <!-- View Details -->
                                    <button type="button"
                                            class="btn btn-sm btn-light text-primary shadow-none rounded-2"
                                            title="View Details"
                                            onclick="Toast.openModal('/Admin/Bookmarks/Details/@item.BookmarkId', 'modal-md')">
                                        <i class="bi bi-eye"></i>
                                    </button>

                                    <!-- Delete Bookmark -->
                                    <button type="button"
                                            class="btn btn-sm btn-light text-danger shadow-none rounded-2"
                                            title="Delete Bookmark"
                                            onclick="confirmDelete('@item.BookmarkId', '@item.StudentName')">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="text-center py-5">
                            <div class="text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary opacity-50"></i>
                                <h6 class="fw-semibold mb-1">No Bookmarks Found</h6>
                                <p class="small mb-0">There are no saved student bookmarks available.</p>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-body text-center p-4">
                <div class="text-danger mb-3">
                    <i class="bi bi-exclamation-octagon-fill display-5"></i>
                </div>
                <h6 class="fw-bold text-dark mb-2">Delete Bookmark?</h6>
                <p class="text-muted small mb-4" id="deleteBookmarkWarningText">Are you sure you want to delete this bookmark?</p>

                <div class="d-flex gap-2 justify-content-center">
                    <button type="button" class="btn btn-light rounded-3 px-3 w-50" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" id="confirmDeleteBtn" class="btn btn-danger rounded-3 px-3 w-50">Delete</button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    let selectedDeleteId = null;
    let deleteModalInstance = null;

    function confirmDelete(id, studentName) {
        selectedDeleteId = id;
        document.getElementById('deleteBookmarkWarningText').innerText = `Are you sure you want to delete the bookmark for "${studentName}"? This action cannot be undone.`;

        const modalEl = document.getElementById('deleteConfirmModal');
        deleteModalInstance = new bootstrap.Modal(modalEl);
        deleteModalInstance.show();
    }

    document.getElementById('confirmDeleteBtn').addEventListener('click', function() {
        if (!selectedDeleteId) return;

        deleteModalInstance.hide();
        Toast.showLoader();

        const token = $('input[name="__RequestVerificationToken"]').val();

        $.ajax({
            url: '/Admin/Bookmarks/Delete/' + selectedDeleteId,
            type: 'POST',
            data: {
                __RequestVerificationToken: token
            },
            success: function(response) {
                Toast.hideLoader();

                if (typeof response === 'object' && response.isSuccess) {
                    Toast.success(response.message || "Bookmark deleted successfully.");
                    setTimeout(() => location.reload(), 800);
                } else {
                    const errorMsg = (response && response.message) ? response.message : "Unable to delete bookmark.";
                    Toast.error(errorMsg);
                }
            },
            error: function() {
                Toast.hideLoader();
                Toast.error("An error occurred while deleting the bookmark.");
            }
        });
    });

    function filterTable() {
        const input = document.getElementById("tableSearch");
        const filter = input.value.toLowerCase();
        const table = document.getElementById("bookmarksTable");
        const trs = table.getElementsByTagName("tr");

        for (let i = 1; i < trs.length; i++) {
            const tdStudent = trs[i].getElementsByTagName("td")[0];
            const tdQuestion = trs[i].getElementsByTagName("td")[1];

            if (tdStudent || tdQuestion) {
                const studentText = tdStudent ? (tdStudent.textContent || tdStudent.innerText) : "";
                const questionText = tdQuestion ? (tdQuestion.textContent || tdQuestion.innerText) : "";

                if (studentText.toLowerCase().indexOf(filter) > -1 || questionText.toLowerCase().indexOf(filter) > -1) {
                    trs[i].style.display = "";
                } else {
                    trs[i].style.display = "none";
                }
            }
        }
    }
</script>