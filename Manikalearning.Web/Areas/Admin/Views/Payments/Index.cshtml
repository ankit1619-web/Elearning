@model Manikalearning.Web.Areas.Admin.ViewModels.PaymentTransactionListViewModel

@{
    ViewData["Title"] = "Payment Transactions";
    ViewData["HeaderTitle"] = "Transactions";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@Html.AntiForgeryToken()

<div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
    <!-- Header Title & Overview Revenue -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h5 class="fw-bold text-dark mb-1">Payment Transactions</h5>
            <p class="text-muted small mb-0">Track student payments, Razorpay order IDs, and revenue details.</p>
        </div>

        <div class="d-flex align-items-center gap-3 bg-light px-3 py-2 rounded-3 border">
            <div>
                <small class="text-muted d-block lh-1">Total Revenue</small>
                <span class="fw-bold fs-5 text-success">₹@Model.TotalRevenue.ToString("N2")</span>
            </div>
            <i class="bi bi-wallet2 fs-3 text-success opacity-75"></i>
        </div>
    </div>

    <!-- Filters & Search Form -->
    <form method="get" asp-area="Admin" asp-controller="PaymentTransactions" asp-action="Index" class="row g-2 mb-4">
        <div class="col-md-4">
            <div class="input-group input-group-sm rounded-3 overflow-hidden border">
                <span class="input-group-text bg-light border-0 text-muted"><i class="bi bi-search"></i></span>
                <input type="text" name="search" value="@Model.SearchTerm" class="form-control bg-light border-0 shadow-none" placeholder="Search by email, payment ID, or name...">
            </div>
        </div>

        <div class="col-md-2">
            <select name="status" class="form-select form-select-sm rounded-3 shadow-none border">
                <option value="All" selected="@(Model.StatusFilter == "All")">All Statuses</option>
                <option value="Success" selected="@(Model.StatusFilter == "Success")">Success</option>
                <option value="Failed" selected="@(Model.StatusFilter == "Failed")">Failed</option>
                <option value="Pending" selected="@(Model.StatusFilter == "Pending")">Pending</option>
            </select>
        </div>

        <div class="col-md-2">
            <input type="date" name="fromDate" value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm rounded-3 shadow-none border" title="From Date" />
        </div>

        <div class="col-md-2">
            <input type="date" name="toDate" value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm rounded-3 shadow-none border" title="To Date" />
        </div>

        <div class="col-md-2 d-flex gap-1">
            <button type="submit" class="btn btn-primary-custom btn-sm w-100 rounded-3 shadow-sm">
                <i class="bi bi-filter me-1"></i> Filter
            </button>
            <a href="/Admin/Payments" class="btn btn-light btn-sm text-secondary rounded-3" title="Reset Filters">
                <i class="bi bi-arrow-counterclockwise"></i>
            </a>
        </div>
    </form>

    <!-- Table -->
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light rounded-3">
                <tr>
                    <th class="text-muted fw-semibold border-0 py-3 ps-3">Customer</th>
                    <th class="text-muted fw-semibold border-0 py-3">Item Purchased</th>
                    <th class="text-muted fw-semibold border-0 py-3">Razorpay Payment ID</th>
                    <th class="text-muted fw-semibold border-0 py-3">Amount</th>
                    <th class="text-muted fw-semibold border-0 py-3">Status</th>
                    <th class="text-muted fw-semibold border-0 py-3">Date</th>
                    <th class="text-muted fw-semibold border-0 py-3 text-end pe-3">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Transactions != null && Model.Transactions.Any())
                {
                    @foreach (var item in Model.Transactions)
                    {
                        <tr>
                            <td class="ps-3">
                                <div class="fw-semibold text-dark">@item.UserName</div>
                                <small class="text-muted">@item.UserEmail</small>
                            </td>
                            <td>
                                <span class="badge bg-secondary bg-opacity-10 text-secondary mb-1">@item.ItemType</span>
                                <div class="fw-medium text-dark small text-truncate" style="max-width: 180px;">@item.ItemName</div>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.RazorpayPaymentId))
                                {
                                    <span class="font-monospace small text-primary fw-medium">@item.RazorpayPaymentId</span>
                                }
                                else
                                {
                                    <span class="text-muted small">N/A</span>
                                }
                            </td>
                            <td>
                                <span class="fw-bold text-dark">₹@item.FinalAmount.ToString("N2")</span>
                                @if (item.DiscountAmount > 0)
                                {
                                    <small class="d-block text-success fs-8">Save ₹@item.DiscountAmount.ToString("N0")</small>
                                }
                            </td>
                            <td>
                                @if (item.PaymentStatus == "Success")
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-2 fw-medium">Success</span>
                                }
                                else if (item.PaymentStatus == "Failed")
                                {
                                    <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-3 py-2 fw-medium">Failed</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning bg-opacity-10 text-warning rounded-pill px-3 py-2 fw-medium">Pending</span>
                                }
                            </td>
                            <td>
                                <small class="text-muted d-block">@item.PaidAt</small>
                                
                            </td>
                            <td class="text-end pe-3">
                                <button type="button"
                                        class="btn btn-sm btn-light text-primary shadow-none rounded-2"
                                        title="View Transaction Details"
                                        onclick="Toast.openModal('/Admin/Payments/DetailsPartial/@item.TransactionId', 'modal-lg')">
                                    <i class="bi bi-eye me-1"></i> View
                                </button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-5">
                            <div class="text-muted">
                                <i class="bi bi-receipt fs-1 d-block mb-2 text-secondary opacity-50"></i>
                                <h6 class="fw-semibold mb-1">No Transactions Found</h6>
                                <p class="small mb-0">No payment transaction records match your filter criteria.</p>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="d-flex justify-content-between align-items-center pt-4 border-top mt-3">
            <small class="text-muted">Showing @(((Model.PageIndex - 1) * Model.PageSize) + 1) to @Math.Min(Model.PageIndex * Model.PageSize, Model.TotalCount) of @Model.TotalCount transactions</small>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                    <a class="page-link shadow-none" href="/Admin/PaymentTransactions?search=@Model.SearchTerm&status=@Model.StatusFilter&fromDate=@Model.FromDate?.ToString("yyyy-MM-dd")&toDate=@Model.ToDate?.ToString("yyyy-MM-dd")&pageIndex=@(Model.PageIndex - 1)">Previous</a>
                </li>
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                        <a class="page-link shadow-none" href="/Admin/PaymentTransactions?search=@Model.SearchTerm&status=@Model.StatusFilter&fromDate=@Model.FromDate?.ToString("yyyy-MM-dd")&toDate=@Model.ToDate?.ToString("yyyy-MM-dd")&pageIndex=@i">@i</a>
                    </li>
                }
                <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                    <a class="page-link shadow-none" href="/Admin/PaymentTransactions?search=@Model.SearchTerm&status=@Model.StatusFilter&fromDate=@Model.FromDate?.ToString("yyyy-MM-dd")&toDate=@Model.ToDate?.ToString("yyyy-MM-dd")&pageIndex=@(Model.PageIndex + 1)">Next</a>
                </li>
            </ul>
        </div>
    }
</div>