@using Manikalearning.Application.DTOs
@{
    ViewData["Title"] = "Manage Course Exams";
    var courseId = (Guid)ViewBag.CourseId;
    var mappedExams = ViewBag.MappedExams as List<ExamCourseDto> ?? new List<ExamCourseDto>();
    var unmappedExams = ViewBag.UnmappedExams as List<ExamDto> ?? new List<ExamDto>();
}
<div class="container-fluid py-3">
    <!-- Top Header -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h4 class="mb-1 fw-bold text-dark">Manage Course Exams</h4>
            <p class="text-muted small mb-0">Assign or remove exams for this course using click or drag & drop.</p>
        </div>
        <a href="/Admin/Courses" class="btn btn-outline-secondary btn-sm shadow-sm rounded-2">
            <i class="bi bi-arrow-left me-1"></i> Back to Courses
        </a>
    </div> 
    @if (ViewBag.Course != null)
    {
        var course = ViewBag.Course;
        <div class="card border-0 shadow-sm rounded-3 mb-4 bg-white">
            <div class="card-body p-3">
                <div class="row align-items-center g-3">
                    <div class="col-auto">
                        <div class="bg-primary-subtle text-primary rounded-3 p-3 d-flex align-items-center justify-content-center" style="width: 52px; height: 52px;">
                            <i class="bi bi-journal-bookmark fs-3"></i>
                        </div>
                    </div>
                    <div class="col">
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <h5 class="fw-bold mb-0 text-dark">@course.CourseName</h5>
                            <span class="badge @(course.Ispublished ? "bg-success-subtle text-success border border-success-subtle" : "bg-danger-subtle text-danger border border-danger-subtle") rounded-pill px-2 py-1 small">
                                @(course.Ispublished ? "Active" : "Inactive")
                            </span>
                        </div>
                        @* <div class="d-flex flex-wrap gap-4 text-secondary small">
                            <span><i class="bi bi-barcode me-1 text-primary"></i>Code: <strong class="text-dark">@(course.CourseCode ?? "N/A")</strong></span>
                            <span><i class="bi bi-folder me-1 text-primary"></i>Category: <strong class="text-dark">@(course.CategoryName ?? "General")</strong></span>
                            <span><i class="bi bi-currency-rupee me-1 text-primary"></i>Price: <strong class="text-dark">₹@(course.Price?.ToString("N2") ?? "0.00")</strong></span>
                        </div> *@
                    </div>
                </div>
            </div>
        </div>
    }

    <input type="hidden" id="hdnCourseId" value="@courseId" />

    <div class="row g-4">
        <!-- LEFT PANEL: Available Exams -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-light py-3 d-flex justify-content-between align-items-center">
                    <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-journal-plus me-2"></i>Available Exams</h6>
                    <span class="badge bg-secondary rounded-pill" id="cntAvailable">@unmappedExams.Count</span>
                </div>
                <div class="card-body">
                    <input type="text" id="txtSearchAvailable" class="form-control form-control-sm mb-3" placeholder="Search available exams..." />

                    <div class="list-group list-group-flush overflow-auto" id="listAvailableExams" style="max-height: 420px;">
                        @foreach (var exam in unmappedExams)
                        {
                            <div class="list-group-item d-flex justify-content-between align-items-center px-2 py-3 exam-item" data-exam-id="@exam.ExamId">
                                <div class="d-flex align-items-center">
                                    @if (!string.IsNullOrEmpty(exam.ImageUrl))
                                    {
                                        <img src="@exam.ImageUrl" class="rounded me-3" style="width: 40px; height: 40px; object-fit: cover;" />
                                    }
                                    else
                                    {
                                        <div class="bg-primary-subtle text-primary rounded d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                                            <i class="bi bi-file-earmark-text"></i>
                                        </div>
                                    }
                                    <div>
                                        <div class="fw-semibold text-dark search-title">@exam.ExamName</div>
                                        <small class="text-muted">Code: @(exam.ExamCode ?? "N/A")</small>
                                    </div>
                                </div>
                                <button class="btn btn-sm btn-outline-success btn-map" onclick="mapExam('@exam.ExamId', this)">
                                    <i class="bi bi-plus-lg"></i> Map
                                </button>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- RIGHT PANEL: Mapped Exams -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-light py-3 d-flex justify-content-between align-items-center">
                    <h6 class="mb-0 fw-bold text-success"><i class="bi bi-check-circle me-2"></i>Mapped Exams</h6>
                    <span class="badge bg-success rounded-pill" id="cntMapped">@mappedExams.Count</span>
                </div>
                <div class="card-body">
                    <input type="text" id="txtSearchMapped" class="form-control form-control-sm mb-3" placeholder="Search mapped exams..." />

                    <div class="list-group list-group-flush overflow-auto" id="listMappedExams" style="max-height: 420px;">
                        @foreach (var exam in mappedExams)
                        {
                            <div class="list-group-item d-flex justify-content-between align-items-center px-2 py-3 exam-item" data-exam-id="@exam.ExamId">
                                <div class="d-flex align-items-center">
                                    @if (!string.IsNullOrEmpty(exam.ImageUrl))
                                    {
                                        <img src="@exam.ImageUrl" class="rounded me-3" style="width: 40px; height: 40px; object-fit: cover;" />
                                    }
                                    else
                                    {
                                        <div class="bg-success-subtle text-success rounded d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                                            <i class="bi bi-check-lg"></i>
                                        </div>
                                    }
                                    <div>
                                        <div class="fw-semibold text-dark search-title">@exam.ExamName</div>
                                        <small class="text-muted">Code: @(exam.ExamCode ?? "N/A")</small>
                                    </div>
                                </div>
                                <button class="btn btn-sm btn-outline-danger btn-unmap" onclick="unmapExam('@exam.ExamId', this)">
                                    <i class="bi bi-trash"></i> Remove
                                </button>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        const courseId = $('#hdnCourseId').val();

        // MAP EXAM ACTION
        function mapExam(examId, btn) {
            const row = $(btn).closest('.exam-item');

            $.ajax({
                url: '/Admin/CourseExam/MapExam',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ examId: examId, courseId: courseId }),
                success: function (res) {
                    if (res.isSuccess) {
                        row.fadeOut(200, function () {
                            // Transform button from Map to Remove
                            $(this).find('.btn-map')
                                .removeClass('btn-outline-success btn-map')
                                .addClass('btn-outline-danger btn-unmap')
                                .html('<i class="bi bi-trash"></i> Remove')
                                .attr('onclick', `unmapExam('${examId}', this)`);

                            $('#listMappedExams').append($(this));$(this).fadeIn(200);
                            updateCounts();
                        });
                    } else {
                        alert(res.message || 'Failed to map exam.');
                    }
                },
                error: function () {
                    alert('Server error while mapping exam.');
                }
            });
        }

        // UNMAP EXAM ACTION
        function unmapExam(examId, btn) {
            const row = $(btn).closest('.exam-item');

            $.ajax({
                url: '/Admin/CourseExam/UnmapExam',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ examId: examId, courseId: courseId }),
                success: function (res) {
                    if (res.isSuccess) {
                        row.fadeOut(200, function () {
                            // Transform button from Remove to Map
                            $(this).find('.btn-unmap')
                                .removeClass('btn-outline-danger btn-unmap')
                                .addClass('btn-outline-success btn-map')
                                .html('<i class="bi bi-plus-lg"></i> Map')
                                .attr('onclick', `mapExam('${examId}', this)`);

                            $('#listAvailableExams').append($(this));$(this).fadeIn(200);
                            updateCounts();
                        });
                    } else {
                        alert(res.message || 'Failed to unmap exam.');
                    }
                },
                error: function () {
                    alert('Server error while unmapping exam.');
                }
            });
        }

        // UPDATE BADGE COUNTS
        function updateCounts() {
            $('#cntAvailable').text($('#listAvailableExams .exam-item').length);
            $('#cntMapped').text($('#listMappedExams .exam-item').length);
        }

        // LIVE SEARCH FILTER
        $('#txtSearchAvailable').on('keyup', function () {
            const value = $(this).val().toLowerCase();$('#listAvailableExams .exam-item').filter(function () {
                $(this).toggle($(this).find('.search-title').text().toLowerCase().indexOf(value) > -1);
            });
        });

        $('#txtSearchMapped').on('keyup', function () {
            const value = $(this).val().toLowerCase();$('#listMappedExams .exam-item').filter(function () {
                $(this).toggle($(this).find('.search-title').text().toLowerCase().indexOf(value) > -1);
            });
        });
    </script>
}