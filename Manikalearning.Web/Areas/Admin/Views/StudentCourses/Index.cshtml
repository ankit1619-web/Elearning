@model Manikalearning.Web.Areas.Admin.ViewModels.StudentCourseListViewModel

@{
    ViewData["Title"] = "Student Courses";
    ViewData["HeaderTitle"] = "Student Course Management";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@Html.AntiForgeryToken()

<div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
    <!-- Header Title & Action -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h5 class="fw-bold text-dark mb-1">Student Courses</h5>
            <p class="text-muted small mb-0">Manage student course enrollments, start/expiry dates, and access status.</p>
        </div>

        <div class="d-flex align-items-center gap-2">
            <div class="badge bg-success bg-opacity-10 text-success p-2 px-3 rounded-3 text-start border border-success border-opacity-25">
                <small class="d-block text-muted fs-8">Active</small>
                <span class="fw-bold fs-6">@Model.ActiveCount</span>
            </div>
            <div class="badge bg-secondary bg-opacity-10 text-secondary p-2 px-3 rounded-3 text-start border border-secondary border-opacity-25">
                <small class="d-block text-muted fs-8">Inactive</small>
                <span class="fw-bold fs-6">@Model.InactiveCount</span>
            </div>
            @* <button class="btn btn-primary-custom btn-sm text-nowrap rounded-3 px-3 shadow-sm" onclick="Toast.openModal('/Admin/StudentCourses/EnrollPartial', 'modal-md')">
                <i class="bi bi-person-plus me-1"></i> Enroll Student
            </button> *@
        </div>
    </div>
     
    <form method="get" asp-area="Admin" asp-controller="StudentCourses" asp-action="Index" class="row g-2 mb-4">
        <div class="col-md-5">
            <div class="input-group input-group-sm rounded-3 overflow-hidden border">
                <span class="input-group-text bg-light border-0 text-muted"><i class="bi bi-search"></i></span>
                <input type="text" name="search" value="@Model.SearchTerm" class="form-control bg-light border-0 shadow-none" placeholder="Search by student or course title...">
            </div>
        </div>

        <div class="col-md-3">
            <select name="courseId" asp-items="Model.CourseFilterOptions" class="form-select form-select-sm rounded-3 shadow-none border">
                <option value="">All Courses</option>
            </select>
        </div>

        <div class="col-md-2">
            <select name="isActive" class="form-select form-select-sm rounded-3 shadow-none border">
                <option value="">All Statuses</option>
                <option value="true" selected="@(Model.IsActiveFilter == true)">Active Only</option>
                <option value="false" selected="@(Model.IsActiveFilter == false)">Inactive Only</option>
            </select>
        </div>

        <div class="col-md-2 d-flex gap-1">
            <button type="submit" class="btn btn-primary-custom btn-sm w-100 rounded-3 shadow-sm">
                <i class="bi bi-filter me-1"></i> Filter
            </button>
            <a href="/Admin/StudentCourses" class="btn btn-light btn-sm text-secondary rounded-3" title="Reset Filters">
                <i class="bi bi-arrow-counterclockwise"></i>
            </a>
        </div>
    </form>

    <!-- Table -->
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light rounded-3">
                <tr>
                    <th class="text-muted fw-semibold border-0 py-3 ps-3">Student</th>
                    <th class="text-muted fw-semibold border-0 py-3">Course</th>
                    <th class="text-muted fw-semibold border-0 py-3">Enrolled At</th>
                    <th class="text-muted fw-semibold border-0 py-3">Expiry Date</th>
                    <th class="text-muted fw-semibold border-0 py-3">Status</th>
                    <th class="text-muted fw-semibold border-0 py-3 text-end pe-3">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Enrollments != null && Model.Enrollments.Any())
                {
                    @foreach (var item in Model.Enrollments)
                    {
                        <tr>
                            <td class="ps-3">
                                <div class="fw-semibold text-dark">@item.UserName</div>
                                <small class="text-muted">@item.UserEmail</small>
                            </td>
                            <td>
                                <div class="fw-semibold text-primary">@item.CourseTitle</div>
                                <small class="text-muted">@item.CategoryName</small>
                            </td>
                            <td>
                                <small class="text-dark fw-medium">@item.EnrolledAt.ToString("dd MMM yyyy")</small>
                            </td>
                            <td>
                                @if (item.ExpiryDate.HasValue)
                                {
                                    <small class="@(item.IsExpired ? "text-danger fw-bold" : "text-dark")">
                                        @item.ExpiryDate.Value.ToString("dd MMM yyyy")
                                    </small>
                                }
                                else
                                {
                                    <small class="text-muted">Lifetime</small>
                                }
                            </td>
                            <td>
                                @if (item.IsExpired)
                                {
                                    <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-2 py-1">Expired</span>
                                }
                                else if (item.IsActive)
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 px-2 py-1">Inactive</span>
                                }
                            </td>
                            <td class="text-end pe-3">
                                <div class="d-inline-flex gap-1">
                                    <button type="button"
                                            class="btn btn-sm btn-light text-primary shadow-none rounded-2"
                                            title="View Details"
                                            onclick="Toast.openModal('/Admin/StudentCourses/DetailsPartial/@item.StudentCourseId', 'modal-md')">
                                        <i class="bi bi-eye"></i>
                                    </button>

                                    <button type="button"
                                            class="btn btn-sm btn-light @(item.IsActive ? "text-warning" : "text-success") shadow-none rounded-2"
                                            title="@(item.IsActive ? "Deactivate Access" : "Activate Access")"
                                            onclick="toggleStatus('@item.StudentCourseId')">
                                        <i class="bi @(item.IsActive ? "bi-pause-circle" : "bi-play-circle")"></i>
                                    </button>

                                    <button type="button"
                                            class="btn btn-sm btn-light text-danger shadow-none rounded-2"
                                            title="Delete Enrollment"
                                            onclick="unenrollStudent('@item.StudentCourseId', '@item.UserName', '@item.CourseTitle')">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center py-5">
                            <div class="text-muted">
                                <i class="bi bi-journal-bookmark fs-1 d-block mb-2 text-secondary opacity-50"></i>
                                <h6 class="fw-semibold mb-1">No Student Courses Found</h6>
                                <p class="small mb-0">No records match your selected filter criteria.</p>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="d-flex justify-content-between align-items-center pt-4 border-top mt-3">
            <small class="text-muted">Showing @(((Model.PageIndex - 1) * Model.PageSize) + 1) to @Math.Min(Model.PageIndex * Model.PageSize, Model.TotalCount) of @Model.TotalCount records</small>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                    <a class="page-link shadow-none" href="/Admin/StudentCourses?search=@Model.SearchTerm&courseId=@Model.CourseIdFilter&isActive=@Model.IsActiveFilter&pageIndex=@(Model.PageIndex - 1)">Previous</a>
                </li>
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                        <a class="page-link shadow-none" href="/Admin/StudentCourses?search=@Model.SearchTerm&courseId=@Model.CourseIdFilter&isActive=@Model.IsActiveFilter&pageIndex=@i">@i</a>
                    </li>
                }
                <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                    <a class="page-link shadow-none" href="/Admin/StudentCourses?search=@Model.SearchTerm&courseId=@Model.CourseIdFilter&isActive=@Model.IsActiveFilter&pageIndex=@(Model.PageIndex + 1)">Next</a>
                </li>
            </ul>
        </div>
    }
</div>

<script>
    function toggleStatus(id) {
        Toast.showLoader();
        const token = $('input[name="__RequestVerificationToken"]').val();

        $.ajax({
            url: '/Admin/StudentCourses/ToggleStatus/' + id,
            type: 'POST',
            data: { __RequestVerificationToken: token },
            success: function(response) {
                Toast.hideLoader();
                if (typeof response === 'object' && response.isSuccess) {
                    Toast.success(response.message || "Status updated.");
                    setTimeout(() => location.reload(), 800);
                } else {
                    Toast.error((response && response.message) ? response.message : "Failed to toggle status.");
                }
            },
            error: function() {
                Toast.hideLoader();
                Toast.error("An error occurred while updating status.");
            }
        });
    }

    function unenrollStudent(id, studentName, courseTitle) {
        if (!confirm(`Are you sure you want to delete enrollment for "${studentName}" in "${courseTitle}"?`)) return;

        Toast.showLoader();
        const token = $('input[name="__RequestVerificationToken"]').val();

        $.ajax({
            url: '/Admin/StudentCourses/Unenroll/' + id,
            type: 'POST',
            data: { __RequestVerificationToken: token },
            success: function(response) {
                Toast.hideLoader();
                if (typeof response === 'object' && response.isSuccess) {
                    Toast.success(response.message || "Record deleted successfully.");
                    setTimeout(() => location.reload(), 800);
                } else {
                    Toast.error((response && response.message) ? response.message : "Failed to delete enrollment.");
                }
            },
            error: function() {
                Toast.hideLoader();
                Toast.error("An error occurred while deleting enrollment.");
            }
        });
    }
</script>