@using Manikalearning.Application.DTOs
@model  StudentCourseDto

<div class="modal-header border-bottom-0 pb-0">
    <div>
        <h5 class="modal-title fw-bold text-dark" id="globalModalTitle">Student Course Record</h5>
        <small class="text-muted font-monospace">ID: @Model.StudentCourseId</small>
    </div>
    <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<div class="modal-body py-3">
    <!-- Status Banner -->
    <div class="p-3 rounded-3 mb-4 bg-light border d-flex justify-content-between align-items-center">
        <div>
            <span class="d-block fw-bold text-dark small">Access Status</span>
            <span class="small text-muted">
                @(Model.IsExpired ? "Expired" : (Model.IsActive ? "Active & Accessible" : "Inactive / Restricted"))
            </span>
        </div>
        <div>
            @if (Model.IsExpired)
            {
                <span class="badge bg-danger px-3 py-2">Expired</span>
            }
            else if (Model.IsActive)
            {
                <span class="badge bg-success px-3 py-2">Active</span>
            }
            else
            {
                <span class="badge bg-secondary px-3 py-2">Inactive</span>
            }
        </div>
    </div>

    <!-- Student & Course Information -->
    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <div class="border rounded-3 p-3 h-100">
                <h6 class="text-uppercase text-muted fs-7 fw-bold mb-2">Student Info</h6>
                <div class="fw-bold text-dark">@Model.UserName</div>
                <small class="text-muted d-block">@Model.UserEmail</small>
            </div>
        </div>

        <div class="col-md-6">
            <div class="border rounded-3 p-3 h-100">
                <h6 class="text-uppercase text-muted fs-7 fw-bold mb-2">Course Info</h6>
                <div class="fw-bold text-primary">@Model.CourseTitle</div>
                <small class="badge bg-secondary bg-opacity-10 text-secondary mt-1">@Model.CategoryName</small>
            </div>
        </div>
    </div>

    <!-- Timeline Dates -->
    <ul class="list-group list-group-flush border rounded-3">
        <li class="list-group-item d-flex justify-content-between align-items-center py-2">
            <span class="text-muted small">Enrolled At:</span>
            <strong class="text-dark small">@Model.EnrolledAt.ToString("dd MMMM yyyy, hh:mm tt")</strong>
        </li>
        <li class="list-group-item d-flex justify-content-between align-items-center py-2">
            <span class="text-muted small">Start Date:</span>
            <strong class="text-dark small">
                @(Model.StartDate.HasValue ? Model.StartDate.Value.ToString("dd MMMM yyyy, hh:mm tt") : "Immediate")
            </strong>
        </li>
        <li class="list-group-item d-flex justify-content-between align-items-center py-2">
            <span class="text-muted small">Expiry Date:</span>
            <strong class="small @(Model.IsExpired ? "text-danger" : "text-dark")">
                @(Model.ExpiryDate.HasValue ? Model.ExpiryDate.Value.ToString("dd MMMM yyyy, hh:mm tt") : "Lifetime / No Expiry")
            </strong>
        </li>
    </ul>
</div>

<div class="modal-footer border-top-0 pt-0">
    <button type="button" class="btn btn-light rounded-3 px-4" data-bs-dismiss="modal">Close</button>
</div>