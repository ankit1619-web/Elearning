@using Manikalearning.Application.DTOs
@model List<TopicDto>

@{
    ViewData["Title"] = "Topics Management";
    ViewData["HeaderTitle"] = "Topics";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var selectedSectionId = ViewData["SectionId"] as Guid?;
}

@Html.AntiForgeryToken()

<div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                @if (selectedSectionId.HasValue && selectedSectionId.Value != Guid.Empty)
                {
                    <a href="javascript:history.back()" class="btn btn-sm btn-light rounded-circle shadow-none p-1 text-muted" title="Back">
                        <i class="bi bi-arrow-left fs-5"></i>
                    </a>
                }
                <h5 class="fw-bold text-dark mb-0">Topics</h5>
            </div>
            <p class="text-muted small mb-0 ms-1">Manage exam topics under sections.</p>
        </div>

        <div class="d-flex flex-wrap align-items-center gap-2"> 
            <form id="sectionFilterForm" method="get" asp-area="Admin" asp-controller="Topics" asp-action="Index" class="m-0">
                <select name="sectionId" class="form-select form-select-sm border shadow-none rounded-3" style="min-width: 200px;" onchange="this.form.submit()">
                    <option value="">-- All Sections --</option>
                    @if (ViewBag.SectionsList != null)
                    {
                        foreach (SelectListItem item in ViewBag.SectionsList)
                        {
                            <option value="@item.Value" selected="@item.Selected">@item.Text</option>
                        }
                    }
                </select>
            </form>

            <div class="input-group input-group-sm rounded-3 overflow-hidden border" style="max-width: 220px;">
                <span class="input-group-text bg-light border-0 text-muted"><i class="bi bi-search"></i></span>
                <input type="text" id="tableSearch" class="form-control bg-light border-0 shadow-none" placeholder="Search topics..." onkeyup="filterTable()">
            </div>

            <button class="btn btn-primary-custom btn-sm text-nowrap rounded-3 px-3 shadow-sm"
                    onclick="Toast.openModal('/Admin/Topics/CreatePartial?sectionId=@(selectedSectionId ?? Guid.Empty)', 'modal-lg')">
                <i class="bi bi-plus-lg me-1"></i> Add Topic
            </button>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0" id="topicsTable">
            <thead class="table-light rounded-3">
                <tr>
                    <th class="text-muted fw-semibold border-0 py-3 ps-3">Topic Name</th>
                    <th class="text-muted fw-semibold border-0 py-3">Section</th>
                    <th class="text-muted fw-semibold border-0 py-3 text-center">Display Order</th>
                    <th class="text-muted fw-semibold border-0 py-3">Status</th>
                    <th class="text-muted fw-semibold border-0 py-3 text-end pe-3">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-medium text-dark ps-3">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                                        <i class="bi bi-journal-text fs-6"></i>
                                    </div>
                                    <span class="fw-semibold text-dark">@item.TopicName</span>
                                </div>
                            </td>
                            <td>
                                <span class="badge bg-light text-secondary border fw-normal px-2.5 py-1.5 rounded-2">
                                    <i class="bi bi-diagram-3 me-1"></i>@item.SectionName
                                </span>
                            </td>
                            <td class="text-center fw-semibold text-dark">
                                <span class="badge bg-light text-dark border">#@item.DisplayOrder</span>
                            </td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-2 fw-medium">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill px-3 py-2 fw-medium">Inactive</span>
                                }
                            </td>
                            <td class="text-end pe-3">
                                <div class="d-inline-flex gap-1">
                                    <button type="button" class="btn btn-sm btn-light text-info shadow-none rounded-2"
                                            title="Manage Topic Content" 
                                            onclick="Toast.openModal('/Admin/Topics/ManageContent/@item.TopicId', 'modal-xl')">
                                        <i class="bi bi-journal-richtext"></i>
                                    </button>
                                    <button type="button" class="btn btn-sm btn-light text-primary shadow-none rounded-2"
                                            title="Edit Topic" onclick="Toast.openModal('/Admin/Topics/EditPartial/@item.TopicId', 'modal-lg')">
                                        <i class="bi bi-pencil-square"></i>
                                    </button>

                                    <button type="button" class="btn btn-sm btn-light text-danger shadow-none rounded-2"
                                            title="Delete Topic" onclick="confirmDelete('@item.TopicId', '@item.TopicName')">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center py-5">
                            <div class="text-muted">
                                <i class="bi bi-journal-text fs-1 d-block mb-2 text-secondary opacity-50"></i>
                                <h6 class="fw-semibold mb-1">No Topics Found</h6>
                                <p class="small mb-0">Click "Add Topic" or choose a different section filter.</p>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-body text-center p-4">
                <div class="text-danger mb-3">
                    <i class="bi bi-exclamation-octagon-fill display-5"></i>
                </div>
                <h6 class="fw-bold text-dark mb-2">Delete Topic?</h6>
                <p class="text-muted small mb-4" id="deleteWarningText">Are you sure you want to delete this topic?</p>

                <div class="d-flex gap-2 justify-content-center">
                    <button type="button" class="btn btn-light rounded-3 px-3 w-50" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" id="confirmDeleteBtn" class="btn btn-danger rounded-3 px-3 w-50">Delete</button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    let selectedDeleteId = null;
    let deleteModalInstance = null;

    function confirmDelete(id, topicName) {
        selectedDeleteId = id;
        document.getElementById('deleteWarningText').innerText = `Are you sure you want to delete "${topicName}"? This action cannot be undone.`;

        const modalEl = document.getElementById('deleteConfirmModal');
        deleteModalInstance = new bootstrap.Modal(modalEl);
        deleteModalInstance.show();
    }

    document.getElementById('confirmDeleteBtn').addEventListener('click', function() {
        if (!selectedDeleteId) return;

        deleteModalInstance.hide();
        Toast.showLoader();

        const token = $('input[name="__RequestVerificationToken"]').val();

        $.ajax({
            url: '/Admin/Topics/Delete/' + selectedDeleteId,
            type: 'POST',
            data: {
                __RequestVerificationToken: token
            },
            success: function(response) {
                Toast.hideLoader();

                if (typeof response === 'object' && response.isSuccess) {
                    Toast.success(response.message || "Topic deleted successfully.");
                    setTimeout(() => location.reload(), 800);
                } else {
                    const errorMsg = (response && response.message) ? response.message : "Unable to delete topic.";
                    Toast.error(errorMsg);
                }
            },
            error: function() {
                Toast.hideLoader();
                Toast.error("An error occurred while deleting the topic.");
            }
        });
    });

    function filterTable() {
        const input = document.getElementById("tableSearch");
        const filter = input.value.toLowerCase();
        const table = document.getElementById("topicsTable");
        const trs = table.getElementsByTagName("tr");

        for (let i = 1; i < trs.length; i++) {
            const nameTd = trs[i].getElementsByTagName("td")[0];
            const sectionTd = trs[i].getElementsByTagName("td")[1];

            if (nameTd || sectionTd) {
                const nameText = nameTd ? nameTd.textContent || nameTd.innerText : "";
                const sectionText = sectionTd ? sectionTd.textContent || sectionTd.innerText : "";

                if (nameText.toLowerCase().indexOf(filter) > -1 || sectionText.toLowerCase().indexOf(filter) > -1) {
                    trs[i].style.display = "";
                } else {
                    trs[i].style.display = "none";
                }
            }
        }
    }
</script>