@model TopicContentViewModel

<!-- Custom CSS for Sleek Modal Design -->
<style>
    .modal-header-gradient {
        background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
    }
    .nav-pills-custom .nav-link {
        color: #6c757d;
        border-radius: 8px;
        padding: 8px 20px;
        font-weight: 600;
        transition: all 0.2s ease;
    }
    .nav-pills-custom .nav-link.active {
        background-color: #0d6efd;
        color: #ffffff;
        box-shadow: 0 4px 10px rgba(13, 110, 253, 0.25);
    }
    .note-editor.note-frame {
        border-radius: 10px !important;
        border: 1px solid #dee2e6 !important;
        overflow: hidden;
        box-shadow: 0 2px 6px rgba(0,0,0,0.02);
    }
    .note-toolbar {
        background: #f8f9fa !important;
        border-bottom: 1px solid #e9ecef !important;
    }
</style>

<!-- Modal Header -->
<div class="modal-header modal-header-gradient border-bottom py-3 px-4">
    <div class="d-flex align-items-center">
        <div class="bg-primary text-white rounded-3 p-2 me-3 d-flex align-items-center justify-content-center" style="width: 42px; height: 42px;">
            <i class="bi bi-journal-richtext fs-4"></i>
        </div>
        <div>
            <h5 class="modal-title fw-bold text-dark mb-0">Manage Topic Content</h5>
            <small class="text-muted">Topic: <span class="fw-semibold text-primary">@Model.TopicName</span></small>
        </div>
    </div>
    <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<form id="topicContentForm" asp-action="SaveContent" asp-controller="Topics" asp-area="Admin" method="post" onsubmit="return Toast.submitModalForm(this, event);">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="TopicId" />

    <div class="modal-body p-4 bg-light-subtle">
         
        <div class="alert alert-white border shadow-sm rounded-3 mb-4 p-3 d-flex align-items-start">
            <i class="bi bi-info-circle-fill text-primary fs-5 me-3 mt-1"></i>
            <div class="small text-secondary">
                Add detailed reading passages, theory, or case studies for this topic.
                This content will be displayed in <strong>Reading Mode (Left Pane)</strong> during tests.
                You can copy-paste formatted text and images directly from MS Word.
            </div>
        </div>
         
        <div class="d-flex justify-content-between align-items-center mb-3"> 
            <button type="button" class="btn btn-sm btn-outline-danger border-0 rounded-2" onclick="clearCurrentEditor()">
                <i class="bi bi-eraser-fill me-1"></i> Clear Editor
            </button>
        </div>
         
        <div class="tab-content" id="contentLangTabsContent">
             
            <div class="tab-pane fade show active" id="tab-en-pane" role="tabpanel">
                <div class="form-group mb-0">
                    <textarea asp-for="ContentEn" id="txtContentEn" class="form-control rich-editor-large"></textarea>
                </div>
            </div>   
        </div>
    </div>
     
    <div class="modal-footer bg-light border-top px-4 py-3">
        <button type="button" class="btn btn-outline-secondary rounded-2 px-4 fw-medium" data-bs-dismiss="modal">
            <i class="bi bi-x-lg me-1"></i> Close
        </button>
        <button type="submit" class="btn btn-primary rounded-2 px-4 shadow-sm fw-semibold">
            <i class="bi bi-cloud-arrow-up-fill me-1"></i> Save Topic Content
        </button>
    </div>
</form>
 
<link href="https://cdn.jsdelivr.net/npm/summernote@0.8.18/dist/summernote-lite.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/summernote@0.8.18/dist/summernote-lite.min.js"></script>

<script>
    function initTopicContentEditor() {
        if (typeof $.fn.summernote === "undefined") {
            console.error("Summernote library not loaded.");
            return;
        } 
        $('.rich-editor-large').summernote('destroy');
         
        $('.rich-editor-large').summernote({
            height: 380,
            placeholder: 'Type or paste MS Word reading passage, tables, or images here...',
            toolbar: [
                ['style', ['style']],
                ['font', ['bold', 'italic', 'underline', 'strikethrough', 'clear']],
                ['fontname', ['fontname']],
                ['fontsize', ['fontsize']],
                ['color', ['color']],
                ['para', ['ul', 'ol', 'paragraph']],
                ['table', ['table']],
                ['insert', ['link', 'picture', 'video']],
                ['view', ['fullscreen', 'codeview']]
            ],
            callbacks: {
                onImageUpload: function (files) {
                    for (let i = 0; i < files.length; i++) {
                        handleEditorImageUpload(files[i], $(this));
                    }
                }
            }
        });
    } 
    function handleEditorImageUpload(file, $editor) { 
            let reader = new FileReader();
            reader.onload = function (e) {
                $editor.summernote('insertImage', e.target.result);
            };
            reader.readAsDataURL(file);
   };
      
    function clearCurrentEditor() {
        let activeTab = $('#contentLangTabs .nav-link.active').attr('id');
        if (activeTab === 'tab-en-btn') {
            $('#txtContentEn').summernote('code', '');
        } else {
            $('#txtContentHi').summernote('code', '');
        }
    }
     
    setTimeout(function () {
        initTopicContentEditor();
    }, 150);
     
    $('#topicContentForm').off('submit').on('submit', function () {
        if ($('#txtContentEn').data('summernote')) {
            $('#txtContentEn').val($('#txtContentEn').summernote('code'));
        }
        if ($('#txtContentHi').data('summernote')) {
            $('#txtContentHi').val($('#txtContentHi').summernote('code'));
        }
    });
</script>