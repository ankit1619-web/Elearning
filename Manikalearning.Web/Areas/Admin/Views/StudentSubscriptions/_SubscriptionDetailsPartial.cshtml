@using Manikalearning.Application.DTOs
@model  StudentSubscriptionDto

<div class="modal-header border-bottom-0 pb-0">
    <div>
        <h5 class="modal-title fw-bold text-dark" id="globalModalTitle">Subscription Info</h5>
        <small class="text-muted font-monospace">ID: @Model.SubscriptionId</small>
    </div>
    <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<div class="modal-body py-3"> 
    <div class="p-3 rounded-3 mb-4 d-flex align-items-center justify-content-between @(Model.Status == "Active" ? "bg-success bg-opacity-10 text-success" : Model.Status == "Expired" ? "bg-danger bg-opacity-10 text-danger" : "bg-secondary bg-opacity-10 text-secondary")">
        <div class="d-flex align-items-center gap-2">
            <i class="bi @(Model.Status == "Active" ? "bi-check-circle-fill" : "bi-exclamation-triangle-fill") fs-4"></i>
            <div>
                <h6 class="fw-bold mb-0">Status: @Model.Status</h6>
                <small class="opacity-75">
                    @(Model.Status == "Active" ? $"{Model.DaysRemaining} days remaining" : "Access expired")
                </small>
            </div>
        </div>
        <span class="badge bg-white text-dark shadow-sm px-3 py-2">Plan: @Model.PlanName</span>
    </div>
 
    <div class="mb-3">
        <h6 class="text-uppercase text-muted fs-7 fw-bold mb-2">Student Information</h6>
        <div class="bg-light p-3 rounded-3">
            <div class="row g-2">
                <div class="col-6">
                    <span class="text-muted d-block small">Full Name:</span>
                    <strong class="text-dark">@Model.UserName</strong>
                </div>
                <div class="col-6">
                    <span class="text-muted d-block small">Email Address:</span>
                    <strong class="text-dark">@Model.UserEmail</strong>
                </div>
                <div class="col-6 mt-2">
                    <span class="text-muted d-block small">Phone:</span>
                    <strong class="text-dark">@Model.UserPhone</strong>
                </div>
                <div class="col-6 mt-2">
                    <span class="text-muted d-block small">Payment ID:</span>
                    <small class="text-primary font-monospace">@(Model.PaymentId  == Guid.Empty ? "Manual Grant" : Model.PaymentId)</small>
                </div>
            </div>
        </div>
    </div>
 
    <div>
        <h6 class="text-uppercase text-muted fs-7 fw-bold mb-2">Subscription Period</h6>
        <ul class="list-group list-group-flush rounded-3 border">
            <li class="list-group-item d-flex justify-content-between align-items-center py-2">
                <span class="text-muted">Start Date:</span>
                <strong>@Model.StartDate.ToString("dd MMMM yyyy")</strong>
            </li>
            <li class="list-group-item d-flex justify-content-between align-items-center py-2">
                <span class="text-muted">Expiry Date:</span>
                <strong>@Model.EndDate.ToString("dd MMMM yyyy")</strong>
            </li>
            <li class="list-group-item d-flex justify-content-between align-items-center py-2">
                <span class="text-muted">Price Paid:</span>
                <strong class="text-success">₹@Model.PlanPrice.ToString("N2")</strong>
            </li>
        </ul>
    </div>
</div>

<div class="modal-footer border-top-0 pt-0">
    <button type="button" class="btn btn-light rounded-3 px-4" data-bs-dismiss="modal">Close</button>
</div>