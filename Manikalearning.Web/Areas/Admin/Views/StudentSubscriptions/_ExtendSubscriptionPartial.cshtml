@model Manikalearning.Web.Areas.Admin.ViewModels.ExtendSubscriptionViewModel

<div class="modal-header border-bottom-0 pb-0">
    <h5 class="modal-title fw-bold text-dark" id="globalModalTitle">Extend Subscription</h5>
    <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<form asp-area="Admin" asp-controller="StudentSubscriptions" asp-action="Extend" method="post" onsubmit="return Toast.submitModalForm(this);">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="SubscriptionId" />

    <div class="modal-body py-3">
        <div class="bg-light p-3 rounded-3 mb-3">
            <div class="row g-2 text-sm">
                <div class="col-6">
                    <span class="text-muted d-block small">Student Name:</span>
                    <strong class="text-dark">@Model.StudentName</strong>
                </div>
                <div class="col-6">
                    <span class="text-muted d-block small">Plan:</span>
                    <strong class="text-primary">@Model.PlanName</strong>
                </div>
                <div class="col-12 mt-2">
                    <span class="text-muted d-block small">Current Expiry Date:</span>
                    <strong class="text-dark">@Model.CurrentEndDate.ToString("dd MMMM yyyy")</strong>
                </div>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="AdditionalDays" class="form-label text-muted small fw-semibold">Days to Add</label>
            <input asp-for="AdditionalDays" type="number" min="1" max="365" class="form-control rounded-3 shadow-none" placeholder="e.g. 30" required />
            <span asp-validation-for="AdditionalDays" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Reason" class="form-label text-muted small fw-semibold">Reason for Extension (Optional)</label>
            <textarea asp-for="Reason" rows="2" class="form-control rounded-3 shadow-none" placeholder="e.g. Admin complimentary grant or promo extension"></textarea>
            <span asp-validation-for="Reason" class="text-danger small"></span>
        </div>
    </div>

    <div class="modal-footer border-top-0 pt-0">
        <button type="button" class="btn btn-light rounded-3 px-4" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary-custom px-4 shadow-sm">
            <i class="bi bi-clock-history me-1"></i> Confirm Extension
        </button>
    </div>
</form>