@using Manikalearning.Application.DTOs
@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    ViewData["HeaderTitle"] = "Overview & Analytics";
    Layout = "~/Views/Shared/_AdminLayout.cshtml"; 
}

<div class="row g-4 mb-4"> 
    <!-- Total Students Card -->
    <div class="col-xl-3 col-sm-6">
        <div class="card border-0 shadow-sm rounded-4 h-100 p-3">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px; color: #6366f1 !important; background-color: #eef2ff !important;">
                        <i class="bi bi-people-fill fs-5"></i>
                    </div>
                    <span class="badge bg-success bg-opacity-10 text-success rounded-pill">+@Model.StudentsGrowthPercentage%</span>
                </div>
                <h6 class="text-muted fw-medium mb-1">Total Students</h6>
                <h3 class="fw-bold text-dark mb-0">@Model.TotalStudents.ToString("N0")</h3>
            </div>
        </div>
    </div>
     
    <!-- Monthly Revenue Card -->
    <div class="col-xl-3 col-sm-6">
        <div class="card border-0 shadow-sm rounded-4 h-100 p-3">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div class="bg-success bg-opacity-10 text-success rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="bi bi-currency-rupee fs-5"></i>
                    </div>
                    <span class="badge bg-success bg-opacity-10 text-success rounded-pill">+@Model.RevenueGrowthPercentage%</span>
                </div>
                <h6 class="text-muted fw-medium mb-1">Monthly Revenue</h6>
                <h3 class="fw-bold text-dark mb-0">₹@Model.MonthlyRevenue.ToString("N0")</h3>
            </div>
        </div>
    </div>
     
    <!-- Active Courses Card -->
    <div class="col-xl-3 col-sm-6">
        <div class="card border-0 shadow-sm rounded-4 h-100 p-3">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div class="bg-warning bg-opacity-10 text-warning rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="bi bi-journal-album fs-5"></i>
                    </div>
                    <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill">Active</span>
                </div>
                <h6 class="text-muted fw-medium mb-1">Active Courses</h6>
                <h3 class="fw-bold text-dark mb-0">@Model.ActiveCourses</h3>
            </div>
        </div>
    </div>
     
    <!-- Test Attempts Card -->
    <div class="col-xl-3 col-sm-6">
        <div class="card border-0 shadow-sm rounded-4 h-100 p-3">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div class="bg-danger bg-opacity-10 text-danger rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="bi bi-ui-checks fs-5"></i>
                    </div>
                    <span class="badge bg-success bg-opacity-10 text-success rounded-pill">+@Model.TestAttemptsGrowthPercentage%</span>
                </div>
                <h6 class="text-muted fw-medium mb-1">Test Attempts (This Week)</h6>
                <h3 class="fw-bold text-dark mb-0">@Model.WeeklyTestAttempts.ToString("N0")</h3>
            </div>
        </div>
    </div>
</div>

<div class="row g-4"> 
    <!-- Dynamic Analytics Bar Chart -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h6 class="fw-bold text-dark mb-0">Revenue & Enrollments Analytics</h6>
                <select class="form-select form-select-sm shadow-none w-auto rounded-3">
                    <option value="7" selected>Last 7 Days</option>
                    <option value="30">Last 30 Days</option>
                    <option value="365">This Year</option>
                </select>
            </div>
             
            <div class="chart-container" style="position: relative; height:300px; width:100%"> 
                <div class="d-flex align-items-end justify-content-between h-100 pb-4 px-2" style="background: repeating-linear-gradient(0deg, transparent, transparent 39px, #f1f5f9 40px);">
                    @foreach (var point in Model.WeeklyAnalytics)
                    {
                        <div class="bg-indigo rounded-top position-relative" 
                             style="width: 8%; height: @(point.HeightPercentage)%; background-color: #6366f1; opacity: 0.85;"
                             title="₹@point.Value.ToString("N0")">
                        </div>
                    }
                </div>
                <div class="d-flex justify-content-between text-muted small mt-2">
                    @foreach (var point in Model.WeeklyAnalytics)
                    {
                        <span>@point.Label</span>
                    }
                </div>
            </div>
        </div>
    </div>
     
    <!-- Recent Enrollments List -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h6 class="fw-bold text-dark mb-0">Recent Enrollments</h6>
                <a href="/Admin/Enrollments" class="text-decoration-none small" style="color: #6366f1;">View All</a>
            </div>

            <div class="d-flex flex-column gap-3"> 
                @if (Model.RecentEnrollments.Any())
                {
                    @foreach (var item in Model.RecentEnrollments)
                    {
                        <div class="d-flex align-items-center justify-content-between">
                            <div class="d-flex align-items-center gap-3">
                                <div class="bg-light rounded-circle d-flex align-items-center justify-content-center fw-bold text-secondary text-uppercase" style="width: 40px; height: 40px;">
                                    @(string.IsNullOrEmpty(item.StudentName) ? "U" : item.StudentName[0])
                                </div>
                                <div>
                                    <h6 class="mb-0 fw-semibold fs-6">@item.StudentName</h6>
                                    <small class="text-muted">@item.CourseTitle</small>
                                </div>
                            </div>
                            <span class="badge bg-success bg-opacity-10 text-success rounded-pill">₹@item.AmountPaid.ToString("N0")</span>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center py-4 text-muted small">No recent enrollments found.</div>
                }
            </div>
            
            <button class="btn btn-light w-100 mt-auto rounded-3 shadow-none fw-medium text-muted" onclick="location.reload();">
                <i class="bi bi-arrow-clockwise me-1"></i> Refresh Data
            </button>
        </div>
    </div>
</div>