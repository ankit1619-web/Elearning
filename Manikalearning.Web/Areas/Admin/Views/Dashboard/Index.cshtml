@{
    ViewData["Title"] = "Dashboard";
    ViewData["HeaderTitle"] = "Overview & Analytics";
      Layout = "~/Views/Shared/_AdminLayout.cshtml"; 
}
 
<div class="row g-4 mb-4"> 
    <div class="col-xl-3 col-sm-6">
        <div class="card border-0 shadow-sm rounded-4 h-100 p-3">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px; color: #6366f1 !important; background-color: #eef2ff !important;">
                        <i class="bi bi-people-fill fs-5"></i>
                    </div>
                    <span class="badge bg-success bg-opacity-10 text-success rounded-pill">+12%</span>
                </div>
                <h6 class="text-muted fw-medium mb-1">Total Students</h6>
                <h3 class="fw-bold text-dark mb-0">12,450</h3>
            </div>
        </div>
    </div>
     
    <div class="col-xl-3 col-sm-6">
        <div class="card border-0 shadow-sm rounded-4 h-100 p-3">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div class="bg-success bg-opacity-10 text-success rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="bi bi-currency-rupee fs-5"></i>
                    </div>
                    <span class="badge bg-success bg-opacity-10 text-success rounded-pill">+8.5%</span>
                </div>
                <h6 class="text-muted fw-medium mb-1">Monthly Revenue</h6>
                <h3 class="fw-bold text-dark mb-0">₹4.2L</h3>
            </div>
        </div>
    </div>
     
    <div class="col-xl-3 col-sm-6">
        <div class="card border-0 shadow-sm rounded-4 h-100 p-3">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div class="bg-warning bg-opacity-10 text-warning rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="bi bi-journal-album fs-5"></i>
                    </div>
                    <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill">Stable</span>
                </div>
                <h6 class="text-muted fw-medium mb-1">Active Courses</h6>
                <h3 class="fw-bold text-dark mb-0">24</h3>
            </div>
        </div>
    </div>
     
    <div class="col-xl-3 col-sm-6">
        <div class="card border-0 shadow-sm rounded-4 h-100 p-3">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div class="bg-danger bg-opacity-10 text-danger rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="bi bi-ui-checks fs-5"></i>
                    </div>
                    <span class="badge bg-success bg-opacity-10 text-success rounded-pill">+24%</span>
                </div>
                <h6 class="text-muted fw-medium mb-1">Test Attempts (This Week)</h6>
                <h3 class="fw-bold text-dark mb-0">1,890</h3>
            </div>
        </div>
    </div>
</div>

<div class="row g-4"> 
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h6 class="fw-bold text-dark mb-0">Revenue & Enrollments Analytics</h6>
                <select class="form-select form-select-sm shadow-none w-auto rounded-3">
                    <option value="7">Last 7 Days</option>
                    <option value="30" selected>Last 30 Days</option>
                    <option value="365">This Year</option>
                </select>
            </div>
             
            <div class="chart-container" style="position: relative; height:300px; width:100%"> 
                <div class="d-flex align-items-end justify-content-between h-100 pb-4 px-2" style="background: repeating-linear-gradient(0deg, transparent, transparent 39px, #f1f5f9 40px);">
                    <div class="bg-indigo rounded-top" style="width: 8%; height: 40%; background-color: #6366f1; opacity: 0.8;"></div>
                    <div class="bg-indigo rounded-top" style="width: 8%; height: 60%; background-color: #6366f1; opacity: 0.8;"></div>
                    <div class="bg-indigo rounded-top" style="width: 8%; height: 35%; background-color: #6366f1; opacity: 0.8;"></div>
                    <div class="bg-indigo rounded-top" style="width: 8%; height: 80%; background-color: #6366f1; opacity: 0.8;"></div>
                    <div class="bg-indigo rounded-top" style="width: 8%; height: 50%; background-color: #6366f1; opacity: 0.8;"></div>
                    <div class="bg-indigo rounded-top" style="width: 8%; height: 90%; background-color: #6366f1; opacity: 0.8;"></div>
                    <div class="bg-indigo rounded-top" style="width: 8%; height: 75%; background-color: #6366f1; opacity: 0.8;"></div>
                </div>
                <div class="d-flex justify-content-between text-muted small mt-2">
                    <span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span><span>Sun</span>
                </div>
            </div>
        </div>
    </div>
     
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h6 class="fw-bold text-dark mb-0">Recent Enrollments</h6>
                <a href="#" class="text-decoration-none small" style="color: #6366f1;">View All</a>
            </div>

            <div class="d-flex flex-column gap-3"> 
                <div class="d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center gap-3">
                        <div class="bg-light rounded-circle d-flex align-items-center justify-content-center fw-bold text-secondary" style="width: 40px; height: 40px;">
                            A
                        </div>
                        <div>
                            <h6 class="mb-0 fw-semibold fs-6">Amit Kumar</h6>
                            <small class="text-muted">UGC NET Paper 1</small>
                        </div>
                    </div>
                    <span class="badge bg-success bg-opacity-10 text-success rounded-pill">₹1,499</span>
                </div>
                 
                <div class="d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center gap-3">
                        <div class="bg-light rounded-circle d-flex align-items-center justify-content-center fw-bold text-secondary" style="width: 40px; height: 40px;">
                            P
                        </div>
                        <div>
                            <h6 class="mb-0 fw-semibold fs-6">Priya Singh</h6>
                            <small class="text-muted">Mastering Aptitude</small>
                        </div>
                    </div>
                    <span class="badge bg-success bg-opacity-10 text-success rounded-pill">₹999</span>
                </div>
                 
                <div class="d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center gap-3">
                        <div class="bg-light rounded-circle d-flex align-items-center justify-content-center fw-bold text-secondary" style="width: 40px; height: 40px;">
                            R
                        </div>
                        <div>
                            <h6 class="mb-0 fw-semibold fs-6">Rahul Verma</h6>
                            <small class="text-muted">Mock Test Series</small>
                        </div>
                    </div>
                    <span class="badge bg-success bg-opacity-10 text-success rounded-pill">₹499</span>
                </div>
            </div>
            
            <button class="btn btn-light w-100 mt-auto rounded-3 shadow-none fw-medium text-muted" onclick="AdminUI.info('Refreshing latest data...')">
                <i class="bi bi-arrow-clockwise me-1"></i> Refresh Data
            </button>
        </div>
    </div>
</div>