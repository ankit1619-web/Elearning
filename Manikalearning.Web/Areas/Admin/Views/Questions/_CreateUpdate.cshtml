@model Manikalearning.Web.Areas.Admin.ViewModels.QuestionViewModel
@using Manikalearning.Domain.Enums

@{
    bool isEdit = Model.QuestionId != Guid.Empty;
    string title = isEdit ? "Edit Question" : "Create Question";
    string actionName = isEdit ? "Edit" : "Create";
}

<div class="modal-header border-bottom pb-2">
    <h5 class="modal-title fw-bold text-dark">@title</h5>
    <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<form asp-area="Admin" asp-controller="Questions" asp-action="@actionName" method="post" onsubmit="return Toast.submitModalForm(this);">
    @Html.AntiForgeryToken()
    @if (isEdit)
    {
        <input type="hidden" asp-for="QuestionId" />
    }

    <!-- Clean Nav Tabs -->
    <ul class="nav nav-tabs px-3 pt-2 bg-light border-bottom" id="questionTabs" role="tablist">
        <li class="nav-item">
            <button class="nav-link active py-2 small fw-semibold" id="category-tab" data-bs-toggle="tab" data-bs-target="#tabCategory" type="button">
                1. Category & Type
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link py-2 small fw-semibold" id="question-tab" data-bs-toggle="tab" data-bs-target="#tabQuestion" type="button">
                2. Question & Options
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link py-2 small fw-semibold" id="settings-tab" data-bs-toggle="tab" data-bs-target="#tabSettings" type="button">
                3. Settings & Solution
            </button>
        </li>
    </ul>

    <div class="modal-body py-3">
        <div class="tab-content" id="questionTabsContent">

            <!-- TAB 1: CATEGORIZATION -->
            <div class="tab-pane fade show active" id="tabCategory" role="tabpanel">
                <div class="row g-2 mb-2">
                    <div class="col-md-6">
                        <label asp-for="SubjectId" class="form-label small fw-semibold text-muted">Subject *</label>
                        <select asp-for="SubjectId" asp-items="Model.SubjectsList" class="form-select form-select-sm rounded-2 shadow-none" id="ddlSubject" required>
                            <option value="">-- Select Subject --</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="SectionId" class="form-label small fw-semibold text-muted">Section *</label>
                        <select asp-for="SectionId" asp-items="Model.SectionsList" class="form-select form-select-sm rounded-2 shadow-none" id="ddlSection" required>
                            <option value="">-- Select Section --</option>
                        </select>
                    </div>
                </div>

                <div class="row g-2 mb-2">
                    <div class="col-md-6">
                        <label asp-for="TopicId" class="form-label small fw-semibold text-muted">Topic *</label>
                        <select asp-for="TopicId" asp-items="Model.TopicsList" class="form-select form-select-sm rounded-2 shadow-none" id="ddlTopic" required>
                            <option value="">-- Select Topic --</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="SubTopicId" class="form-label small fw-semibold text-muted">SubTopic</label>
                        <select asp-for="SubTopicId" asp-items="Model.SubTopicsList" class="form-select form-select-sm rounded-2 shadow-none" id="ddlSubTopic">
                            <option value="">-- Select SubTopic --</option>
                        </select>
                    </div>
                </div>

                <hr class="my-2 text-muted" />

                <div class="row g-2">
                    <div class="col-md-6">
                        <label asp-for="QuestionType" class="form-label small fw-semibold text-muted">Question Type *</label>
                        <select asp-for="QuestionType" asp-items="Html.GetEnumSelectList<QuestionType>()" class="form-select form-select-sm rounded-2 shadow-none" required></select>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="PassageId" class="form-label small fw-semibold text-muted">Passage (Comprehension)</label>
                        <select asp-for="PassageId" asp-items="Model.PassagesList" class="form-select form-select-sm rounded-2 shadow-none" id="ddlPassage">
                            <option value="">-- None --</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ExamId" class="form-label small fw-semibold text-muted">Exam</label>
                        <select asp-for="ExamId" asp-items="Model.ExamsList" class="form-select form-select-sm rounded-2 shadow-none">
                            <option value="">-- Select Exam --</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="PaperId" class="form-label small fw-semibold text-muted">Paper</label>
                        <select asp-for="PaperId" asp-items="Model.PapersList" class="form-select form-select-sm rounded-2 shadow-none">
                            <option value="">-- Select Paper --</option>
                        </select>
                    </div>
                </div>
            </div>

            <!-- TAB 2: QUESTION & OPTIONS -->
            <div class="tab-pane fade" id="tabQuestion" role="tabpanel">
                <div class="mb-3">
                    <label asp-for="QuestionText" class="form-label small fw-semibold text-muted">Question Text *</label>
                    <textarea asp-for="QuestionText" class="form-control rounded-2 shadow-none" rows="3" placeholder="Enter question text..." required></textarea>
                </div>

                <div class="mb-2">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <label class="form-label small fw-semibold text-muted mb-0">Question Options</label>
                        <small class="text-muted fs-7">Select radio button for correct option</small>
                    </div>

                    <div id="optionsContainer">
                        @for (int i = 0; i < Model.Options.Count; i++)
                        {
                            <div class="input-group input-group-sm mb-2 rounded-2 option-row">
                                <span class="input-group-text bg-light fw-bold text-dark px-3">@Model.Options[i].OptionLabel</span>
                                <input type="hidden" name="Options[@i].OptionId" value="@Model.Options[i].OptionId" />
                                <input type="hidden" name="Options[@i].OptionLabel" value="@Model.Options[i].OptionLabel" />
                                <input type="hidden" name="Options[@i].DisplayOrder" value="@(i + 1)" />

                                <input type="text" name="Options[@i].OptionText" value="@Model.Options[i].OptionText" class="form-control shadow-none" placeholder="Option text" required />

                                <div class="input-group-text bg-light">
                                    <input class="form-check-input mt-0" type="radio" name="CorrectOptionIndex" value="@i" @(Model.Options[i].IsCorrect ? "checked" : "") required />
                                    <span class="ms-1 small text-muted fs-7">Correct</span>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- TAB 3: SETTINGS & SOLUTION -->
            <div class="tab-pane fade" id="tabSettings" role="tabpanel">
                <div class="row g-2 mb-2">
                    <div class="col-md-4">
                        <label asp-for="Difficulty" class="form-label small fw-semibold text-muted">Difficulty</label>
                        <select asp-for="Difficulty" asp-items="Html.GetEnumSelectList<DifficultyLevel>()" class="form-select form-select-sm rounded-2 shadow-none"></select>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Marks" class="form-label small fw-semibold text-muted">Marks *</label>
                        <input asp-for="Marks" type="number" step="0.25" class="form-control form-control-sm rounded-2 shadow-none" required />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="NegativeMarks" class="form-label small fw-semibold text-muted">Negative Marks *</label>
                        <input asp-for="NegativeMarks" type="number" step="0.05" class="form-control form-control-sm rounded-2 shadow-none" required />
                    </div>
                </div>

                <!-- PYQ & Source -->
                <div class="p-2 bg-light rounded-2 mb-2 border">
                    <div class="row align-items-center">
                        <div class="col-md-5">
                            <div class="form-check form-switch">
                                <input class="form-check-input shadow-none" type="checkbox" asp-for="IsPYQ" id="pyqSwitch" onchange="togglePyqFields(this.checked)" />
                                <label class="form-check-label fw-semibold text-dark small" for="pyqSwitch">Is PYQ?</label>
                            </div>
                        </div>
                        <div class="col-md-7">
                            <input asp-for="SourceName" placeholder="Source (e.g. NCERT Class 11)" class="form-control form-control-sm rounded-2 shadow-none" />
                        </div>
                    </div>

                    <div id="pyqFields" class="row g-2 mt-1 @(Model.IsPYQ ? "" : "d-none")">
                        <div class="col-6">
                            <input asp-for="PYQYear" type="number" placeholder="Year e.g. 2024" class="form-control form-control-sm rounded-2 shadow-none" />
                        </div>
                        <div class="col-6">
                            <input asp-for="PYQSession" placeholder="Shift 1 / June" class="form-control form-control-sm rounded-2 shadow-none" />
                        </div>
                    </div>
                </div>

                <!-- Explanations -->
                <div class="mb-2">
                    <label asp-for="ShortExplanation" class="form-label small fw-semibold text-muted">Short Hint</label>
                    <input asp-for="ShortExplanation" class="form-control form-control-sm rounded-2 shadow-none" placeholder="Brief hint..." />
                </div>

                <div class="mb-2">
                    <label asp-for="Explanation" class="form-label small fw-semibold text-muted">Detailed Solution</label>
                    <textarea asp-for="Explanation" class="form-control form-control-sm rounded-2 shadow-none" rows="2" placeholder="Detailed explanation..."></textarea>
                </div>

                <div class="d-flex gap-4 mt-2">
                    <div class="form-check form-switch">
                        <input class="form-check-input shadow-none" type="checkbox" asp-for="IsActive" />
                        <label class="form-check-label small fw-semibold text-dark" asp-for="IsActive">Active</label>
                    </div>
                    <div class="form-check form-switch">
                        <input class="form-check-input shadow-none" type="checkbox" asp-for="IsApproved" />
                        <label class="form-check-label small fw-semibold text-dark" asp-for="IsApproved">Approved</label>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <div class="modal-footer border-top pt-2">
        <button type="button" class="btn btn-sm btn-light rounded-2 px-3" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-sm btn-primary px-4 shadow-sm">
            <i class="bi bi-check-lg me-1"></i> Save Question
        </button>
    </div>
</form>
@section Scripts {

    <script>
        function togglePyqFields(isPyq) {
            if (isPyq) {
                document.getElementById('pyqFields').classList.remove('d-none');
            } else {
                document.getElementById('pyqFields').classList.add('d-none');
            }
        }

                $(document).ready(function () {
                    $('#ddlTopic').change(function () {
                        var topicId = $(this).val();

                        var $subTopic = $('#ddlSubTopic');
                        $subTopic.empty().append('<option value="">-- Select SubTopic --</option>');
                        if (topicId) {
                            $.getJSON('/Admin/Questions/GetSubTopics', { topicId: topicId }, function (data) {
                                $.each(data, function (i, item) {
                                    $subTopic.append($('<option>', { value: item.id, text: item.name }));
                                });
                            });
                        }

                        var $passage = $('#ddlPassage');
                        $passage.empty().append('<option value="">-- None --</option>');
                        if (topicId) {
                            $.getJSON('/Admin/Questions/GetPassages', { topicId: topicId }, function (data) {
                                $.each(data, function (i, item) {
                                    $passage.append($('<option>', { value: item.id, text: item.name }));
                                });
                            });
                        }
                    });
                });
    </script><script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
}