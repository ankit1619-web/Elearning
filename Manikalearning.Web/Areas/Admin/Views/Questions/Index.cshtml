@using Manikalearning.Application.DTOs
@using Manikalearning.Domain.Enums
@model List<QuestionDto>

@{
    ViewData["Title"] = "Question Bank";
    ViewData["HeaderTitle"] = "Questions";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var selectedTopicId = ViewData["TopicId"] as Guid?;
    var selectedSubTopicId = ViewData["SubTopicId"] as Guid?;
}

@Html.AntiForgeryToken()

<div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h5 class="fw-bold text-dark mb-0">Question Bank <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-2.5 py-1">@Model.Count Total</span></h5>
               <p class="text-muted small mb-0">Manage questions, choices, explanations, and PYQs.</p>
        </div>   
        <div class="d-flex align-items-center gap-2">
            <div class="input-group input-group-sm rounded-3 overflow-hidden border">
                <span class="input-group-text bg-light border-0 text-muted"><i class="bi bi-search"></i></span>
                <input type="text" id="tableSearch" class="form-control bg-light border-0 shadow-none" placeholder="Search questions..." onkeyup="filterQuestionsTable()">
            </div>
            
            <button class="btn btn-primary-custom btn-sm text-nowrap rounded-3 px-3 shadow-sm"
                    onclick="Toast.openModal('/Admin/Questions/CreatePartial?topicId=@(selectedTopicId ?? Guid.Empty)&subTopicId=@(selectedSubTopicId ?? Guid.Empty)', 'modal-xl')">
                <i class="bi bi-plus-lg me-1"></i> Add Question
            </button>
        </div>
    </div>  
    <!-- Questions Table -->
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0" id="questionsTable">
            <thead class="table-light rounded-3">
                <tr>
                    <th class="text-muted fw-semibold border-0 py-3 ps-3" style="width: 45%;">Question</th>
                    <th class="text-muted fw-semibold border-0 py-3">Type / Difficulty</th>
                    <th class="text-muted fw-semibold border-0 py-3 text-center">Marks (+/-)</th>
                    <th class="text-muted fw-semibold border-0 py-3">PYQ Info</th>
                    <th class="text-muted fw-semibold border-0 py-3">Status</th>
                    <th class="text-muted fw-semibold border-0 py-3 text-end pe-3">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        
                       
                        <tr>
                            <td class="ps-3">
                                <div class="d-flex flex-column gap-1">
                                    <span class="fw-medium text-dark text-wrap fs-6" style="max-height: 4.5em; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;">
                                        @item.QuestionText
                                    </span>
                                    <div class="d-flex align-items-center gap-2 small text-muted">
                                        <span class="badge bg-light text-secondary border fw-normal px-2 py-0.5">
                                            <i class="bi bi-list-check me-1"></i>@item.Options.Count Options
                                        </span>
                                        @if (!string.IsNullOrEmpty(item.Explanation))
                                        {
                                            <span class="text-success"><i class="bi bi-check-circle-fill me-1"></i>Has Solution</span>
                                        }
                                    </div>
                                </div>
                            </td>

                            <td>
                                <div class="d-flex flex-column gap-1">
                                    @{
                                        var questionTypeName = item.QuestionType switch
                                        {
                                            QuestionType.SingleChoice => "Single Choice",
                                            QuestionType.MultipleChoice => "Multiple Choice",
                                            QuestionType.TrueFalse => "True / False",
                                            QuestionType.AssertionReason => "Assertion & Reason",
                                            QuestionType.MatchFollowing => "Match Following",
                                            QuestionType.StatementBased => "Statement Based",
                                            QuestionType.Chronology => "Chronology",
                                            QuestionType.Comprehension => "Comprehension",
                                            QuestionType.FillBlank => "Fill in Blank",
                                            QuestionType.Numerical => "Numerical",
                                            _ => item.QuestionType.ToString()
                                        };
                                    }
                                        <span class="badge bg-light text-dark border w-auto align-self-start">
                                            @questionTypeName
                                        </span>

                                        @if (item.Difficulty == DifficultyLevel.Easy)
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success fw-medium w-auto align-self-start">Easy</span>
                                        }
                                        else if (item.Difficulty == DifficultyLevel.Medium)
                                        {
                                            <span class="badge bg-warning bg-opacity-10 text-warning fw-medium w-auto align-self-start">Medium</span>
                                        }
                                        else if (item.Difficulty == DifficultyLevel.Hard)
                                        {
                                            <span class="badge bg-danger bg-opacity-10 text-danger fw-medium w-auto align-self-start">Hard</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary bg-opacity-10 text-secondary fw-medium w-auto align-self-start">@item.Difficulty</span>
                                        }
                                </div>
                            </td>

                            <td class="text-center">
                                <span class="fw-bold text-success">+@item.Marks</span> /
                                <span class="fw-semibold text-danger">-@item.NegativeMarks</span>
                            </td>

                            <td>
                                @if (item.IsPYQ)
                                {
                                    <div class="d-flex flex-column">
                                        <span class="badge bg-primary bg-opacity-10 text-primary fw-medium mb-1 w-auto align-self-start">PYQ</span>
                                        <small class="text-muted">@(item.PYQYear?.ToString() ?? "N/A") @(string.IsNullOrEmpty(item.PYQSession) ? "" : $"({item.PYQSession})")</small>
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted small">-</span>
                                }
                            </td>

                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-2.5 py-1 fw-medium">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill px-2.5 py-1 fw-medium">Inactive</span>
                                }
                            </td>

                            <td class="text-end pe-3">
                                <div class="d-inline-flex gap-1">
                                    <button type="button" class="btn btn-sm btn-light text-primary shadow-none rounded-2"
                                            title="Edit Question" onclick="Toast.openModal('/Admin/Questions/EditPartial/@item.QuestionId', 'modal-xl')">
                                        <i class="bi bi-pencil-square"></i>
                                    </button>

                                    <button type="button" class="btn btn-sm btn-light text-danger shadow-none rounded-2"
                                            title="Delete Question" onclick="confirmQuestionDelete('@item.QuestionId')">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center py-5">
                            <div class="text-muted">
                                <i class="bi bi-patch-question fs-1 d-block mb-2 text-secondary opacity-50"></i>
                                <h6 class="fw-semibold mb-1">No Questions Found</h6>
                                <p class="small mb-0">Click "Add Question" to create your first question.</p>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteQuestionModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-body text-center p-4">
                <div class="text-danger mb-3">
                    <i class="bi bi-exclamation-octagon-fill display-5"></i>
                </div>
                <h6 class="fw-bold text-dark mb-2">Delete Question?</h6>
                <p class="text-muted small mb-4">Are you sure you want to delete this question and its options?</p>

                <div class="d-flex gap-2 justify-content-center">
                    <button type="button" class="btn btn-light rounded-3 px-3 w-50" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" id="confirmDeleteQuestionBtn" class="btn btn-danger rounded-3 px-3 w-50">Delete</button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    let activeQuestionDeleteId = null;
    let questionDeleteModal = null;

    function confirmQuestionDelete(id) {
        activeQuestionDeleteId = id;
        const modalEl = document.getElementById('deleteQuestionModal');
        questionDeleteModal = new bootstrap.Modal(modalEl);
        questionDeleteModal.show();
    }

    document.getElementById('confirmDeleteQuestionBtn').addEventListener('click', function() {
        if (!activeQuestionDeleteId) return;

        questionDeleteModal.hide();
        Toast.showLoader();

        const token = $('input[name="__RequestVerificationToken"]').val();

        $.ajax({
            url: '/Admin/Questions/Delete/' + activeQuestionDeleteId,
            type: 'POST',
            data: {
                __RequestVerificationToken: token
            },
            success: function(response) {
                Toast.hideLoader();
                if (typeof response === 'object' && response.isSuccess) {
                    Toast.success(response.message || "Question deleted successfully.");
                    setTimeout(() => location.reload(), 800);
                } else {
                    Toast.error((response && response.message) ? response.message : "Unable to delete question.");
                }
            },
            error: function() {
                Toast.hideLoader();
                Toast.error("An error occurred while deleting the question.");
            }
        });
    });

    function filterQuestionsTable() {
        const input = document.getElementById("tableSearch");
        const filter = input.value.toLowerCase();
        const table = document.getElementById("questionsTable");
        const trs = table.getElementsByTagName("tr");

        for (let i = 1; i < trs.length; i++) {
            const qTd = trs[i].getElementsByTagName("td")[0];
            if (qTd) {
                const text = qTd.textContent || qTd.innerText;
                if (text.toLowerCase().indexOf(filter) > -1) {
                    trs[i].style.display = "";
                } else {
                    trs[i].style.display = "none";
                }
            }
        }
    }
</script>