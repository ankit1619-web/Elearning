@{
    ViewData["Title"] = "Careers";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4"> 
    <div class="page-header-banner">
        <span class="banner-badge">CAREERS</span>
        <h1 class="mb-2">Build the Future of EdTech With Us</h1>
        <p class="mb-0">Join an energetic team working to transform student learning experiences across competitive exams in India.</p>
    </div>

    <h4 class="fw-bold text-dark mb-4">Open Positions</h4>
    <div class="row g-3">
        <div class="col-12">
            <div class="card border-0 shadow-sm p-4 rounded-4 bg-white d-flex flex-row justify-content-between align-items-center flex-wrap gap-3">
                <div>
                    <span class="badge bg-success-subtle text-success mb-2 px-3 py-1.5 rounded-pill fw-bold">Full-Time</span>
                    <h5 class="fw-bold mb-1 text-dark">Subject Matter Expert (SME) - Law / General Studies</h5>
                    <p class="text-muted small mb-0"><i class="bi bi-geo-alt me-1"></i>Jaipur / Remote</p>
                </div>
                <a href="mailto:careers@manikalearning.com?subject=Apply for SME" class="btn rounded-pill px-4 fw-bold shadow-sm" style="border: 1px solid var(--brand-indigo); color: var(--brand-indigo);">Apply Now</a>
            </div>
        </div>

        <div class="col-12">
            <div class="card border-0 shadow-sm p-4 rounded-4 bg-white d-flex flex-row justify-content-between align-items-center flex-wrap gap-3">
                <div>
                    <span class="badge px-3 py-1.5 rounded-pill fw-bold mb-2" style="background: rgba(79, 70, 229, 0.1); color: var(--brand-indigo);">Full-Time</span>
                    <h5 class="fw-bold mb-1 text-dark">Full-Stack .NET Developer</h5>
                    <p class="text-muted small mb-0"><i class="bi bi-geo-alt me-1"></i>Jaipur, Rajasthan</p>
                </div>
                <a href="mailto:careers@manikalearning.com?subject=Apply for .NET Developer" class="btn rounded-pill px-4 fw-bold shadow-sm" style="border: 1px solid var(--brand-indigo); color: var(--brand-indigo);">Apply Now</a>
            </div>
        </div>
    </div>
</div>