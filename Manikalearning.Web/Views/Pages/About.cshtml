@{
    ViewData["Title"] = "About Us";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4"> 
    <div class="page-header-banner">
        <span class="banner-badge">OUR MISSION</span>
        <h1 class="mb-2">Empowering Education Through Innovation</h1>
        <p class="mb-0">Manika Learning is dedicated to providing high-quality, accessible, and structured learning resources for competitive exams and academic success.</p>
    </div>
 
    <div class="row g-4 align-items-center mb-5">
        <div class="col-lg-6">
            <h2 class="fw-bold mb-3 text-dark">Why Choose Manika Learning?</h2>
            <p class="text-secondary leading-relaxed mb-4">
                We bridge the gap between traditional learning and modern technology. With an extensive question bank, interactive practice modules, and real-time performance analytics, we help candidates prepare smarter and achieve higher.
            </p>
            <div class="row g-3">
                <div class="col-sm-6">
                    <div class="p-3.5 bg-white rounded-4 border shadow-sm">
                        <h3 class="fw-bold mb-1" style="color: var(--brand-indigo);">100K+</h3>
                        <p class="text-muted small mb-0 fw-semibold">Active Learners</p>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="p-3.5 bg-white rounded-4 border shadow-sm">
                        <h3 class="fw-bold mb-1" style="color: var(--brand-indigo);">50,000+</h3>
                        <p class="text-muted small mb-0 fw-semibold">PYQs & Practice Qs</p>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="p-4 p-md-5 rounded-4 shadow-lg text-white" style="background-color: var(--brand-dark-banner);">
                <div class="d-inline-flex p-3 rounded-3 mb-3" style="background: rgba(79, 70, 229, 0.2); color: #818cf8;">
                    <i class="bi bi-lightbulb-fill fs-3"></i>
                </div>
                <h4 class="fw-bold mb-3">Our Core Vision</h4>
                <p class="mb-0 text-slate-300 leading-relaxed" style="color: #cbd5e1;">
                    To build India's most trusted, affordable, and personalized learning platform where every student can practice Previous Year Questions (PYQs) and master core concepts with absolute confidence.
                </p>
            </div>
        </div>
    </div>
</div>