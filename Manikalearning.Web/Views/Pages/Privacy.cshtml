@{
    ViewData["Title"] = "Privacy Policy";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4"> 
    <div class="page-header-banner">
        <span class="banner-badge">LEGAL</span>
        <h1 class="mb-2">Privacy Policy</h1>
        <p class="mb-0">Last Updated: October 2026 &middot; Learn how we handle and protect your personal data.</p>
    </div>

    <div class="card border-0 shadow-sm p-4 p-md-5 rounded-4 bg-white text-secondary leading-relaxed space-y-4">
        <h5 class="fw-bold text-dark">1. Information Collection</h5>
        <p>We collect personal information such as your name, email address, and practice test progress when you register or interact with Manika Learning platform.</p>

        <h5 class="fw-bold text-dark">2. Use of Information</h5>
        <p>Your information is used to personalize your practice sessions, manage user authentication, improve app performance, and send essential notifications regarding your account.</p>

        <h5 class="fw-bold text-dark">3. Data Security</h5>
        <p>We implement strict technical safeguards and encryption standards to ensure your account credentials and personal data remain protected.</p>
    </div>
</div>