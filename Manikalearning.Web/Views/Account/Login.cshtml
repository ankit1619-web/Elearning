@model Manikalearning.Application.Features.Commands.Authentication.LoginCommand
@{
    Layout = "_Layout";
    ViewData["Title"] = "Sign In";
    var returnUrl = ViewData["ReturnUrl"] as string;
}

<div class="container py-5">
    <div class="row align-items-center g-5 py-lg-4">
 
        <div class="col-lg-6 col-xl-7 pe-lg-5">
 
            <div class="d-inline-flex align-items-center gap-2 px-3 py-1.5 rounded-pill bg-primary bg-opacity-10 text-primary fw-semibold small mb-4">
                <i class="bi bi-stars"></i> Smart Learning Platform
            </div>
 
            <h1 class="display-5 fw-extrabold text-dark mb-3" style="font-weight: 800; letter-spacing: -0.5px;">
                Master Your Exams with <br />
                <span class="text-primary-gradient">Data-Driven Practice</span>
            </h1>

            <p class="text-muted mb-5 fs-6 col-lg-10 lh-base">
                Join thousands of aspirants using Manika Learning to practice real-exam standard tests, track accuracy, and boost scores effortlessly.
            </p>
 
            <div class="d-flex flex-column gap-3 col-lg-11 mb-5">
 
                <div class="d-flex align-items-start gap-3 p-3 rounded-4 bg-white border border-light shadow-sm">
                    <div class="rounded-3 bg-primary bg-opacity-10 text-primary p-2.5 d-flex align-items-center justify-content-center" style="width: 46px; height: 46px; flex-shrink: 0;">
                        <i class="bi bi-journal-check fs-5"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold text-dark mb-1">Real-Exam Pattern Mocks</h6>
                        <p class="text-muted small mb-0">Updated previous year questions and live mock tests designed by experts.</p>
                    </div>
                </div>
 
                <div class="d-flex align-items-start gap-3 p-3 rounded-4 bg-white border border-light shadow-sm">
                    <div class="rounded-3 bg-success bg-opacity-10 text-success p-2.5 d-flex align-items-center justify-content-center" style="width: 46px; height: 46px; flex-shrink: 0;">
                        <i class="bi bi-graph-up-arrow fs-5"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold text-dark mb-1">Deep Performance Analytics</h6>
                        <p class="text-muted small mb-0">Get instant breakdown of your speed, accuracy, and topic-wise weak spots.</p>
                    </div>
                </div>
 
                <div class="d-flex align-items-start gap-3 p-3 rounded-4 bg-white border border-light shadow-sm">
                    <div class="rounded-3 bg-warning bg-opacity-10 text-warning p-2.5 d-flex align-items-center justify-content-center" style="width: 46px; height: 46px; flex-shrink: 0;">
                        <i class="bi bi-lightning-charge fs-5"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold text-dark mb-1">Adaptive Practice Mode</h6>
                        <p class="text-muted small mb-0">Focus on subject-specific questions and custom test series anytime.</p>
                    </div>
                </div>

            </div>
 
            <div class="d-flex align-items-center gap-3 text-muted small">
                <div class="d-flex align-items-center text-warning">
                    <i class="bi bi-star-fill me-1"></i>
                    <i class="bi bi-star-fill me-1"></i>
                    <i class="bi bi-star-fill me-1"></i>
                    <i class="bi bi-star-fill me-1"></i>
                    <i class="bi bi-star-fill me-2"></i>
                    <span class="text-dark fw-bold me-2">4.9/5</span>
                </div>
                <span class="border-start ps-3 border-secondary border-opacity-25">Trusted by 50,000+ Students</span>
            </div>

        </div>
 
        <div class="col-lg-6 col-xl-5">
            <div class="card auth-card border-0 bg-white p-4 p-sm-5">
                <div class="mb-4">
                    <h3 class="fw-bold text-dark mb-1">Welcome Back 👋</h3>
                    <p class="text-muted small">Sign in to continue your learning journey</p>
                </div>

                <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 mb-3 small" role="alert"></div>

                <form asp-controller="Account" asp-action="Login" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="ReturnUrl" value="@returnUrl" />
 
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label text-dark small fw-semibold">Email Address</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-envelope"></i></span>
                            <input asp-for="Email" type="email" class="form-control bg-light border-start-0 py-2.5 shadow-none" placeholder="name@example.com" required autofocus />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
 
                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <label asp-for="Password" class="form-label text-dark small fw-semibold">Password</label>
                            <a asp-action="ForgotPassword" class="text-decoration-none small fw-semibold text-primary">Forgot?</a>
                        </div>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-lock"></i></span>
                            <input asp-for="Password" type="password" class="form-control bg-light border-start-0 py-2.5 shadow-none" placeholder="••••••••" required />
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>
 
                    <div class="form-check form-switch mb-4">
                        <input class="form-check-input shadow-none" type="checkbox" asp-for="RememberMe" id="rememberMeSwitch" />
                        <label class="form-check-label text-dark small fw-medium" for="rememberMeSwitch">Keep me signed in</label>
                    </div>
 
                    <button type="submit" class="btn btn-brand w-100 py-3 rounded-3 fw-bold mb-3">
                        Sign In <i class="bi bi-arrow-right ms-1"></i>
                    </button>
                </form>

                <div class="text-center mt-3 pt-3 border-top">
                    <p class="text-muted small mb-0">
                        Don't have an account?
                        <a asp-controller="Account" asp-action="Register" class="text-primary fw-bold text-decoration-none">Create One Free</a>
                    </p>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}