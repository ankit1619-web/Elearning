@model Manikalearning.Application.Features.Commands.Authentication.RegisterCommand
@{
    Layout = "_Layout";
    ViewData["Title"] = "Register Account";
}

<div class="container py-5">
    <div class="row align-items-center g-5 py-lg-4">
         
        <div class="col-lg-6 col-xl-7 pe-lg-5">
             
            <div class="d-inline-flex align-items-center gap-2 px-3 py-1.5 rounded-pill bg-primary bg-opacity-10 text-primary fw-semibold small mb-4">
                <i class="bi bi-rocket-takeoff-fill"></i> Start Your Preparation Today
            </div>
             
            <h1 class="display-5 fw-extrabold text-dark mb-3" style="font-weight: 800; letter-spacing: -0.5px;">
                Accelerate Your Career with <br />
                <span class="text-primary-gradient">Smart Exam Prep</span>
            </h1>

            <p class="text-muted mb-5 fs-6 col-lg-10 lh-base">
                Create your free account today and unlock instant access to high-yielding practice tests, detailed solutions, and performance analytics.
            </p>
             
            <div class="d-flex flex-column gap-3 col-lg-11 mb-5">
                 
                <div class="d-flex align-items-start gap-3 p-3 rounded-4 bg-white border border-light shadow-sm">
                    <div class="rounded-3 bg-primary bg-opacity-10 text-primary p-2.5 d-flex align-items-center justify-content-center" style="width: 46px; height: 46px; flex-shrink: 0;">
                        <i class="bi bi-patch-check fs-5"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold text-dark mb-1">Instant Test Access</h6>
                        <p class="text-muted small mb-0">Get immediate access to free mock tests, PYQs, and daily quiz series.</p>
                    </div>
                </div>
                 
                <div class="d-flex align-items-start gap-3 p-3 rounded-4 bg-white border border-light shadow-sm">
                    <div class="rounded-3 bg-success bg-opacity-10 text-success p-2.5 d-flex align-items-center justify-content-center" style="width: 46px; height: 46px; flex-shrink: 0;">
                        <i class="bi bi-pie-chart fs-5"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold text-dark mb-1">Detailed Performance Analytics</h6>
                        <p class="text-muted small mb-0">Track your speed, accuracy, and subject readiness with live reports.</p>
                    </div>
                </div>
                 
                <div class="d-flex align-items-start gap-3 p-3 rounded-4 bg-white border border-light shadow-sm">
                    <div class="rounded-3 bg-info bg-opacity-10 text-info p-2.5 d-flex align-items-center justify-content-center" style="width: 46px; height: 46px; flex-shrink: 0;">
                        <i class="bi bi-phone fs-5"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold text-dark mb-1">Learn Anywhere, Anytime</h6>
                        <p class="text-muted small mb-0">Seamlessly practice on mobile, tablet, or desktop with cloud progress sync.</p>
                    </div>
                </div>

            </div>
             
            <div class="d-flex align-items-center gap-3 text-muted small">
                <div class="d-flex align-items-center text-warning">
                    <i class="bi bi-star-fill me-1"></i>
                    <i class="bi bi-star-fill me-1"></i>
                    <i class="bi bi-star-fill me-1"></i>
                    <i class="bi bi-star-fill me-1"></i>
                    <i class="bi bi-star-fill me-2"></i>
                    <span class="text-dark fw-bold me-2">4.9/5</span>
                </div>
                <span class="border-start ps-3 border-secondary border-opacity-25">Join 50,000+ Active Aspirants</span>
            </div>

        </div> 
        <div class="col-lg-6 col-xl-5">
            <div class="card auth-card border-0 bg-white p-4 p-sm-5">
                <div class="mb-4">
                    <h3 class="fw-bold text-dark mb-1">Create Account 🚀</h3>
                    <p class="text-muted small">Fill in your details to start your preparation</p>
                </div>

                <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 mb-3 small" role="alert"></div>

                <form asp-controller="Account" asp-action="Register" method="post">
                    @Html.AntiForgeryToken()
                     
                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label text-dark small fw-semibold">Full Name</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-person"></i></span>
                            <input asp-for="FullName" class="form-control bg-light border-start-0 py-2.5 shadow-none" placeholder="John Doe" required autofocus />
                        </div>
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>
                     
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label text-dark small fw-semibold">Email Address</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-envelope"></i></span>
                            <input asp-for="Email" type="email" class="form-control bg-light border-start-0 py-2.5 shadow-none" placeholder="name@example.com" required />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                     
                    <div class="mb-3">
                        <label asp-for="Mobile" class="form-label text-dark small fw-semibold">Mobile Number</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-telephone"></i></span>
                            <input asp-for="Mobile" class="form-control bg-light border-start-0 py-2.5 shadow-none" placeholder="10-digit mobile number" required />
                        </div>
                        <span asp-validation-for="Mobile" class="text-danger small"></span>
                    </div>
                     
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label text-dark small fw-semibold">Password</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-lock"></i></span>
                            <input asp-for="Password" type="password" class="form-control bg-light border-start-0 py-2.5 shadow-none" placeholder="••••••••" required />
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>
                     
                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label text-dark small fw-semibold">Confirm Password</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-shield-lock"></i></span>
                            <input asp-for="ConfirmPassword" type="password" class="form-control bg-light border-start-0 py-2.5 shadow-none" placeholder="••••••••" required />
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>
                     
                    <button type="submit" class="btn btn-brand w-100 py-3 rounded-3 fw-bold mb-3">
                        Get Started <i class="bi bi-arrow-right ms-1"></i>
                    </button>
                </form>

                <div class="text-center mt-3 pt-3 border-top">
                    <p class="text-muted small mb-0">
                        Already have an account?
                        <a asp-controller="Account" asp-action="Login" class="text-primary fw-bold text-decoration-none">Sign In Here</a>
                    </p>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}