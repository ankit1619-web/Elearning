@using Manikalearning.Application.Features.Commands.Web
@model PYQTestSessionVM

<div class="container-fluid py-4 bg-light min-vh-100">
    <div class="row g-4"> 
        <div class="col-lg-8" id="questionAreaContainer">
            @if (Model.Questions.Any())
            {
                var firstQ = Model.Questions.First();
                @await Html.PartialAsync("_PYQQuestionCardPartial", firstQ)
            }
        </div> 
        <div class="col-lg-4"> 
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white mb-3 text-center">
                <div class="d-flex justify-content-between align-items-center">
                    <span class="text-muted small fw-bold">TIME REMAINING</span>
                    <span class="badge bg-danger-subtle text-danger px-3 py-2 rounded-pill fw-bold fs-6" id="testTimer">00:59:49</span>
                </div>
            </div> 
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-3">
                <h6 class="fw-bold text-dark mb-3">Question Palette (@Model.Title)</h6>
                <div class="d-flex flex-wrap gap-2 mb-4">
                    @{
                        int qIndex = 1;
                    }
                    @foreach (var q in Model.Questions)
                    {
                        var statusClass = (qIndex == 1) ? "bg-success text-white" : "bg-light text-dark border";
                        <a href="javascript:void(0)" class="palette-btn @statusClass rounded-2 d-flex align-items-center justify-content-center fw-bold text-decoration-none" style="width: 38px; height: 38px; font-size: 0.85rem;" data-question-id="@q.QuestionId">
                            @qIndex
                        </a>
                        qIndex++;
                    }
                </div> 
                <div class="row g-2 pt-3 border-top text-muted" style="font-size: 0.75rem;">
                    <div class="col-6"><span class="rounded-circle bg-secondary d-inline-block me-1" style="width:10px;height:10px;"></span> Not Visited</div>
                    <div class="col-6"><span class="rounded-circle bg-danger d-inline-block me-1" style="width:10px;height:10px;"></span> Not Answered</div>
                    <div class="col-6"><span class="rounded-circle bg-success d-inline-block me-1" style="width:10px;height:10px;"></span> Answered</div>
                    <div class="col-6"><span class="rounded-circle bg-primary d-inline-block me-1" style="width:10px;height:10px;background-color:#4f46e5!important;"></span> Marked Review</div>
                </div>
            </div> 
            <button class="btn btn-success w-100 py-3 rounded-4 fw-bold shadow-sm" style="background-color: #16a34a; border: none;">
                <i class="bi bi-check2-all me-1"></i> Submit Test
            </button>
        </div>
    </div>
</div>