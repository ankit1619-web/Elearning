@model ManikaLearning.Features.Pyq.PyqBankDto
@{
    ViewData["Title"] = "PYQ Bank";
}

@section Styles {
    <style>
        .pyq-hero { padding: 72px 0 36px; background: radial-gradient(800px 320px at 90% -10%, rgba(99,102,241,.13), transparent 60%); }
        .pyq-hero h1 { font-family: 'Outfit', sans-serif; font-weight: 800; letter-spacing: -.02em; font-size: clamp(2rem, 4.5vw, 3rem); margin: 14px 0 10px; }
        .pyq-hero p { color: #5b6475; max-width: 560px; }

        .count-picker { display: inline-flex; background: #fff; border: 1px solid #e3e6f3; border-radius: 12px; padding: 4px; gap: 4px; margin-top: 18px; }
        .count-picker button { border: 0; background: transparent; padding: 7px 16px; border-radius: 9px; font-weight: 600; color: #4b5563; }
        .count-picker button.active { background: #4f46e5; color: #fff; }

        .pyq-tabs { display: flex; gap: 8px; margin: 34px 0 20px; }
        .pyq-tab { border: 1.5px solid #dfe2f3; background: #fff; padding: 9px 20px; border-radius: 999px; font-weight: 600; color: #4b5563; }
        .pyq-tab.active { border-color: #4f46e5; background: #eef0ff; color: #4f46e5; }

        .pyq-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 16px; }
        .pyq-card { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 18px 20px; border-radius: 16px; background: #fff; border: 1px solid #e8eaf3; text-decoration: none; color: #1e1b4b; box-shadow: 0 4px 16px rgba(30,41,90,.05); transition: all .2s ease; }
        .pyq-card:hover { transform: translateY(-3px); border-color: #4f46e5; box-shadow: 0 10px 26px rgba(79,70,229,.14); }
        .pyq-card .name { font-family: 'Outfit', sans-serif; font-weight: 700; font-size: 1.05rem; }
        .pyq-card .meta { font-size: .85rem; color: #6b7280; }
        .pyq-card .go { width: 38px; height: 38px; flex: none; display: grid; place-items: center; border-radius: 50%; background: #eef0ff; color: #4f46e5; }

        .pyq-panel { display: none; }
        .pyq-panel.active { display: block; }
        .pyq-empty { color: #6b7280; padding: 24px 0; }
    </style>
}

<section id="pyq" class="pyq-hero">
    <div class="container">
        <span class="section-badge">PREVIOUS YEAR QUESTIONS</span>
        <h1>PYQ Bank</h1>
        <p>Subject ya year chuno aur turant practice shuru karo. Login ki zaroorat nahi.</p>

        @if (TempData["PyqMessage"] is string msg)
        {
            <div class="alert alert-warning mt-3 mb-0">@msg</div>
        }

        <div class="count-picker" role="group" aria-label="Number of questions">
            <button type="button" data-count="10" class="active">10 Qs</button>
            <button type="button" data-count="20">20 Qs</button>
            <button type="button" data-count="30">30 Qs</button>
        </div>
    </div>
</section>

<section class="pb-5">
    <div class="container">

        <div class="pyq-tabs" role="tablist">
            <button type="button" class="pyq-tab active" data-target="#panel-subjects">Subject wise</button>
            <button type="button" class="pyq-tab" data-target="#panel-years">Year wise</button>
        </div>

        <div id="panel-subjects" class="pyq-panel active">
            @if (Model.Subjects.Count == 0)
            {
                <p class="pyq-empty">Abhi koi subject available nahi hai.</p>
            }
            else
            {
                <div class="pyq-grid">
                    @foreach (var s in Model.Subjects)
                    {
                        <a class="pyq-card" data-base="/pyq-bank/practice?subjectId=@s.SubjectId"
                           href="/pyq-bank/practice?subjectId=@s.SubjectId&count=10">
                            <span>
                                <span class="name d-block">@s.Name</span>
                                <span class="meta">@s.QuestionCount.ToString("N0") questions</span>
                            </span>
                            <span class="go"><i class="bi bi-arrow-right"></i></span>
                        </a>
                    }
                </div>
            }
        </div>

        <div id="panel-years" class="pyq-panel">
            @if (Model.Years.Count == 0)
            {
                <p class="pyq-empty">Abhi koi year available nahi hai.</p>
            }
            else
            {
                <div class="pyq-grid">
                    @foreach (var y in Model.Years)
                    {
                        <a class="pyq-card" data-base="/pyq-bank/practice?year=@y.Year"
                           href="/pyq-bank/practice?year=@y.Year&count=10">
                            <span>
                                <span class="name d-block">@y.Year</span>
                                <span class="meta">@y.QuestionCount.ToString("N0") questions</span>
                            </span>
                            <span class="go"><i class="bi bi-arrow-right"></i></span>
                        </a>
                    }
                </div>
            }
        </div>

    </div>
</section>

@section Scripts {
    <script>
        (function () {
            var count = 10;

            // Tabs
            document.querySelectorAll('.pyq-tab').forEach(function (tab) {
                tab.addEventListener('click', function () {
                    document.querySelectorAll('.pyq-tab').forEach(function (t) { t.classList.remove('active'); });
                    document.querySelectorAll('.pyq-panel').forEach(function (p) { p.classList.remove('active'); });
                    tab.classList.add('active');
                    document.querySelector(tab.getAttribute('data-target')).classList.add('active');
                });
            });

            // Question count: sab card links update
            document.querySelectorAll('.count-picker button').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    document.querySelectorAll('.count-picker button').forEach(function (b) { b.classList.remove('active'); });
                    btn.classList.add('active');
                    count = btn.getAttribute('data-count');
                    document.querySelectorAll('.pyq-card').forEach(function (card) {
                        card.href = card.getAttribute('data-base') + '&count=' + count;
                    });
                });
            });
        })();
    </script>
}
