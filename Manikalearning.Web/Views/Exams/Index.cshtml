@model List<Manikalearning.Web.Models.ExamViewModel>

@{
    ViewData["Title"] = "Competitive Exams";
} 
<section class="page-hero">  
    <div class="hero-glow hero-glow-one"></div>
    <div class="hero-glow hero-glow-two"></div> 
    <div class="container"> 
        <div class="page-hero-content"> 
            <span class="hero-badge">
                <i class="bi bi-mortarboard-fill"></i>
                EXAM PREPARATION
            </span>

            <h1>
                Prepare for Your
                <span>Dream Exam</span>
            </h1>

            <p>
                Explore exam-wise preparation, previous year questions,
                mock tests and study material — all in one place.
            </p>
              
            <div class="hero-search">

                <i class="bi bi-search"></i>

                <input type="text"
                       id="examSearch"
                       autocomplete="off"
                       placeholder="Search exam e.g. SSC CGL, UPSC, Banking..." />

                <span class="search-shortcut">
                    Ctrl K
                </span>

            </div>

        </div>

    </div>

</section> 
<section class="section-padding exams-section">

    <div class="container">
         
        <div class="section-header-row">

            <div>

                <span class="section-label">
                    EXPLORE EXAMS
                </span>

                <h2>
                    Explore Competitive Exams
                </h2>

                <p>
                    Choose your exam and start your preparation journey.
                </p>

            </div>


            <div class="exam-count">

                <div class="count-number">
                    @Model.Count
                </div>

                <div class="count-label">
                    Exams Available
                </div>

            </div>

        </div>
           
        <div class="exam-filter-wrapper">

            <button type="button"
                    class="exam-filter active"
                    data-category="all">

                <i class="bi bi-grid-fill"></i>
                All Exams

            </button>


            <button type="button"
                    class="exam-filter"
                    data-category="government">

                <i class="bi bi-building"></i>
                Government

            </button>


            <button type="button"
                    class="exam-filter"
                    data-category="banking">

                <i class="bi bi-bank"></i>
                Banking

            </button>


            <button type="button"
                    class="exam-filter"
                    data-category="ssc">

                <i class="bi bi-person-badge"></i>
                SSC

            </button>


            <button type="button"
                    class="exam-filter"
                    data-category="railway">

                <i class="bi bi-train-front"></i>
                Railway

            </button>


            <button type="button"
                    class="exam-filter"
                    data-category="state">

                <i class="bi bi-geo-alt"></i>
                State Exams

            </button>

        </div>

          
        <div class="row g-4 mt-4" id="examGrid">

            @if (Model != null && Model.Any())
            {
                foreach (var exam in Model)
                {
                    <div class="col-xl-4 col-lg-4 col-md-6 exam-item"
                         data-name="@exam.Name.ToLower()"
                         data-category="@(exam.CategorySlug?.ToLower() ?? "")">  
                        <div class="exam-card">  
                            <div class="exam-card-header"> 
                                <div class="exam-card-icon"> 
                                        <i class="bi bi-mortarboard-fill"></i> 
                                </div> 
                                <span class="exam-status"> 
                                    <span class="status-dot"></span> 
                                    Active 
                                </span> 
                            </div>  
                            <div class="exam-card-body"> 
                                <div class="exam-title-row"> 
                                    <h3 class="exam-title">
                                        @exam.Name
                                    </h3> 
                                    <i class="bi bi-arrow-up-right card-arrow"></i>  
                                </div> 
                                <p class="exam-description"> 
                                    @(exam.ShortDescription  ?? "Complete preparation material, PYQs and mock tests.") 
                                </p>  
                                <div class="exam-stats">  
                                    <div class="exam-stat">  
                                        <div class="stat-icon">
                                            <i class="bi bi-patch-question-fill"></i>
                                        </div> 
                                        <div class="stat-content"> 
                                            <strong>
                                                @exam.TotalQuestions
                                            </strong> 
                                            <span>
                                                Questions
                                            </span> 
                                        </div> 
                                    </div>  
                                    <div class="exam-stat"> 
                                        <div class="stat-icon">
                                            <i class="bi bi-file-earmark-text-fill"></i>
                                        </div> 
                                        <div class="stat-content"> 
                                            <strong>
                                                @exam.TotalPYQs
                                            </strong> 
                                            <span>
                                                PYQs
                                            </span>  
                                        </div> 
                                    </div> 
                                </div> 
                                <div class="exam-meta"> 
                                    <span> 
                                        <i class="bi bi-ui-checks-grid"></i> 
                                        @exam.TotalTests Tests 
                                    </span> 
                                    <span> 
                                        <i class="bi bi-people-fill"></i> 
                                        @exam.TotalStudents Students 
                                    </span> 
                                </div> 
                            </div>  
                            <div class="exam-card-footer"> 
                                <a asp-controller="Exams"
                                       asp-action="Details"
                                       asp-route-id="@exam.Id"
                                       class="btn-exam"> 
                                    <span>
                                        Explore Exam
                                    </span> 
                                    <i class="bi bi-arrow-right"></i> 
                                </a> 
                            </div> 
                        </div> 
                    </div>
                }
            }
            else
            { 
                <div class="col-12">

                    <div class="no-exams">

                        <div class="no-exams-icon">

                            <i class="bi bi-mortarboard"></i>

                        </div>

                        <h3>
                            No Exams Available
                        </h3>

                        <p>
                            Exams will be available here soon.
                        </p>

                    </div>

                </div>
            }

        </div>
         

        <div id="examEmpty"
             class="empty-state d-none">

            <div class="empty-icon">

                <i class="bi bi-search"></i>

            </div>

            <h3>
                No exam found
            </h3>

            <p>
                We couldn't find an exam matching your search.
                Try another exam name or category.
            </p>

            <button type="button"
                    id="clearSearch"
                    class="clear-search-btn">

                <i class="bi bi-arrow-counterclockwise"></i>

                Clear Search

            </button>

        </div>

    </div>

</section>


<!-- =========================================================
     CTA SECTION
========================================================= -->

<section class="exam-cta">

    <div class="container">

        <div class="exam-cta-card">

            <!-- Background -->

            <div class="cta-bg-circle circle-one"></div>
            <div class="cta-bg-circle circle-two"></div>


            <!-- Content -->

            <div class="cta-content">

                <span class="section-label light">
                    START TODAY
                </span>

                <h2>
                    Your Dream Exam
                    <br />
                    Starts With One Step.
                </h2>

                <p>
                    Practice PYQs, take mock tests and track your
                    preparation with smart analytics.
                </p>


                <div class="cta-buttons">

                    <a asp-controller="PYQ"
                           asp-action="Index"
                           class="btn btn-light cta-primary">

                        <i class="bi bi-file-earmark-text"></i>

                        Practice PYQs

                        <i class="bi bi-arrow-right"></i>

                    </a>


                    <a asp-controller="Tests"
                           asp-action="Index"
                           class="btn btn-outline-light cta-secondary">

                        <i class="bi bi-stopwatch"></i>

                        Explore Mock Tests

                    </a>

                </div>

            </div>


            <!-- Decoration -->

            <div class="cta-decoration">

                <div class="floating-card card-one">

                    <i class="bi bi-check-circle-fill"></i>

                    <div>
                        <strong>500+</strong>
                        <span>Mock Tests</span>
                    </div>

                </div>


                <div class="floating-card card-two">

                    <i class="bi bi-lightning-charge-fill"></i>

                    <div>
                        <strong>Smart</strong>
                        <span>Practice</span>
                    </div>

                </div>


                <div class="cta-main-circle">

                    <div class="circle-inner">

                        <i class="bi bi-trophy-fill"></i>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- =========================================================
     CSS
========================================================= -->

<style>

    /* =========================================================
       PAGE HERO
    ========================================================= */

    .page-hero {
        position: relative;
        min-height: 480px;
        display: flex;
        align-items: center;
        overflow: hidden;
        padding: 120px 0 90px;
        background: radial-gradient( circle at 10% 20%, rgba(124,58,237,.22), transparent 34% ), radial-gradient( circle at 90% 20%, rgba(6,182,212,.16), transparent 32% ), linear-gradient( 135deg, #0f172a 0%, #17134a 50%, #111827 100% );
    }


    /* Decorative glow */

    .hero-glow {
        position: absolute;
        width: 320px;
        height: 320px;
        border-radius: 50%;
        filter: blur(80px);
        opacity: .35;
        pointer-events: none;
    }


    .hero-glow-one {
        left: -150px;
        top: 80px;
        background: #7c3aed;
    }


    .hero-glow-two {
        right: -150px;
        bottom: -100px;
        background: #06b6d4;
    }


    /* Hero content */

    .page-hero-content {
        position: relative;
        z-index: 2;
        max-width: 850px;
        margin: auto;
        text-align: center;
    }


    .hero-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 9px 17px;
        border: 1px solid rgba(255,255,255,.12);
        border-radius: 50px;
        background: rgba(255,255,255,.07);
        color: #c4b5fd;
        font-size: 12px;
        font-weight: 800;
        letter-spacing: .12em;
        backdrop-filter: blur(10px);
    }


    .page-hero h1 {
        margin: 25px 0 18px;
        color: white;
        font-size: clamp(42px,5vw,66px);
        font-weight: 850;
        line-height: 1.08;
        letter-spacing: -1.5px;
    }


        .page-hero h1 span {
            background: linear-gradient( 90deg, #a78bfa, #818cf8, #22d3ee );
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }


    .page-hero p {
        max-width: 680px;
        margin: 0 auto;
        color: #cbd5e1;
        font-size: 17px;
        line-height: 1.75;
    }


    /* =========================================================
       SEARCH
    ========================================================= */

    .hero-search {
        position: relative;
        display: flex;
        align-items: center;
        max-width: 680px;
        height: 66px;
        margin: 32px auto 0;
        padding: 5px 8px 5px 22px;
        background: #ffffff;
        border-radius: 17px;
        box-shadow: 0 25px 60px rgba(0,0,0,.30);
    }


        .hero-search > i {
            color: #6366f1;
            font-size: 20px;
        }


        .hero-search input {
            width: 100%;
            height: 100%;
            border: 0;
            outline: none;
            padding: 0 15px;
            color: #0f172a;
            background: transparent;
            font-size: 14px;
        }


            .hero-search input::placeholder {
                color: #94a3b8;
            }


    .search-shortcut {
        flex-shrink: 0;
        padding: 6px 10px;
        border-radius: 7px;
        background: #f1f5f9;
        color: #64748b;
        font-size: 11px;
        font-weight: 700;
    }


    /* =========================================================
       EXAMS SECTION
    ========================================================= */

    .exams-section {
        background: #f8fafc;
    }


    .section-padding {
        padding: 90px 0;
    }


    .section-header-row {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 30px;
    }


    .section-label {
        display: inline-block;
        color: #6366f1;
        font-size: 12px;
        font-weight: 800;
        letter-spacing: .13em;
    }


    .section-header-row h2 {
        margin: 9px 0 8px;
        color: #0f172a;
        font-size: 38px;
        font-weight: 850;
        letter-spacing: -.7px;
    }


    .section-header-row p {
        margin: 0;
        color: #64748b;
        font-size: 15px;
    }


    /* Count */

    .exam-count {
        min-width: 130px;
        text-align: right;
    }


    .count-number {
        color: #4f46e5;
        font-size: 38px;
        line-height: 1;
        font-weight: 850;
    }


    .count-label {
        margin-top: 6px;
        color: #64748b;
        font-size: 12px;
        font-weight: 600;
    }


    /* =========================================================
       FILTERS
    ========================================================= */

    .exam-filter-wrapper {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 38px;
    }


    .exam-filter {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 11px 18px;
        border: 1px solid #e2e8f0;
        border-radius: 50px;
        background: white;
        color: #475569;
        font-size: 13px;
        font-weight: 650;
        cursor: pointer;
        transition: .25s ease;
    }


        .exam-filter i {
            font-size: 13px;
        }


        .exam-filter:hover {
            border-color: #a5b4fc;
            color: #4f46e5;
            transform: translateY(-2px);
        }


        .exam-filter.active {
            border-color: #4f46e5;
            background: linear-gradient( 135deg, #4f46e5, #7c3aed );
            color: white;
            box-shadow: 0 10px 25px rgba(79,70,229,.20);
        }


    /* =========================================================
       EXAM CARD
    ========================================================= */

    .exam-item {
        transition: .35s ease;
    }


    .exam-card {
        position: relative;
        height: 100%;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        border: 1px solid #e6eaf2;
        border-radius: 24px;
        background: #ffffff;
        box-shadow: 0 8px 28px rgba(15,23,42,.055);
        transition: transform .35s ease, box-shadow .35s ease, border-color .35s ease;
    }


        .exam-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient( 90deg, #4f46e5, #7c3aed, #06b6d4 );
        }


        .exam-card:hover {
            transform: translateY(-9px);
            border-color: #c7d2fe;
            box-shadow: 0 25px 55px rgba(79,70,229,.13);
        }


    /* =========================================================
       CARD HEADER
    ========================================================= */

    .exam-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 25px 25px 0;
    }


    .exam-card-icon {
        width: 62px;
        height: 62px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 18px;
        color: white;
        font-size: 26px;
        background: linear-gradient( 135deg, #4f46e5, #7c3aed );
        box-shadow: 0 10px 25px rgba(79,70,229,.25);
        transition: .35s ease;
    }


    .exam-card:hover .exam-card-icon {
        transform: rotate(-5deg) scale(1.07);
        box-shadow: 0 15px 32px rgba(79,70,229,.30);
    }


    /* Status */

    .exam-status {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 7px 11px;
        border: 1px solid #d1fae5;
        border-radius: 50px;
        background: #ecfdf5;
        color: #059669;
        font-size: 10px;
        font-weight: 800;
    }


    .status-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #10b981;
        box-shadow: 0 0 0 4px rgba(16,185,129,.10);
    }


    /* =========================================================
       CARD BODY
    ========================================================= */

    .exam-card-body {
        flex: 1;
        padding: 22px 25px 20px;
    }


    .exam-title-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
    }


    .exam-title {
        margin: 0;
        color: #0f172a;
        font-size: 23px;
        font-weight: 850;
        line-height: 1.25;
        transition: .25s ease;
    }


    .exam-card:hover .exam-title {
        color: #4f46e5;
    }


    .card-arrow {
        flex-shrink: 0;
        color: #cbd5e1;
        font-size: 17px;
        transition: .25s ease;
    }


    .exam-card:hover .card-arrow {
        color: #6366f1;
        transform: translate(3px,-3px);
    }


    .exam-description {
        min-height: 47px;
        margin: 10px 0 0;
        color: #64748b;
        font-size: 13px;
        line-height: 1.65;
    }


    /* =========================================================
       STATISTICS
    ========================================================= */

    .exam-stats {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 7px;
        margin-top: 21px;
        padding: 11px;
        border: 1px solid #eef0f7;
        border-radius: 17px;
        background: linear-gradient( 135deg, #f8faff, #f7f5ff );
    }


    .exam-stat {
        display: flex;
        align-items: center;
        gap: 8px;
        min-width: 0;
        padding: 7px 3px;
    }


    .stat-icon {
        width: 32px;
        height: 32px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 9px;
        background: #eef2ff;
        color: #4f46e5;
        font-size: 13px;
    }


    .stat-content {
        min-width: 0;
    }


    .exam-stat strong {
        display: block;
        color: #0f172a;
        font-size: 14px;
        font-weight: 850;
        line-height: 1.2;
    }


    .exam-stat span {
        display: block;
        margin-top: 3px;
        color: #94a3b8;
        font-size: 9px;
        font-weight: 650;
    }


    /* =========================================================
       META
    ========================================================= */

    .exam-meta {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        margin-top: 17px;
        padding-top: 15px;
        border-top: 1px solid #f1f5f9;
    }


        .exam-meta span {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            color: #64748b;
            font-size: 11px;
            white-space: nowrap;
        }


        .exam-meta i {
            color: #6366f1;
            font-size: 12px;
        }


    /* =========================================================
       CARD FOOTER
    ========================================================= */

    .exam-card-footer {
        padding: 0 25px 25px;
    }


    .btn-exam {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        width: 100%;
        padding: 13px 18px;
        overflow: hidden;
        border-radius: 13px;
        background: linear-gradient( 135deg, #4f46e5, #7c3aed );
        color: white;
        font-size: 13px;
        font-weight: 750;
        text-decoration: none;
        box-shadow: 0 8px 20px rgba(79,70,229,.20);
        transition: .3s ease;
    }


        .btn-exam::before {
            content: "";
            position: absolute;
            top: 0;
            left: -120%;
            width: 100%;
            height: 100%;
            background: linear-gradient( 90deg, transparent, rgba(255,255,255,.20), transparent );
            transition: .55s ease;
        }


        .btn-exam:hover::before {
            left: 120%;
        }


        .btn-exam:hover {
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 13px 28px rgba(79,70,229,.30);
        }


        .btn-exam i {
            font-size: 16px;
            transition: .25s ease;
        }


        .btn-exam:hover i {
            transform: translateX(5px);
        }


    /* =========================================================
       NO EXAMS
    ========================================================= */

    .no-exams {
        padding: 80px 20px;
        text-align: center;
    }


    .no-exams-icon {
        width: 75px;
        height: 75px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: auto;
        border-radius: 22px;
        background: #eef2ff;
        color: #4f46e5;
        font-size: 30px;
    }


    .no-exams h3 {
        margin: 20px 0 7px;
        color: #0f172a;
        font-size: 22px;
        font-weight: 800;
    }


    .no-exams p {
        color: #64748b;
    }


    /* =========================================================
       SEARCH EMPTY
    ========================================================= */

    .empty-state {
        padding: 80px 20px;
        text-align: center;
    }


    .empty-icon {
        width: 76px;
        height: 76px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: auto;
        border-radius: 22px;
        background: #eef2ff;
        color: #4f46e5;
        font-size: 28px;
    }


    .empty-state h3 {
        margin: 20px 0 7px;
        color: #0f172a;
        font-size: 23px;
        font-weight: 800;
    }


    .empty-state p {
        max-width: 450px;
        margin: auto;
        color: #64748b;
        font-size: 14px;
        line-height: 1.6;
    }


    .clear-search-btn {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        margin-top: 20px;
        padding: 10px 17px;
        border: 0;
        border-radius: 10px;
        background: #eef2ff;
        color: #4f46e5;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
    }


    /* =========================================================
       CTA
    ========================================================= */

    .exam-cta {
        padding: 0 0 90px;
        background: #f8fafc;
    }


    .exam-cta-card {
        position: relative;
        min-height: 370px;
        overflow: hidden;
        padding: 60px;
        border-radius: 30px;
        background: linear-gradient( 120deg, #312e81, #4f46e5 50%, #7c3aed );
        box-shadow: 0 25px 60px rgba(49,46,129,.20);
    }


    /* CTA Background */

    .cta-bg-circle {
        position: absolute;
        border-radius: 50%;
        border: 1px solid rgba(255,255,255,.10);
    }


    .circle-one {
        width: 420px;
        height: 420px;
        right: -130px;
        top: -180px;
    }


    .circle-two {
        width: 260px;
        height: 260px;
        right: 80px;
        bottom: -180px;
    }


    /* CTA content */

    .cta-content {
        position: relative;
        z-index: 5;
        max-width: 650px;
    }


    .section-label.light {
        color: #c4b5fd;
    }


    .cta-content h2 {
        margin: 14px 0;
        color: white;
        font-size: 42px;
        font-weight: 850;
        line-height: 1.15;
        letter-spacing: -.7px;
    }


    .cta-content p {
        max-width: 580px;
        margin: 0;
        color: #ddd6fe;
        font-size: 15px;
        line-height: 1.7;
    }


    /* Buttons */

    .cta-buttons {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 28px;
    }


        .cta-buttons .btn {
            display: inline-flex;
            align-items: center;
