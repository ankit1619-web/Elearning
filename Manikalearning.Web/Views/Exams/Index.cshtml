@model List<Manikalearning.Web.Models.ExamViewModel>

@{
    ViewData["Title"] = "Competitive Exams";
} 
<section class="page-hero">  
    <div class="hero-glow hero-glow-one"></div>
    <div class="hero-glow hero-glow-two"></div> 
    <div class="container"> 
        <div class="page-hero-content"> 
            <span class="hero-badge">
                <i class="bi bi-mortarboard-fill"></i>
                EXAM PREPARATION
            </span>

            <h1>
                Prepare for Your
                <span>Dream Exam</span>
            </h1>

            <p>
                Explore exam-wise preparation, previous year questions,
                mock tests and study material — all in one place.
            </p>
              
            <div class="hero-search">

                <i class="bi bi-search"></i>

                <input type="text"
                       id="examSearch"
                       autocomplete="off"
                       placeholder="Search exam e.g. SSC CGL, UPSC, Banking..." />

                <span class="search-shortcut">
                    Ctrl K
                </span>

            </div>

        </div>

    </div>

</section> 
<section class="section-padding exams-section">

    <div class="container">
         
        <div class="section-header-row">

            <div>

                <span class="section-label">
                    EXPLORE EXAMS
                </span>

                <h2>
                    Explore Competitive Exams
                </h2>

                <p>
                    Choose your exam and start your preparation journey.
                </p>

            </div>


            <div class="exam-count">

                <div class="count-number">
                    @Model.Count
                </div>

                <div class="count-label">
                    Exams Available
                </div>

            </div>

        </div>
           
        <div class="exam-filter-wrapper">

            <button type="button"
                    class="exam-filter active"
                    data-category="all">

                <i class="bi bi-grid-fill"></i>
                All Exams

            </button>


            <button type="button"
                    class="exam-filter"
                    data-category="government">

                <i class="bi bi-building"></i>
                Government

            </button>


            <button type="button"
                    class="exam-filter"
                    data-category="banking">

                <i class="bi bi-bank"></i>
                Banking

            </button>


            <button type="button"
                    class="exam-filter"
                    data-category="ssc">

                <i class="bi bi-person-badge"></i>
                SSC

            </button>


            <button type="button"
                    class="exam-filter"
                    data-category="railway">

                <i class="bi bi-train-front"></i>
                Railway

            </button>


            <button type="button"
                    class="exam-filter"
                    data-category="state">

                <i class="bi bi-geo-alt"></i>
                State Exams

            </button>

        </div>

          
        <div class="row g-4 mt-4" id="examGrid">

            @if (Model != null && Model.Any())
            {
                foreach (var exam in Model)
                {
                    <div class="col-xl-4 col-lg-4 col-md-6 exam-item"
                         data-name="@exam.Name.ToLower()"
                         data-category="@(exam.CategorySlug?.ToLower() ?? "")">  
                        <div class="exam-card">  
                            <div class="exam-card-header"> 
                                <div class="exam-card-icon"> 
                                        <i class="bi bi-mortarboard-fill"></i> 
                                </div> 
                                <span class="exam-status"> 
                                    <span class="status-dot"></span> 
                                    Active 
                                </span> 
                            </div>  
                            <div class="exam-card-body"> 
                                <div class="exam-title-row"> 
                                    <h3 class="exam-title">
                                        @exam.Name
                                    </h3> 
                                    <i class="bi bi-arrow-up-right card-arrow"></i>  
                                </div> 
                                <p class="exam-description"> 
                                    @(exam.ShortDescription  ?? "Complete preparation material, PYQs and mock tests.") 
                                </p>  
                                <div class="exam-stats">  
                                    <div class="exam-stat">  
                                        <div class="stat-icon">
                                            <i class="bi bi-patch-question-fill"></i>
                                        </div> 
                                        <div class="stat-content"> 
                                            <strong>
                                                @exam.TotalQuestions
                                            </strong> 
                                            <span>
                                                Questions
                                            </span> 
                                        </div> 
                                    </div>  
                                    <div class="exam-stat"> 
                                        <div class="stat-icon">
                                            <i class="bi bi-file-earmark-text-fill"></i>
                                        </div> 
                                        <div class="stat-content"> 
                                            <strong>
                                                @exam.TotalPYQs
                                            </strong> 
                                            <span>
                                                PYQs
                                            </span>  
                                        </div> 
                                    </div> 
                                </div> 
                                <div class="exam-meta"> 
                                    <span> 
                                        <i class="bi bi-ui-checks-grid"></i> 
                                        @exam.TotalTests Tests 
                                    </span> 
                                    <span> 
                                        <i class="bi bi-people-fill"></i> 
                                        @exam.TotalStudents Students 
                                    </span> 
                                </div> 
                            </div>  
                            <div class="exam-card-footer"> 
                                <a asp-controller="Exams"
                                       asp-action="Details"
                                       asp-route-id="@exam.Id"
                                       class="btn-exam"> 
                                    <span>
                                        Explore Exam
                                    </span> 
                                    <i class="bi bi-arrow-right"></i> 
                                </a> 
                            </div> 
                        </div> 
                    </div>
                }
            }
            else
            { 
                <div class="col-12">

                    <div class="no-exams">

                        <div class="no-exams-icon">

                            <i class="bi bi-mortarboard"></i>

                        </div>

                        <h3>
                            No Exams Available
                        </h3>

                        <p>
                            Exams will be available here soon.
                        </p>

                    </div>

                </div>
            }

        </div>
         

        <div id="examEmpty"
             class="empty-state d-none">

            <div class="empty-icon">

                <i class="bi bi-search"></i>

            </div>

            <h3>
                No exam found
            </h3>

            <p>
                We couldn't find an exam matching your search.
                Try another exam name or category.
            </p>

            <button type="button"
                    id="clearSearch"
                    class="clear-search-btn">

                <i class="bi bi-arrow-counterclockwise"></i>

                Clear Search

            </button>

        </div>

    </div>

</section>

 

<section class="exam-cta">

    <div class="container">

        <div class="exam-cta-card">

            <!-- Background -->

            <div class="cta-bg-circle circle-one"></div>
            <div class="cta-bg-circle circle-two"></div>


            <!-- Content -->

            <div class="cta-content">

                <span class="section-label light">
                    START TODAY
                </span>

                <h2>
                    Your Dream Exam
                    <br />
                    Starts With One Step.
                </h2>

                <p>
                    Practice PYQs, take mock tests and track your
                    preparation with smart analytics.
                </p>


                <div class="cta-buttons">

                    <a asp-controller="PYQ"
                           asp-action="Index"
                           class="btn btn-light cta-primary">

                        <i class="bi bi-file-earmark-text"></i>

                        Practice PYQs

                        <i class="bi bi-arrow-right"></i>

                    </a>


                    <a asp-controller="Tests"
                           asp-action="Index"
                           class="btn btn-outline-light cta-secondary">

                        <i class="bi bi-stopwatch"></i>

                        Explore Mock Tests

                    </a>

                </div>

            </div>


            <!-- Decoration -->

            <div class="cta-decoration">

                <div class="floating-card card-one">

                    <i class="bi bi-check-circle-fill"></i>

                    <div>
                        <strong>500+</strong>
                        <span>Mock Tests</span>
                    </div>

                </div>


                <div class="floating-card card-two">

                    <i class="bi bi-lightning-charge-fill"></i>

                    <div>
                        <strong>Smart</strong>
                        <span>Practice</span>
                    </div>

                </div>


                <div class="cta-main-circle">

                    <div class="circle-inner">

                        <i class="bi bi-trophy-fill"></i>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>

  
@section Scripts {

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const searchInput =
                document.getElementById("examSearch");

            const filters =
                document.querySelectorAll(".exam-filter");

            const cards =
                document.querySelectorAll(".exam-item");

            const empty =
                document.getElementById("examEmpty");

            const clearSearch =
                document.getElementById("clearSearch");


            let activeCategory = "all";


            /* =====================================================
               FILTER FUNCTION
            ===================================================== */

            function filterExams() {

                const search =
                    (searchInput?.value || "")
                        .toLowerCase()
                        .trim();


                let visible = 0;


                cards.forEach(card => {

                    const name =
                        (card.dataset.name || "")
                            .toLowerCase();


                    const category =
                        (card.dataset.category || "")
                            .toLowerCase();


                    const categoryMatch =
                        activeCategory === "all" ||
                        category === activeCategory;


                    const searchMatch =
                        name.includes(search);


                    if (categoryMatch && searchMatch) {

                        card.classList.remove("d-none");

                        visible++;

                    }
                    else {

                        card.classList.add("d-none");

                    }

                });


                if (visible === 0) {

                    empty?.classList.remove("d-none");

                }
                else {

                    empty?.classList.add("d-none");

                }

            }


            /* =====================================================
               SEARCH
            ===================================================== */

            searchInput?.addEventListener(
                "input",
                filterExams
            );


            /* =====================================================
               CATEGORY FILTER
            ===================================================== */

            filters.forEach(button => {

                button.addEventListener(
                    "click",
                    function () {

                        filters.forEach(item => {

                            item.classList.remove("active");

                        });


                        this.classList.add("active");


                        activeCategory =
                            (
                                this.dataset.category ||
                                "all"
                            ).toLowerCase();


                        filterExams();

                    }
                );

            });


            /* =====================================================
               CLEAR SEARCH
            ===================================================== */

            clearSearch?.addEventListener(
                "click",
                function () {

                    if (searchInput) {

                        searchInput.value = "";

                    }


                    activeCategory = "all";


                    filters.forEach(item => {

                        item.classList.remove("active");

                    });


                    const allFilter =
                        document.querySelector(
                            '.exam-filter[data-category="all"]'
                        );


                    allFilter?.classList.add("active");


                    filterExams();

                }
            );


            /* =====================================================
               CTRL + K SEARCH
            ===================================================== */

            document.addEventListener(
                "keydown",
                function (event) {

                    if (
                        (event.ctrlKey || event.metaKey) &&
                        event.key.toLowerCase() === "k"
                    ) {

                        event.preventDefault();

                        searchInput?.focus();

                    }

                }
            );

        });

    </script>

}