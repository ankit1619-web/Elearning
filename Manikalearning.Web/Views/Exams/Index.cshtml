@model IEnumerable<ExamViewModel>

@{
    ViewData["Title"] = "Competitive Exams";
}

<section class="page-hero">
    <div class="container">
        <div class="page-hero-content">

            <span class="hero-badge">
                <i class="bi bi-mortarboard-fill"></i>
                EXAM PREPARATION
            </span>

            <h1>
                Prepare for Your
                <span>Dream Exam</span>
            </h1>

            <p>
                Explore exam-wise preparation, previous year questions,
                mock tests and study material.
            </p>

            <div class="hero-search">
                <i class="bi bi-search"></i>
                <input type="text"
                       id="examSearch"
                       placeholder="Search exam e.g. SSC CGL, UPSC, Banking..." />
            </div>

        </div>
    </div>
</section>


<section class="section-padding bg-light">
    <div class="container">

        <!-- Header -->
        <div class="section-header-row">

            <div>
                <span class="section-label">
                    EXAMS
                </span>

                <h2>
                    Explore Competitive Exams
                </h2>

                <p>
                    Choose your exam and start your preparation journey.
                </p>
            </div>

            <div class="exam-count">
                <strong>@Model.Count()</strong>
                <span>Exams Available</span>
            </div>

        </div>


        <!-- Category Filters -->
        <div class="exam-filter-wrapper">

            <button class="exam-filter active"
                    data-category="all">
                All Exams
            </button>

            <button class="exam-filter"
                    data-category="government">
                Government
            </button>

            <button class="exam-filter"
                    data-category="banking">
                Banking
            </button>

            <button class="exam-filter"
                    data-category="ssc">
                SSC
            </button>

            <button class="exam-filter"
                    data-category="railway">
                Railway
            </button>

            <button class="exam-filter"
                    data-category="state">
                State Exams
            </button>

        </div>


        <!-- Exam Grid -->
        <div class="row g-4 mt-4"
             id="examGrid">

            @foreach (var exam in Model)
            {
                <div class="col-xl-4 col-lg-4 col-md-6 exam-item"
                     data-category="@exam.CategorySlug"
                     data-name="@exam.Name.ToLower()">

                    <div class="exam-card">

                        <!-- Card Header -->
                        <div class="exam-card-top">

                            <div class="exam-icon">
                                @if (!string.IsNullOrEmpty(exam.Icon))
                                {
                                    <img src="@exam.Icon"
                                         alt="@exam.Name" />
                                }
                                else
                                {
                                    <i class="bi bi-journal-bookmark-fill"></i>
                                }
                            </div>

                            <span class="exam-status">
                                <i class="bi bi-circle-fill"></i>
                                Active
                            </span>

                        </div>


                        <!-- Content -->
                        <div class="exam-card-body">

                            <h3>
                                @exam.Name
                            </h3>

                            <p>
                                @exam.ShortDescription
                            </p>


                            <div class="exam-meta">

                                <div>
                                    <i class="bi bi-question-circle"></i>
                                    <span>
                                        @exam.TotalQuestions Questions
                                    </span>
                                </div>

                                <div>
                                    <i class="bi bi-clock"></i>
                                    <span>
                                        @exam.Duration Minutes
                                    </span>
                                </div>

                            </div>


                            <div class="exam-stats">

                                <div>
                                    <strong>
                                        @exam.TotalPYQs+
                                    </strong>

                                    <span>
                                        PYQs
                                    </span>
                                </div>

                                <div>
                                    <strong>
                                        @exam.TotalTests+
                                    </strong>

                                    <span>
                                        Mock Tests
                                    </span>
                                </div>

                                <div>
                                    <strong>
                                        @exam.TotalStudents+
                                    </strong>

                                    <span>
                                        Students
                                    </span>
                                </div>

                            </div>

                        </div>


                        <!-- Footer -->
                        <div class="exam-card-footer">

                            <a asp-area="Public"
                                   asp-controller="Exams"
                                   asp-action="Details"
                                   asp-route-id="@exam.Id"
                                   class="btn-exam">

                                Explore Exam

                                <i class="bi bi-arrow-right"></i>

                            </a>

                        </div>

                    </div>

                </div>
            }

        </div>


        <!-- Empty State -->
        <div id="examEmpty"
             class="empty-state d-none">

            <div class="empty-icon">
                <i class="bi bi-search"></i>
            </div>

            <h3>
                No exam found
            </h3>

            <p>
                Try searching with another exam name.
            </p>

        </div>

    </div>
</section>


<!-- CTA -->
<section class="exam-cta">

    <div class="container">

        <div class="exam-cta-card">

            <div class="cta-content">

                <span class="section-label light">
                    START TODAY
                </span>

                <h2>
                    Your Dream Exam
                    Starts With One Step.
                </h2>

                <p>
                    Practice PYQs, take mock tests and track your
                    preparation with smart analytics.
                </p>

                <div class="cta-buttons">

                    <a asp-area="Public"
                           asp-controller="PYQ"
                           asp-action="Index"
                           class="btn btn-light">

                        Practice PYQs
                        <i class="bi bi-arrow-right"></i>

                    </a>

                    <a asp-area="Public"
                           asp-controller="Tests"
                           asp-action="Index"
                           class="btn btn-outline-light">

                        Explore Mock Tests

                    </a>

                </div>

            </div>

            <div class="cta-decoration">

                <div class="floating-card card-one">
                    <i class="bi bi-check-circle-fill"></i>
                    500+ Tests
                </div>

                <div class="floating-card card-two">
                    <i class="bi bi-lightning-charge-fill"></i>
                    Smart Practice
                </div>

                <div class="cta-circle">
                    <i class="bi bi-trophy-fill"></i>
                </div>

            </div>

        </div>

    </div>

</section>


<style>

    /* ================================
           PAGE HERO
        ================================= */

    .page-hero {
        position: relative;
        padding: 100px 0 90px;
        overflow: hidden;
        background: radial-gradient(circle at 10% 20%, rgba(124,58,237,.15), transparent 35%), radial-gradient(circle at 90% 20%, rgba(6,182,212,.14), transparent 35%), #0f172a;
    }

    .page-hero-content {
        max-width: 850px;
        margin: auto;
        text-align: center;
    }

    .hero-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 16px;
        border-radius: 50px;
        background: rgba(255,255,255,.08);
        color: #c4b5fd;
        font-size: 13px;
        font-weight: 700;
        letter-spacing: .08em;
    }

    .page-hero h1 {
        margin-top: 25px;
        color: white;
        font-size: clamp(42px,5vw,68px);
        font-weight: 800;
        line-height: 1.1;
    }

        .page-hero h1 span {
            background: linear-gradient( 90deg, #8b5cf6, #06b6d4 );
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

    .page-hero p {
        max-width: 650px;
        margin: 22px auto;
        color: #cbd5e1;
        font-size: 18px;
        line-height: 1.7;
    }

    .hero-search {
        display: flex;
        align-items: center;
        max-width: 650px;
        margin: 35px auto 0;
        padding: 6px 20px;
        background: white;
        border-radius: 16px;
        box-shadow: 0 20px 50px rgba(0,0,0,.25);
    }

        .hero-search i {
            color: #64748b;
            font-size: 20px;
        }

        .hero-search input {
            width: 100%;
            border: 0;
            outline: none;
            padding: 16px;
            font-size: 15px;
        }


    /* ================================
           SECTION
        ================================= */

    .section-padding {
        padding: 90px 0;
    }

    .section-header-row {
        display: flex;
        align-items: end;
        justify-content: space-between;
        gap: 30px;
    }

    .section-label {
        color: #6366f1;
        font-size: 13px;
        font-weight: 800;
        letter-spacing: .12em;
    }

    .section-header-row h2 {
        margin: 10px 0;
        font-size: 38px;
        font-weight: 800;
        color: #0f172a;
    }

    .section-header-row p {
        color: #64748b;
    }

    .exam-count {
        text-align: right;
    }

        .exam-count strong {
            display: block;
            font-size: 32px;
            color: #4f46e5;
        }

        .exam-count span {
            color: #64748b;
            font-size: 14px;
        }


    /* ================================
           FILTERS
        ================================= */

    .exam-filter-wrapper {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 40px;
    }

    .exam-filter {
        border: 1px solid #e2e8f0;
        background: white;
        color: #475569;
        padding: 11px 20px;
        border-radius: 50px;
        font-weight: 600;
        cursor: pointer;
        transition: .25s;
    }

        .exam-filter:hover,
        .exam-filter.active {
            background: #4f46e5;
            border-color: #4f46e5;
            color: white;
            box-shadow: 0 8px 20px rgba(79,70,229,.2);
        }


    /* ================================
           EXAM CARD
        ================================= */

    .exam-card {
        height: 100%;
        overflow: hidden;
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 22px;
        transition: .3s ease;
    }

        .exam-card:hover {
            transform: translateY(-8px);
            border-color: #c4b5fd;
            box-shadow: 0 20px 50px rgba(15,23,42,.10);
        }

    .exam-card-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 25px 25px 0;
    }

    .exam-icon {
        width: 58px;
        height: 58px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 16px;
        color: white;
        font-size: 25px;
        background: linear-gradient( 135deg, #4f46e5, #7c3aed );
    }

        .exam-icon img {
            width: 100%;
            height: 100%;
            border-radius: inherit;
            object-fit: cover;
        }

    .exam-status {
        padding: 6px 11px;
        border-radius: 30px;
        background: #ecfdf5;
        color: #059669;
        font-size: 12px;
        font-weight: 700;
    }

        .exam-status i {
            font-size: 6px;
            vertical-align: middle;
            margin-right: 4px;
        }

    .exam-card-body {
        padding: 22px 25px;
    }

        .exam-card-body h3 {
            margin-bottom: 10px;
            font-size: 22px;
            font-weight: 750;
            color: #0f172a;
        }

        .exam-card-body p {
            min-height: 48px;
            color: #64748b;
            line-height: 1.6;
            font-size: 14px;
        }

    .exam-meta {
        display: flex;
        gap: 20px;
        margin-top: 20px;
        padding-top: 18px;
        border-top: 1px solid #f1f5f9;
    }

        .exam-meta div {
            display: flex;
            align-items: center;
            gap: 7px;
            color: #64748b;
            font-size: 13px;
        }

        .exam-meta i {
            color: #6366f1;
        }


    /* Stats */

    .exam-stats {
        display: grid;
        grid-template-columns: repeat(3,1fr);
        gap: 10px;
        margin-top: 22px;
        padding: 15px;
        border-radius: 14px;
        background: #f8fafc;
    }

        .exam-stats div {
            text-align: center;
        }

        .exam-stats strong {
            display: block;
            color: #0f172a;
            font-size: 16px;
        }

        .exam-stats span {
            color: #94a3b8;
            font-size: 11px;
        }


    /* Footer */

    .exam-card-footer {
        padding: 0 25px 25px;
    }

    .btn-exam {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        width: 100%;
        padding: 13px;
        border-radius: 12px;
        background: #eef2ff;
        color: #4f46e5;
        font-weight: 700;
        text-decoration: none;
        transition: .25s;
    }

        .btn-exam:hover {
            color: white;
            background: #4f46e5;
        }


    /* ================================
           CTA
        ================================= */

    .exam-cta {
        padding: 0 0 90px;
        background: #f8fafc;
    }

    .exam-cta-card {
        position: relative;
        overflow: hidden;
        min-height: 350px;
        padding: 60px;
        border-radius: 30px;
        background: linear-gradient( 120deg, #312e81, #4f46e5, #7c3aed );
    }

    .cta-content {
        position: relative;
        z-index: 2;
        max-width: 650px;
    }

    .section-label.light {
        color: #c4b5fd;
    }

    .cta-content h2 {
        margin: 15px 0;
        color: white;
        font-size: 42px;
        font-weight: 800;
    }

    .cta-content p {
        color: #ddd6fe;
        line-height: 1.7;
        font-size: 16px;
    }

    .cta-buttons {
        display: flex;
        gap: 12px;
        margin-top: 28px;
    }

        .cta-buttons .btn {
            padding: 13px 22px;
            border-radius: 12px;
            font-weight: 700;
        }


    /* Decoration */

    .cta-decoration {
        position: absolute;
        right: 70px;
        top: 50%;
        transform: translateY(-50%);
    }

    .cta-circle {
        width: 170px;
        height: 170px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        color: white;
        font-size: 60px;
        background: rgba(255,255,255,.12);
        border: 1px solid rgba(255,255,255,.2);
    }

    .floating-card {
        position: absolute;
        z-index: 2;
        padding: 12px 17px;
        white-space: nowrap;
        border-radius: 12px;
        background: white;
        color: #334155;
        font-size: 13px;
        font-weight: 700;
        box-shadow: 0 15px 30px rgba(0,0,0,.2);
    }

        .floating-card i {
            margin-right: 5px;
            color: #4f46e5;
        }

    .card-one {
        top: -20px;
        left: -70px;
    }

    .card-two {
        bottom: -20px;
        right: -50px;
    }


    /* Empty */

    .empty-state {
        padding: 80px 20px;
        text-align: center;
    }

    .empty-icon {
        width: 70px;
        height: 70px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: auto;
        border-radius: 50%;
        background: #eef2ff;
        color: #4f46e5;
        font-size: 25px;
    }


    /* ================================
           RESPONSIVE
        ================================= */

    @@media(max-width: 991px) {

        .section-header-row {
            align-items: start;
            flex-direction: column;
        }

        .exam-count {
            text-align: left;
        }

        .cta-decoration {
            opacity: .25;
            right: 20px;
        }
    }

    @@media(max-width: 767px) {

        .page-hero {
            padding: 70px 0;
        }

            .page-hero h1 {
                font-size: 42px;
            }

        .section-padding {
            padding: 65px 0;
        }

        .section-header-row h2 {
            font-size: 30px;
        }

        .exam-filter-wrapper {
            overflow-x: auto;
            flex-wrap: nowrap;
            padding-bottom: 5px;
        }

        .exam-filter {
            white-space: nowrap;
        }

        .exam-cta-card {
            padding: 40px 25px;
        }

        .cta-content h2 {
            font-size: 32px;
        }

        .cta-decoration {
            display: none;
        }

        .cta-buttons {
            flex-direction: column;
        }
    }

</style>


@section Scripts {

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const searchInput =
                document.getElementById("examSearch");

            const filters =
                document.querySelectorAll(".exam-filter");

            const cards =
                document.querySelectorAll(".exam-item");

            const empty =
                document.getElementById("examEmpty");


            let activeCategory = "all";


            function filterExams() {

                const search =
                    searchInput.value
                        .toLowerCase()
                        .trim();

                let visible = 0;


                cards.forEach(card => {

                    const name =
                        card.dataset.name || "";

                    const category =
                        card.dataset.category || "";


                    const categoryMatch =
                        activeCategory === "all" ||
                        category === activeCategory;


                    const searchMatch =
                        name.includes(search);


                    if (categoryMatch && searchMatch) {

                        card.classList.remove("d-none");

                        visible++;

                    }
                    else {

                        card.classList.add("d-none");

                    }

                });


                if (visible === 0) {

                    empty.classList.remove("d-none");

                }
                else {

                    empty.classList.add("d-none");

                }

            }


            searchInput.addEventListener(
                "input",
                filterExams
            );


            filters.forEach(button => {

                button.addEventListener(
                    "click",
                    function () {

                        filters.forEach(x =>
                            x.classList.remove("active")
                        );

                        this.classList.add("active");

                        activeCategory =
                            this.dataset.category;

                        filterExams();

                    }
                );

            });

        });

    </script>

}