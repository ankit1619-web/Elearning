@model Manikalearning.Web.Models.ExamVM

@{
    ViewData["Title"] = Model.ExamName;
} 

<section class="exam-detail-hero">
    <div class="container">
        <div class="exam-breadcrumb">
            <a asp-controller="Home" asp-action="Index">
                Home
            </a>
            <i class="bi bi-chevron-right"></i>
            <a asp-controller="Exams" asp-action="Index">
                Exams
            </a>
            <i class="bi bi-chevron-right"></i>
            <span>@Model.ExamName</span>
        </div>
        <div class="row align-items-center g-5">
            <div class="col-lg-8">
                <div class="exam-detail-badge">
                    <i class="bi bi-mortarboard-fill"></i>
                    EXAM PREPARATION
                </div>
                <h1>
                    @Model.ExamName
                </h1>
                @if (!string.IsNullOrWhiteSpace(Model.ExamCode))
                {
                    <div class="exam-code">
                        @Model.ExamCode
                    </div>
                }
                <p class="exam-detail-description">
                    @Model.Description
                </p>
                <div class="hero-buttons">
                    <a asp-controller="PYQ" asp-action="Index" asp-route-examId="@Model.ExamId" class="btn btn-primary btn-lg">
                        <i class="bi bi-journal-text"></i>
                        Practice PYQs
                    </a> 
                    <a asp-controller="Tests"  asp-action="Index"
                           asp-route-examId="@Model.ExamId"
                           class="btn btn-outline-light btn-lg">

                        <i class="bi bi-lightning-charge"></i>

                        Start Mock Test

                    </a>

                </div>

            </div>  
            <div class="col-lg-4">

                <div class="exam-hero-image">

                    @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                    {
                        <img src="@Model.ImageUrl"
                             alt="@Model.ExamName" />
                    }
                    else
                    {
                        <div class="default-exam-icon">

                            <i class="bi bi-mortarboard-fill"></i>

                        </div>
                    }

                </div>

            </div>

        </div>

    </div>

</section>
 

<section class="exam-stats-section">

    <div class="container">

        <div class="exam-stat-grid">


            <div class="exam-stat-card">

                <div class="stat-icon purple">

                    <i class="bi bi-question-circle-fill"></i>

                </div>

                <div>

                    <strong>
                        @Model.TotalQuestions.ToString("N0")
                    </strong>

                    <span>
                        Practice Questions
                    </span>

                </div>

            </div>



            <div class="exam-stat-card">

                <div class="stat-icon blue">

                    <i class="bi bi-journal-text"></i>

                </div>

                <div>

                    <strong>
                        @Model.TotalPYQs.ToString("N0")
                    </strong>

                    <span>
                        Previous Year Questions
                    </span>

                </div>

            </div>



            <div class="exam-stat-card">

                <div class="stat-icon orange">

                    <i class="bi bi-stopwatch-fill"></i>

                </div>

                <div>

                    <strong>
                        @Model.TotalTests.ToString("N0")
                    </strong>

                    <span>
                        Mock Tests
                    </span>

                </div>

            </div>



            <div class="exam-stat-card">

                <div class="stat-icon green">

                    <i class="bi bi-book-fill"></i>

                </div>

                <div>

                    <strong>
                        @Model.TotalSubjects.ToString("N0")
                    </strong>

                    <span>
                        Subjects
                    </span>

                </div>

            </div>


        </div>

    </div>

</section>
 

<section class="exam-content-section">

    <div class="container"> 
        <!-- =====================================================
             COURSES
        ====================================================== -->

        <div class="content-header tests-header">

            <div>

                <span class="section-label">
                    LEARN FROM EXPERTS
                </span>

                <h2>
                    Courses for @Model.ExamName
                </h2>

                <p>
                    Learn concepts with structured courses and video lectures.
                </p>

            </div>


            <a asp-controller="Course"
                   asp-action="Index"
                   asp-route-examId="@Model.ExamId"
                   class="view-all" >
                View All 
                <i class="bi bi-arrow-right"></i>

            </a>

        </div>


        <div class="row g-4">

            @if (Model.Courses != null && Model.Courses.Any())
            {
                foreach (var course in Model.Courses)
                {
                    <div class="col-lg-4 col-md-6">

                        <div class="course-card">

                            <div class="course-image">

                                @if (!string.IsNullOrWhiteSpace(course.ThumbnailUrl))
                                {
                                    <img src="@course.ThumbnailUrl"
                                         alt="@course.CourseName" />
                                }
                                else
                                {
                                    <div class="course-placeholder">

                                        <i class="bi bi-play-circle-fill"></i>

                                    </div>
                                }

                            </div>


                            <div class="course-body">

                                <span class="course-tag">
                                    @Model.ExamName
                                </span>

                                <h3>
                                    @course.CourseName
                                </h3>

                                <div class="course-meta">

                                    <span>

                                        <i class="bi bi-play-circle"></i>

                                        @course.TotalLectures Lectures

                                    </span>

                                </div>


                                <div class="course-footer">

                                    <div>

                                        @if (course.DiscountPrice.HasValue)
                                        {
                                            <strong>
                                                ₹@course.DiscountPrice.Value.ToString("N0")
                                            </strong>

                                            <del>
                                                ₹@course.Price.ToString("N0")
                                            </del>
                                        }
                                        else
                                        {
                                            <strong>
                                                ₹@course.Price.ToString("N0")
                                            </strong>
                                        }

                                    </div>


                                    <a asp-controller="Course"
                                           asp-action="Details"
                                           asp-route-id="@course.CourseId"
                                           class="course-button">

                                        View Course

                                    </a>

                                </div>

                            </div>

                        </div>

                    </div>
                }
            }
            else
            {
                <div class="col-12">

                    <div class="no-data">

                        <i class="bi bi-play-btn"></i>

                        <h4>
                            Courses coming soon
                        </h4>

                    </div>

                </div>
            }

        </div>
        @* <div class="content-header">

            <div>

                <span class="section-label">
                    EXAM SYLLABUS
                </span>

                <h2>
                    Subjects & Topics
                </h2>

                <p>
                    Explore subject-wise questions, PYQs and practice material.
                </p>

            </div>

        </div> *@


