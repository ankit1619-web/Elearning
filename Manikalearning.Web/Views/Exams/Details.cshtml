        <div class="content-header tests-header"> 
            <div> 
                <span class="section-label">
                    TEST SERIES
                </span> 
                <h2>
                    Mock Tests
                </h2> 
                <p>
                    Attempt exam-level tests and improve your preparation.
                </p> 
            </div>  
            <a asp-controller="Tests"
                   asp-action="Index"
                   asp-route-examId="@Model.ExamId"
                   class="view-all">

                View All

                <i class="bi bi-arrow-right"></i>

            </a> 
        </div> 

        <div class="row g-4"> 
            @if (Model.Tests != null && Model.Tests.Any())
            {
                foreach (var test in Model.Tests)
                {
                    <div class="col-lg-4 col-md-6">

                        <div class="test-card">

                            <div class="test-top">

                                <span class="test-badge">

                                    <i class="bi bi-lightning-fill"></i>

                                    MOCK TEST

                                </span>

                                <span class="test-time">

                                    <i class="bi bi-clock"></i>

                                    @test.DurationMinutes min

                                </span>

                            </div>


                            <h3>
                                @test.TestName
                            </h3>


                            <div class="test-info">

                                <span>

                                    <i class="bi bi-question-circle"></i>

                                    @test.TotalQuestions Questions

                                </span>

                                <span>

                                    <i class="bi bi-award"></i>

                                    @test.TotalMarks Marks

                                </span>

                            </div>


                            <a asp-controller="Tests"
                                   asp-action="Details"
                                   asp-route-id="@test.TestId"
                                   class="test-button">

                                Start Test

                                <i class="bi bi-arrow-right"></i>

                            </a>

                        </div>

                    </div>
                }
            }
            else
            {
                <div class="col-12">

                    <div class="no-data">

                        <i class="bi bi-clipboard-check"></i>

                        <h4>
                            Mock tests coming soon
                        </h4>

                    </div>

                </div>
            }

        </div>   
         
    </div>

</section>
 
<section class="section-padding bg-light">

    <div class="container">
         
        <div class="section-header-row">

            <div>
                <span class="section-label">
                    PREVIOUS YEAR QUESTIONS
                </span>

                <h2>
                    Practice Real Exam Questions
                </h2>

                <p>
                    Solve previous year papers, understand exam patterns
                    and improve your preparation.
                </p>
            </div >
        </div>

         
        @if (Model.PYQs != null && Model.PYQs.Any())
        {
            <div class="row g-4 mt-4"> 
                @foreach (var pyq in Model.PYQs)
                {
                    <div class="col-xl-4 col-lg-4 col-md-6"> 
                        <div class="app-card"> 
                            <div class="app-card-header"> 
                                <div class="app-card-icon">
                                    <i class="bi bi-file-earmark-text"></i>
                                </div> 
                                <span class="app-card-badge">
                                    <i class="bi bi-patch-check-fill"></i>
                                    PYQ
                                </span> 
                            </div> 
                            <div class="app-card-body"> 
                                <h3 class="app-card-title">
                                    @pyq.PaperName
                                </h3> 
                                @if (!string.IsNullOrWhiteSpace(pyq.Session))
                                {
                                    <div class="app-card-meta-item mb-2">

                                        <i class="bi bi-clock-history"></i>

                                        <span>
                                            @pyq.Session
                                        </span>

                                    </div>
                                }


                                @if (!string.IsNullOrWhiteSpace(pyq.SubjectName))
                                {
                                    <div class="app-card-meta-item">

                                        <i class="bi bi-book"></i>

                                        <span>
                                            @pyq.SubjectName
                                        </span>

                                    </div>
                                }

                                 
                                <div class="app-card-meta">

                                    <div class="app-card-meta-item">

                                        <i class="bi bi-calendar3"></i>

                                        <span>
                                            @pyq.Year
                                        </span>

                                    </div>


                                    <div class="app-card-meta-item">

                                        <i class="bi bi-file-earmark-check"></i>

                                        <span>
                                            Previous Year Paper
                                        </span>

                                    </div>

                                </div>

                                 
                                <div class="app-card-highlight">

                                    <div class="app-card-highlight-icon">

                                        <i class="bi bi-question-circle"></i>

                                    </div>

                                    <div class="app-card-highlight-content">

                                        <strong>
                                            @pyq.TotalQuestions Questions
                                        </strong>

                                        <span>
                                            Complete PYQ Paper
                                        </span>

                                    </div>

                                </div>

                            </div>

                             
                            <div class="app-card-footer">

                                <a asp-controller="PYQ"
                                       asp-action="Index"
                                       asp-route-paperId="@pyq.PaperId"
                                       class="app-card-btn secondary">

                                    <i class="bi bi-book"></i>

                                    Read PYQ

                                </a>


                                <a asp-controller="PYQ"
                                       asp-action="Practice"
                                       asp-route-paperId="@pyq.PaperId"
                                       class="app-card-btn">

                                    Practice

                                    <i class="bi bi-arrow-right"></i>

                                </a>

                            </div>

                        </div>

                    </div>
                }

            </div>
        }
        else
        {
            <div class="app-empty">

                <div class="app-empty-icon">

                    <i class="bi bi-journal-x"></i>

                </div>

                <h3>
                    PYQs coming soon
                </h3>

                <p>
                    Previous year papers for this exam
                    will be available here soon.
                </p>

            </div>
        }

    </div>

</section>
<section class="exam-final-cta">

    <div class="container">

        <div class="final-cta-card">

            <div class="cta-content">

                <span>
                    READY TO START?
                </span>

                <h2>
                    Start Preparing for
                    @Model.ExamName Today.
                </h2>

                <p>
                    Practice PYQs, attempt mock tests and prepare smarter
                    with our complete exam preparation platform.
                </p>


                <div class="cta-actions">

                    <a asp-controller="PYQ"
                           asp-action="Index"
                           asp-route-examId="@Model.ExamId"
                           class="btn btn-light">

                        Practice PYQs

                        <i class="bi bi-arrow-right"></i>

                    </a>


                    <a asp-controller="Tests"
                           asp-action="Index"
                           asp-route-examId="@Model.ExamId"
                           class="btn btn-outline-light">

                        Take Mock Test

                    </a>

                </div>

            </div>


            <div class="cta-icon">

                <i class="bi bi-trophy-fill"></i>

            </div>

        </div>

    </div>

</section>

 