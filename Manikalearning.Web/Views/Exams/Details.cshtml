@model Manikalearning.Web.Models.ExamVM

@{
    ViewData["Title"] = Model.ExamName;
} 

<section class="exam-detail-hero">
    <div class="container">
        <div class="exam-breadcrumb">
            <a asp-controller="Home" asp-action="Index">
                Home
            </a>
            <i class="bi bi-chevron-right"></i>
            <a asp-controller="Exams" asp-action="Index">
                Exams
            </a>
            <i class="bi bi-chevron-right"></i>
            <span>@Model.ExamName</span>
        </div>
        <div class="row align-items-center g-5">
            <div class="col-lg-8">
                <div class="exam-detail-badge">
                    <i class="bi bi-mortarboard-fill"></i>
                    EXAM PREPARATION
                </div>
                <h1>
                    @Model.ExamName
                </h1>
                @if (!string.IsNullOrWhiteSpace(Model.ExamCode))
                {
                    <div class="exam-code">
                        @Model.ExamCode
                    </div>
                }
                <p class="exam-detail-description">
                    @Model.Description
                </p>
                <div class="hero-buttons">
                    <a asp-controller="PYQ" asp-action="Index" asp-route-examId="@Model.ExamId" class="btn btn-primary btn-lg">
                        <i class="bi bi-journal-text"></i>
                        Practice PYQs
                    </a> 
                    <a asp-controller="Tests"  asp-action="Index"
                           asp-route-examId="@Model.ExamId"
                           class="btn btn-outline-light btn-lg">

                        <i class="bi bi-lightning-charge"></i>

                        Start Mock Test

                    </a>

                </div>

            </div>  
            <div class="col-lg-4">

                <div class="exam-hero-image">

                    @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                    {
                        <img src="@Model.ImageUrl"
                             alt="@Model.ExamName" />
                    }
                    else
                    {
                        <div class="default-exam-icon">

                            <i class="bi bi-mortarboard-fill"></i>

                        </div>
                    }

                </div>

            </div>

        </div>

    </div>

</section>
 

<section class="exam-stats-section">

    <div class="container">

        <div class="exam-stat-grid">


            <div class="exam-stat-card">

                <div class="stat-icon purple">

                    <i class="bi bi-question-circle-fill"></i>

                </div>

                <div>

                    <strong>
                        @Model.TotalQuestions.ToString("N0")
                    </strong>

                    <span>
                        Practice Questions
                    </span>

                </div>

            </div>



            <div class="exam-stat-card">

                <div class="stat-icon blue">

                    <i class="bi bi-journal-text"></i>

                </div>

                <div>

                    <strong>
                        @Model.TotalPYQs.ToString("N0")
                    </strong>

                    <span>
                        Previous Year Questions
                    </span>

                </div>

            </div>



            <div class="exam-stat-card">

                <div class="stat-icon orange">

                    <i class="bi bi-stopwatch-fill"></i>

                </div>

                <div>

                    <strong>
                        @Model.TotalTests.ToString("N0")
                    </strong>

                    <span>
                        Mock Tests
                    </span>

                </div>

            </div>



            <div class="exam-stat-card">

                <div class="stat-icon green">

                    <i class="bi bi-book-fill"></i>

                </div>

                <div>

                    <strong>
                        @Model.TotalSubjects.ToString("N0")
                    </strong>

                    <span>
                        Subjects
                    </span>

                </div>

            </div>


        </div>

    </div>

</section>
 

<section class="exam-content-section">

    <div class="container"> 

        <div class="content-header">

            <div>

                <span class="section-label">
                    EXAM SYLLABUS
                </span>

                <h2>
                    Subjects & Topics
                </h2>

                <p>
                    Explore subject-wise questions, PYQs and practice material.
                </p>

            </div>

        </div>


        <div class="row g-4">

            @if (Model.Subjects != null && Model.Subjects.Any())
            {
                foreach (var subject in Model.Subjects)
                {
                    <div class="col-lg-4 col-md-6">

                        <div class="subject-card">

                            <div class="subject-icon">

                                <i class="bi bi-book"></i>

                            </div>


                            <div class="subject-content">

                                <h3>
                                    @subject.SubjectName
                                </h3>

                                <p>
                                    @subject.TotalQuestions Questions
                                </p>

                            </div>


                            <a href="#"
                                   class="subject-arrow">

                                <i class="bi bi-arrow-right"></i>

                            </a>

                        </div>

                    </div>
                }
            }
            else
            {
                <div class="col-12">

                    <div class="no-data">

                        <i class="bi bi-book"></i>

                        <h4>
                            Subjects coming soon
                        </h4>

                        <p>
                            Exam subjects and syllabus will be available shortly.
                        </p>

                    </div>

                </div>
            }

        </div>

         

        <div class="content-header tests-header">

            <div>

                <span class="section-label">
                    TEST SERIES
                </span>

                <h2>
                    Mock Tests
                </h2>

                <p>
                    Attempt exam-level tests and improve your preparation.
                </p>

            </div>


            <a asp-controller="Tests"
                   asp-action="Index"
                   asp-route-examId="@Model.ExamId"
                   class="view-all">

                View All

                <i class="bi bi-arrow-right"></i>

            </a>

        </div>


        <div class="row g-4">

            @if (Model.Tests != null && Model.Tests.Any())
            {
                foreach (var test in Model.Tests)
                {
                    <div class="col-lg-4 col-md-6">

                        <div class="test-card">

                            <div class="test-top">

                                <span class="test-badge">

                                    <i class="bi bi-lightning-fill"></i>

                                    MOCK TEST

                                </span>

                                <span class="test-time">

                                    <i class="bi bi-clock"></i>

                                    @test.DurationMinutes min

                                </span>

                            </div>


                            <h3>
                                @test.TestName
                            </h3>


                            <div class="test-info">

                                <span>

                                    <i class="bi bi-question-circle"></i>

                                    @test.TotalQuestions Questions

                                </span>

                                <span>

                                    <i class="bi bi-award"></i>

                                    @test.TotalMarks Marks

                                </span>

                            </div>


                            <a asp-controller="Tests"
                                   asp-action="Details"
                                   asp-route-id="@test.TestId"
                                   class="test-button">

                                Start Test

                                <i class="bi bi-arrow-right"></i>

                            </a>

                        </div>

                    </div>
                }
            }
            else
            {
                <div class="col-12">

                    <div class="no-data">

                        <i class="bi bi-clipboard-check"></i>

                        <h4>
                            Mock tests coming soon
                        </h4>

                    </div>

                </div>
            }

        </div>



        <!-- =====================================================
             COURSES
        ====================================================== -->

        <div class="content-header tests-header">

            <div>

                <span class="section-label">
                    LEARN FROM EXPERTS
                </span>

                <h2>
                    Courses for @Model.ExamName
                </h2>

                <p>
                    Learn concepts with structured courses and video lectures.
                </p>

            </div>


            <a asp-controller="Courses"
                   asp-action="Index"
                   asp-route-examId="@Model.ExamId"
                   class="view-all">

                View All

                <i class="bi bi-arrow-right"></i>

            </a>

        </div>


        <div class="row g-4">

            @if (Model.Courses != null && Model.Courses.Any())
            {
                foreach (var course in Model.Courses)
                {
                    <div class="col-lg-4 col-md-6">

                        <div class="course-card">

                            <div class="course-image">

                                @if (!string.IsNullOrWhiteSpace(course.ThumbnailUrl))
                                {
                                    <img src="@course.ThumbnailUrl"
                                         alt="@course.CourseName" />
                                }
                                else
                                {
                                    <div class="course-placeholder">

                                        <i class="bi bi-play-circle-fill"></i>

                                    </div>
                                }

                            </div>


                            <div class="course-body">

                                <span class="course-tag">
                                    @Model.ExamName
                                </span>

                                <h3>
                                    @course.CourseName
                                </h3>  

                                <div class="course-meta">

                                    <span>

                                        <i class="bi bi-play-circle"></i>

                                        @course.TotalLectures Lectures

                                    </span> 

                                </div>


                                <div class="course-footer">

                                    <div>

                                        @if (course.DiscountPrice.HasValue)
                                        {
                                            <strong>
                                                ₹@course.DiscountPrice.Value.ToString("N0")
                                            </strong>

                                            <del>
                                                ₹@course.Price.ToString("N0")
                                            </del>
                                        }
                                        else
                                        {
                                            <strong>
                                                ₹@course.Price.ToString("N0")
                                            </strong>
                                        }

                                    </div>


                                    <a asp-controller="Courses"
                                           asp-action="Details"
                                           asp-route-id="@course.CourseId"
                                           class="course-button">

                                        View Course

                                    </a>

                                </div>

                            </div>

                        </div>

                    </div>
                }
            }
            else
            {
                <div class="col-12">

                    <div class="no-data">

                        <i class="bi bi-play-btn"></i>

                        <h4>
                            Courses coming soon
                        </h4>

                    </div>

                </div>
            }

        </div>

         
        @if (Model.RelatedExams != null && Model.RelatedExams.Any())
        {
            <div class="content-header tests-header">

                <div>

                    <span class="section-label">
                        MORE EXAMS
                    </span>

                    <h2>
                        Related Exams
                    </h2>

                </div>

            </div>


            <div class="row g-4">

                @foreach (var exam in Model.RelatedExams)
                {
                    <div class="col-lg-4 col-md-6">

                        <div class="related-exam-card">

                            <div class="related-icon">

                                <i class="bi bi-mortarboard-fill"></i>

                            </div>

                            <div>

                                <h3>
                                    @exam.ExamName
                                </h3>

                                <span>
                                    @exam.TotalQuestions Questions
                                </span>

                            </div>


                            <a asp-controller="Exams"
                                   asp-action="Details"
                                   asp-route-id="@exam.ExamId">

                                <i class="bi bi-arrow-up-right"></i>

                            </a>

                        </div>

                    </div>
                }

            </div>
        }

        @if (Model.PYQs != null && Model.PYQs.Any())
        {
            <div class="pyq-grid">

                @foreach (var pyq in Model.PYQs)
                {
                    <div class="pyq-card">

                        <!-- TOP -->
                        <div class="pyq-card-top">

                            <div class="pyq-year">
                                @pyq.Year
                            </div>

                            <span class="pyq-badge">
                                <i class="bi bi-patch-check-fill"></i>
                                PYQ
                            </span>

                        </div>

                         
                        <div class="pyq-card-body">
                             
                            <h3>
                                @pyq.PaperName
                            </h3> 
                            <div class="pyq-meta">

                                <span>
                                    <i class="bi bi-calendar3"></i>
                                    @pyq.Year
                                </span>

                                <span>
                                    <i class="bi bi-file-earmark-text"></i>
                                    Previous Year Paper
                                </span>

                            </div> 
                            <div class="pyq-question-count">

                                <div class="pyq-question-count-icon">
                                    <i class="bi bi-question-circle"></i>
                                </div>

                                <div class="pyq-question-count-text">

                                    <strong>
                                        @pyq.TotalQuestions Questions
                                    </strong>

                                    <span>
                                        Complete PYQ Paper
                                    </span>

                                </div>

                            </div>

                        </div>


                        <!-- FOOTER -->
                        <div class="pyq-card-footer">

                            <a asp-controller="PYQ"
                                   asp-action="Index"
                                   asp-route-paperId="@pyq.PaperId"
                                   class="pyq-read-btn">

                                <i class="bi bi-book"></i>

                                Read PYQ

                            </a>


                            <a asp-controller="PYQ"
                                   asp-action="Practice"
                                   asp-route-paperId="@pyq.PaperId"
                                   class="pyq-solve-btn">

                                Start Practice

                                <i class="bi bi-arrow-right"></i>

                            </a>

                        </div>

                    </div>
                }

            </div>
        }
        else
        {
            <div class="pyq-empty">

                <div class="pyq-empty-icon">
                    <i class="bi bi-journal-x"></i>
                </div>

                <h3>
                    PYQs coming soon
                </h3>

                <p>
                    Previous year question papers for this exam
                    will be available here soon.
                </p>

            </div>
        }
    </div>

</section>
 

<section class="exam-final-cta">

    <div class="container">

        <div class="final-cta-card">

            <div class="cta-content">

                <span>
                    READY TO START?
                </span>

                <h2>
                    Start Preparing for
                    @Model.ExamName Today.
                </h2>

                <p>
                    Practice PYQs, attempt mock tests and prepare smarter
                    with our complete exam preparation platform.
                </p>


                <div class="cta-actions">

                    <a asp-controller="PYQ"
                           asp-action="Index"
                           asp-route-examId="@Model.ExamId"
                           class="btn btn-light">

                        Practice PYQs

                        <i class="bi bi-arrow-right"></i>

                    </a>


                    <a asp-controller="Tests"
                           asp-action="Index"
                           asp-route-examId="@Model.ExamId"
                           class="btn btn-outline-light">

                        Take Mock Test

                    </a>

                </div>

            </div>


            <div class="cta-icon">

                <i class="bi bi-trophy-fill"></i>

            </div>

        </div>

    </div>

</section>



<style>
      
    .exam-detail-hero {
        position: relative;
        overflow: hidden;
        padding: 45px 0 85px;
        color: white;
        background:
            radial-gradient(circle at 10% 20%, rgba(124,58,237,.35), transparent 35%),
            radial-gradient(circle at 90% 30%, rgba(6,182,212,.22), transparent 35%),
            #0f172a;
    }

    .exam-breadcrumb {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 55px;
        color: #94a3b8;
        font-size: 13px;
    }

    .exam-breadcrumb a {
        color: #cbd5e1;
        text-decoration: none;
    }

    .exam-breadcrumb a:hover {
        color: white;
    }

    .exam-breadcrumb i {
        font-size: 10px;
    }


    .exam-detail-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 15px;
        border: 1px solid rgba(255,255,255,.12);
        border-radius: 50px;
        color: #c4b5fd;
        background: rgba(255,255,255,.07);
        font-size: 12px;
        font-weight: 800;
        letter-spacing: .1em;
    }


    .exam-detail-hero h1 {
        margin: 20px 0 5px;
        font-size: clamp(42px, 5vw, 65px);
        font-weight: 850;
        line-height: 1.05;
    }


    .exam-code {
        display: inline-block;
        margin-top: 12px;
        color: #a5b4fc;
        font-weight: 700;
    }


    .exam-detail-description {
        max-width: 720px;
        margin: 22px 0;
        color: #cbd5e1;
        font-size: 17px;
        line-height: 1.8;
    }


    .hero-buttons {
        display: flex;
        gap: 12px;
        margin-top: 30px;
    }

    .hero-buttons .btn {
        padding: 13px 22px;
        border-radius: 12px;
        font-weight: 700;
    }


    .exam-hero-image {
        width: 270px;
        height: 270px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: auto;
        padding: 12px;
        border-radius: 35px;
        background: rgba(255,255,255,.08);
        border: 1px solid rgba(255,255,255,.15);
        box-shadow: 0 30px 80px rgba(0,0,0,.3);
        transform: rotate(3deg);
    }


    .exam-hero-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 25px;
    }


    .default-exam-icon {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 25px;
        color: white;
        font-size: 80px;
        background: linear-gradient(135deg,#4f46e5,#7c3aed);
    }


    /* =========================================================
       STATS
    ========================================================= */

    .exam-stats-section {
        position: relative;
        margin-top: -45px;
        z-index: 5;
    }


    .exam-stat-grid {
        display: grid;
        grid-template-columns: repeat(4,1fr);
        gap: 15px;
    }


    .exam-stat-card {
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 22px;
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 18px;
        box-shadow: 0 15px 40px rgba(15,23,42,.08);
    }


    .stat-icon {
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border-radius: 14px;
        font-size: 20px;
    }


    .stat-icon.purple {
        color: #6366f1;
        background: #eef2ff;
    }

    .stat-icon.blue {
        color: #0284c7;
        background: #e0f2fe;
    }

    .stat-icon.orange {
        color: #ea580c;
        background: #fff7ed;
    }

    .stat-icon.green {
        color: #059669;
        background: #ecfdf5;
    }


    .exam-stat-card strong {
        display: block;
        color: #0f172a;
        font-size: 22px;
        font-weight: 800;
    }


    .exam-stat-card span {
        color: #64748b;
        font-size: 12px;
    }


    /* =========================================================
       CONTENT
    ========================================================= */

    .exam-content-section {
        padding: 90px 0;
        background: #f8fafc;
    }


    .content-header {
        margin-bottom: 30px;
    }


    .content-header.tests-header {
        display: flex;
        align-items: end;
        justify-content: space-between;
        margin-top: 85px;
    }


    .section-label {
        color: #6366f1;
        font-size: 12px;
        font-weight: 800;
        letter-spacing: .12em;
    }


    .content-header h2 {
        margin: 8px 0;
        color: #0f172a;
        font-size: 35px;
        font-weight: 800;
    }


    .content-header p {
        margin: 0;
        color: #64748b;
    }


    .view-all {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: #4f46e5;
        font-weight: 700;
        text-decoration: none;
    }


    /* =========================================================
       SUBJECT
    ========================================================= */

    .subject-card {
        display: flex;
        align-items: center;
        gap: 15px;
        height: 100%;
        padding: 22px;
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 18px;
        transition: .25s;
    }


    .subject-card:hover {
        transform: translateY(-5px);
        border-color: #c4b5fd;
        box-shadow: 0 18px 40px rgba(15,23,42,.08);
    }


    .subject-icon {
        width: 52px;
        height: 52px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border-radius: 14px;
        color: #6366f1;
        background: #eef2ff;
        font-size: 21px;
    }


    .subject-content {
        flex: 1;
    }


    .subject-content h3 {
        margin: 0 0 5px;
        color: #0f172a;
        font-size: 17px;
        font-weight: 750;
    }


    .subject-content p {
        margin: 0;
        color: #94a3b8;
        font-size: 13px;
    }


    .subject-arrow {
        width: 36px;
        height: 36px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        color: #6366f1;
        background: #f8fafc;
    }


    /* =========================================================
       TEST CARD
    ========================================================= */

    .test-card {
        height: 100%;
        padding: 25px;
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 20px;
        transition: .25s;
    }


    .test-card:hover {
        transform: translateY(-6px);
        border-color: #c4b5fd;
        box-shadow: 0 20px 45px rgba(15,23,42,.08);
    }


    .test-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }


    .test-badge {
        padding: 6px 10px;
        border-radius: 30px;
        color: #4f46e5;
        background: #eef2ff;
        font-size: 10px;
        font-weight: 800;
    }


    .test-time {
        color: #64748b;
        font-size: 12px;
    }


    .test-card h3 {
        margin: 22px 0;
        color: #0f172a;
        font-size: 19px;
        font-weight: 750;
    }


    .test-info {
        display: flex;
        gap: 20px;
        padding: 15px 0;
        border-top: 1px solid #f1f5f9;
        border-bottom: 1px solid #f1f5f9;
    }


    .test-info span {
        display: flex;
        align-items: center;
        gap: 6px;
        color: #64748b;
        font-size: 12px;
    }


    .test-info i {
        color: #6366f1;
    }


    .test-button {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        margin-top: 20px;
        padding: 12px;
        border-radius: 11px;
        color: white;
        background: #4f46e5;
        text-decoration: none;
        font-size: 13px;
        font-weight: 700;
        transition: .25s;
    }


    .test-button:hover {
        color: white;
        background: #3730a3;
    }


    /* =========================================================
       COURSE
    ========================================================= */

    .course-card {
        height: 100%;
        overflow: hidden;
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 20px;
        transition: .25s;
    }


    .course-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 20px 45px rgba(15,23,42,.08);
    }


    .course-image {
        height: 190px;
        overflow: hidden;
    }


    .course-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }


    .course-placeholder {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 55px;
        background: linear-gradient(135deg,#4f46e5,#7c3aed);
    }


    .course-body {
        padding: 22px;
    }


    .course-tag {
        color: #6366f1;
        font-size: 11px;
        font-weight: 800;
        text-transform: uppercase;
    }


    .course-body h3 {
        margin: 9px 0;
