<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - My Learning</title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="~/css/student-theme.css" rel="stylesheet" />

    <style>
        body { font-family: 'Inter', sans-serif; background-color: #f8fafc; color: #1e293b; }
        
        #studentSidebar {
            width: 250px; background: #ffffff; border-right: 1px solid #e2e8f0;
            position: fixed; top: 0; left: 0; height: 100vh; z-index: 1000;
        }
        .sidebar-brand { padding: 1.5rem; font-weight: 700; color: #6366f1; }
        .nav-link { color: #64748b; font-weight: 500; padding: 0.75rem 1.25rem; margin: 0.25rem 0.75rem; border-radius: 0.5rem; }
        .nav-link:hover, .nav-link.active { color: #6366f1; background-color: #eef2ff; }
        
        #mainContent { margin-left: 250px; width: calc(100% - 250px); min-height: 100vh; }
        .student-navbar { height: 70px; background: #ffffff; border-bottom: 1px solid #e2e8f0; padding: 0 2rem; }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
     
    <nav id="studentSidebar">
        <div class="sidebar-brand d-flex align-items-center gap-2">
            <i class="bi bi-mortarboard-fill fs-4"></i> ManikaLearning
        </div>
        <div class="py-3">
            <ul class="nav flex-column">
                <li class="nav-item">
                    <a class="nav-link" asp-area="Student" asp-controller="Dashboard" asp-action="Index">
                        <i class="bi bi-grid-fill me-2"></i> My Dashboard
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-area="Student" asp-controller="MyCourses" asp-action="Index">
                        <i class="bi bi-play-btn-fill me-2"></i> My Courses
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-area="Student" asp-controller="MockTests" asp-action="Index">
                        <i class="bi bi-stopwatch-fill me-2"></i> Mock Tests
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-area="Student" asp-controller="PYQPractice" asp-action="Index">
                        <i class="bi bi-journal-check me-2"></i> PYQ Practice
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-area="Student" asp-controller="MistakeBook" asp-action="Index">
                        <i class="bi bi-exclamation-triangle-fill me-2 text-warning"></i> Mistake Book
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-area="Student" asp-controller="Bookmarks" asp-action="Index">
                        <i class="bi bi-bookmark-fill me-2"></i> Bookmarks
                    </a>
                </li>
                <li class="nav-item mt-4 border-top pt-3">
                    <a class="nav-link" asp-area="Student" asp-controller="Profile" asp-action="Index">
                        <i class="bi bi-person-fill me-2"></i> Profile & Billing
                    </a>
                </li>
            </ul>
        </div>
    </nav>
     
    <div id="mainContent">
        <header class="student-navbar d-flex align-items-center justify-content-between">
            <h5 class="fw-bold mb-0">@ViewData["Title"]</h5>
            
            <div class="d-flex align-items-center gap-3">
                <button class="btn btn-light rounded-circle shadow-none position-relative pt-1 pb-1">
                    <i class="bi bi-bell fs-5"></i>
                    <span class="position-absolute top-0 start-100 translate-middle p-1 bg-danger border border-light rounded-circle"></span>
                </button>
                <div class="dropdown">
                    <a href="#" class="d-flex align-items-center text-decoration-none text-dark fw-medium" data-bs-toggle="dropdown">
                        <img src="/images/avatar-placeholder.png" class="rounded-circle me-2 border" width="35" height="35" alt="User">
                        <span>Hi, Student!</span>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-3">
                        <li><a class="dropdown-item" asp-controller="Account" asp-action="Logout">Logout</a></li>
                    </ul>
                </div>
            </div>
        </header>

        <main class="p-4"> 
            <div id="toastContainer" class="toast-container position-fixed top-0 end-0 p-4" style="z-index: 1055;"></div>
            
            @RenderBody()
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/admin-ui.js"></script> 
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>