@{
    var title = ViewData["Title"] ?? "EduPrep";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@title - Manika Learning</title>

    <meta name="description"
          content="Prepare smarter with PYQs, mock tests, practice questions and expert courses." />

    <link rel="preconnect" href="https://fonts.googleapis.com">

    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Outfit:wght@500;600;700;800&display=swap"
          rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
          rel="stylesheet">

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>  
    <div class="top-offer-bar">
        <div class="container"> 
            <div class="d-flex justify-content-center align-items-center gap-2"> 
                <span class="offer-dot"></span> 
                <span>
                    New Batch Starting Soon
                </span> 
                <a href="/Courses"
                       class="offer-link">
                    Explore Courses
                    <i class="bi bi-arrow-right"></i>
                </a> 
            </div> 
        </div>
    </div>
      
    <header class="main-header"> 
        <nav class="navbar navbar-expand-lg"> 
            <div class="container">  
                <a class="navbar-brand brand"
                       asp-controller="Home"
                       asp-action="Index">

                    <span class="brand-icon">
                        <i class="bi bi-mortarboard-fill"></i>
                    </span>

                    <span>
                        Manika<span>Learning</span>
                    </span>

                </a>  
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"> 
                    <i class="bi bi-list"></i>

                </button> 

                <div class="collapse navbar-collapse"
                     id="mainNavbar"> 
                    <ul class="navbar-nav mx-auto">

                        <li class="nav-item">
                            <a class="nav-link"
                                   asp-controller="Home"
                                   asp-action="Index">
                                Home
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                                   asp-controller="Exams"
                                   asp-action="Index">
                                Exams
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                                   asp-controller="PYQ"
                                   asp-action="Index">
                                PYQs
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                                   asp-controller="Practice"
                                   asp-action="Index">
                                Practice
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                                   asp-controller="Tests"
                                   asp-action="Index">
                                Mock Tests
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                                   asp-controller="Courses"
                                   asp-action="Index">
                                Courses
                            </a>
                        </li>

                    </ul>
                      
                    <div class="nav-actions">

                        <a asp-controller="Account"
                               asp-action="Login"
                               class="login-link">
                            Login
                        </a>

                        <a asp-controller="Account"
                               asp-action="Register"
                               class="btn btn-primary-custom">
                            Get Started
                            <i class="bi bi-arrow-up-right"></i>
                        </a>

                    </div>

                </div>

            </div>

        </nav>

    </header>
     

    <main>

        @RenderBody()

    </main>

     

  @*   <section class="final-cta">

        <div class="container">

            <div class="cta-box">

                <div>

                    <span class="section-badge">
                        START YOUR PREPARATION
                    </span>

                    <h2>
                        Your next attempt
                        <br />
                        can be your <span>best one.</span>
                    </h2>

                    <p>
                        Practice smarter, understand your mistakes
                        and prepare with confidence.
                    </p>

                </div>

                <div>

                    <a asp-controller="Account"
                           asp-action="Register"
                           class="btn btn-light btn-lg px-4">

                        Start Preparing
                        <i class="bi bi-arrow-right ms-2"></i>

                    </a>

                </div>

            </div>

        </div>

    </section> *@

     

    <footer class="site-footer">

        <div class="container">

            <div class="row g-5">

                <div class="col-lg-4"> 
                    <a class="footer-brand"  asp-controller="Home"  asp-action="Index"> 
                        <span class="brand-icon">
                            <i class="bi bi-mortarboard-fill"></i>
                        </span>
                        Manika<span>Learning</span> 
                    </a>

                    <p class="footer-description">
                        A smarter preparation platform for competitive
                        exams with PYQs, practice, mock tests and
                        expert-led courses.
                    </p>

                    <div class="social-links">

                        <a href="#">
                            <i class="bi bi-instagram"></i>
                        </a>
                        @{
                            var youtube = "https://www.youtube.com/@manikalearningacademy";
                        }
                        <a href="@youtube" target="_blank">
                            <i class="bi bi-youtube"></i>
                        </a>

                        <a href="#">
                            <i class="bi bi-telegram"></i>
                        </a>

                        <a href="https://www.whatsapp.com/channel/0029Vb7XLuMLNSa6IBMp4N0G" target="_blank">
                            <i class="bi bi-whatsapp"></i>
                        </a>

                    </div>

                </div>


                <div class="col-6 col-lg-2">

                    <h6>Platform</h6>

                    <a href="/Exams">Exams</a>
                    <a href="/PYQ">PYQs</a>
                    <a href="/Practice">Practice</a>
                    <a href="/Tests">Mock Tests</a>

                </div>


                <div class="col-6 col-lg-2">

                    <h6>Learn</h6>

                    <a href="/Courses">Courses</a>
                    <a href="#">Free Content</a>
                    <a href="#">Study Material</a>
                    <a href="#">Results</a>

                </div>


                <div class="col-6 col-lg-2">

                    <h6>Company</h6>

                    <a href="#">About Us</a>
                    <a href="#">Contact</a>
                    <a href="#">Careers</a>
                    <a href="#">FAQs</a>

                </div>


                <div class="col-6 col-lg-2">

                    <h6>Legal</h6> 
                    <a href="#">Privacy</a>
                    <a href="#">Terms</a>
                    <a href="#">Refund Policy</a> 
                </div>

            </div> 

            <hr />

            <div class="footer-bottom">

                <span>
                    © @DateTime.Now.Year Manika Learning Academy. All rights reserved.
                </span>

                <span>
                    Made for learners.
                </span>

            </div>

        </div>

    </footer> 
    <a href="https://www.whatsapp.com/channel/0029Vb7XLuMLNSa6IBMp4N0G" class="floating-whatsapp">
        <i class="bi bi-whatsapp"></i> 
    </a> 

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"  asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>