@{
    var title = ViewData["Title"] ?? "Manika Learning Academy";

    // Menu active state: current controller ke hisaab se
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";

    string Active(params string[] names)
    {
        foreach (var n in names)
        {
            if (string.Equals(n, currentController, StringComparison.OrdinalIgnoreCase))
            {
                return "active";
            }
        }
        return "";
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@title - Manika Learning</title>

    <meta name="description"
          content="Prepare smarter with PYQs, mock tests, practice questions and expert courses." />

    <link rel="preconnect" href="https://fonts.googleapis.com">

    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Outfit:wght@500;600;700;800&display=swap"
          rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">
    <script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
          rel="stylesheet">

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout-extras.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>  
    <div class="top-offer-bar">
        <div class="container"> 
            <div class="d-flex justify-content-center align-items-center gap-2"> 
                <span class="offer-dot"></span> 
                <span>
                    New Batch Starting Soon
                </span> 
                <a href="/Courses"
                       class="offer-link">
                    Explore Courses
                    <i class="bi bi-arrow-right"></i>
                </a> 
            </div> 
        </div>
    </div>
      
    <header class="main-header"> 
        <nav class="navbar navbar-expand-lg"> 
            <div class="container">  
                <a class="navbar-brand brand"
                       asp-controller="Home"
                       asp-action="Index">
                    <span class="brand-icon">
                        <i class="bi bi-mortarboard-fill"></i>
                    </span>
                    <span>
                        Manika<span>Learning</span>
                    </span>

                </a>  
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-label="Toggle menu"> 
                    <i class="bi bi-list"></i>

                </button> 

                <div class="collapse navbar-collapse"
                     id="mainNavbar"> 
                    <ul class="navbar-nav mx-auto">

                        <li class="nav-item">
                            <a class="nav-link @Active("Home")"
                                   asp-controller="Home"
                                   asp-action="Index">
                                Home
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @Active("Exams")"
                                   asp-controller="Exams"
                                   asp-action="Index">
                                Exams
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @Active("PYQ")"
                                   asp-controller="PYQ"
                                   asp-action="Index">
                                PYQs
                            </a>
                        </li>
                        
                        <li class="nav-item">
                            <a class="nav-link @Active("Course", "Courses")"
                                   asp-controller="Course"
                                   asp-action="Index">
                                Courses
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @Active("Plans")"
                                   asp-controller="Plans"
                                   asp-action="Index">
                                Plans
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @Active("Tests")"
                                   asp-controller="Tests"
                                   asp-action="Index">
                                Mock Tests
                            </a>
                        </li>  
                    </ul>
                    <div class="nav-actions">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            var area = User.IsInRole("Admin") ? "Admin"
                                     : User.IsInRole("Teacher") ? "Teacher"
                                     : User.IsInRole("Student") ? "Student"
                                     : null;

                            @if (area != null)
                            {
                                <a asp-area="@area" asp-controller="Dashboard" asp-action="Index"
                                   class="btn btn-primary-custom">
                                    <i class="bi bi-speedometer2"></i>
                                    Go to Dashboard
                                </a>
                            }

                            <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                <button type="submit" class="login-link border-0 bg-transparent">Logout</button>
                            </form>
                        }
                        else
                        {
                            <a asp-area="" asp-controller="Account" asp-action="Login" class="login-link">Login</a> 
                            <a asp-area="" asp-controller="Account" asp-action="Register" class="btn btn-primary-custom">
                                Get Started
                                <i class="bi bi-arrow-up-right"></i>
                            </a>
                        }
                    </div>


                </div>

            </div>

        </nav>

    </header>
     

    <main>

        @RenderBody()

    </main>
      

    <footer class="site-footer">

        <div class="container">

            <div class="row g-5">

                <div class="col-lg-4"> 
                    <a class="footer-brand"  asp-controller="Home"  asp-action="Index"> 
                        <span class="brand-icon">
                            <i class="bi bi-mortarboard-fill"></i>
                        </span>
                        Manika<span>Learning</span> 
                    </a>

                    <p class="footer-description">
                        A smarter preparation platform for competitive
                        exams with PYQs, practice, mock tests and
                        expert-led courses.
                    </p>

                    <div class="social-links">

                        <a href="#">
                            <i class="bi bi-instagram"></i>
                        </a>
                        @{
                            var youtube = "https://www.youtube.com/@manikalearningacademy";
                        }
                        <a href="@youtube" target="_blank">
                            <i class="bi bi-youtube"></i>
                        </a>

                        <a href="#">
                            <i class="bi bi-telegram"></i>
                        </a>

                        <a href="https://www.whatsapp.com/channel/0029Vb7XLuMLNSa6IBMp4N0G" target="_blank">
                            <i class="bi bi-whatsapp"></i>
                        </a>

                    </div>

                </div>


                <div class="col-6 col-lg-2">

                    <h6>Platform</h6>

                    <a asp-controller="Exams" asp-action="Index">Exams</a>
                    <a asp-controller="PYQ" asp-action="Index">PYQs</a>
                    <a asp-controller="PYQ" asp-action="Index">Practice</a>
                    <a asp-controller="Course" asp-action="Index">Courses</a>
                </div>   

                <div class="col-6 col-lg-2">
                    <h6>Company</h6>
                    <a asp-controller="Pages" asp-action="About">About Us</a>
                    <a asp-controller="Pages" asp-action="Contact">Contact</a>
                    <a asp-controller="Pages" asp-action="Careers">Careers</a>
                    <a asp-controller="Pages" asp-action="Faq">FAQs</a>
                </div>

                <div class="col-6 col-lg-2">
                    <h6>Legal</h6>
                    <a asp-controller="Pages" asp-action="Privacy">Privacy Policy</a>
                    <a asp-controller="Pages" asp-action="Terms">Terms & Conditions</a>
                    <a asp-controller="Pages" asp-action="Refund">Refund Policy</a>
                </div>
            </div> 

            <hr />

            <div class="footer-bottom">

                <span>
                    © @DateTime.Now.Year Manika Learning Academy. All rights reserved.
                </span>

                <span>
                    Made for learners.
                </span>

            </div>

        </div>

    </footer> 

    <!-- Back to top: WhatsApp icon ke theek upar -->
    <button type="button" id="backToTop" class="back-to-top" aria-label="Back to top">
        <i class="bi bi-arrow-up"></i>
    </button>

    <a href="https://www.whatsapp.com/channel/0029Vb7XLuMLNSa6IBMp4N0G" class="floating-whatsapp" target="_blank" aria-label="WhatsApp">
        <i class="bi bi-whatsapp"></i> 
    </a> 
    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"  asp-append-version="true"></script>
    <script src="~/js/layout-extras.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
