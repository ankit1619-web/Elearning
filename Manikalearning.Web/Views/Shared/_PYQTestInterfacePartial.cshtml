@model Manikalearning.Web.Models.PYQQuestionVM

<div class="row g-4"> 
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white"> 
            <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                <div>
                    <span class="badge bg-primary-subtle text-primary fw-semibold px-3 py-2 rounded-pill" style="font-size: 0.8rem;">
                        Q. @Model.QuestionNumber / @Model.TotalQuestions
                    </span>
                    <span class="badge bg-light text-muted ms-2 px-3 py-2 rounded-pill border" style="font-size: 0.8rem;">
                        Topic: @Model.TopicName
                    </span>
                </div>
                <span class="text-muted small fw-medium">ID: (@Model.QuestionId)</span>
            </div> 
            <div class="mb-4">
                <div class="fw-bold text-dark mb-2" style="font-size: 1.05rem; line-height: 1.6;">
                    @Html.Raw(Model.EnglishText)
                </div>
            </div> 
            @if (!string.IsNullOrEmpty(Model.HindiText))
            {
                <div class="mb-4 p-3 bg-light rounded-3 border-start border-4 border-primary">
                    <div class="text-secondary" style="font-size: 0.95rem; line-height: 1.6;">
                        @Html.Raw(Model.HindiText)
                    </div>
                </div>
            } 
            <div class="pyq-options-list mb-4">
                @if (Model.Options != null)
                {
                    foreach (var opt in Model.Options)
                    {
                        <div class="pyq-option-item d-flex align-items-center p-3 mb-2 rounded-3 border transition-all hover-bg-light" style="cursor: pointer;" data-option-id="@opt.OptionId">
                            <div class="option-circle rounded-circle border d-flex align-items-center justify-content-center fw-bold me-3 text-secondary" style="width: 35px; height: 35px; min-width: 35px;">
                                @opt.OptionId
                            </div>
                            <div class="flex-grow-1 text-dark fw-medium" style="font-size: 0.95rem;">
                                @opt.OptionText
                            </div>
                        </div>
                    }
                }
            </div>
             
            <div class="bg-light p-3 rounded-3 mb-4 text-muted small">
                <strong>This Question came in:</strong> @Model.ExamSourceInfo
            </div>

            <div class="d-flex align-items-center justify-content-between pt-2 border-top">
                <div class="d-flex gap-2">
                    <button class="btn btn-outline-success btn-sm px-3 rounded-pill fw-semibold" id="btnShowExplanation">
                        <i class="bi bi-lightbulb-fill me-1"></i> Explanation
                    </button>
                    <button class="btn btn-outline-danger btn-sm px-3 rounded-pill fw-semibold" id="btnReportQuestion">
                        <i class="bi bi-flag-fill me-1"></i> Report Question
                    </button>
                </div>
            </div>
             
            <div id="explanationBox" class="mt-3 p-3 bg-success-subtle rounded-3 border border-success-subtle d-none">
                <h6 class="fw-bold text-success mb-2"><i class="bi bi-check-circle-fill me-1"></i> Correct Answer & Explanation</h6>
                <div class="text-dark small" style="line-height: 1.6;">
                    @Html.Raw(Model.ExplanationHtml)
                </div>
            </div>
        </div> 
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white mt-3">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div class="d-flex gap-2">
                    <button class="btn btn-success px-4 py-2 rounded-3 fw-semibold text-white" id="btnSaveNext" style="background-color: #16a34a; border: none;">Save & Next</button>
                    <button class="btn btn-indigo px-4 py-2 rounded-3 fw-semibold text-white" id="btnMarkReview" style="background-color: #4f46e5; border: none;">Mark for Review</button>
                </div>
                <button class="btn btn-outline-secondary px-4 py-2 rounded-3 fw-semibold" id="btnClearSelection">Clear</button>
            </div>
        </div>
    </div>
     
    <div class="col-lg-4"> 
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white mb-3 text-center">
            <div class="d-flex justify-content-between align-items-center">
                <span class="text-muted small fw-bold">TIME REMAINING</span>
                <span class="badge bg-danger-subtle text-danger px-3 py-2 rounded-pill fw-bold fs-6" id="testTimer">00:59:49</span>
            </div>
        </div>
         
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-3">
            <h6 class="fw-bold text-dark mb-3">Question Palette</h6>
            <div class="d-flex flex-wrap gap-2 mb-4" id="questionPaletteGrid"> 
                @for (int i = 1; i <= Model.TotalQuestions; i++)
                {
                    var activeClass = (i == Model.QuestionNumber) ? "border-2 border-dark" : "border-0";
                    var statusClass = (i == 1) ? "bg-success text-white" : "bg-light text-dark";
                    <a href="javascript:void(0)" class="palette-item @statusClass @activeClass rounded-2 d-flex align-items-center justify-content-center fw-bold text-decoration-none" style="width: 38px; height: 38px; font-size: 0.85rem;" data-qno="@i">
                        @i
                    </a>
                }
            </div>
             
            <div class="row g-2 pt-3 border-top text-muted" style="font-size: 0.75rem;">
                <div class="col-6 d-flex align-items-center gap-2">
                    <span class="rounded-circle bg-secondary opacity-25 d-inline-block" style="width: 12px; height: 12px;"></span> Not Visited
                </div>
                <div class="col-6 d-flex align-items-center gap-2">
                    <span class="rounded-circle bg-danger d-inline-block" style="width: 12px; height: 12px;"></span> Not Answered
                </div>
                <div class="col-6 d-flex align-items-center gap-2">
                    <span class="rounded-circle bg-success d-inline-block" style="width: 12px; height: 12px;"></span> Answered
                </div>
                <div class="col-6 d-flex align-items-center gap-2">
                    <span class="rounded-circle bg-primary d-inline-block" style="width: 12px; height: 12px; background-color: #4f46e5 !important;"></span> Marked For Review
                </div>
            </div>
        </div>
         
        <button class="btn btn-success w-100 py-3 rounded-4 fw-bold shadow-sm" style="background-color: #16a34a; border: none;">
            <i class="bi bi-check2-all me-1"></i> Submit Test
        </button>
    </div>
</div> 
<div class="modal fade" id="quitTestModal" tabindex="-1" aria-labelledby="quitTestModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 p-3">
            <div class="modal-body text-center py-4">
                <h5 class="fw-bold text-dark mb-4" id="quitTestModalLabel" style="font-size: 1.25rem;">
                    Sure to quit Test Series?
                </h5>
                <div class="d-flex justify-content-center gap-3">
                    <button type="button" class="btn btn-danger px-4 py-2 rounded-pill fw-semibold shadow-sm" id="btnConfirmQuit" style="background-color: #dc3526; border: none;">
                        Yes, quit!
                    </button>
                    <button type="button" class="btn btn-light border px-4 py-2 rounded-pill fw-semibold text-dark shadow-sm" data-bs-dismiss="modal">
                        Close
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
<style>
    .pyq-option-item.selected {
        background-color: #e0e7ff !important;
        border-color: #4f46e5 !important;
    }
    .pyq-option-item.selected .option-circle {
        background-color: #4f46e5 !important;
        color: #fff !important;
        border-color: #4f46e5 !important;
    }
</style>