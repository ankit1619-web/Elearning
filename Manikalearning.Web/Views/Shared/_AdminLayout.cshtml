<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Manika Learning Admin</title>
     
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet" />
     
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
     
    <link rel="stylesheet"  href="~/css/adminlayout.css"  asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false) 
</head>
<body>
     
    <nav id="sidebar">
        <div class="sidebar-brand">
            <i class="bi bi-mortarboard-fill fs-4 text-indigo"></i>
            <span>Manika Admin</span>
        </div>
        <div class="py-3 overflow-auto" style="height: calc(100vh - 75px);">
            <ul class="nav flex-column" id="adminSidebarMenu">
             
                <li class="nav-item">
                    <a class="nav-link" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                        <i class="bi bi-grid-1x2-fill"></i> Dashboard
                    </a>
                </li>
                 
                <li class="nav-item">
                    <a class="nav-link collapsed" data-bs-toggle="collapse" href="#menuUsers" role="button" aria-expanded="false">
                        <i class="bi bi-people-fill"></i> User Management <i class="bi bi-chevron-down ms-auto fs-7"></i>
                    </a>
                    <div class="collapse" id="menuUsers" data-bs-parent="#adminSidebarMenu">
                        <ul class="nav flex-column sub-menu ps-3">
                            <li><a class="nav-link" asp-area="Admin" asp-controller="Users" asp-action="Index">Users</a></li>
                            <li><a class="nav-link" asp-area="Admin" asp-controller="Roles" asp-action="Index">Roles</a></li>
                            <li><a class="nav-link" asp-area="Admin" asp-controller="UserRoles" asp-action="Index">User Roles</a></li>
                        </ul>
                    </div>
                </li>
                 
                <li class="nav-item">
                    <a class="nav-link collapsed" data-bs-toggle="collapse" href="#menuCurriculum" role="button" aria-expanded="false">
                        <i class="bi bi-diagram-3-fill"></i> Curriculum Setup <i class="bi bi-chevron-down ms-auto fs-7"></i>
                    </a>
                    <div class="collapse" id="menuCurriculum" data-bs-parent="#adminSidebarMenu">
                        <ul class="nav flex-column sub-menu ps-3">
                            <li><a class="nav-link" asp-area="Admin" asp-controller="Exams" asp-action="Index">Exams & Papers</a></li>
                            <li><a class="nav-link" asp-area="Admin" asp-controller="Subjects" asp-action="Index">Subjects</a></li>
                            <li><a class="nav-link" asp-area="Admin" asp-controller="Sections" asp-action="Index">Sections (PYQ Categories)</a></li>
                            <li><a class="nav-link" asp-area="Admin" asp-controller="Topics" asp-action="Index">Topics</a></li>
                            <li><a class="nav-link" asp-area="Admin" asp-controller="SubTopics" asp-action="Index">SubTopics</a></li>
                        </ul>
                    </div>
                </li>
                 
                <li class="nav-item">
                    <a class="nav-link collapsed" data-bs-toggle="collapse" href="#menuCourses" role="button" aria-expanded="false">
                        <i class="bi bi-camera-video-fill"></i> Course Builder <i class="bi bi-chevron-down ms-auto fs-7"></i>
                    </a>
                    <div class="collapse" id="menuCourses" data-bs-parent="#adminSidebarMenu">
                        <ul class="nav flex-column sub-menu ps-3">
                            <li><a class="nav-link" asp-area="Admin" asp-controller="Courses" asp-action="Index">All Courses</a></li>
                            <li><a class="nav-link" asp-area="Admin" asp-controller="CourseSections" asp-action="Index">Course Sections (Modules)</a></li>
                            <li><a class="nav-link" asp-area="Admin" asp-controller="CourseLectures" asp-action="Index">Lectures & Notes</a></li>
                            <li><a class="nav-link" asp-area="Admin" asp-controller="ExamCourses" asp-action="Index">Exam-Course Mapping</a></li>
                        </ul>
                    </div>
                </li>
                 
                <li class="nav-item">
                    <a class="nav-link collapsed" data-bs-toggle="collapse" href="#menuQuestionBank" role="button" aria-expanded="false">
                        <i class="bi bi-database-fill"></i> Question Bank <i class="bi bi-chevron-down ms-auto fs-7"></i>
                    </a>
                    <div class="collapse" id="menuQuestionBank" data-bs-parent="#adminSidebarMenu">
                        <ul class="nav flex-column sub-menu ps-3">
                            <li><a class="nav-link" asp-area="Admin" asp-controller="Questions" asp-action="Index">Manage Questions</a></li>
                            <li><a class="nav-link" asp-area="Admin" asp-controller="QuestionOptions" asp-action="Index">Question Options</a></li>
                            <li><a class="nav-link" asp-area="Admin" asp-controller="QuestionPassages" asp-action="Index">Passages (Comprehension)</a></li>
                        </ul>
                    </div>
                </li>
                 
                <li class="nav-item">
                    <a class="nav-link collapsed" data-bs-toggle="collapse" href="#menuMockTests" role="button" aria-expanded="false">
                        <i class="bi bi-ui-checks"></i> Mock Tests <i class="bi bi-chevron-down ms-auto fs-7"></i>
                    </a>
                    <div class="collapse" id="menuMockTests" data-bs-parent="#adminSidebarMenu">
                        <ul class="nav flex-column sub-menu ps-3">
                            <li><a class="nav-link" asp-area="Admin" asp-controller="Tests" asp-action="Index">Test Series Setup</a></li>
                            <li><a class="nav-link" asp-area="Admin" asp-controller="TestQuestions" asp-action="Index">Test Questions</a></li>
                            <li><a class="nav-link" asp-area="Admin" asp-controller="TestAttempts" asp-action="Index">Student Attempts</a></li>
                            <li><a class="nav-link" asp-area="Admin" asp-controller="TestAttemptAnswers" asp-action="Index">Attempt Answers</a></li>
                        </ul>
                    </div>
                </li>
                 
                <li class="nav-item">
                    <a class="nav-link collapsed" data-bs-toggle="collapse" href="#menuSales" role="button" aria-expanded="false">
                        <i class="bi bi-credit-card-fill"></i> Sales & Revenue <i class="bi bi-chevron-down ms-auto fs-7"></i>
                    </a>
                    <div class="collapse" id="menuSales" data-bs-parent="#adminSidebarMenu">
                        <ul class="nav flex-column sub-menu ps-3">
                            <li><a class="nav-link" asp-area="Admin" asp-controller="Plans" asp-action="Index">Subscription Plans</a></li>
                            <li><a class="nav-link" asp-area="Admin" asp-controller="PlanCourses" asp-action="Index">Plan-Course Access</a></li>
                            <li><a class="nav-link" asp-area="Admin" asp-controller="Coupons" asp-action="Index">Promo Coupons</a></li>
                            <li><a class="nav-link" asp-area="Admin" asp-controller="Payments" asp-action="Index">Payment Transactions</a></li>
                        </ul>
                    </div>
                </li>
                 
                <li class="nav-item">
                    <a class="nav-link collapsed" data-bs-toggle="collapse" href="#menuStudents" role="button" aria-expanded="false">
                        <i class="bi bi-person-lines-fill"></i> Student Tracking <i class="bi bi-chevron-down ms-auto fs-7"></i>
                    </a>
                    <div class="collapse" id="menuStudents" data-bs-parent="#adminSidebarMenu">
                        <ul class="nav flex-column sub-menu ps-3">
                            <li><a class="nav-link" asp-area="Admin" asp-controller="StudentSubscriptions" asp-action="Index">Active Subscriptions</a></li>
                            <li><a class="nav-link" asp-area="Admin" asp-controller="StudentCourses" asp-action="Index">Enrolled Courses</a></li>
                            <li><a class="nav-link" asp-area="Admin" asp-controller="StudentLectureProgress" asp-action="Index">Lecture Progress</a></li>
                            <li><a class="nav-link" asp-area="Admin" asp-controller="Bookmarks" asp-action="Index">Saved Bookmarks</a></li>
                            <li><a class="nav-link" asp-area="Admin" asp-controller="QuestionMistakes" asp-action="Index">Mistake Book</a></li>
                        </ul>
                    </div>
                </li> 
            </ul>
        </div>
    </nav>
     
    <div id="content"> 
        <header class="admin-navbar">
            <div class="d-flex align-items-center gap-3">
                <button class="btn btn-light border-0 shadow-none d-md-none" id="sidebarToggle">
                    <i class="bi bi-list fs-5"></i>
                </button>
                <h5 class="fw-bold mb-0 text-dark">@ViewData["HeaderTitle"]</h5>
            </div>
            <div class="d-flex align-items-center gap-3">
                <div class="dropdown">
                    <a href="#" class="d-flex align-items-center text-decoration-none dropdown-toggle text-dark fw-medium" data-bs-toggle="dropdown">
                        <div class="bg-indigo-subtle text-indigo rounded-circle d-flex align-items-center justify-content-center me-2" style="width: 38px; height: 38px; background-color: #eef2ff; color: #6366f1;">
                            <i class="bi bi-person-fill"></i>
                        </div>
                        <span>Administrator</span>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 rounded-3">
                        <li><a class="dropdown-item py-2" href="#"><i class="bi bi-gear me-2"></i> Settings</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <form asp-controller="Account" asp-action="Logout" method="post" id="logoutForm" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="dropdown-item text-danger fw-medium d-flex align-items-center gap-2">
                                <i class="bi bi-box-arrow-right"></i> Sign Out
                            </button>
                        </form>
                    </ul>
                </div>
            </div>
        </header>
         
        <main class="p-4">
            <div id="globalLoader" class="d-none">
                <div class="spinner-border shadow-sm" style="color: #6366f1; width: 3.5rem; height: 3.5rem; border-width: 0.35em;" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </div> 
            <div class="modal fade" id="globalModal" tabindex="-1" aria-labelledby="globalModalTitle" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
                <div class="modal-dialog modal-dialog-centered" id="globalModalSize">
                    <div class="modal-content rounded-4 border-0 shadow-lg" id="globalModalContent">
                      
                    </div>
                </div>
            </div>
            <div class="toast-container position-fixed top-0 end-0 p-4" style="z-index: 1055;" id="toastContainer"> 
            </div>
            @RenderBody()
        </main>
    </div>
    <script src="~/js/admin-ui.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>