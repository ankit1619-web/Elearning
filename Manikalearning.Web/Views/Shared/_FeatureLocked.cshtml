@using Manikalearning.Application.DTOs
@model string

<div class="modal-header border-bottom-0 pb-0">
    <h5 class="modal-title fw-bold text-dark" id="globalModalTitle">Upgrade required</h5>
    <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<div class="modal-body text-center px-4 py-4">
    <div style="width:56px;height:56px;border-radius:16px;background:#eceafd;color:var(--brand);display:inline-flex;align-items:center;justify-content:center;font-size:1.6rem;margin-bottom:.8rem">
        <i class="bi bi-lock-fill"></i>
    </div>
    <h3 style="font-size:1.1rem;font-weight:800;margin:0 0 .3rem">@PlanFeatureCodes.Label(Model) is not in your plan</h3>
    <p style="color:var(--muted);margin:0">@PlanFeatureCodes.Description(Model)</p>
</div>

<div class="modal-footer border-top-0 pt-0 justify-content-center gap-2">
    <button type="button" class="btn btn-light rounded-3 px-4" data-bs-dismiss="modal">Cancel</button>
    <a class="btn btn-pyq-blue rounded-3 px-4 shadow-sm" asp-area="Student" asp-controller="Subscription" asp-action="Index">
        <i class="bi bi-stars me-1"></i> View plans
    </a>
</div>