 
@model Manikalearning.Application.DTOs.PyqResultVm
@{
    Layout = "_CbtLayout";
    ViewData["Title"] = "Result";
}

<div class="cbt-center">
    <div class="cbt-card">
        <i class="bi bi-trophy-fill" style="font-size:3.2rem;color:#f59e0b"></i>
        <h1 style="font-size:1.6rem;font-weight:800;letter-spacing:-.02em;margin:.5rem 0">
            @(Model.AutoSubmitted ? "Time is up. Your test was submitted." : "Test submitted successfully!")
        </h1>

        <div class="res-grid">
            <div class="res-box"><small>Total</small><strong>@Model.TotalQuestions</strong></div>
            <div class="res-box good"><small>Correct</small><strong>@Model.CorrectAnswers</strong></div>
            <div class="res-box bad"><small>Incorrect</small><strong>@Model.WrongAnswers</strong></div>
            <div class="res-box"><small>Skipped</small><strong>@Model.SkippedQuestions</strong></div>
        </div>

        <div class="score">Score: @Model.Score / @Model.TotalMarks &nbsp;|&nbsp; Accuracy: @Model.Accuracy%</div>

        @if (!Model.Saved && !string.IsNullOrEmpty(Model.SaveNotice))
        {
            <div style="margin:0 auto 1.4rem;max-width:520px;padding:1rem 1.2rem;border-radius:14px;background:var(--mk-soft);color:var(--cb-text);text-align:left;font-size:.92rem">
                <strong>Result not saved.</strong> @Model.SaveNotice
                @if (!string.IsNullOrEmpty(Model.SaveLink)) { <div style="margin-top:.7rem"><a class="b b-solid b-sm" href="@Model.SaveLink">@Model.SaveLinkText</a></div> }
            </div>
        }

        <div class="b-group b-group-stack" style="justify-content:center">
            @if (Model.Saved) { <a class="b b-line" asp-area="Student" asp-controller="MistakeBook" asp-action="Index">Review mistakes</a> }
            <a class="b b-solid" href="@(string.IsNullOrEmpty(Model.ExitUrl) ? Url.Action("Index", "PYQPractice", new { area = "Student" }) : Model.ExitUrl)">@Model.ExitLabel</a>
        </div>
    </div>
</div>
