@using Manikalearning.Application.DTOs
@model WatchIndexViewModel

@{
    ViewData["Title"] = Model.CourseOverview.CourseTitle;
}

<section class="exam-detail-hero">
    <div class="container">
        <div class="exam-breadcrumb">
            <a asp-controller="Home" asp-action="Index">Home</a>
            <i class="bi bi-chevron-right"></i>
            <a asp-controller="Course" asp-action="Index">Courses</a>
            <i class="bi bi-chevron-right"></i>
            <span>@Model.CourseOverview.CourseTitle</span>
        </div>
        <div class="row align-items-center g-5">
            <div class="col-lg-8">
                <div class="exam-detail-badge">
                    <i class="bi bi-patch-check-fill"></i>
                    EXPERT-LED COURSE
                </div>
                <h1>@Model.CourseOverview.CourseTitle</h1>
                <p class="exam-detail-description">
                    @(Model.CourseOverview.CourseDescription ?? "Comprehensive course featuring high-yield video lectures, structured notes, and interactive practice tests to master your curriculum.")
                </p>
                <div class="hero-buttons">
                    <a asp-area="Student" asp-controller="Watch" asp-action="Index" asp-route-courseId="@Model.CourseOverview.CourseId" class="btn btn-primary btn-lg">
                        <i class="bi bi-play-circle-fill"></i>
                        Start Learning Now
                    </a>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="exam-hero-image">
                    <div class="card border-0 shadow-lg rounded-4 p-4 bg-white text-dark w-100">
                        <div class="text-center mb-3">
                            <h2 class="fw-bold mb-0" style="color: #1e293b;">₹@Model.CourseOverview.Price.ToString("N0")</h2>
                            <span class="text-muted small text-decoration-line-through">₹@(Model.CourseOverview.Price + 1000)</span>
                        </div>
                        <ul class="list-unstyled small mb-4 text-start">
                            <li class="py-2 border-bottom"><i class="bi bi-check-circle-fill me-2" style="color: #4f46e5;"></i> Full lifetime access</li>
                            <li class="py-2 border-bottom"><i class="bi bi-check-circle-fill me-2" style="color: #4f46e5;"></i> Topic-wise PYQs & Solutions</li>
                            <li class="py-2"><i class="bi bi-check-circle-fill me-2" style="color: #4f46e5;"></i> Interactive Reading & Test Mode</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap');

  

    /* Sidebar Course Content */
    .sidebar-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        overflow: hidden;
    }

    .sidebar-header {
        padding: 1.2rem 1.5rem;
        font-weight: 700;
        font-size: 1.1rem;
        color: #0f172a;
        display: flex;
        align-items: center;
        gap: 10px;
        border-bottom: 1px solid #f1f5f9;
    }

    .course-module-accordion .accordion-item {
        border: 1px solid #e2e8f0;
        border-radius: 12px !important;
        margin-bottom: 0.75rem;
        overflow: hidden;
    }

    .course-module-accordion .accordion-button {
        font-weight: 700;
        font-size: 0.95rem;
        color: #1e293b;
        background: #ffffff;
        padding: 1rem 1.25rem;
        box-shadow: none !important;
    }

        .course-module-accordion .accordion-button:not(.collapsed) {
            background: #f8fafc;
            color: #0f172a;
        }

    /* Lecture List Items */
    .lecture-list-group {
        padding: 0.5rem;
    }

    .lecture-item {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        padding: 0.85rem 1rem;
        border-radius: 10px;
        text-decoration: none;
        color: #334155;
        transition: all 0.2s ease;
        position: relative;
        margin-bottom: 4px;
        cursor: pointer;
    }

        .lecture-item:hover {
            background-color: #f1f5f9;
            color: #0f172a;
        }

        .lecture-item.active {
            background-color: #f0fdf4;
            color: #0f172a;
            font-weight: 600;
        }

            .lecture-item.active::before {
                content: '';
                position: absolute;
                left: 0;
                top: 0;
                bottom: 0;
                width: 4px;
                background-color: #4f46e5;
                border-top-left-radius: 10px;
                border-bottom-left-radius: 10px;
            }

    .lecture-num {
        font-weight: 600;
        color: #64748b;
        font-size: 0.9rem;
        min-width: 18px;
    }

    .lecture-info-title {
        font-size: 0.875rem;
        line-height: 1.4;
        margin-bottom: 4px;
    }

    .badge-free {
        background-color: #dcfce7;
        color: #15803d;
        font-size: 0.7rem;
        font-weight: 700;
        padding: 2px 8px;
        border-radius: 999px;
    }

    .lec-done {
        display: none;
        color: #16a34a;
        margin-left: auto;
        font-size: 1rem;
        flex-shrink: 0;
    }

    .lecture-item.done .lec-done {
        display: inline-block;
    }

    .lecture-type-icon {
        font-size: 0.75rem;
        color: #6366f1;
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }
</style>

<style>
    .transition-all {
        transition: all 0.2s ease-in-out;
    }

    .hover-bg-light:hover {
        background-color: #f8fafc !important;
        cursor: pointer;
    }

    .accordion-button:not(.collapsed) {
        background-color: #f8fafc;
        color: #4f46e5;
        box-shadow: inset 0 -1px 0 rgba(0,0,0,.125);
    }

    .accordion-button:focus {
        border-color: #4f46e5;
        box-shadow: 0 0 0 0.25rem rgba(79, 70, 229, 0.25);
    }

    .reading-content {
        font-size: 0.95rem;
        line-height: 1.7;
    }

    .active-lecture {
        background-color: #f8fafc !important;
        border-left: 4px solid #4f46e5 !important;
    }
</style>

<div class="container-fluid py-3 px-lg-4">
    <div class="row g-4">
        <div class="col-lg-4 col-xl-3">
            <div class="sidebar-card shadow-sm">
                <div class="sidebar-header">
                    <i class="bi bi-list-stars text-primary fs-5"></i>
                    <span>Course Content</span>
                </div>

                <div class="p-3">
                    <div class="accordion course-module-accordion" id="sidebarAccordion">
                        @if (Model.CourseOverview.Modules != null && Model.CourseOverview.Modules.Any())
                        {
                            for (int i = 0; i < Model.CourseOverview.Modules.Count; i++)
                            {
                                var module = Model.CourseOverview.Modules[i];
                                var collapseId = $"collapse_mod_{module.ModuleId}";
                                var headingId = $"heading_mod_{module.ModuleId}";
                                var hasActiveLesson = module.Lessons.Any(l => l.LessonId == Model.CurrentLesson.LessonId);

                                <div class="accordion-item">
                                    <h2 class="accordion-header" id="@headingId">
                                        <button class="accordion-button @(hasActiveLesson || i == 0 ? "" : "collapsed")"
                                                type="button"
                                                data-bs-toggle="collapse"
                                                data-bs-target="#@collapseId"
                                                aria-expanded="@(hasActiveLesson || i == 0 ? "true" : "false")">
                                            @module.Title
                                        </button>
                                    </h2>
                                    <div id="@collapseId"
                                         class="accordion-collapse collapse @(hasActiveLesson || i == 0 ? "show" : "")"
                                         data-bs-parent="#sidebarAccordion">
                                        <div class="accordion-body p-0">
                                            <div class="lecture-list-group">
                                                @for (int j = 0; j < module.Lessons.Count; j++)
                                                {
                                                    var lesson = module.Lessons[j];
                                                    var isActive = lesson.LessonId == Model.CurrentLesson.LessonId;

                                                    <div class="lecture-item js-lecture-click @(isActive ? "active" : "")"
                                                         data-course-id="@Model.CourseOverview.CourseId"
                                                         data-lesson-id="@lesson.LessonId">

                                                        <span class="lecture-num">@(j + 1)</span>
                                                        <div class="flex-grow-1">
                                                            <div class="lecture-info-title fw-semibold">
                                                                @lesson.Title
                                                            </div>
                                                            <div class="d-flex align-items-center gap-2">
                                                                @if (lesson.IsFree)
                                                                {
                                                                    <span class="badge-free">Free</span>
                                                                }
                                                                <span class="lecture-type-icon">
                                                                    <i class="bi bi-play-circle-fill"></i> Video
                                                                </span>
                                                            </div>
                                                        </div>
                                                        @* once your lesson DTO has IsCompleted, use:  class="lec-done"  +  add "done" to the row class when lesson.IsCompleted *@
                                                        <i class="bi bi-check-circle-fill lec-done" title="Completed"></i>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-8 col-xl-9" id="lessonPlayerContainer">
            @await Html.PartialAsync("_LectureViewerPartial", Model.CurrentLesson)
        </div>

    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $(document).on('click', '.js-lecture-click', function() {
                var $this = $(this);
                var courseId = $this.data('course-id');
                var lessonId = $this.data('lesson-id');

                if (window.flushLessonProgress) window.flushLessonProgress();

                $('.js-lecture-click').removeClass('active'); $this.addClass('active');

                $('#lessonPlayerContainer').html(`
                                    <div class="d-flex flex-column justify-content-center align-items-center py-5 my-5">
                                        <div class="spinner-border text-primary mb-3" role="status"></div>
                                        <p class="text-muted fw-semibold">Lecture loading...</p>
                                    </div>
                                `);

                $.ajax({
                    url: '/Course/GetLesson',
                    type: 'GET',
                    data: { courseId: courseId, lessonId: lessonId },
                    success: function(partialHtml) {
                        $('#lessonPlayerContainer').html(partialHtml);
                    },
                    error: function() {
                        $('#lessonPlayerContainer').html(`
                                            <div class="alert alert-danger p-4 text-center rounded-4">
                                                <i class="bi bi-exclamation-triangle fs-3 d-block mb-2"></i>
                                                We could not load this lecture. Please refresh and try again.
                                            </div>
                                        `);
                    }
                });
            });
        });
    </script>
}
  