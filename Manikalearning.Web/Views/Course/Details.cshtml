@model Manikalearning.Web.Models.CourseVM

@{
    ViewData["Title"] = Model.CourseName;
}

<section class="exam-detail-hero">
    <div class="container">
        <div class="exam-breadcrumb">
            <a asp-controller="Home" asp-action="Index">Home</a>
            <i class="bi bi-chevron-right"></i>
            <a asp-controller="Course" asp-action="Index">Courses</a>
            <i class="bi bi-chevron-right"></i>
            <span>@Model.CourseName</span>
        </div>
        <div class="row align-items-center g-5">
            <div class="col-lg-8">
                <div class="exam-detail-badge">
                    <i class="bi bi-patch-check-fill"></i>
                    EXPERT-LED COURSE
                </div>
                <h1>@Model.CourseName</h1>
                <p class="exam-detail-description">
                    @(Model.Description ?? "Comprehensive course featuring high-yield video lectures, structured notes, and interactive practice tests to master your curriculum.")
                </p>
                <div class="hero-buttons">
                    <a asp-controller="Student" asp-action="Learning" asp-route-courseId="@Model.CourseId" class="btn btn-primary btn-lg">
                        <i class="bi bi-play-circle-fill"></i>
                        Start Learning Now
                    </a>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="exam-hero-image">
                    <div class="card border-0 shadow-lg rounded-4 p-4 bg-white text-dark w-100">
                        <div class="text-center mb-3">
                            <h2 class="fw-bold mb-0" style="color: #1e293b;">₹@Model.Price.ToString("N0")</h2>
                            <span class="text-muted small text-decoration-line-through">₹@(Model.Price + 1000)</span>
                        </div>
                        <ul class="list-unstyled small mb-4 text-start">
                            <li class="py-2 border-bottom"><i class="bi bi-check-circle-fill me-2" style="color: #4f46e5;"></i> Full lifetime access</li>
                            <li class="py-2 border-bottom"><i class="bi bi-check-circle-fill me-2" style="color: #4f46e5;"></i> Topic-wise PYQs & Solutions</li>
                            <li class="py-2"><i class="bi bi-check-circle-fill me-2" style="color: #4f46e5;"></i> Interactive Reading & Test Mode</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="exam-stats-section">
    <div class="container">
        <div class="exam-stat-grid">
            <div class="exam-stat-card">
                <div class="stat-icon purple">
                    <i class="bi bi-collection-play-fill"></i>
                </div>
                <div>
                    <strong>@Model.TotalLectures.ToString("N0")</strong>
                    <span>Total Lectures</span>
                </div>
            </div>
            <div class="exam-stat-card">
                <div class="stat-icon blue">
                    <i class="bi bi-journal-text"></i>
                </div>
                <div>
                    <strong>100%</strong>
                    <span>Sponsorship Coverage</span>
                </div>
            </div>
            <div class="exam-stat-card">
                <div class="stat-icon orange">
                    <i class="bi bi-stopwatch-fill"></i>
                </div>
                <div>
                    <strong>Lifetime</strong>
                    <span>Access Validity</span>
                </div>
            </div>
            <div class="exam-stat-card">
                <div class="stat-icon green">
                    <i class="bi bi-shield-check"></i>
                </div>
                <div>
                    <strong>Verified</strong>
                    <span>Expert Content</span>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="exam-content-section">
    <div class="container">
        <div class="content-header tests-header">
            <div>
                <span class="section-label">COURSE SYLLABUS</span>
                <h2>Course Curriculum</h2>
                <p>Explore structured sections, video concepts, and practice modules.</p>
            </div>
        </div>

        <div class="row g-4">
            <!-- LEFT SIDE: Course Syllabus -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white sticky-top" style="top: 20px; z-index: 10;">
                    <div class="card-header bg-white border-bottom-0 pt-4 pb-2 px-4 rounded-top-4">
                        <h5 class="fw-bold mb-0 text-dark">
                            <i class="bi bi-list-ul me-2" style="color: #4f46e5;"></i> Course Content
                        </h5>
                    </div>
                    <div class="card-body p-0 pb-3">
                        <div class="accordion accordion-flush" id="courseSyllabus">
                            @if (Model.Sections != null && Model.Sections.Any())
                            {
                                int index = 1;
                                foreach (var section in Model.Sections)
                                {
                                    <div class="accordion-item border-0 mb-1 overflow-hidden">
                                        <h2 class="accordion-header px-3" id="heading@(section.CourseSectionId)">
                                            <button class="accordion-button collapsed fw-semibold text-dark bg-light rounded-3 shadow-none py-3" type="button" data-bs-toggle="collapse" data-bs-target="#collapse@(section.CourseSectionId)">
                                                 @(section.SectionName)
                                            </button>
                                        </h2>
                                        <div id="collapse@(section.CourseSectionId)" class="accordion-collapse collapse" data-bs-parent="#courseSyllabus">
                                            <div class="accordion-body p-0 bg-white">
                                                <div class="list-group list-group-flush rounded-0 px-2 py-1">
                                                    @if (section.Lectures != null && section.Lectures.Any())
                                                    {
                                                        int lecIndex = 1;
                                                        foreach (var lecture in section.Lectures)
                                                        {
                                                            <a href="javascript:void(0)" 
                                                               class="list-group-item list-group-item-action d-flex align-items-start p-3 border-0 rounded-3 mb-1 transition-all hover-bg-light lecture-btn @(lecIndex == 1 && index == 1 ? "active-lecture bg-light" : "")"
                                                               data-lecture-id="@lecture.LectureId">
                                                                <div class="text-muted fw-bold small me-3 mt-1" style="width: 15px;">
                                                                    @lecIndex
                                                                </div>
                                                                <div class="flex-grow-1">
                                                                    <div class="fw-semibold text-dark mb-1 lh-sm" style="font-size: 0.9rem;">
                                                                        @lecture.LectureTitle
                                                                    </div>
                                                                    <div class="d-flex align-items-center flex-wrap gap-2">
                                                                        @if (lecture.IsFreePreview)
                                                                        {
                                                                            <span class="badge rounded-pill bg-success-subtle text-success border border-success-subtle px-2 py-0" style="font-size: 0.65rem;">Free</span>
                                                                        }
                                                                        else
                                                                        {
                                                                            <i class="bi bi-lock-fill text-muted" style="font-size: 0.7rem;"></i>
                                                                        }
                                                                        <span class="text-muted" style="font-size: 0.75rem;">
                                                                            <i class="bi bi-play-circle me-1" style="color: #4f46e5;"></i> Video
                                                                        </span>
                                                                    </div>
                                                                </div>
                                                            </a>
                                                            lecIndex++;
                                                        }
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    index++;
                                }
                            }
                        </div>
                    </div>
                </div>
            </div>
             
            <div class="col-lg-8" id="lectureViewerContainer">
                @{ 
                    var firstLecture = Model.Sections?.FirstOrDefault()?.Lectures?.FirstOrDefault();
                }
                
                @if (firstLecture != null)
                {
                    @await Html.PartialAsync("_LectureViewerPartial", firstLecture)
                }
                else
                { 
                    <div class="card border-0 shadow-sm rounded-4 p-5 bg-white text-center h-100 d-flex align-items-center justify-content-center">
                        <div>
                            <i class="bi bi-play-circle-fill text-muted opacity-25" style="font-size: 4rem;"></i>
                            <h5 class="mt-3 fw-bold text-dark opacity-50">No Lectures Available</h5>
                            <p class="text-muted small">Select a lecture from the syllabus to start learning.</p>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

<section class="exam-final-cta">
    <div class="container">
        <div class="final-cta-card">
            <div class="cta-content">
                <span>READY TO ACCELERATE?</span>
                <h2>Start Learning @Model.CourseName Today.</h2>
                <p>Unlock video tutorials, curated resources, and practice tests with your complete learning path.</p>
                <div class="cta-actions">
                    <a asp-controller="Student" asp-action="Learning" asp-route-courseId="@Model.CourseId" class="btn btn-light">
                        Start Learning Now
                        <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
            <div class="cta-icon">
                <i class="bi bi-trophy-fill"></i>
            </div>
        </div>
    </div>
</section>

<style>
    .transition-all {
        transition: all 0.2s ease-in-out;
    }
    .hover-bg-light:hover {
        background-color: #f8fafc !important;
        cursor: pointer;
    }
    .accordion-button:not(.collapsed) {
        background-color: #f8fafc;
        color: #4f46e5;
        box-shadow: inset 0 -1px 0 rgba(0,0,0,.125);
    }
    .accordion-button:focus {
        border-color: #4f46e5;
        box-shadow: 0 0 0 0.25rem rgba(79, 70, 229, 0.25);
    }
    .reading-content {
        font-size: 0.95rem;
        line-height: 1.7;
    }
    .active-lecture {
        background-color: #f8fafc !important;
        border-left: 4px solid #4f46e5 !important;
    }
</style>
 
<script> 
    $(document).ready(function () { 
        $(document).on('click', '.lecture-btn', function (e) {
            e.preventDefault();
            
            var lectureId = $(this).data('lecture-id');
             
            $('.lecture-btn').removeClass('active-lecture bg-light');
            $(this).addClass('active-lecture bg-light');
             
            $('#lectureViewerContainer').html(`
                <div class="text-center py-5 bg-white rounded-4 shadow-sm">
                    <div class="spinner-border text-primary" role="status" style="color: #4f46e5 !important;"></div>
                    <p class="mt-2 text-muted small mb-0">Loading lecture content...</p>
                </div>
            `);
             
            $.ajax({
                url: '/Course/GetLecturePartial',
                type: 'GET',
                data: { lectureId: lectureId },
                success: function (data) {
                    $('#lectureViewerContainer').html(data);
                },
                error: function () {
                    $('#lectureViewerContainer').html(`
                        <div class="alert alert-danger rounded-4">Failed to load lecture content.</div>
                    `);
                }
            });
        });
         
        $(document).on('click', '.btn-show-ans', function () {
            $(this).next('.ans-box').toggleClass('d-none');
        }); 
        $(document).on('click', '#btnOpenTestModal', function () {
            var quitModal = new bootstrap.Modal(document.getElementById('quitTestModal'));
            quitModal.show();
        });
         
        $(document).on('click', '#btnConfirmQuit', function () { 
            window.location.href = '/Course/Index';  
        });
    });
</script> 