@model Manikalearning.Web.Models.PublicLectureVM
 
<div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4 bg-black">
    <div class="ratio ratio-16x9 d-flex align-items-center justify-content-center">
        @if (!string.IsNullOrEmpty(Model?.VideoUrl))
        {
            <iframe src="@Model.VideoUrl" allowfullscreen class="w-100 h-100 border-0"></iframe>
        }
        else
        {
            <div class="text-center text-white opacity-50 d-flex flex-column align-items-center justify-content-center h-100">
                <i class="bi bi-play-circle-fill" style="font-size: 4rem;"></i>
                <p class="mt-2 fw-light">@Model?.LectureTitle</p>
            </div>
        }
    </div>
</div>
 
<div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
    <div class="d-flex justify-content-between align-items-start mb-4 flex-wrap gap-3 border-bottom pb-3">
        <div>
            <h4 class="fw-bold text-dark mb-1">@(Model?.LectureTitle ?? "Select a Lecture")</h4>
            @if (!string.IsNullOrEmpty(Model?.CourseName))
            {
                <span class="text-muted small">in @Model.CourseName</span>
            }
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-light border btn-sm shadow-none rounded-pill px-3">
                <i class="bi bi-question-circle me-1" style="color: #4f46e5;"></i> Ask Doubt
            </button>
            <button class="btn btn-light border btn-sm shadow-none rounded-pill px-3">
                <i class="bi bi-star-fill text-warning me-1"></i> Reviews
            </button>
        </div>
    </div>
      
    <div class="reading-mode-box border rounded-3 overflow-hidden">
         
        <div class="p-3 d-flex justify-content-between align-items-center text-white" style="background-color: #212529;">
            <h6 class="mb-0 fw-bold d-flex align-items-center text-white" style="font-size: 1rem;">
                @(Model?.LectureTitle ?? "Teaching Aptitude Basics")
            </h6>
            <div class="d-flex gap-2 align-items-center">
                <form asp-controller="PYQ" asp-action="StartPYQTest" method="get" class="d-inline"> 
                    <input type="hidden" name="sectionId" value="@Model.CourseSectionId" />
    
                    <button type="submit" class="btn btn-sm text-white shadow-none px-3 py-1 rounded-1" style="background-color: #0d6efd; font-size: 0.85rem;">
                        Topic-wise PYQs
                    </button>
                </form>
                <button class="btn btn-sm btn-light border-0 shadow-none px-2 py-1" onclick="window.print()" title="Print Notes">
                    <i class="bi bi-floppy text-dark"></i>
                </button>
            </div>
        </div>
          
        <div class="p-4 bg-white reading-content">
            @if (!string.IsNullOrEmpty(Model?.NotesHtml))
            {
                @Html.Raw(Model.NotesHtml)
            }
            else
            { 
                <div class="notes-section mb-4">
                    <h5 class="fw-bold text-dark text-uppercase mb-2" style="font-size: 1.05rem;">LEVELS OF TEACHING</h5>
                    <p class="text-dark mb-2">The level of teaching generally comprises three levels as stated below:-</p>
                    <p class="mb-1"><strong>Memory level</strong>: Thoughtless teaching</p>
                    <p class="mb-1"><strong>Understanding level</strong>: Thoughtful teaching</p>
                    <p class="mb-3"><strong>Reflective level</strong>: Upper thoughtful level</p>

                    <h5 class="fw-bold text-primary mb-2 mt-3" style="font-size: 1.05rem;">शिक्षण का स्तर</h5>
                    <p class="text-secondary mb-2">शिक्षण के स्तर में आम तौर पर तीन स्तर शामिल होते हैं जैसा कि नीचे बताया गया है: -</p>
                    <p class="mb-1"><strong>स्मृति स्तर</strong>: विचारहीन शिक्षण</p>
                    <p class="mb-1"><strong>समझ का स्तर</strong>: विचारशील शिक्षण</p>
                    <p class="mb-3"><strong>चिंतनशील स्तर</strong>: ऊपरी विचारशील स्तर</p>
                </div>
                 
                <div class="text-center my-3">
                    <span class="badge border bg-light text-dark px-4 py-2 rounded-pill fw-normal shadow-sm" style="font-size: 0.85rem; border-color: #dee2e6 !important;">
                        Manika Learning Academy 95-988-788-95
                    </span>
                </div>

                <hr class="my-4 border-light" />
                 
                <div class="notes-section mb-4">
                    <h5 class="fw-bold text-dark mb-2">1. Memory level of teaching:</h5>
                    <p class="text-dark mb-2">It is the first and <strong>thoughtless level</strong> of teaching. Teaching at memory level is considered to be the <strong>lowest level</strong> of teaching. At this level, the focus is on <strong>Drills and Remembering and recalling</strong> the facts and information.</p>

                    <h5 class="fw-bold text-primary mb-2 mt-3">1. शिक्षण का स्मृति स्तर:</h5>
                    <p class="text-dark mb-3">यह शिक्षण का प्रथम एवं <strong>विचारहीन स्तर</strong> है। स्मृति स्तर पर शिक्षण को शिक्षण का <strong>निम्नतम स्तर</strong> माना जाता है। इस स्तर पर, ध्यान अभ्यास और तथ्यों और सूचनाओं को याद रखने पर है।</p>
                </div>

                <div class="text-center my-3">
                    <span class="badge border bg-light text-dark px-4 py-2 rounded-pill fw-normal shadow-sm" style="font-size: 0.85rem; border-color: #dee2e6 !important;">
                        Manika Learning Academy 95-988-788-95
                    </span>
                </div>
            }
             
            @if (Model?.PYQData?.Questions != null && Model.PYQData.Questions.Any())
            {
                <div id="pyqContainer" class="mt-4 pt-3 border-top" style="display: none;">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h6 class="fw-bold text-dark mb-0"><i class="bi bi-patch-question me-2" style="color: #4f46e5;"></i> Practice PYQs</h6>
                        <span class="badge bg-light text-secondary border">Total: @Model.PYQData.TotalRecords</span>
                    </div>
                    
                    @foreach (var q in Model.PYQData.Questions)
                    {
                        <div class="pyq-example bg-light rounded-3 p-4 border border-light mb-3" data-question-id="@q.QuestionId">
                            <div class="d-flex gap-2 mb-3">
                                <span class="badge bg-white text-dark border fw-bold mt-1" style="height: fit-content;">Q.</span>
                                <div class="w-100">
                                    <span class="fw-semibold text-dark d-block">@Html.Raw(q.QuestionText)</span>
                                    @if (!string.IsNullOrEmpty(q.ExamName) || q.Year.HasValue)
                                    {
                                        <div class="text-muted mt-1" style="font-size: 0.75rem;">
                                            <span><i class="bi bi-bookmark me-1"></i> @q.ExamName</span>
                                            @if (q.Year.HasValue)
                                            {
                                                <span class="ms-2">(@q.Year)</span>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                            <div class="ps-4">
                                @if (q.Options != null)
                                {
                                    foreach (var opt in q.Options)
                                    {
                                        <div class="form-check mb-2">
                                            <input class="form-check-input shadow-none" type="radio" name="pyq_@q.QuestionId" id="opt_@opt.OptionId">
                                            <label class="form-check-label text-muted small" for="opt_@opt.OptionId">
                                                <strong>@opt.OptionLabel.</strong> @Html.Raw(opt.OptionText)
                                            </label>
                                        </div>
                                    }
                                }
                                <button class="btn btn-sm btn-outline-success mt-2 shadow-none px-3 py-1 rounded-pill btn-show-ans" style="font-size: 0.75rem;">
                                    Show Answer
                                </button>
                                <div class="ans-box mt-2 p-3 bg-success-subtle text-success border border-success-subtle rounded small d-none">
                                    <strong class="d-block mb-1">Explanation / Status:</strong>
                                    @(q.HasExplanation ? "Explanation available." : "Correct answer loaded from records.")
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>